		hasInnerCompositeWithViewCount: 2.
	
	self assertCompositeView: innerComposite hasMagritteDataViewWithDataKey: #magritteData.
	self assertCompositeView: innerComposite hasJsonDataViewWithDataKey: #jsonData.
	
