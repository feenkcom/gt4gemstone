method: GtLACPStoredSessionFixtures
writeRecords: records to: aFile
	aFile parent ensureCreateDirectory.
	aFile
		writeStreamDo: [ :stream | 
			records
				do: [ :record | 
					stream
						nextPutAll: (STONJSON toString: record);
						lf ] ]
%

