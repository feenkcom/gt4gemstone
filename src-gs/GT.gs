	anAnnotation := aLeDocumenterAnnotationNode annotation.
	(GtLAnnotationVisitorSupport visitor: self supports: anAnnotation)
		ifFalse: [ ^ stream nextPutAll: aLeDocumenterAnnotationNode source ].

	^ self visit: anAnnotation
