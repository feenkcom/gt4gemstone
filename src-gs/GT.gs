method: GtLChat
addAssistantMessage: aMessage
	"Add assistant message.
	Assistant messages are held in a reply message."

	| aReplyMessage |
	self updateLastUpdate.

	aMessage chat: self.
	aReplyMessage := self ensureReplyMessage.
	aReplyMessage finalMessage: aMessage
