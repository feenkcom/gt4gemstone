		ifTrue: [ nil ]
		ifFalse: [ segments last ]
%

method: ZnUrl
path
	self hasPath
		ifFalse: [ ^ String new ].
	^ String streamContents: [ :stream |
		segments
			do: [ :each |
				each = $/
					ifFalse: [ stream nextPutAll: each ] ]
			separatedBy: [ stream nextPut: $/ ] ]
%

method: ZnUrl
pathSegments
	^ segments ifNil: [ #() ]
