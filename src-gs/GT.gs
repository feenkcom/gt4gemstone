method: ProcessTelemetry
rootTimeSync: aNameBlock during: aBlock
	| aTelemetry aResult |
	"we store the telemetry on a stack to prevent it from being garbage collected"
	aTelemetry := self ensureValue.

	self value: aTelemetry.
	self reset.

	aResult := self
		time: aNameBlock
		during: aBlock.

	self emit.

	^ aResult
