interactionChatView
	^ GtPhlowView empty explicit
		title: 'Chat';
		priority: 0;
		stencil: [ | element |
			element := self chat asElement.
			interactionToReveal
				ifNotNil: [ element revealInteraction: interactionToReveal.
					interactionToReveal := nil ].
