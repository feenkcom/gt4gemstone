category: 'accessing'
method: GtLClassChangeHistory
addMethodHistory: aMethodHistory
	methodHistories addHistory: aMethodHistory
%

method: GtLClassChangeHistory
behaviourChangeHistory
	^ behaviourChangeHistory ifNil: [ 
			behaviourChangeHistory := GtLClassDefinitionChangeHistory new
				targetClassName: self targetClassName;
				yourself].
%

method: GtLClassChangeHistory
behaviourChanges
	^ self behaviourChangeHistory changes
%

method: GtLClassChangeHistory
changes
	"Return all changes: behaviour changes and method changes"
	| allChanges |
	allChanges := GtLSummarizerCodeChangesGroup new.
	allChanges addAll: self behaviourChanges.
	self methodHistories items do: [ :methodHistory |
		allChanges addAll: methodHistory changes ].
	^ allChanges
%

method: GtLClassChangeHistory
initialBehaviourChange 
	^ behaviourChangeHistory initialChange 
%

method: GtLClassChangeHistory
latestBehaviourChange 
	^ behaviourChangeHistory latestChange 
%

method: GtLClassChangeHistory
methodHistories
	^ methodHistories
%

category: 'adding'
method: GtLClassChangeHistory
addBehaviourChange: aCodeChange
	self behaviourChanges add: aCodeChange
%

category: 'gt - extensions'
method: GtLClassChangeHistory
gtViewDefinitionDiffFor: aView
	<gtView>
	self hasBehaviourChanges ifFalse: [ ^ aView empty ].
	
	^ aView diff
		title: 'Definition diff';
		priority: 10;
		from: [ self initialBehaviourChange changeResult originalDefinitionWithCommentString ];
		to: [ self latestBehaviourChange changeResult updatedDefinitionWithCommentString ];
		fromLabel: 'Initial version:';
		toLabel: 'Changed version: ';
		styler: GtCodeDiffRBTextStyler new
%

category: 'initialization'
method: GtLClassChangeHistory
initialize
	super initialize.
	methodHistories := GtLMethodChangeHistoriesGroup new
%

category: 'printing'
method: GtLClassChangeHistory
gtDisplayOn: aStream
	aStream nextPutAll: self targetClassName
%

category: 'testing'
method: GtLClassChangeHistory
hasBehaviourChanges
	^ self behaviourChanges size > 0
%

method: GtLClassChangeHistory
hasNoEffect
	^ self hasOnlyMethodChanges
		ifTrue: [
			"In case only methods changed, all method histories should have no effect"
			self methodHistories items allSatisfy: #hasNoEffect ]
		ifFalse: [
			"Check if definition changes cancel out"
			self isInitialDefinitionChangeAddition 
				and: [ self isLatestDefinitionChangeRemoval ] ]
%

method: GtLClassChangeHistory
hasOnlyMethodChanges
	^ self hasBehaviourChanges not
%

method: GtLClassChangeHistory
isInitialDefinitionChangeAddition
	^ behaviourChangeHistory isInitialChangeAddition
%

method: GtLClassChangeHistory
isLatestDefinitionChangeRemoval
	^ behaviourChangeHistory isLatestChangeRemoval
%

category: 'views'
method: GtLClassChangeHistory
gtBehaviourChangesFor: aView
	<gtView>
	^(aView forward)
		title: 'Behaviour changes';
		priority: 40;
		object: [behaviourChangeHistory];
		view: #gtCodeChangesFor:
%

method: GtLClassChangeHistory
gtMethodHistoriesFor: aView
	<gtView>
	^(aView forward)
		title: 'Methods';
		priority: 5;
		object: [methodHistories];
		view: #gtViewHistoriesFor:
%

method: GtLClassChangeHistory
gtViewChangeDescriptionElement
	^GtLClassDefinitionChangeDescriptionElement new
		updateForChangeHistory: self
%

method: GtLClassChangeHistory
gtViewChangeEditTime
	"Return the latest edit time across all changes"
	| times |
	times := OrderedCollection new.
	
	"Collect times from method histories"
	self methodHistories items do: [ :each | 
		each gtViewChangeEditTime ifNotNil: [ :t | times add: t ] ].
	
	"Collect times from behaviour changes"
	self behaviourChanges do: [ :each | 
		each gtViewChangeEditTime ifNotNil: [ :t | times add: t ] ].
	
	^ times ifEmpty: [ nil ] ifNotEmpty: [ times max ]
%

method: GtLClassChangeHistory
gtViewChangeHistoryChildren
	"Return definition/comment histories and method histories as children for tree view"
	| children |
	children := OrderedCollection new.
	self behaviourChangeHistory changes ifNotEmpty: [
		children add: self behaviourChangeHistory ].
	children addAll: self methodHistories items.
	^ children
%

method: GtLClassChangeHistory
gtViewChangesCount
	"Return total count including method changes and class-level changes"
	| methodChangesCount |
	methodChangesCount := self methodHistories items
		inject: 0
		into: [ :sum :each | sum + each gtViewChangesCount ].
	^ methodChangesCount + self behaviourChanges size
%

category: 'accessing'
method: GtJsonBasic
fullPathText

	| aPath |
	aPath := '' asRopedText.
	self withParentsDo: [ :aNode | aPath append: aNode pathText ].

	^ aPath
%

method: GtJsonBasic
jsonObject

	^ jsonValue exists
		  ifTrue: [ jsonValue value ]
		  ifFalse: [ nil ]
%

method: GtJsonBasic
jsonObject: aJsonObject

	jsonValue := GtJsonValue forValue: aJsonObject
%

method: GtJsonBasic
parents

	^ Array streamContents: [ :aStream | 
		  self withParentsDo: [ :eachNode | aStream nextPut: eachNode ] ]
%

method: GtJsonBasic
pathText

	<return: #BlText>
	^ self subclassResponsibility
%

method: GtJsonBasic
printOn: aStream

	super printOn: aStream.

	aStream
		nextPut: $(;
		nextPutAll: self fullPathText asString;
		nextPut: $)
%

method: GtJsonBasic
root

	^ self withParentsDo: [ :aNode | ^ aNode ]
%

category: 'accessing - path'
method: GtJsonBasic
at: anIndex

	self exists ifFalse: [ ^ self atUnknown: anIndex ].

	self jsonObject isDictionary ifTrue: [ ^ self atKey: anIndex ].

	(self jsonObject isCollection and: [ self jsonObject isString not ])
		ifTrue: [ ^ self atIndex: anIndex ].

	^ self atUnknown: anIndex
%

method: GtJsonBasic
at: anIndex ifAbsent: absentBlock
	^ self
		at: anIndex
		ifPresent: [ :aJson | aJson ]
		ifAbsent: absentBlock
%

method: GtJsonBasic
at: anIndex ifPresent: presentBlock ifAbsent: absentBlock
	| aJson |
	aJson := self at: anIndex.
	^ aJson ifExists: presentBlock ifNotExists: absentBlock
%

method: GtJsonBasic
atPath: aCollection

	^ aCollection
		  inject: self
		  into: [ :aJson :anIndex | aJson at: anIndex ]
%

method: GtJsonBasic
atPath: aCollection ifPresent: presentBlock ifAbsent: absentBlock
	| aJson |
	aJson := self atPath: aCollection.
	^ aJson ifExists: presentBlock ifNotExists: absentBlock
%

method: GtJsonBasic
atPath: aCollection put: aValue
	| aParent |
	aParent := aCollection allButLast
			inject: self
			into: [ :aJson :anIndex | aJson at: anIndex ].

	^ aParent at: aCollection last put: aValue
%

category: 'converting'
method: GtJsonBasic
asGtJson

	^ self
%

method: GtJsonBasic
asJson
	self
		deprecated: 'Please use #asGtJson instead.'
		transformWith: '`@receiver asJson' -> '`@receiver asGtJson'.
		
	^ self asGtJson
%

method: GtJsonBasic
asJsonString

	^ String streamContents: [ :aStream | 
		  | aWriter |
		  aWriter := NeoJSONWriter on: aStream.
		  aWriter nextPut: self jsonObject ]
%

category: 'enumerating'
method: GtJsonBasic
allLeafValuesDepthFirstDo: aBlock
	self
		allValuesDepthFirstDo: [ :aValue :aKey :aParent :aJson | 
			(aValue isCollection and: [ aValue isString not ])
				ifFalse: [ aBlock
						cull: aValue
						cull: aKey
						cull: aParent
						cull: aJson ] ]
%

method: GtJsonBasic
allValuesDepthFirstDo: aBlock
	self exists ifFalse: [ ^ self ].
	self jsonObject isString
		ifTrue: [ self evaluateBlock: aBlock.
			^ self ].
	self jsonObject isDictionary
		ifTrue: [ self jsonObject
				keysDo: [ :eachKey | (self at: eachKey) allValuesDepthFirstDo: aBlock ].
			self evaluateBlock: aBlock.
			^ self ].
	self jsonObject isCollection
		ifTrue: [ 1
				to: self jsonObject size
				do: [ :anIndex | (self at: anIndex) allValuesDepthFirstDo: aBlock ] ].
	self evaluateBlock: aBlock
%

method: GtJsonBasic
collect: aBlock
	self exists ifFalse: [ ^ #() ].

	^ self jsonObject species
		new: self jsonObject size
		streamContents: [ :aStream | 
			self jsonObject isDictionary
				ifTrue: [ self jsonObject
						keysDo: [ :aKey | 
							| aJson aResult |
							aJson := self at: aKey.
							aResult := aBlock cull: aJson cull: aKey.
							aStream nextPut: aResult ] ]
				ifFalse: [ 1
						to: self jsonObject size
						do: [ :anIndex | 
							| aJson aResult |
							aJson := self at: anIndex.
							aResult := aBlock cull: aJson cull: anIndex.
							aStream nextPut: aResult ] ] ]
%

method: GtJsonBasic
detect: aBlock ifFound: aFoundBlock ifNone: anExceptionBlock
	self jsonObject isDictionary
		ifTrue: [ self jsonObject
				keysDo: [ :aKey | 
					| aJson |
					aJson := self at: aKey.
					(aBlock cull: aJson cull: aKey)
						ifTrue: [ ^ aFoundBlock cull: aJson cull: aKey ] ] ]
		ifFalse: [ 1
				to: self jsonObject size
				do: [ :anIndex | 
					| aJson |
					aJson := self at: anIndex.
					(aBlock cull: aJson cull: anIndex)
						ifTrue: [ ^ aFoundBlock cull: aJson cull: anIndex ] ] ].

	^ anExceptionBlock value
%

method: GtJsonBasic
do: aBlock
	self jsonObject isDictionary
		ifTrue: [ self jsonObject
				keysDo: [ :aKey | 
					| aJson |
					aJson := self at: aKey.
					aBlock cull: aJson cull: aKey ] ]
		ifFalse: [ 1
				to: self jsonObject size
				do: [ :anIndex | 
					| aJson |
					aJson := self at: anIndex.
					aBlock cull: aJson cull: anIndex ] ]
%

method: GtJsonBasic
select: aBlock
	| aSelection |
	self exists ifFalse: [ ^ GtJson forJsonObject: #() ].

	aSelection := self jsonObject species
			streamContents: [ :aStream | 
				self jsonObject isDictionary
					ifTrue: [ self jsonObject
							keysDo: [ :aKey | 
								| aJson aResult |
								aJson := self at: aKey.
								aResult := aBlock cull: aJson cull: aKey.
								aResult ifTrue: [ aStream nextPut: aJson jsonObject ] ] ]
					ifFalse: [ 1
							to: self jsonObject size
							do: [ :anIndex | 
								| aJson aResult |
								aJson := self at: anIndex.
								aResult := aBlock cull: aJson cull: anIndex.
								aResult ifTrue: [ aStream nextPut: aJson jsonObject ] ] ] ].

	^ GtJsonFilter new
		parent: self;
		jsonObject: aSelection
%

method: GtJsonBasic
withParentsDo: aBlock

	self subclassResponsibility
%

category: 'evaluating'
method: GtJsonBasic
value
	"Overwritten to make this accessor available as key"
	
	^ self at: #value
