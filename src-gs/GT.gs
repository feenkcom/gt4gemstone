	^ 'grepFiles'
%

method: GtLMagritteToolForFilesGrep
resultLimit
	^ resultLimit ifNil: [ 1000 ]
%

category: 'initialization'
method: GtLMagritteToolForFilesGrep
initialize
	super initialize.
	resultLimit := 2000
%

category: 'magritte'
method: GtLMagritteToolForFilesGrep
