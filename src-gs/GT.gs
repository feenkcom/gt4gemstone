										toString: {{'type' -> 'junk'.
													'junk' -> 'rubbish'} asDictionary})} asDictionary.
	result := tool performToolCall: call.

	model := result targetObject.
	self assert: model isErrorDomainObject.
	self assert: model description equals: 'Unknown type: ''junk'''.

	^ call
