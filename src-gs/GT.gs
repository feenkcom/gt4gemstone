category: 'examples'
method: GtLMcpServerRpcErrorRecordExamples
basicRequest
	<gtExample>
	^ (ZnRequest post: '/') entity: (ZnEntity json: (STONJSON toString: Dictionary new))
%

method: GtLMcpServerRpcErrorRecordExamples
recordForParseFailure
	<gtExample>
	<return: #GtLMcpServerRpcErrorRecord>
	| request response record |
	request := self basicRequest.
	response := ZnResponse badRequest: request entity: (ZnEntity textCRLF: 'boom').
	record := [ STONJSON fromString: 'not-json' ]
		on: Error
		do: [ :anError |
			GtLMcpServerRpcErrorRecord
				forException: anError
				request: request
				response: response ].

	self assert: record exception notNil.
	self assert: record request equals: request.
	self assert: record response equals: response.
	self assert: record rpcMethodDescription isNil.
	self assert: record createdAt notNil.

	^ record
%

category: 'assertions'
method: GtLPrimitiveDataBlockExamples
assertSerializationForDataBlock: aDataBlock dataPartsCount: expectedSize
	"Assert that all LLM serialization methods return arrays of the expected size.
	This ensures consistency across different LLM providers (Anthropic, OpenAI, Bedrock, etc.)."
	
	| pragmas |
	pragmas := Pragma
		allNamed: #llmSerialization:
		from: aDataBlock class
		to: Object.
	
	self assert: pragmas isNotEmpty description: 'Data block should have LLM serialization methods'.
	
	pragmas do: [ :eachPragma |
		| result llmName |
		llmName := eachPragma arguments first.
		result := aDataBlock perform: eachPragma methodSelector.
		self 
			assert: result size = expectedSize
			description: ('Serialization for {1} should return array of size {2}, but got {3}' 
				format: { llmName. expectedSize. result size }) ]
%

method: GtLPrimitiveDataBlockExamples
assertSerializationForDataBlockWithOneDataPart: aDataBlock
	self assertSerializationForDataBlock: aDataBlock dataPartsCount: 1
