category: 'accessing'
method: GtLMcpHttpTransport
sessionId
	^ sessionId
%

method: GtLMcpHttpTransport
sessionId: anObject
	sessionId := anObject
%

category: 'as yet unclassified'
method: GtLMcpHttpTransport
client
	| client |
	client := ZnClient new
			url: url;
			accept: 'application/json,text/event-stream';
			contentReader: [ :entity | 
				entity
					ifNil: [ {} ]
					ifNotNil: [ NeoJSONReader
							fromString: (entity contentType asString = 'application/json'
									ifTrue: [ entity contents ]
									ifFalse: [ (entity contents lines last: 2) first removePrefix: 'data: ' ]) ] ];
			contentWriter: [ :data | ZnEntity json: (NeoJSONWriter toString: data) ].

	sessionId ifNotNil: [ client headerAt: 'Mcp-Session-Id' put: sessionId ].

	^ client
%

method: GtLMcpHttpTransport
gtMessagesFor: aView
	<gtView>
	^ aView columnedList
		title: 'Messages';
		priority: 1;
		items: [ messages ];
		column: 'Method'
			text: [ :aMessage | aMessage at: 'method' ifAbsent: [ 'response' ] ];
		column: 'Body'
			text: [ :aMessage | aMessage ]
			weight: 3
%

method: GtLMcpHttpTransport
initialize
	super initialize.
	
	messages := OrderedCollection new
%

method: GtLMcpHttpTransport
receiveResponse
	messages add: result.
	^ result
%

method: GtLMcpHttpTransport
sendMessage: anObject
	| client |
	client := self client contents: anObject.
	
	messages add: anObject.

	result := client post.

	client response headers
		at: 'Mcp-Session-Id'
		ifPresent: [ :aValue | sessionId := aValue ]
%

method: GtLMcpHttpTransport
terminate
%

method: GtLMcpHttpTransport
url: anUrl
	url := anUrl asZnUrl
%

category: 'examples'
method: GtLOllamaResponsesExamples
messageWithToolCallThenCompactionExecutor
	| executor provider |
	executor := GtLOllamaResponsesExampleExecutor new.
	executor loadExpectedHistoryFrom: self messageWithToolCallThenCompactionExampleHistory.
	provider := executor provider.
	provider 
		baseUrl: 'https://ollama.com' asZnUrl;
		loadApiKeyFromFile;
		modelName: 'kimi-k2.7-code:cloud'.
	^ executor
