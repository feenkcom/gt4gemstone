category: 'examples'
method: GtLClassRemovalResultExamples
classRemovalResultCreation
	<gtExample>
	| result |
	result := GtLClassRemovalResult new
		removedClass: (GtLClassDefinitionDescription new 
			currentClassName: 'MyTestClass');
		status: 'removed';
		yourself.
