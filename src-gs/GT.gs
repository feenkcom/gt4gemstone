	^ self
		profile: aBlock
		executing:  [ :blockClosure |			
			blockClosure value.
			aSpace
				asSpartaForm: nil
				scaleFactor: nil
				hdpiScaleFactor: aSpace scaleFactor ]
		as: #spaceSnapshot
