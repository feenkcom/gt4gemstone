category: 'initialization'
method: GtLACPWorkGraphElement
initialize
	super initialize.
	self
		hMatchParent;
		vMatchParent.
	renderedKeys := #().
	listElement := BrColumnedList new
			id: #'acp-work-graph-list';
			hMatchParent;
			vMatchParent;
			items: OrderedCollection new;
			yourself.
	self configureColumns.
	updater := BrElementUpdater new
			element: self selector: #updateRows;
			postponedDuration: 150 milliseconds;
			yourself.
	self addChild: listElement
%

category: 'updating'
method: GtLACPWorkGraphElement
onWorkChanged: anAnnouncement
	self enqueueTask: (BlTaskAction new action: [ updater requestUpdate ])
%

method: GtLACPWorkGraphElement
updateRows
	| items previous oldCount changed keys source |
	graph ifNil: [ ^ self ].
	graph refresh.
	items := graph rows.
	keys := items collect: #renderingKey as: Array.
	previous := listElement items.
	oldCount := previous size.
	graphColumn columnWidth = graph graphWidth
		ifFalse: [ graphColumn width: graph graphWidth ].
	(oldCount <= items size
		and: [ (1 to: oldCount)
				allSatisfy: [ :index | (previous at: index) == (items at: index) ] ])
		ifFalse: [ listElement items: items asOrderedCollection.
			renderedKeys := keys.
			^ self ].
	changed := (1 to: oldCount)
			select: [ :index | (renderedKeys at: index) ~= (keys at: index) ].
	source := (listElement childNamed: #scrollable) dataSource.
	items size > oldCount
		ifTrue: [ previous addAll: (items copyFrom: oldCount + 1 to: items size).
			source notifyItemsInserted: (oldCount + 1 to: items size) ].
	changed do: [ :index | source notifyItemsChanged: (index to: index) ].
	renderedKeys := keys
%

category: 'accessing'
method: GROrderedMultiMap2
allAt: aKey
	^ self privateAllAt: aKey startingAt: 1
%

method: GROrderedMultiMap2
allAt: aKey ifAbsent: absentBlock
	| results |
	results := self allAt: aKey.
	^ results isEmpty
		ifTrue: [ absentBlock value ]
		ifFalse: [ results ]
%

category: 'adding'
method: GROrderedMultiMap2
add: anAssociation
	self privateAt: anAssociation key put: anAssociation value.
	^ anAssociation
%

method: GROrderedMultiMap2
addAll: aDictionary
	aDictionary keysAndValuesDo: [ :key :value |
			self privateAt: key put: value ].
	^ aDictionary
%

method: GROrderedMultiMap2
at: aKey add: aValue
	"Add an association between aKey and aValue. Do not replace existing
	values with the same key."

	^ self privateAt: aKey put: aValue
%

category: 'enumerating'
method: GROrderedMultiMap2
keysAndAllValuesDo: aTwoArgumentBlock
	| seenKeys |
	seenKeys := GRSmallOrderedSet new.
	1 to: size * 2 - 1 by: 2 do: [ :index |
		| key |
		key := table at: index.
		(seenKeys includes: key) ifFalse: [
			aTwoArgumentBlock
				value: key
				value: (self privateAllAt: key startingAt: index).
			seenKeys add: key ] ]
%

category: 'private '
method: GROrderedMultiMap2
privateAllAt: aKey startingAt: index
	^ Array new: 2 streamContents: [ :stream |
		index to: size * 2 - 1 by: 2 do: [ :i |
			(table at: i) = aKey
				ifTrue: [ stream nextPut: (table at: i + 1) ] ] ]
%

category: 'removing'
method: GROrderedMultiMap2
removeKey: aKey ifAbsent: aBlock
	"Remove aKey from the receiver, evaluate aBlock if the element is missing."

	"This is inefficient and could be optimized."
	| removed |
	removed := Array new: 2 streamContents: [ :stream |
		| index |
		[ (index := self findIndexFor: aKey) = 0 ] whileFalse: [
			stream nextPut: (self removeIndex: index) ] ].
	^ removed isEmpty
		ifTrue: [ aBlock value ]
		ifFalse: [ removed ]
%

