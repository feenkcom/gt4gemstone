method: GtLToolForExampleMethodRunExamples
exampleRunSerializesForMcp
	<gtExample>
	| call data |
	call := self exampleRunSuccessStoresObjectId.
	data := NeoJSONReader fromString:
		(GtMagritteJSONDataExporter forObject: call result targetObject) exportObjectAsJsonString.
	self assert: (data at: 'statusText') equals: 'success'.
	self assert: ((data at: 'exampleReference') at: 'methodName') equals: 'successfulExample'.
	self assert: (data at: 'objectId') isString.
	self assert: ((data at: 'result') at: 'objectId') equals: (data at: 'objectId').
	self assert: (((data at: 'result') at: 'objectValue') at: 'objectPrintString') equals: '42'.
	^ call
%

method: GtLToolForExampleMethodRunExamples
exampleRunSuccess
	<gtExample>
	| tool call targetObject resultObject |
	resultObject := GtLExampleRunDummyExamples new successfulExample.
	self ensureLepiterPageForObject: resultObject withSnippetCode: 'GtLExampleRunDummyExamples new successfulExample'.
	tool := GtLToolForExampleMethodRun new.
	call := self
		executeTool: tool
		withArguments: {
			'exampleReference' -> {
					'exampleClassName' -> 'GtLExampleRunDummyExamples'.
					'methodName' -> 'successfulExample'.
					'classSide' -> false
				} asDictionary
			} asDictionary
		inContext: (GtLToolExecutionContext new 
			lepiterDatabase: self theDatabase).
	targetObject := call result targetObject.
	self assert: (targetObject isKindOf: GtLExampleWithResult).
	self assert: targetObject isSuccessResult.
	self assert: targetObject objectId isNil.
	self
		gtDo: [
	self assert: targetObject playgroundPageReference notNil.
	self assert: targetObject playgroundPageReference databaseId equals: self theDatabase primaryDB uuidString.
	self assert: targetObject playgroundPageReference pageId equals: self theDatabase pages first uid asString36.
		]
		gemstoneDo: [ self assert: targetObject playgroundPageReference isNil ].
	^ call
%

method: GtLToolForExampleMethodRunExamples
exampleRunSuccessStoresObjectId
	<gtExample>
	| objectStorage tool call targetObject objectId storedObject resultObject |
	resultObject := GtLExampleRunDummyExamples new successfulExample.
	self ensureLepiterPageForObject: resultObject withSnippetCode: 'GtLExampleRunDummyExamples new successfulExample'.
	objectStorage := GtLObjectStorage new.
	tool := GtLToolForExampleMethodRun new.
	call := self
		executeTool: tool
		withArguments: {
			'exampleReference' -> {
				'exampleClassName' -> 'GtLExampleRunDummyExamples'.
				'methodName' -> 'successfulExample'.
				'classSide' -> false
			} asDictionary
		} asDictionary
		inContext: (GtLToolExecutionContext new 
			objectStorage: objectStorage;
			lepiterDatabase: self theDatabase).
	targetObject := call result targetObject.
	self assert: (targetObject isKindOf: GtLExampleWithResult).
	self assert: targetObject isSuccessResult.
	self
		gtDo: [
	self assert: targetObject playgroundPageReference notNil.
	self assert: targetObject playgroundPageReference databaseId equals: self theDatabase primaryDB uuidString.
	self assert: targetObject playgroundPageReference pageId equals: self theDatabase pages first uid asString36.
		]
		gemstoneDo: [ self assert: targetObject playgroundPageReference isNil ].
	objectId := targetObject objectId.
	self assert: objectId isString.
	self assert: (objectStorage objectAt: objectId) equals: 42.
	storedObject := objectStorage storedObjectAt: objectId.
	self assert: storedObject reason class equals: GtLStoredObjectExampleMethodReason.
	^ call
%

category: 'private'
method: GtLToolForExampleMethodRunExamples
ensureLepiterPageForObject: anObject withSnippetCode: aString
	| page snippet |
	self gtDo: [ ] gemstoneDo: [ ^ self ].
	page := LePage pharoClassName: anObject class name.
	snippet := LePharoSnippet new.
	snippet code: aString.
	page addSnippet: snippet.
	self theDatabase addPage: page.
	self assert: page children size equals: 1
%

category: 'examples'
method: GtLToolForSearchFilterExamples
searchFilterForExampleMethods
	<gtExample>
	| call targetObject |
	call := self
		executeTool: GtLToolForSearchFilter new
		withArguments: {
			'query' -> 'GtLToolForSearchFilterExamples gtMethodsInClass & #gtExample gtPragmas'
		} asDictionary.
	targetObject := call result targetObject.
	self assert: (targetObject isKindOf: GtLSearchFilterDomainObject).
	self assert: targetObject isErrorDomainObject not.
	self assert: targetObject items isNotEmpty.
	self assert: (targetObject items anySatisfy: [ :eachMethod |
		eachMethod methodClass = GtLToolForSearchFilterExamples
			and: [ eachMethod selector = #searchFilterForExampleMethods ] ]).
	^ call
%

method: GtLToolForSearchFilterExamples
searchFilterWithError
	<gtExample>
	| call targetObject |
	call := self
		executeTool: GtLToolForSearchFilter new
		withArguments: {
			'query' -> 'self error: ''boom'''
		} asDictionary.
	targetObject := call result targetObject.
	self assert: targetObject isErrorDomainObject.
	self assert: (targetObject description beginsWith: 'There was an error when evaluating the query: ').
	self assert: (targetObject description includesSubstring: 'boom').
	^ call
