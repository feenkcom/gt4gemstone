category: 'running'
method: GtExamplesTestingHudsonReport
end
	resultsStream tab; nextPutAll: '<system-out><![CDATA[]]></system-out>'; lf.
	resultsStream tab; nextPutAll: '<system-err><![CDATA[]]></system-err>'; lf.
	resultsStream nextPutAll: '</testsuite>'.
	
	resultsStream wrappedStream position: resultSummaryPosition.
	resultsStream 
		nextPutAll: ' failures="'; print: self failureCount; 
		nextPutAll: '" errors="'; print: self errorCount; 
		nextPutAll: '" time="'; print: executionTime asMilliSeconds / 1000.0; 
		nextPutAll: '">'.
	resultsStream close.
	
	progressStream 
		nextPutAll: ('Finished running {1}: ' format: {self class name});
		nextPutAll: self reportName;
		close
%

method: GtExamplesTestingHudsonReport
ensureStreamsClosed
	"Close both streams and then forget them.
	Leaving a closed stream in an instance variable is what let a second #tearDown write to a closed
	file and raise a FileWriteError, which escaped #run and failed a whole package run."

	[ resultsStream ifNotNil: [ resultsStream close ] ] 
		on: Error 
		do: [ :anError |  Stdio stderr print: anError ].
	resultsStream := nil.
	[ progressStream ifNotNil: [ progressStream close ] ] 
		on: Error 
		do: [ :anError |  Stdio stderr print: anError ].
	progressStream := nil
%

method: GtExamplesTestingHudsonReport
run
	[ self setUp.
	executionTime := [ self runAll ] timeToRun ] ensure: [ self tearDown ]
%

method: GtExamplesTestingHudsonReport
runAll
	CurrentExecutionEnvironment
		runTestsBy: [ self testCasesToRun do: [ :each | self runTestCase: each ] ]
%

method: GtExamplesTestingHudsonReport
runTestCase: anExample
	self subclassResponsibility
%

method: GtExamplesTestingHudsonReport
setUp
	self ensureResultsFile.
	self ensureProgressFile.
	
	self startFor: self testCases.
%

method: GtExamplesTestingHudsonReport
startFor: examplesToTest

	resultsStream nextPutAll: '<?xml version="1.0" encoding="UTF-8"?>'; lf.
	resultsStream 
		nextPutAll: '<testsuite '; 
			nextPutAll: 'name="'; nextPutAll: (self encode: self reportName); 
			nextPutAll: '" tests="'; print: examplesToTest size; 
		nextPutAll: '">'.
	
	"Now this is ugly. We want to update the time and the number of failures and errors, but still at the same time stream a valid XML. So remember this position and add some whitespace, that we can fill later."
	resultSummaryPosition := resultsStream wrappedStream position - 1.
	resultsStream nextPutAll: (String new: 100 withAll: Character space); lf.
%

method: GtExamplesTestingHudsonReport
tearDown
	"Finalise the report.
	#run calls me from an ensure: block, so I also run when an example terminates the process and the
	stack unwinds. I must therefore be idempotent: once the streams are gone there is nothing to write.
	Writing the footer is guarded the same way closing already is, so a failure here truncates one
	class' report instead of failing the whole package run."

	resultsStream ifNil: [ ^ self ensureStreamsClosed ].
	[ self end ] 
		on: Error 
		do: [ :anError | Stdio stderr print: anError ].
	self ensureStreamsClosed
%

