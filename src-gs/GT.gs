	^ self remove: anObject ifAbsent: [ self errorNotFound ]
%

method: GRSmallOrderedSet
remove: anObject ifAbsent: aNiladicBlock
	| index |
	index := self findIndexFor: anObject.
	index = 0
		ifTrue: [ ^ aNiladicBlock value ]
		ifFalse: [ self removeIndex: index ].
	^ anObject
%

