	| content role |

	content := self visitNode: aMessage.
	role := aMessage isCompactionMessage
		ifTrue: [ 'assistant' ]
		ifFalse: [ aMessage role ].
	^ {
		'role' -> role.
		'content' -> content
	} asDictionary
%

category: 'visiting'
method: GtLOllamaCompletionsMessageVisitor
visitGtLModelAssistantMessage: anAssistantMessage

	^ { {
		'type' -> 'text'.
		'text' -> anAssistantMessage contentText 
		} asDictionary.
		}
%

method: GtLOllamaCompletionsMessageVisitor
visitGtLModelCompactionMessage: aCompactionMessage
	aCompactionMessage hasPortableContent ifFalse: [
		self error: 'This opaque compaction cannot be serialized for the current provider' ].

	^ { {
		'type' -> 'text'.
		'text' -> aCompactionMessage portableContentText
	} asDictionary }
%

method: GtLOllamaCompletionsMessageVisitor
visitGtLModelUserMessage: aUserMessage

	^ aUserMessage computeContentBlockFromInputModels acceptVisitor: self
%

method: GtLOllamaCompletionsMessageVisitor
visitGtLPrimitiveCompositeJsonGenericDataBlock: aDataBlock
	| content |

	content := aDataBlock jsonDataBlocks 
			collect: [ :dataBlock |
				dataBlock acceptVisitor: self ]
			as: Array.

	^ aDataBlock dataKey ifNil:
		[ content ]
	ifNotNil:
		[ { aDataBlock dataKey -> content } asDictionary ]
%

method: GtLOllamaCompletionsMessageVisitor
visitGtLPrimitiveJsonBareDataBlock: aDataBlock
	| string |

	string := aDataBlock jsonData.
	self assert: string isString.
	^ string
%

method: GtLOllamaCompletionsMessageVisitor
visitGtLPrimitiveJsonDataBlock: aDataBlock
	"This is a bit of a hack at the moment.
	If the data block is just content, assume that the message is a simple string and just answer the content, otherwise answer the string serialisation."

	^ aDataBlock jsonData 
		at: 'content'
		ifPresent: [ :string |
			self assert: string isString.
			string ]
		ifAbsent:
			[ NeoJSONWriter toStringPretty: aDataBlock jsonData ].
%

method: GtLOllamaCompletionsMessageVisitor
visitGtLPrimitiveMessageDataBlock: aDataBlock
	"Non-string parts (for example a stored object's serialised views) are printed with #printOn: before joining. #join: relies on #asString, which answers the printString in Pharo but only a class description (such as 'aDictionary') in GemStone, and GemStone's Collection>>#printString is capped at 700 characters."

	| content text |
	content := OrderedCollection new.
	text := String crlf
			join: ((aDataBlock compositeJsonDataBlock acceptVisitor: self)
					collect: [ :each | 
						each isString
							ifTrue: [ each ]
							ifFalse: [ String streamContents: [ :aStream | each printOn: aStream ] ] ]).
	content
		add: {'type' -> 'text'.
				'text' -> (NeoJSONWriter toStringPretty: text)} asDictionary.
	aDataBlock imageDataBlocks
		do: [ :dataBlock | 
			content
				add: {'type' -> 'image_url'.
						'image_url'
							-> ('data:image/' , dataBlock imageType , ';base64,' , dataBlock encodedBytes)}
						asDictionary ].
	^ content asArray
%

method: GtLOllamaCompletionsMessageVisitor
visitNode: aUserMessage

	^ aUserMessage acceptVisitor: self
%

category: 'examples'
method: GtLClassDefinitionDescriptionExamples
classDefinitionDescriptionCreation
	<gtExample>
	| description |
	description := GtLClassDefinitionDescription new
		currentClassName: 'MyClass';
		superclassName: 'Object';
		comment: 'A test class';
		packageName: 'MyPackage';
		instanceSlotNames: #('slot1' 'slot2');
		classSlotNames: #();
		classVariableNames: #('SharedValue');
		traitCompositionString: '{}';
		yourself.
	self assert: description currentClassName equals: 'MyClass'.
	self assert: description superclassName equals: 'Object'.
	self assert: description comment equals: 'A test class'.
	self assert: description packageName equals: 'MyPackage'.
	self assert: description instanceSlotNames equals: #('slot1' 'slot2').
	self assert: description classSlotNames equals: #().
	self assert: description classVariableNames equals: #('SharedValue').
	self assert: description traitCompositionString equals: '{}'.
	^ description
%

method: GtLClassDefinitionDescriptionExamples
classDefinitionDescriptionSerialization
	<gtExample>
	| description json |
	description := self classDefinitionDescriptionCreation.
	
	json := GtMagritteJSONDataExporter exportObject: description.
	self assert: (json at: 'currentClassName') equals: 'MyClass'.
	self assert: (json at: 'superclassName') equals: 'Object'.
	self assert: (json at: 'comment') equals: 'A test class'.
	self assert: (json at: 'packageName') equals: 'MyPackage'.
	self assert: (json at: 'instanceSlotNames') asArray equals: #('slot1' 'slot2').
	self assert: (json at: 'classSlotNames') asArray equals: #().
	self assert: (json at: 'classVariableNames') asArray equals: #('SharedValue').
	self assert: (json at: 'traitCompositionString') equals: '{}'.
	^ json
%

method: GtLClassDefinitionDescriptionExamples
fromClassWithClassVariables
	<gtExample>
	| description aClass |
	"Use a class with class variables"
	aClass := Boolean.
	description := GtLClassDefinitionDescription fromClass: aClass.
	self assert: description currentClassName equals: aClass name.
	self assert: description superclassName equals: aClass superclass name.
	self assert: description packageName equals: aClass package name.
	self assert: description classVariableNames isCollection.
	^ description
%

method: GtLClassDefinitionDescriptionExamples
fromConcreteClass
	<gtExample>
	| description aClass |
	aClass := GtLClassDefinitionDescription.
	description := GtLClassDefinitionDescription fromClass: aClass.
	self assert: description currentClassName equals: aClass name.
	self assert: description superclassName equals: aClass superclass name.
	self assert: description packageName equals: aClass package name.
	self assert: description instanceSlotNames asArray equals: (aClass instanceVariables collect: #name) asArray.
	self assert: description classSlotNames asArray equals: aClass class slotNames asArray.
	self assert: description classVariableNames asArray equals: (aClass classVariables collect: #name) asArray.
	self assert: description traitCompositionString equals: aClass traitCompositionString.
	^ description
%

