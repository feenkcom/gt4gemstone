category: 'assertions'
method: GtLMagritteToolForMethodCompilationExamples
assertExceptionDomainObject: aDomainObject withExceptionClass: anExceptionClass messageSubstring: aMessageSubstring
	"Assert that the domain object has an exception with expected class and message."
	
	self assert: aDomainObject isErrorDomainObject.
	self assert: aDomainObject exception isNotNil.
	self assert: aDomainObject exception class equals: anExceptionClass.
	self assert: (aDomainObject messageText includesSubstring: aMessageSubstring)
%

method: GtLMagritteToolForMethodCompilationExamples
assertMethodCompilationException: aDomainObject withTargetClassName: aClassName sourceCode: aSourceCode description: aDescription exceptionClass: anExceptionClass messageSubstring: aMessageSubstring
	"Assert that the domain object is a GtLMethodCompilationExceptionDomainObject with expected values."
	
	self assert: (aDomainObject isKindOf: GtLMethodCompilationExceptionDomainObject).
	self assert: aDomainObject targetClassName equals: aClassName.
	self assert: aDomainObject sourceCode equals: aSourceCode.
	self assert: (aDomainObject description beginsWith: aDescription).
	self 
		assertExceptionDomainObject: aDomainObject 
		withExceptionClass: anExceptionClass 
		messageSubstring: aMessageSubstring
%

category: 'examples'
method: GtLMagritteToolForMethodCompilationExamples
compileClassSideMethod
	<gtExample>
	| selector targetClass metaClass source |
	selector := #gtMagritteCompiledExampleClassSideMethod.
	targetClass := GtLMagritteToolForMethodCompilationExamples.
	metaClass := targetClass class.
	source := 'gtMagritteCompiledExampleClassSideMethod ^ ''class'''.
