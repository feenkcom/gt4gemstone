category: 'examples - assertions'
method: GtLOpenAIProviderCopyChatExamples
assertCopiedReplyMessage: aCopiedReply isCopyOf: anOriginalReply forChat: aChat
	self assertCopiedChatMessage: aCopiedReply isCopyOf: anOriginalReply forChat: aChat.
	self assert: aCopiedReply userMessage ~~ anOriginalReply userMessage.
	self assert: aCopiedReply finalMessage ~~ anOriginalReply finalMessage.
	self assert: aCopiedReply executionMessages size equals: anOriginalReply executionMessages size.
	self assert: (aCopiedReply executionMessages allSatisfy: [ :each | each chat == aChat ]).
	self assertCopiedChatMessage: aCopiedReply userMessage isCopyOf: anOriginalReply userMessage forChat: aChat.
	self assertCopiedChatMessage: aCopiedReply finalMessage isCopyOf: anOriginalReply finalMessage forChat: aChat.
	self assert: aCopiedReply summarizersRegistry ~~ anOriginalReply summarizersRegistry.
	self assert: aCopiedReply summarizersRegistry specifications size equals: anOriginalReply summarizersRegistry specifications size.
	self assert: aCopiedReply summarizersRegistry currentSummarizers isEmpty.
%

method: GtLOpenAIProviderCopyChatExamples
assertForkedChat: aForkedChat from: anOriginalChat hasReplyWithExecutionMessagesCount: anInteger hasFinalMessage: aBoolean
	| originalMessages forkedMessages originalReply forkedReply |
	
	originalMessages := anOriginalChat messages asArray.
	forkedMessages := aForkedChat messages asArray.
	originalReply := originalMessages second.
	forkedReply := forkedMessages second.
	
	self assert: aForkedChat ~~ anOriginalChat.
	self assert: forkedMessages size equals: 2.
	self assert: (forkedMessages allSatisfy: [ :each | each chat == aForkedChat ]).
	self assertCopiedChatMessage: forkedMessages first isCopyOf: originalMessages first forChat: aForkedChat.
	self assert: forkedReply class equals: GtLReplyMessage.
	self assert: forkedReply chat == aForkedChat.
	self assert: forkedReply userMessage == forkedMessages first.
	self assert: forkedReply executionMessages size equals: anInteger.
	self assert: (forkedReply executionMessages allSatisfy: [ :each | each chat == aForkedChat ]).
	self assert: forkedReply summarizersRegistry ~~ originalReply summarizersRegistry.
	self assert: forkedReply summarizersRegistry specifications size equals: originalReply summarizersRegistry specifications size.
	self assert: forkedReply summarizersRegistry currentSummarizers isEmpty.
	aBoolean
		ifTrue: [
			self assert: forkedReply finalMessage notNil.
			self assert: forkedReply finalMessage class equals: GtLOpenAIAssistantMessage.
			self assert: forkedReply finalMessage chat == aForkedChat ]
		ifFalse: [ self assert: forkedReply finalMessage isNil ].
%

category: 'private'
method: GtLOpenAIProviderCopyChatExamples
newFinishedToolMessageWithText: aString forChat: aChat
	| toolCall toolMessage |
	
	toolCall := GtLFunctionToolCall new.
	toolCall
		name: 'search';
		arguments: Dictionary new;
		result: (GtLString forString: aString).
	toolMessage := GtLToolMessage new.
	toolMessage toolCall: toolCall.
	toolMessage beFinishedExecutionState.
	toolMessage chat: aChat.
	
	^ toolMessage
%

category: 'examples'
method: GtLACPElicitationScripterExamples
childQuestionVisibleInRoot
	<gtExample>
	| root child question scripter helper modelExamples |
	modelExamples := GtLACPElicitationExamples new.
	root := GtLACPExamples new session.
	root prompt: 'Ask a worker to choose a layout'.
	helper := GtLACPSubagentExamples new.
	child := helper
			announce: 'question-worker'
			title: 'Layout worker'
			in: root.
	helper
		task: 'Choose the layout'
		from: root
		to: child
		id: 'question-task'.
	scripter := BlScripter new
			extent: 1000 @ 1000;
			model: root;
			element: root asElement;
			yourself.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-content';
				notExists ].
	scripter
		doStep: [ :step | 
			step
				block: [ modelExamples
						receive: (modelExamples questionParametersFor: child)
						id: 'child-question'
						in: child ] ].
	scripter pulseUntilReady.
	question := child currentTurn elicitationRequests first.
	self assert: (root currentTurn pendingDelegatedElicitations includes: question).
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-content';
				exists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-question-submit';
				exists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-tool-summary-ask-1';
				notExists ].
	scripter click
		id: #'acp-question-question_0-option-1';
		play.
	scripter click
		id: #'acp-question-submit';
		play.
	self assert: question state equals: #accept.
	self assert: root currentTurn pendingDelegatedElicitations isEmpty.
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

method: GtLACPElicitationScripterExamples
freeTextSurvivesRefresh
	<gtExample>
	| question scripter reply |
	question := GtLACPElicitationExamples new pendingQuestion.
	scripter := BlScripter new
			extent: 1000 @ 1000;
			model: question;
			element: question session asElement;
			yourself.
	scripter requestFocus
		id: #'acp-question-question_0_custom';
		play.
	scripter typeStep: [ :step | step text: 'Use a timeline instead' ].
	self
		assert: (question answerAt: 'question_0_custom')
		equals: 'Use a timeline instead'.
	scripter doStep: [ :step | step block: [ question session announceChanged ] ].
	scripter pulseUntilReady.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-question-question_0_custom';
				value: [ :editor | editor text asString ]
					equals: [ 'Use a timeline instead' ] ].
	scripter click
		id: #'acp-question-submit';
		play.
	reply := question session connection transport sentMessages last.
	self
		assert: (((reply at: 'result') at: 'content') at: 'question_0_custom')
		equals: 'Use a timeline instead'.
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

method: GtLACPElicitationScripterExamples
pendingQuestionDisplayed
	<gtExample>
	| question scripter |
	question := GtLACPElicitationExamples new pendingQuestion.
	scripter := BlScripter new
			extent: 1000 @ 1000;
			model: question;
			element: question session asElement;
			yourself.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-question-submit';
				exists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-content';
				exists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-tool-summary-ask-1';
				notExists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-content';
				satisfies: [ :work | 
					| questions |
					questions := OrderedCollection new.
					work
						withAllChildrenBreadthFirstDo: [ :each | (each isKindOf: GtLACPInteractionElement) ifTrue: [ questions add: each ] ].
					questions size = 1 ] ].
	scripter click
		id: #'acp-work-toggle';
		play.
	scripter doStep: [ :step | step block: [ question session announceChanged ] ].
	scripter pulseUntilReady.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-question-submit';
				notExists ].
	scripter click
		id: #'acp-work-toggle';
		play.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-question-submit';
				exists ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
