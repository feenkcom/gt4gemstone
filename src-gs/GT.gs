category: 'examples - support'
method: GtLPrimitiveImageDataBlockExamples
sampleImageBytes
	<gtExample>
	| element rootElement form imageBytes |
	element := BlElement new
		size: 100@100;
		background: Color blue.
		
	rootElement := BlScripter new
			element: element;
			extent: 1600@1200;
			elementWithoutParent.
	form := BlExporter png
			element: rootElement;
			doExport: [ :aCanvas | aCanvas asForm ].
	imageBytes :=(ByteArray
		streamContents: [ :out | PNGReadWriter putForm: form onStream: out ]).
	
	self assert: imageBytes isNotEmpty.
	
	^ imageBytes
%

category: 'examples'
method: GtLPrimitiveJsonDataBlockExamples
addJsonBlockOneWithDataKeyWithBlockTwoWithDataKey
	<gtExample>
	| block1 block2 expectedJsonData expectedLlmJsonData |
	block1 := GtLPrimitiveJsonDataBlock new
		dataKey: 'person';
		jsonData: (Dictionary new
			at: 'name' put: 'John';
			yourself).
	
	block2 := GtLPrimitiveJsonDataBlock new
		dataKey: 'address';
		jsonData: (Dictionary new
			at: 'city' put: 'New York';
			yourself).
	
	self assert: block1 keysForMerge equals: #('person').
	self assert: block2 keysForMerge equals: #('address').
	
	block1 addJsonBlock: block2.
	
	expectedJsonData := Dictionary new
		at: 'name' put: 'John';
		at: 'address' put: (Dictionary new
			at: 'city' put: 'New York';
			yourself);
		yourself.
	
	expectedLlmJsonData := Dictionary new
		at: 'person' put: expectedJsonData;
		yourself.
	
	self assert: block1 jsonData equals: expectedJsonData.
	self assert: block1 llmJsonData equals: expectedLlmJsonData.
	self assert: block1 keysForMerge equals: #('person').
	self assertSerializationForDataBlockWithOneDataPart: block1.
	
	^ block1
%

