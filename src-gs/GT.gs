method: GtLACPToolCall
mcpToolMessageIn: aServer
 | toolCallId |
 aServer ifNil: [ ^ nil ].
 toolCallId := self id.
 toolCallId ifNil: [ ^ nil ].
 ^ aServer historySnapshot
  detect: [ :each | each toolCall id = toolCallId ]
  ifNone: [ nil ]
