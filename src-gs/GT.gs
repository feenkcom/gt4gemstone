method: GtLChat
postCopyForIndependentRequestAt: aMessage
	announcer := Announcer new.
	
	messages := messages 
		copyForIndependentRequestInChat: self upTo: aMessage.
	provider := provider copyForIndependentRequest.
	provider chat: self.
	
	instructions := instructions copy.
	objectStorage := objectStorage copy.
	responseFormat := responseFormat copy.
	tools := tools copy.
	summarizersRegistry := summarizersRegistry copy
%

