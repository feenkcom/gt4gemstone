category: 'public'
method: GtExampleEvaluator
result
	<return: #GtExampleResult>
	self do: [ result := self runManaged ] on: GtExampleResult signalableExceptions do: [ :anException | result := (self newResultFor: self example) exampleException: (GtSystemUtility freeze: anException) ]. ^ result
%

category: 'public'
method: GtExampleEvaluator
runUnmanaged
	"The ideal case would be to updade the example runner to use runManaged"
	<return: #GtExampleResult>
	^ self value
%

category: 'private'
method: GtExampleMethodResolver
methodClass
	^ self methodClassName isClass ifTrue: [ self methodClassName ] ifFalse: [ System myUserProfile symbolList objectNamed: self methodClassName asSymbol ]
%

category: 'accessing'
method: Metaclass3
classSide
	^ self isMeta
		ifTrue: [ self ]
		ifFalse: [ self class ]
%

category: 'accessing'
method: Metaclass3
gtExamples
	^ self gtExamplesFactory gtExamplesContained
%

category: 'accessing'
method: Metaclass3
gtExamplesFactory
	^ self gtExamplesFactoryClass new
		sourceClass: self;
		yourself
%

category: 'accessing'
method: Metaclass3
gtExamplesFactoryClass
	^ GtExampleFactory
%

category: 'accessing'
method: Metaclass3
gtExamplesSubjects
	"I return the list of subjects for examples defined on the instance side."
	^ #()
%

category: 'testing'
method: Metaclass3
includesBehavior: aBehavior
	^ self == aBehavior or: [ self allSuperclasses includes: aBehavior ]
%

category: 'accessing'
method: Metaclass3
instanceSide
	^ self isMeta
		ifTrue: [ self thisClass ]
		ifFalse: [ self ]
%

category: 'testing'
method: Metaclass3
isInstanceSide
	^ self isMeta not
%

category: 'accessing'
method: Metaclass3
methods
	^ self selectors collect: [ :each | self compiledMethodAt: each ]
%

category: 'accessing'
method: GtExample
defaultTimeLimit
	^ Duration seconds: 60
%

category: 'PRAGMA-SELECTORS'
method: GtExample
timeLimit: milliSecondsValue
	<gtExamplePragma>
	<description: 'The timeout for the example in milliseconds'>
	^ timeLimit := Duration seconds: milliSecondsValue / 1000
%

category: '*GToolkit-Examples'
method: Pragma
isGTExamplePragma
	^ self keyword = #gtExample or: [ self keyword = #gtExample: ]
%

category: 'resolving'
method: GtExampleDependenciesResolver
resolveDependenciesForExample: anExample
	"GemStone does not provide the Pharo AST protocol used by the standard resolver yet."
	^ OrderedCollection new
%

category: '*GToolkit-Examples-Core'
classmethod: CurrentExecutionEnvironment
runExampleEvaluator: anExampleEvaluator
	^ DefaultExecutionEnvironment instance runExampleEvaluator: anExampleEvaluator
%

category: 'testing'
method: GsNMethod
isGTExampleMethod
	^ (self pragmas anySatisfy: [ :each | each isGTExamplePragma ])
		and: [ self numArgs = 0 ]
%

category: 'accessing'
method: GsNMethod
methodClass
	^ self inClass
%

category: '*GToolkit-Examples'
method: Exception
isGtExampleFailure
	"Answer a boolean indicating whether the receiver is considered to be an example failure, as opposed to an error.
	There are multiple implementers of #assert:description: that return different exceptions, thus the exception class can't be counted on to determine what is a failure."
	<gsCode: nil>

	^ false
%

category: 'private'
method: GtExampleClassResolver
theClass
	^ self theClassName isClass ifTrue: [ self theClassName ] ifFalse: [ System myUserProfile symbolList objectNamed: self theClassName asSymbol ]
%

run
GtGemStoneExtensionMethods apply.
true
