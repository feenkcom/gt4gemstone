	| tool call result |
	tool := GtLlmToolForMethodReferences new.
	call := GtLlmFunctionToolCall new.
	call function: {
		'name' -> tool name.
		'arguments' -> {'selector' -> 'methodReferencesForExistingSelector'} asDictionary
	} asDictionary.
