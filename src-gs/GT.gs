category: 'private'
method: GtLMessageStyler
exampleFor: aMethodDefinition
	"Use the compiled method cache so restyling retains results and a changed method resolves a new example."

	^ aMethodDefinition
		ifNotNil: [ aMethodDefinition compiledMethod
				ifNotNil: [ :aMethod | aMethod gtExample ifNotNil: [ :anExample | anExample asCachedExampleWithResult ] ] ]
%

method: GtLMessageStyler
pageForAnnotation: aPageAnnotation
	| database uid |
	database := LeDatabasesRegistry uniqueInstance defaultLogicalDatabase.
	aPageAnnotation dbUuidString
		ifNotNil: [ :databaseId | database := database databaseWithID: databaseId ifNone: [ nil ] ].
	database ifNil: [ ^ nil ].
	aPageAnnotation pageUidString
		ifNotNil: [ :pageId | 
			uid := [ UUID fromString36: pageId ] on: Error do: [ :error | ^ nil ].
			^ database
				pageWithID: uid
				ifPresent: [ :page | page ]
				ifAbsent: [ nil ] ].
	^ database
		pageNamed: aPageAnnotation pageName
		ifPresent: [ :page | page ]
		ifAbsent: [ nil ]
%

method: GtLMessageStyler
storedRegistryObjectForId: anIdString ifPresent: aPresentBlock ifAbsent: anAbsentBlock
	| string36 |
	anIdString ifNil: [ ^anAbsentBlock value ].
	objectRegistry ifNil: [ ^anAbsentBlock value ].
	string36 := (anIdString includes: $-)
				ifTrue: [(UUID fromString: anIdString) asString36]
				ifFalse: [anIdString].
	^objectRegistry
		storedObjectAt: string36
		ifPresent: aPresentBlock
		ifAbsent: anAbsentBlock
%

method: GtLMessageStyler
styleButton: anAnnotation for: object defaultLabel: aLabelBlock withTool: aBlock
	"Style the buttons for gtClass and gtMethod annotations"

	| attribute anId isValid |
	anId := LeTextSnippetAttributeLabelElementId indexed: self nextUniqueId.
	isValid := anAnnotation nameNode
		ifNil: [ true ]
		ifNotNil: [ :node | node isDefined ].

	attribute := GtButtonAttribute new
			beAppend;
			stencil: [ | button label |
				label := object
						ifNil: [ anAnnotation nameNode
								ifNil: [ '' ]
								ifNotNil: [ :name | (name value ifNil: [ name ]) source ] ]
						ifNotNil: [ :obj | 
							anAnnotation labelNode
								ifNil: [ aLabelBlock value: obj ]
								ifNotNil: [ :node | node labelFor: obj ] ].
				button := LeSnippetStylerVisitor
						textLinkButtonPadding: (BlInsets top: 2)
						margin: BlInsets empty
						valid: isValid.
				button aptitude glamorousCodeFont.
				button
					id: anId;
					beSmallSize;
					label: label;
					action: [ :aButton | aButton phlow spawnTool: (aBlock cull: aButton) ].

				button viewModel
					when: BlClickEvent
					do: [ :anEvent | 
						anEvent modifiers isPrimaryModifier
							ifTrue: [ | aTool aSpace |
								aTool := aBlock cull: button.
								aSpace := BlSpace new.
								aSpace title: self gtDisplayString.
								aSpace icon: aTool icon.
								aSpace extent: 1200 @ 600.
								aSpace root background: Color transparent.
								aSpace inPager: aTool.
								aSpace withSceneDriller.
								aSpace showFrom: button ] ].
				button viewModel
					when: BlMouseEnterEvent
					do: [ :anEvent | 
						anEvent consumed: true.
						anEvent modifiers isPrimaryModifier
							ifTrue: [ anEvent target mouseCursor: BlCopyCursor new ]
							ifFalse: [ anEvent target mouseCursor: nil ].
						anEvent target requestFocus ].
				button ].

	self text
		attribute: attribute
		from: anAnnotation parent startPosition
		to: anAnnotation parent stopPosition
%

method: GtLMessageStyler
styleSymbolButton: aSymbolAnnotation
	"Like LeSymbolAnnotationStyler>>#styleButton:, without its context menu"

	| aSymbol attribute |
	aSymbolAnnotation hasSymbolNameSpecified ifFalse: [ ^ self ].
	aSymbol := aSymbolAnnotation symbolValue.
	aSymbol ifNil: [ ^ self ].

	attribute := GtButtonAttribute new
			beAppend;
			stencil: [ | button |
				button := LeSnippetStylerVisitor
						textLinkButtonPadding: (BlInsets top: 2)
						margin: BlInsets empty
						valid: true.
				button aptitude glamorousCodeFont.
				button
					beSmallSize;
					label: '#' , aSymbolAnnotation symbolName;
					action: [ :aButton | aButton phlow spawnObject: aSymbol gtReferences ].
				button ].

	self text
		attribute: attribute
		from: aSymbolAnnotation parent startPosition
		to: aSymbolAnnotation parent stopPosition
%

category: 'private - tables'
method: GtLMessageStyler
tableElementFor: aTable
	"Use native headers with editors that materialize inline adornments.
	Column justification remains in the AST and is not applied here."

	| list |
	list := BrColumnedList new.
	list hMatchParent.
	list vFitContentLimited.
	aTable header cells
		withIndexDo: [ :cell :index | 
			list column
				title: (self tableCellTextFor: cell);
				weight: 1;
				stencil: [ :row | self tableEditorFor: (row cells at: index ifAbsent: [ nil ]) ] ].
	list items: aTable rows.
	list
		withHeadersDo: [ :header | 
			header
				labelStencil: [ :column | 
					BrEditor new
						id: #tableHeaderEditor;
						aptitude: BrGlamorousRegularEditorAptitude;
						beReadOnlyWithSelection;
						hMatchParent;
						vFitContentLimited;
						padding: (BlInsets top: 5 bottom: 5);
						text: column title;
						yourself ] ].
	^ list
%

category: 'styling'
method: GtLMessageStyler
styleAutoHiding: leftRange and: rightRange whenOutside: nodeInterval
	| anAttribute marker1 marker2 cursorAttribute |
	marker1 := BrTextInvisibleMarkerAttribute new.
	marker2 := BrTextInvisibleMarkerAttribute new.
	self text
		attribute: marker1
		from: leftRange first
		to: leftRange last.
	self text
		attribute: marker2
		from: rightRange first
		to: rightRange last.
	anAttribute := BrTextAdornmentDynamicAttribute new
			beReplace;
			stencil: [ :aTBrTextEditorTextualPiece :anEditorElement | #() ].
	self text
		attribute: anAttribute
		from: leftRange first
		to: leftRange last.
	self text
		attribute: anAttribute
		from: rightRange first
		to: rightRange last.
	cursorAttribute := BrTextCursorDynamicAttribute new
			enterAction: [ :aTextEditor | 
				| left right |
				aTextEditor text
					findAttribute: marker1
					indicesDo: [ :start :end | left := start ].
				aTextEditor text
					findAttribute: marker2
					indicesDo: [ :start :end | right := end ].
				(left notNil and: [ right notNil ])
					ifTrue: [ | cursorIndex |
						cursorIndex := aTextEditor cursors first position.
						(cursorIndex between: left - 2 and: right)
							ifTrue: [ aTextEditor text
									clearAttributes: left
									to: right
									if: [ :eachAttribute | eachAttribute == anAttribute ] ] ] ];
			leaveAction: [ :aTextEditor | 
				| left right |
				aTextEditor text
					findAttribute: marker1
					indicesDo: [ :start :end | left := start to: end ].
				aTextEditor text
					findAttribute: marker2
					indicesDo: [ :start :end | right := start to: end ].
				(left notNil and: [ right notNil ])
					ifTrue: [ aTextEditor text
							attributes: {anAttribute}
							from: left first
							to: left last.
						aTextEditor text
							attributes: {anAttribute}
							from: right first
							to: right last ] ].
	self text
		attribute: cursorAttribute
		from: nodeInterval first - 1
		to: nodeInterval last
%

method: GtLMessageStyler
styleButton: anAnnotation forValuable: aValuable defaultLabel: aLabelBlock withTool: aBlock
	"Style the buttons for gtClass and gtMethod annotations"

	| attribute anId |
	anAnnotation isDefined ifFalse: [ ^ self ].

	anId := LeTextSnippetAttributeLabelElementId indexed: self nextUniqueId.

	attribute := GtButtonAttribute new
			beAppend;
			stencil: [ | button |
				button := LeSnippetStylerVisitor
						textLinkButtonPadding: (BlInsets top: 2)
						margin: BlInsets empty.
				button aptitude glamorousCodeFont.
				button
					id: anId;
					beSmallSize;
					label: '?';
					enabled: false.

				button
					withAsyncFutureDo: [ :anElementFuture | 
						anElementFuture
							whenPending: [ :theButton | 
								button
									label: '?';
									enabled: false ];
							whenError: [ :theButton :anError | 
								| aLabel |
								aLabel := (anError messageText ifEmpty: [ anError printString ])
										asRopedText.
								aLabel foreground: BrGlamorousColors errorBackgroundColor.
								theButton label: aLabel.
								theButton action: [ :aButton | aButton phlow spawnObject: anError ].
								theButton enabled: true ];
							whenSuccess: [ :theButton :anObject | 
								| aLabel |
								aLabel := anObject
										ifNil: [ anAnnotation nameNode
												ifNil: [ '' ]
												ifNotNil: [ :aName | (aName value ifNil: [ aName ]) source ] ]
										ifNotNil: [ :theObject | 
											anAnnotation labelNode
												ifNil: [ aLabelBlock value: theObject ]
												ifNotNil: [ :node | node labelFor: theObject ] ].
								theButton label: aLabel.

								theButton
									action: [ :aButton | aButton phlow spawnTool: (aBlock cull: aButton) ].
								theButton enabled: true ].

						anElementFuture future: aValuable asAsyncFuture flatten ].

				button ].

	self text
		attribute: attribute
		from: anAnnotation parent startPosition
		to: anAnnotation parent stopPosition
%

method: GtLMessageStyler
styleExpandingExample: anExampleAnnotation
	| attribute anExample anId |
	anExampleAnnotation isDefined ifFalse: [ ^ self ].

	anExample := anExampleAnnotation imageObject
			ifNotNil: [ :aMethodDefinition | 
				aMethodDefinition compiledMethod
					ifNotNil: [ :aCompiledMethod | 
						aCompiledMethod gtExample
							ifNotNil: [ :anExample | anExample asCachedExampleWithResult ] ] ].

	anId := LeTextSnippetAttributeExampleElementId indexed: self nextUniqueId.

	attribute := GtExamplePreviewAttribute new
			withCache: self elements
				key: {anExampleAnnotation source.
						anExample example method};
			beAppend;
			elementId: anId;
			example: anExample;
			codeExpanded: anExampleAnnotation codeExpanded;
			noCode: anExampleAnnotation noCode;
			previewExpanded: anExampleAnnotation previewExpanded;
			previewShowSelector: (anExampleAnnotation previewShowSelector
					ifNil: [ LepiterConstants defaultShowSelector ]);
			previewSelectSelector: anExampleAnnotation previewSelectSelector;
			previewHeight: (anExampleAnnotation previewHeight
					ifNil: [ LepiterConstants defaultPreviewHeight ]).

	(self text
		from: anExampleAnnotation parent startPosition
		to: anExampleAnnotation parent stopPosition) attribute: attribute
%

method: GtLMessageStyler
styleExpandingObject: anAnnotation for: anObject withDefault: aSymbol
	| cacheKey attribute |
	anObject ifNil: [ ^ self ].

	cacheKey := anAnnotation source.

	attribute := GtCachedTextExpandButtonAttribute new
			isExpanded: (self expanded at: cacheKey ifAbsentPut: [ anAnnotation expanded ]);
			attributesCreatingBlock: [ GtResizablePreviewAttribute new
					withCache: self elements key: cacheKey;
					result: anObject;
					showSelector: (anAnnotation showSelector ifNil: [ aSymbol ]);
					height: (anAnnotation height ifNil: [ LepiterConstants defaultPreviewHeight ]) ];
			onCachingDo: [ :aBoolean :theAttribute | self expanded at: cacheKey put: aBoolean ].

	self text
		attribute: attribute
		from: anAnnotation parent startPosition
		to: anAnnotation parent stopPosition
%

method: GtLMessageStyler
styleExpandingObject: anAnnotation withDefault: aSymbol
	anAnnotation isDefined ifFalse: [ ^ self ].
	self
		styleExpandingObject: anAnnotation
		for: anAnnotation imageObject
		withDefault: aSymbol
%

category: 'tables'
method: GtLMessageStyler
styleTableCellText: aText ast: aCell
	"Style an already parsed cell, not a new document."
	text := aText.
	self accept: aCell.
	^ aText
%

method: GtLMessageStyler
tableCellTextFor: aCell
	"Reuse the grammar-produced AST without reparsing or altering the source
	tree. A fresh visitor preserves this message visitor's current text."
	| source cellText localCell tokens offset first last visitor |
	aCell ifNil: [ ^ '' asRopedText ].
	source := aCell contentSource.
	source trimBoth isEmpty ifTrue: [ ^ '' asRopedText ].
	cellText := source asRopedText.
	localCell := aCell copy.
	localCell parent: nil.
	localCell fixParentPointers.
	offset := aCell startPosition - 1.
	tokens := IdentitySet withAll: localCell allTokens.
	tokens do: [ :token | token startPosition: token startPosition - offset ].
	localCell withAllNodesDo: [ :node |
		node removeAttributeNamed: #startPosition; removeAttributeNamed: #stopPosition ].
	localCell completeSource: source.
	visitor := self class new objectRegistry: self objectRegistry; yourself.
	visitor styleTableCellText: cellText ast: localCell.
	first := 1.
	last := source size.
	[ (source at: first) isSeparator ] whileTrue: [ first := first + 1 ].
	[ (source at: last) isSeparator ] whileTrue: [ last := last - 1 ].
	^ cellText copyFrom: first to: last
%

method: GtLMessageStyler
tableEditorFor: aCell
	"An editor materializes annotation adornments and wraps long cell content.
	The preview is selectable but editing remains in the original Markdown."
	^ BrEditor new
		id: #tableCellEditor;
		aptitude: BrGlamorousRegularEditorAptitude;
		beReadOnlyWithSelection;
		hMatchParent;
		vFitContentLimited;
		padding: (BlInsets top: 5 bottom: 5);
		text: (self tableCellTextFor: aCell);
		yourself
%

method: GtLMessageStyler
tableLabelFor: aCell
	"Compatibility entry point; table cells now use editors."
	^ self tableEditorFor: aCell
%

category: 'visiting'
method: GtLMessageStyler
accept: anObject
	(anObject isKindOf: SmaCCParseNode) ifTrue: [ ^ self acceptNode: anObject ].
	(anObject isKindOf: Collection)
		ifTrue: [ anObject do: [ :each | self accept: each ] ].
	^ anObject
%

method: GtLMessageStyler
acceptNode: aSmaCCParseNode
	aSmaCCParseNode isNil
		ifTrue: [ ^ nil ].
	^ aSmaCCParseNode acceptVisitor: self
%

method: GtLMessageStyler
acceptNodes: aCollection
	aCollection do: [ :each | self acceptNode: each ].
	^ aCollection
%

method: GtLMessageStyler
visitDocumenterAnnotation: aDocumenterAnnotation
	"Style only the annotations I support (see GtLAnnotationVisitorSupport).
	Annotations of grammars I do not know (for example gtPictureReference)
	and unknown or malformed annotations (error nodes) stay plain text, instead of stopping the styling."

	| anAnnotation |
	anAnnotation := aDocumenterAnnotation annotation.
	(GtLAnnotationVisitorSupport visitor: self supports: anAnnotation)
		ifFalse: [ ^ aDocumenterAnnotation ].

	^ anAnnotation acceptVisitor: self
