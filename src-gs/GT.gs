category: 'private - execution'
method: GtMagritteBasicActionExecutor
executeActionWithCallbacks
	[ | aResult |
	self onExecutionStarted.

	aResult := self block
			cull: self object
			cull: self element
			cull: self memento
			cull: self description.

	self onMainActionFinished: aResult.
	self onExecutionFinished: aResult ]
		on: Error
		do: [ :anException | 
			anException emit.
			self onExecutionError: anException ]
%

