category: 'accessing'
method: GtLMethodsSearchResult
foundMethods
	^ foundMethods ifNil: [ #() ]
%

method: GtLMethodsSearchResult
foundMethods: aCollection
	foundMethods := aCollection
%

method: GtLMethodsSearchResult
foundMethodsDescription
	<magritteDescription>

	^ MAToManyRelationDescription new
		label: 'Found methods';
		accessor: #foundMethods;
		classes: { GtLMethodReference };
		beRequired
%

method: GtLMethodsSearchResult
mayHaveMore
	^ mayHaveMore ifNil: [ false ]
%

method: GtLMethodsSearchResult
mayHaveMore: aBoolean
	mayHaveMore := aBoolean
%

method: GtLMethodsSearchResult
mayHaveMoreDescription
	<magritteDescription>

	^ MABooleanDescription new
		label: 'May have more';
		accessor: #mayHaveMore;
		beRequired
%

category: 'llm views'
method: GtLMethodsSearchResult
llmRawDataViewFor: aDataView
	<gtLlmDataView>
	
	^ aDataView magritteObject: [ self ]
%

category: 'printing'
method: GtLMethodsSearchResult
printOn: aStream
	super printOn: aStream.
	aStream parenthesize: [
		aStream
			nextPutAll: self foundMethods size asString;
			nextPutAll: ' methods'.
		self mayHaveMore ifTrue: [ aStream nextPutAll: ' (more available)' ] ]
%

category: 'views'
method: GtLMethodsSearchResult
gtFoundMethodsFor: aView
	<gtView>
	<gtLlmView>
	^ aView columnedList
		title: 'Found methods';
		priority: 1;
		items: [ self foundMethods ];
		column: 'Class' text: [ :each | each methodClass name ] width: 200;
		column: 'Method' text: [ :each | each methodName ]
%

method: GtLMethodsSearchResult
gtMethodsFor: aView
	<gtView>
	<gtLlmView>
	(self foundMethods anySatisfy: [:each | each isKindOf: GtLMissingDomainObject]) ifTrue: [ ^ aView empty ].
	^ aView forward
		title: 'Methods';
		priority: 1;
		object: [ GtSearchFixedMethodsFilter new methods: (self foundMethods 
			collect: [ :each | each compiledMethod ]) ];
		view: #gtItemsFor:
%

category: 'instance creation'
classmethod: GtLMethodsSearchResult
fromReferences: aCollection
	| matchesArray limited |
	matchesArray := aCollection asArray.
	limited := matchesArray first: (200 min: matchesArray size).
	^ self new
		foundMethods: (limited collect: [ :each | GtLMethodReference fromCompiledMethod: each ]);
		mayHaveMore: matchesArray size > 200;
		yourself
%

