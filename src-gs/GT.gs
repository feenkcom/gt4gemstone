	self
		profile: []
		executing:  [ :blockClosure |			
			blockClosure value.
			(aSpace root
				asSpartaForm: nil
				scaleFactor: 0.5
				hdpiScaleFactor: 1) -> aSpace extent ]
		as: #spaceSnapshot
