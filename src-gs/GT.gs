method: GtLToolCallsSummarizerExamplesBase
performTool: aTool withArguments: aDictionary inContext: anExecutionContext
	| toolCall |
	toolCall := GtLFunctionToolCall new
			name: aTool name;
			rawArguments: aDictionary;
			yourself.
	aTool performToolCall: toolCall inContext: anExecutionContext.
	^ toolCall
