	super initialize.

	self fitContent.

	self
		addChild: (BrHorizontalPane new vFitContent hMatchParent
				addChild: self makeApiKeyDropdown;
				addChild: self makeFileError).
	self
		addChild: (BrHorizontalPane new vFitContent hMatchParent
				margin: (BlInsets top: 5);
				addChild: self makeTestingButton;
				addChild: self makeTestingLabel)
