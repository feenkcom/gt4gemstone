category: 'initialization'
method: GtLOpenAICompactionMessage
initializeFromResult: aResult
	self 
		requestResponse: aResult requestResponse.
		
	aResult output 
			detect: [ :anOutput | 
				((anOutput at: 'type') = 'compaction') ]
			ifFound: [ :data | 
				self rawData: data.
				rawContent := GtLOpenAIRawCompactionData from: data  ]  
			ifNone: [
				aResult output 
					detect: [ :anOutput | 
						((anOutput at: 'type') = 'message') ]
					ifFound: [ :data | 
							self rawData: data.
							rawContent := GtLOpenAIRawMessageData from: data] ]
%

category: 'reading'
method: GtLOpenAICompactionMessage
computeResponseModelsByFormat
	^formatDescriptions schemaDescriptions 
		detect: [ :each |
			each name = 'Compaction' ]
		ifFound: [ :aFormat |
			{aFormat modelClass
				fromOpenAICompactionMessage: self} ] 
		ifNone: [ {} ].
