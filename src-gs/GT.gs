category: 'private'
method: GtExamplesTestingHudsonReport
beginTestCase: aTestCase runBlock: aBlock
	| time |
	executedCount := executedCount + 1.
	
	progressStream 
		nextPutAll: 'Starting: ';
		nextPutAll: (self loggingNameFor: aTestCase);
		nextPutAll: ' at ';
		nextPutAll: DateAndTime now asString;
		nextPutAll: ' ... '; 
