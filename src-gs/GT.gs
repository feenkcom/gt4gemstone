method: NullTelemetry
beacon: aBeaconSignal as: aSymbol on: aBlock
	^ self
		profile: aBlock
		executing:  [ :blockClosure |
			| aLogger |
			
			aLogger := MemoryLogger new.
			aLogger startFor: aBeaconSignal.
			
			blockClosure value.
			
			aLogger stop.
			aLogger recordings ]
		as: aSymbol
