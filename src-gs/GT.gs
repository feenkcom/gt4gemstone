category: 'adding'
method: GtLACPSessionRegistry
registerSession: aSession
	| isAdded |
	aSession requireRootSession.
	isAdded := sessions
			lock: [ :theSessions | 
				(theSessions identityIncludes: aSession)
					ifTrue: [ false ]
					ifFalse: [ theSessions add: aSession.
						self subscribeToConnectionOf: aSession.
						true ] ].
	isAdded
		ifTrue: [ self
				announce: (GtLACPSessionRegistered new
						registry: self;
						session: aSession) ].
	^ aSession
%

