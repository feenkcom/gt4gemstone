	aStream
		print: usedTokens;
		nextPutAll: ' / ';
		print: totalTokens;
		nextPutAll: ' tokens'.
	totalTokens = 0 ifTrue: [ ^ self ].
	aStream
		nextPutAll: ' (';
		nextPutAll: self usagePercentageString;
		nextPutAll: ' used)'
%

method: GtLACPContextWindow
