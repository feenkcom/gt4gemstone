method: GtLExampleWithResultExamples
assertSuccessResult: resultJson objectId: objectId objectDetails: expectedObjectDetails hasPlaygroundPageReference: aBoolean
	| expectedKeys |
	expectedKeys := #('objectDetails' #objectId #objectValue).
	aBoolean ifTrue: [ expectedKeys := expectedKeys copyWith: #playgroundPageReference ].
