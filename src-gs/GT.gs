category: 'examples'
method: GtLFileInformationDomainObjectExamples
fileInformationDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| domainObject compositeView dataBlock jsonData expectedJson |
	domainObject := self fileInformationForExistingFile.
	
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock compositeJsonData.
	expectedJson := {
		#path -> domainObject path.
		#size -> domainObject size.
		#creationTime -> domainObject creationTime asIso8601.
		#modificationTime -> domainObject modificationTime asIso8601.
		#accessTime -> domainObject accessTime asIso8601.
		#type -> domainObject type.
		#permissions -> domainObject permissions
	} asDictionary.
	self assert: jsonData equals: expectedJson.
	
	^ dataBlock
%

method: GtLFileInformationDomainObjectExamples
fileInformationForExistingFile
	<gtExample>
	| fileReference domainObject |
	fileReference := FileReference newTempFilePrefix: 'GtLFileInformation' suffix: '.txt'.
	[ fileReference writeStreamDo: [ :stream | stream nextPutAll: 'Example' ].
		domainObject := GtLFileInformation new
			initializeFromFileReference: fileReference;
			yourself.
		self assert: domainObject path equals: fileReference pathString.
		self assert: domainObject size equals: fileReference size.
		self assert: domainObject creationTime equals: fileReference creationTime.
		self assert: domainObject modificationTime equals: fileReference modificationTime.
		self assert: domainObject accessTime equals: fileReference accessTime.
		self assert: domainObject type equals: 'file'.
		self assert: domainObject permissions equals: fileReference permissions printString.
		^ domainObject ]
		ensure: [ fileReference exists ifTrue: [ fileReference delete ] ]
%

method: GtLFileInformationDomainObjectExamples
fileInformationSerialization
	<gtExample>
	| domainObject jsonObject expected |
	domainObject := self fileInformationForExistingFile.
	jsonObject := GtMagritteJSONDataExporter exportObject: domainObject.
	expected := NeoJSONObject new
		at: 'path' put: domainObject path;
		at: 'size' put: domainObject size;
		at: 'creationTime' put: domainObject creationTime asIso8601;
		at: 'modificationTime' put: domainObject modificationTime asIso8601;
		at: 'accessTime' put: domainObject accessTime asIso8601;
		at: 'type' put: domainObject type;
		at: 'permissions' put: domainObject permissions;
		yourself.
	self assert: jsonObject equals: expected.
	^ jsonObject
%

category: 'accessing'
method: GtLSmalltalkCodeEvaluationResultGemStoneStencil
stencilData

	^ Dictionary new
		at: #code put: code;
		at: #object put: objectProxy;
		at: #bindings put: bindings;
		yourself
%

method: GtLSmalltalkCodeEvaluationResultGemStoneStencil
stencilData: aDictionary

	code := aDictionary at: #code.
	objectProxy := (aDictionary at: #object) asGtBareProxyObject.
	bindings := Dictionary new.
	(aDictionary at: #bindings ifAbsent: [ nil ]) ifNotNil: [ :b |
		b keysAndValuesDo: [ :k :v |
			bindings at: k put: v asGtBareProxyObject ] ]
%

category: 'api - instantiation'
method: GtLSmalltalkCodeEvaluationResultGemStoneStencil
create
	| container coderModel coderViewModel sessionLocator pharoBindings |

	container := BrVerticalPane new.
	container matchParent
		addAptitude: (BrLayoutResizerAptitude new common: [ container children ]);
		background: BrGlamorousColors backdropColor.

	coderModel := GtGemStoneSnippetCoderModel new
		sourceCode: (GtCoderExplicitStringSource new source: code).
	coderViewModel := coderModel asCoderViewModel.

	pharoBindings := GtSharedVariablesBindings new.
	bindings ifNotNil: [
		bindings keysAndValuesDo: [ :name :proxyValue |
			(pharoBindings bindingOf: name) value: proxyValue ] ].
	coderViewModel pharoBindings: pharoBindings.

	sessionLocator := nil.
	(objectProxy notNil and: [ objectProxy isGtBareProxyObject ])
		ifTrue: [
			objectProxy proxyObject gtSession ifNotNil: [ :aSession |
				sessionLocator := GtGemStoneSessionLocator new
					registry: aSession registry;
					identifier: (GtGemStoneExplicitSessionIdentifier sessionName: aSession name) ] ].
	sessionLocator ifNil: [
		GtGemStoneSessionRegistry default sessions
			detect: [ :s | s isRunning ]
			ifFound: [ :aSession |
				sessionLocator := GtGemStoneSessionLocator new
					registry: aSession registry;
					identifier: (GtGemStoneExplicitSessionIdentifier sessionName: aSession name) ] ].
	sessionLocator ifNotNil: [
		coderViewModel sessionLocator: sessionLocator ].

	container
		addChild: (coderViewModel asExpandedOnlyElement
			margin: (BlInsets all: 10);
			background: Color white;
			addAptitude: BrShadowAptitude;
			vFitContentLimited);
		addChild: (objectProxy gtDefaultInspectorTool asElement
			margin: (BlInsets all: 10);
			background: Color white;
			addAptitude: BrShadowAptitude;
			vFitContentLimited;
			hMatchParent).

	^ container
%

