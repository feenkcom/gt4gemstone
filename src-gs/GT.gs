method: GtLToolCallsByTypeSummarizerExamples
messagesGroupWithByTypeToolCalls
	<gtExample>
	| group summarizer |
	group := GtLMessagesGroup new.
	group add: (self toolMessageFrom: ((self
		toolCallNamed: 'lookupClass'
		arguments: (Dictionary new at: 'className' put: 'Object'; yourself)
		executionDetails: (self
			fixedExecutionDetailsFrom: '2024-01-01T10:00:00+00:00' asDateAndTime
			to: '2024-01-01T10:00:05+00:00' asDateAndTime))
		performedByTool: GtLMagritteToolForClassLookup new;
		result: (GtLWrappedObjectModel new
			name: 'result';
			model: (GtLClassDescription fromClass: Object);
			yourself);
		yourself)).
	group add: (self toolMessageFrom: ((self
		toolCallNamed: 'lookupClass'
		arguments: (Dictionary new at: 'className' put: 'Collection'; yourself)
		executionDetails: (self
			fixedExecutionDetailsFrom: '2024-01-01T10:01:00+00:00' asDateAndTime
			to: '2024-01-01T10:01:07+00:00' asDateAndTime))
		performedByTool: GtLMagritteToolForClassLookup new;
		result: (GtLWrappedObjectModel new
			name: 'result';
			model: (GtLClassDescription fromClass: Collection);
			yourself);
		yourself)).
	group add: (self toolMessageFrom: ((self
		toolCallNamed: 'lookupClass'
		arguments: (Dictionary new at: 'className' put: 'String'; yourself)
		executionDetails: (self
			fixedExecutionDetailsFrom: '2024-01-01T10:02:00+00:00' asDateAndTime
			to: '2024-01-01T10:02:11+00:00' asDateAndTime))
		performedByTool: GtLMagritteToolForClassLookup new;
		result: (GtLWrappedObjectModel new
			name: 'result';
			model: (GtLClassDescription fromClass: String);
			yourself);
		yourself)).
	group add: (self toolMessageFrom: ((self
		toolCallNamed: 'searchForClasses'
		arguments: (Dictionary new at: 'query' put: 'Tool'; yourself)
		executionDetails: (self
			fixedExecutionDetailsFrom: '2024-01-01T10:03:00+00:00' asDateAndTime
			to: '2024-01-01T10:03:02+00:00' asDateAndTime))
		performedByTool: GtLMagritteToolForClassSearch new;
		result: (GtLWrappedObjectModel new
			name: 'result';
			model: (GtLClassesSearchResult fromClasses: { GtLToolCallsByTypeSummarizer. GtLToolCallsSummarizer });
			yourself);
		yourself)).
	summarizer := group toolCallsSummarizers detect: [ :each | each class = GtLToolCallsByTypeSummarizer ].
	self assert: summarizer relevantToolCalls size equals: 4.
	^ group
%

category: 'examples'
method: GtLCodeChangesToolCallsSummarizerModelExamples
messagesGroupWithCodeChangesSummary
	<gtExample>
	| group classResult methodResult classToolCall methodToolCall |
	group := GtLMessagesGroup new.

	classResult := GtLClassCommentChangeResult new
		originalClass: ((GtLClassDefinitionDescription fromClass: Object)
			comment: '');
		updatedClass: ((GtLClassDefinitionDescription fromClass: Object)
			comment: 'Updated comment');
		status: 'changed';
		
		yourself.
	classToolCall := GtLFunctionToolCall new
		name: 'changeClassOrTraitComment';
		performedByTool: GtLMagritteToolForClassCommentChange new;
		arguments: (Dictionary new
			at: 'className' put: 'Object';
			at: 'classComment' put: 'Updated comment';
			yourself);
		result: (GtLWrappedObjectModel new name: 'result'; model: classResult; yourself);
		yourself.
	group add: (GtLToolMessage new
		toolCall: classToolCall;
		output: classToolCall result;
		yourself).

	methodResult := GtLMethodCompilationResult new
		status: 'compiled';
		yourself.
	methodToolCall := GtLFunctionToolCall new
		name: 'compileMethod';
		performedByTool: GtLMagritteToolForMethodCompilation new;
		arguments: (Dictionary new at: 'methodRequest' put: Dictionary new; yourself);
		result: (GtLWrappedObjectModel new name: 'result'; model: methodResult; yourself);
		yourself.
	group add: (GtLToolMessage new
		toolCall: methodToolCall;
		output: methodToolCall result;
		yourself).

	self assert: ((group toolCallsSummarizers detect: [ :each | each class = GtLCodeChangesToolCallsSummarizer ]) codeChanges size) equals: 2.
	^ group
%

category: 'examples'
method: GtLToolCallsSummarizerExamples
exampleStatusSuccess
	<gtExample>
	^ 42
