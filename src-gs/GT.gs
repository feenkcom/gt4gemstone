category: 'accessing'
method: GtLACPWorkGraph
allSessions
	| result pending |
	result := OrderedCollection new.
	pending := OrderedCollection with: session.
	[ pending notEmpty ]
		whileTrue: [ | current |
			current := pending removeFirst.
			result add: current.
			pending addAll: current childSessions copy ].
	^ result
%

