method: GtLOllamaMigrationExamples
qwen35CompletionsObjectInspection
	"Ask qwen3.5 to inspect the supplied object and describe it."
	<gtExample>
	| chat executor provider chatObject storedObjectId inputModels |
	
	executor := GtLOllamaCompletionsExampleExecutor new.
	provider := executor provider.
	provider modelName: 'qwen3.5:9b'.
	executor loadExpectedHistoryFrom: self qwen35CompletionsObjectInspectionHistory.
	chat := executor chat.
	chatObject := { 'info' -> 'Today is overcast in the Czech Republic' } asDictionary.
	storedObjectId := chat addNewObject: chatObject reasonString: 'Info object'.
	chat 
		reasoningEffort: #none;
		tools: (GtLTools withAll: GtLTools gtObjectsExecution).
	chat sendWith: [ :message |
			message
				addPlainInputObject: chatObject
					withId: storedObjectId
					named: 'Info object';
				string: 'Describe the stored object named ''Info object''.'. ].
	executor waitTimeoutSeconds: 60.
	executor assertHistoryResponsesOK: provider client history.
	inputModels := chat messages first inputModels.
	self assert: inputModels size equals: 2.
	self assert: inputModels first targetObject object equals: chatObject.
	
	executor assertResponseCompletionsStringContent: chat messages last finalMessage.
	self compareIfKnownShapes: chat messages
		with: executor expectedHistory
		in: chat
		selector: #qwen35CompletionsObjectInspectionHistory.

	^ chat
%

method: GtLOllamaMigrationExamples
qwen35Instructions
	"Answer the model and chat for a simple question put to Gemma4:31b."
	<gtExample>
	| chat executor provider instructions explanations |
	
	executor := GtLOllamaCompletionsExampleExecutor new.
	provider := executor provider.
	provider
		completions;
		modelName: 'qwen3.5:9b'.
	executor loadExpectedHistoryFrom: self qwen35InstructionsHistory.
	chat := executor chat.
	chat gtPageExplanation: 'Examples by example'.
	chat 
		reasoningEffort: #none;
		sendString: 'What is an example method?'.
	executor waitTimeoutSeconds: 60.
	executor assertHistoryResponsesOK: provider client history.
	instructions := chat messages first instructions.
	self assert: instructions size equals: 1.
	explanations := instructions sectionNamed: 'Explanations' ifAbsent: [ nil ].
	self assert: explanations isNotNil.
	
	executor assertResponseCompletionsStringContent: chat messages last finalMessage.
	self compareIfKnownShapes: chat messages
		with: executor expectedHistory
		in: chat
		selector: #qwen35InstructionsHistory.
	
	^ chat
%

method: GtLOllamaMigrationExamples
qwen35ResponsesObjectInspection
	"Ask qwen3.5 to inspect the supplied object and describe it."
	<gtExample>
	| chat executor provider chatObject storedObjectId objectStorage |
	
	executor := GtLOllamaResponsesExampleExecutor new.
	provider := executor provider.
	provider modelName: 'qwen3.5:9b'.
	executor loadExpectedHistoryFrom: self qwen35ResponsesObjectInspectionHistory.
	chat := executor chat.
	chatObject := { 'info' -> 'Today is overcast in the Czech Republic' } asDictionary.
