chat
	| chat |
	chat := GtLChat new.
	provider ifNotNil: [ chat provider: provider ].
	chat
		addResponseFormatForMagritte: GtLPharoScript named: 'PharoScript';
		pageExplanation: 'Querying with GT search filters by example'.
