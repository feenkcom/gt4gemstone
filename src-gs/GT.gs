category: 'llm-generated'
method: GtLlmToolForSearchFilterExamples
searchFilterForExampleMethods
	<gtExample>
	| tool call result |
	tool := GtLlmToolForSearchFilter new.
	call := GtLlmFunctionToolCall new.
	call function: {
		'name' -> tool name.
		'arguments' -> {'query' -> 'GtLlmToolForSearchFilterExamples gtMethodsInClass & #gtExample gtPragmas'} asDictionary
	} asDictionary.
	result := tool performToolCall: call.
	self assert: call tool == tool.
	self assert: (result includesSubstring: 'GtLlmToolForSearchFilterExamples>>#searchFilterForExampleMethods').
	^ tool
%

method: GtLlmToolForSearchFilterExamples
searchFilterWithError
	<gtExample>
	| tool call result |
	tool := GtLlmToolForSearchFilter new.
	call := GtLlmFunctionToolCall new.
	call function: {
		'name' -> tool name.
		'arguments' -> {'query' -> 'self error: ''boom'''} asDictionary
	} asDictionary.
	result := tool performToolCall: call.
	self assert: call tool == tool.
	self assert: (result beginsWith: 'There was an error when evaluating the query: ').
	self assert: (result includesSubstring: 'boom').
	^ tool
%

category: '*Gt4Llm-VectorDb'
method: GtLModelUserMessage
addContextFromRag: aGtRag
	| ragContext ragPages |

	ragContext := aGtRag asRagQueryContext
		queryString: self contentText.
	ragPages := aGtRag asRag query: ragContext.
	ragPages do: [ :ragPage |
		self pageObjectExplanation: ragPage page ].
%

category: 'accessing'
method: GtLModelUserMessage
chat: aChat
	super chat: aChat.
	self updateDataFromChat: aChat.
	contentDataBlock := self computeContentBlockFromInputModels.
	contentOneLineSummary := self computeContentOneLineSummaryFromInputModels
%

method: GtLModelUserMessage
computeContentOneLineSummaryFromInputModels
	^ String
		streamContents: [ :aStream | 
			inputModels
				do: [ :each | each addContentOneLineSummaryTo: (ZnIgnoreNewLineWriterStream on: aStream) ]
				separatedBy: [ aStream space ] ]
%

method: GtLModelUserMessage
contentDataBlock
	^ contentDataBlock ifNil: [ self computeContentBlockFromInputModels ]
%

method: GtLModelUserMessage
contentText
	| visitorResult dataViews result |

	dataViews := self computeContentDataViewFromInputModels.
	visitorResult := GtLUserMessageDataViewVisitor new visitNodes: { dataViews }.
	result := visitorResult select: [ :assoc |
		assoc key = 'content' ].
	^ result first value.
%

