lowPrecision
	^ self new
		precision: 2;
		lower: 1e-2;
		upper: 1e5;
		yourself
%

classmethod: NeoJSONFloatPrinter
scientificOnly
	^ self new
		lower: 0;
		upper: 0;
		yourself
%

