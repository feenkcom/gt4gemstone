classmethod: OrderedDictionary
newFromPairs: aSequenceableCollection
	| newDictionary |

	newDictionary := self new: (aSequenceableCollection size / 2) floor.
	1 to: aSequenceableCollection size - 1 by: 2 do: [:i |
		newDictionary
			at: (aSequenceableCollection at: i)
			put: (aSequenceableCollection at: i + 1)].
	^ newDictionary
%

category: 'accessing'
method: ZnMultiValueDictionary
at: key add: value
	"Store value under key. If key already exists, store multiple values as Array"

	| existingValue newValue |

	existingValue := self at: key ifAbsent: [ nil ].
	newValue := existingValue
		ifNil: [ value ]
		ifNotNil: [ existingValue isArray
				ifTrue: [ ( existingValue includes: value )
						ifTrue: [ ^ value ].
					existingValue copyWith: value
					]
				ifFalse: [ existingValue = value
						ifTrue: [ ^ value ].
					Array with: existingValue with: value
					]
			].
	^ self at: key put: newValue
%

method: ZnMultiValueDictionary
at: key put: anObject
