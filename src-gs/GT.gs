method: GtLMcpClient
initialize
	super initialize.
	
	messageId := 0.
	serverCapabilities := {} asDictionary
%

method: GtLMcpClient
initializeSession
	| response |
	response := self
			sendMethod: 'initialize'
			withParams: {'protocolVersion' -> '2024-11-05'.
					'capabilities'
						-> {'roots' -> {} asDictionary.
								'sampling' -> {} asDictionary.
								'elicitation' -> {} asDictionary} asDictionary.
					'clientInfo'
						-> {'name' -> 'Glamorous Toolkit'.
								'title' -> 'Glamorous Toolkit LLM Integration'.
								'version' -> '1.0.0'} asDictionary} asDictionary.

	serverCapabilities := response at: 'result' at: 'capabilities'.

	transport
		sendMessage: {'jsonrpc' -> '2.0'. 'method' -> 'notifications/initialized'} asDictionary
%

method: GtLMcpClient
listPrompts
	^ (self sendMethod: 'prompts/list' withParams: {} asDictionary)
		at: 'result'
		at: 'prompts'
%

method: GtLMcpClient
listResources
	^ (self sendMethod: 'resources/list' withParams: {} asDictionary)
		at: 'result'
		at: 'resources'
%

method: GtLMcpClient
listTools
	^ (self sendMethod: 'tools/list' withParams: {} asDictionary)
		at: 'result'
		at: 'tools'
%

method: GtLMcpClient
messagesFromPrompt: aPromptName withArguments: anArgsDictionary
	^ (self getPrompt: aPromptName withArguments: anArgsDictionary) at: 'messages'
%

method: GtLMcpClient
nextMessageId
	messageId := messageId + 1.
	^ messageId
%

method: GtLMcpClient
readResource: aString
	^ (self
		sendMethod: 'resources/read'
		withParams: {'uri' -> aString} asDictionary) at: 'result' at: 'contents'
%

method: GtLMcpClient
sendMethod: aString withParams: anObject
	| content |
	content := {'jsonrpc' -> '2.0'.
					'id' -> self nextMessageId.
					'method' -> aString.
					'params' -> anObject} asDictionary.
	transport sendMessage: content.
	^ transport receiveResponse
%

category: 'examples'
method: GtLRefactoringToolForClassSubclassesExamples
classSubclassesForClassWithNoSubclasses
	<gtExample>
	| tool call targetObject |
	tool := self toolWithExampleHierarchy.
	call := self
		executeTool: tool
		withArguments: {'targetClassName' -> 'GtLRefactoringToolForClassSubclassesExampleChild'} asDictionary.
	targetObject := call result targetObject.
	self assert: targetObject isErrorDomainObject not.
	self assert: targetObject targetClass name equals: 'GtLRefactoringToolForClassSubclassesExampleChild'.
	self assert: targetObject subclasses equals: #().
	^ call
%

method: GtLRefactoringToolForClassSubclassesExamples
classSubclassesForExistingClass
	<gtExample>
	| tool call targetObject |
	tool := self toolWithExampleHierarchy.
	call := self
		executeTool: tool
		withArguments: {'targetClassName' -> 'GtLRefactoringToolForClassSubclassesExampleBase'} asDictionary.
	targetObject := call result targetObject.
	self assert: targetObject isErrorDomainObject not.
	self
		assert: targetObject targetClass name
		equals: 'GtLRefactoringToolForClassSubclassesExampleBase'.
	self
		assert: (targetObject subclasses collect: #name as: Array)
		equals: #('GtLRefactoringToolForClassSubclassesExampleChild').
	^ call
%

method: GtLRefactoringToolForClassSubclassesExamples
classSubclassesForUnknownClass
	<gtExample>
	| tool call |
	tool := self toolWithExampleHierarchy.
	call := self
		executeTool: tool
		withArguments: {'targetClassName' -> 'NonExistingClassName'} asDictionary.
	self assert: call result targetObject isErrorDomainObject.
	^ call
%

category: 'llm-generated'
method: GtLRefactoringToolForClassSubclassesExamples
toolWithExampleHierarchy
	| namespace tool |
	namespace := GtRBNamespace new.
	namespace defineClass: 'Object subclass: #GtLRefactoringToolForClassSubclassesExampleBase
		instanceVariableNames: ''''
		classVariableNames: ''''
		package: ''Demo''' .
	namespace defineClass: 'GtLRefactoringToolForClassSubclassesExampleBase subclass: #GtLRefactoringToolForClassSubclassesExampleChild
		instanceVariableNames: ''''
		classVariableNames: ''''
		package: ''Demo''' .
	tool := GtLRefactoringToolForClassSubclasses new.
	tool model: namespace.
	^ tool
%

category: 'accessing'
method: GtLMagritteToolForMethodCompilation
description
	^ 'Compiles the provided method source code in the specified class or metaclass and reports the result.

Arguments:
- methodRequest: object with methodClassName, sourceCode, classSide and an optional protocol

The protocol is optional. Omit it when modifying an existing method: the method keeps its current protocol. Do not guess a protocol for an existing method; changing the protocol of an extension method (a protocol starting with ''*'') moves it to a different package. Provide a protocol only for a new method, or to deliberately change the protocol of an existing method.

Example JSON arguments (modifying an existing method):
{
  "methodRequest": {
    "methodClassName": "MyClass",
    "sourceCode": "myMethod ^ 42",
    "classSide": false
  }
}

Example JSON arguments (new method):
{
  "methodRequest": {
    "methodClassName": "MyClass",
    "sourceCode": "myNewMethod ^ 42",
    "protocol": "accessing",
    "classSide": false
  }
}

Example JSON response:
{
  "status": "compiled"
}'
%

method: GtLMagritteToolForMethodCompilation
name
	^ 'compileMethod'
%

category: 'magritte'
method: GtLMagritteToolForMethodCompilation
methodRequestDescription
