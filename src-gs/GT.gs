category: 'accessing'
method: MemoryTelemetry
beacon: aBeaconSignal as: aSymbol on: aBlock
	^ self
		profile: aBlock
		executing:  [ :blockClosure |
			| aLogger |
			
			aLogger := MemoryLogger new.
			aLogger startFor: aBeaconSignal.
			
			blockClosure value.
			
			aLogger stop.
			aLogger recordings ]
		as: aSymbol
%

method: MemoryTelemetry
beacon: aBeaconSignal on: aBlock
	^ self
		beacon: aBeaconSignal
		as: #beacon
		 on: aBlock
%

method: MemoryTelemetry
messageTallyOn: aBlock
	^ self
		profile: aBlock
		executing:  [ :blockClosure |
			| aTally |
			aTally := MessageTally new
				reportOtherProcesses: false;
				maxClassNameSize: 1000;
				maxClassPlusSelectorSize: 1000;
				maxTabs: 100;
				yourself.
			aTally
				spyEvery: 1
				on: blockClosure.
			aTally ]
		as: #tally
%

method: MemoryTelemetry
profile: aBlock executing: aCollectingBlock as: aSymbolKey
	"Record an extra telemetry data associating it with a given key"
	| aValue aData |
	
	aData := aCollectingBlock value: [ aValue := aBlock value ].
	data at: aSymbolKey put: aData.
	^ aValue
%

method: MemoryTelemetry
snapshotSpace: aSpace
	self
		profile: []
		executing:  [ :blockClosure |			
			blockClosure value.
			(aSpace root
				asSpartaForm: nil
				scaleFactor: 0.5
				hdpiScaleFactor: 1) -> aSpace extent ]
		as: #spaceSnapshot
%

method: MemoryTelemetry
snapshotSpace: aSpace after: aBlock
	^ self
		profile: aBlock
		executing:  [ :blockClosure |			
			blockClosure value.
			aSpace
				asSpartaForm: nil
				scaleFactor: nil
				hdpiScaleFactor: aSpace scaleFactor ]
		as: #spaceSnapshot
%

category: 'api - telemetry'
method: MemoryTelemetry
emit
	self emitAs: self
%

method: MemoryTelemetry
emitAs: aSourceTelemetry
	recordings ifNotEmpty: [ :theTasks |
		| aPing |
		aPing := recordings asTelemetryPing.
		aPing := data at: #tally
			ifPresent: [ :aTally | aPing copyWithTally: aTally ]
			ifAbsent: [ aPing ].

		(TelemetrySignal new
			task: aPing;
			data: data copy;
			telemetry: aSourceTelemetry) emit ].
	self reset
%

method: MemoryTelemetry
reset
	[ pingsStack isNotEmpty ]
		whileTrue: [ self finishSync ].

	recordings removeAll.
	pingsStack removeAll.
	data removeAll.
	tally := nil
%

method: MemoryTelemetry
time: aNameBlock during: aBlock	
	self startSync: aNameBlock.
	^ aBlock ensure: [ self finishSync ]
%

method: MemoryTelemetry
timeSync: aNameBlock during: aBlock
	^ self time: aNameBlock during: aBlock
%

category: 'initialization'
method: MemoryTelemetry
initialize
	super initialize.
	
	recordings := TelemetryRecordings new.
	pingsStack := Stack new.
	data := Dictionary new
%

category: 'private - lifecycle'
method: MemoryTelemetry
finishSync
	| anEndTime |

	anEndTime := Time microsecondClockValue.

	pingsStack
		ifEmpty: [ ^ self ].
	
	pingsStack pop
		realEndTime: Time microsecondClockValue;
		endTime: anEndTime;
		recordOverheadEndTime
%

category: 'accessing'
method: GtLToolForApplyRefactoring
description
	^ 'Applies a refactoring previewed with previewRefactoring or previewRewrite. Takes the objectId returned by the preview and executes the previewed changes on the live system. A preview can be applied only once.

The result has the status (applied or failed), the refactoringName and refactoringDescription of the preview, the number of previewed changes, the codeChanges that were made in the image (each as a kind followed by a target) and an errorMessage, which is null unless applying failed. When applying fails partway, codeChanges lists the changes that were made before the error.

Example JSON arguments:
{"objectId": "abc123"}

Example JSON response:
{"status": "applied", "refactoringName": "Push up method", "refactoringDescription": "Push up method foo from MySubclass to MySuperclass", "changesCount": 2, "codeChanges": ["added method MySuperclass>>#foo", "removed method MySubclass>>#foo"], "errorMessage": null}'
%

method: GtLToolForApplyRefactoring
name
	^'applyRefactoring'
%

category: 'descriptions'
method: GtLToolForApplyRefactoring
objectIdDescription
	<magritteDescription>
	^(MAStringDescription new)
		label: 'Object id';
		accessor: #objectId;
		beRequired
%

category: 'execution'
method: GtLToolForApplyRefactoring
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| objectId preview |
	objectId := aToolCall arguments at: 'objectId'.
	objectId trimBoth isEmpty
		ifTrue: 
			[^(GtLMissingArgumentDomainObject new)
				arguments: aToolCall arguments;
				missingArgument: 'objectId'].
	anExecutionContext objectStorage
		ifNil: 
			[^GtLMissingInformationDomainObject new missingModelName: 'objectStorage'].
	preview := anExecutionContext objectStorage
				objectAt: objectId
				ifPresent: [:each | each]
				ifAbsent: [^GtLMissingDomainObject new objectName: objectId].
	(preview isKindOf: GtLRefactoringPreview)
		ifFalse: 
			[^GtLProblemDomainObject new
				errorMessage: objectId , ' is not a refactoring preview'].
	preview isApplied
		ifTrue: 
			[^GtLProblemDomainObject new
				errorMessage: objectId , ' was already applied'].
	^self applyPreview: preview
%

category: 'private'
method: GtLToolForApplyRefactoring
applyPreview: aPreview
	"Errors raised while executing the changes are reported by the applied refactoring itself;
	this handler only covers errors raised while collecting or snapshotting the affected code"

	^ [ aPreview apply ]
		on: Error
		do: [ :anError | GtLExceptionDomainObject freeze: anError ]
%

