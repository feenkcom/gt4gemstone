category: 'accessing'
method: GtLMagritteToolForPackageClasses
description
	^ 'Retrieve all classes defined or extended in the given package.

Arguments:
- packageName: string

Return values:
- foundClassNames: array of class names as strings
- mayHaveMore: boolean indicating if there are more matches than returned

Example JSON arguments:
{
  "packageName": "Bloc"
}

Example JSON response:
{
  "foundClassNames": ["BlElement", "BlSpace"],
  "mayHaveMore": true
}'
%

method: GtLMagritteToolForPackageClasses
name
	^ 'packageClasses'
%

method: GtLMagritteToolForPackageClasses
packageNameDescription
	<magritteDescription>

	^ MAStringDescription new
		label: 'Package name';
		accessor: #packageName;
		beRequired
%

category: 'private'
method: GtLMagritteToolForPackageClasses
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments packageName |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	packageName := arguments at: 'packageName'.

	(packageName trimBoth isEmpty)
		ifTrue: [ ^ GtLMissingArgumentDomainObject new
				arguments: arguments;
				missingArgument: 'packageName' ].

	^ self
		gtDo: [
			| organizer package |
			organizer := PackageOrganizer packageOrganizer.
			package := organizer
				packageNamed: packageName asSymbol
				ifAbsent: [ ^ GtLMissingDomainObject new objectName: packageName ].
			GtLClassesSearchResult fromClasses: package classes ]
		gemstoneDo: [
			| classNames |
			classNames := ClassOrganizer gtDefault
				classNamesInClassCategoryNamed: packageName
				dictionaryName: nil.
			classNames isEmpty
				ifTrue: [ ^ GtLMissingDomainObject new objectName: packageName ].
			GtLClassesSearchResult new
				foundClassNames: (classNames first: (200 min: classNames size));
				mayHaveMore: classNames size > 200;
				yourself ]
%

category: 'as yet unclassified'
method: GtLPushUpMethodSpecificationExamples
pushUpWithExistingSubclassAndSuperclass
	<gtExample>
	| specification namespace |
	specification := GtLPushUpMethodSpecification new
			methodNameToPushUp: #initialize;
			methodClassName: DiffPatchVisitor name;
			targetClassName: DiffVisitor name.
	namespace := specification namespaceWithAppliedRefactoring.
	self assert: namespace changes changesSize > 0.
	^ specification
%

method: GtLPushUpMethodSpecificationExamples
pushUpWithNonExistingSubclassAndSuperclass
	<gtExample>
	| specification refactoring |
	specification := GtLPushUpMethodSpecification new
			methodNameToPushUp: #initialize;
			methodClassName: #Asdf;
			targetClassName: #AsdfSuperclass.
	self should: [ specification namespaceWithAppliedRefactoring ] raise: Error.
	refactoring := specification asRefactoring.
	self assert: (refactoring isKindOf: GtPushUpMethodRefactoring).
	self assert: refactoring gtDescription equals: 'Push up method Asdf>>initialize'.
	^ specification
%

category: 'asserting'
method: GtLPushUpMethodSpecificationExamples
assert: aBoolean
	"We check for true explicitly to make the assertion fail for non booleans"
	aBoolean == true ifFalse: [self signalFailure: 'Assertion failed']
			
%

method: GtLPushUpMethodSpecificationExamples
assert: aBooleanOrBlock description: aStringOrBlock
	aBooleanOrBlock value ifFalse: [
		| message |
		message := aStringOrBlock value.
		self classForTestResult failure signal: message]
			
%

method: GtLPushUpMethodSpecificationExamples
assert: actual equals: expected
	^ self
		assert: expected = actual
		description: [self comparingStringBetween: actual and: expected]
%

method: GtLPushUpMethodSpecificationExamples
assertCollection: actual hasSameElements: expected
	"Assert that a collection contains the same elements as the given collection. Order is not checked, only the presence/absence of elements."
	| missingElements additionalElements |
	
	additionalElements := actual difference: expected.
	missingElements := expected difference: (actual intersection: expected).
	self 
		assert: (additionalElements isEmpty and: [ missingElements isEmpty ])
		description: (String streamContents: 
			[:stream |
			stream
				nextPutAll: 'Given Collections do not match!'; lf;
				tab; nextPutAll: 'additions : '; print: additionalElements asArray; lf;
				tab; nextPutAll: 'missing: '; print: missingElements asArray; lf ])
%

method: GtLPushUpMethodSpecificationExamples
classForTestResult
	"Returns the class of the test result"
	^ GtExampleResult
%

method: GtLPushUpMethodSpecificationExamples
executeShould: aBlock inScopeOf: anExceptionalEvent 
	^[aBlock value.
 	false] on: anExceptionalEvent
		do: [:ex | ex return: true]
%

method: GtLPushUpMethodSpecificationExamples
should: aBlock raise: anExceptionalEvent 
	^self assert: (self executeShould: aBlock inScopeOf: anExceptionalEvent)
%

method: GtLPushUpMethodSpecificationExamples
should: aBlock raise: anExceptionalEvent description: aString 
	^self assert: (self executeShould: aBlock inScopeOf: anExceptionalEvent)
		description: aString
			
%

method: GtLPushUpMethodSpecificationExamples
shouldnt: aBlock raise: anExceptionalEvent  
	 
	^self assert: (self executeShould: aBlock inScopeOf: anExceptionalEvent) not
			
%

method: GtLPushUpMethodSpecificationExamples
shouldnt: aBlock raise: anExceptionalEvent description: aString  
 
	^self
		assert: (self executeShould: aBlock inScopeOf: anExceptionalEvent) not
		description: aString
%

category: 'private'
method: GtLPushUpMethodSpecificationExamples
comparingStringBetween: actual and: expected

	^ String streamContents: [:stream |
			stream
				nextPutAll: 'Got ';
				nextPutAll: actual fullPrintString;
				nextPutAll: ' instead of ';
				nextPutAll: expected fullPrintString;
				nextPutAll: '.']
%

category: 'signalling'
method: GtLPushUpMethodSpecificationExamples
signalFailure: aString
	self classForTestResult failure signal: aString
%

category: 'testing'
method: NeoJSONReaderTests
testAllowNil
	self 
		should: [ 
			(NeoJSONReader on: 'null' readStream)
				mapInstVarsFor: Point;
				nextAs: Point ] 
		raise: NeoJSONParseError.
	self
		assert: ((NeoJSONReader on: 'null' readStream)
						mapInstVarsFor: Point;
						for: Point do: [ :mapping | mapping allowNil ];
						nextAs: Point)
		equals: nil.
	self
		assert: ((NeoJSONReader on: '[ { "x" : 1, "y" : 2 }, null, { "x" : 3, "y" : -1 } ]' readStream)
						mapInstVarsFor: Point;
						for: Point do: [ :mapping | mapping allowNil ];
						for: #ArrayOfPoints customDo: [ :mapping | mapping listOfElementSchema: Point ];
						nextAs: #ArrayOfPoints)
		equals: (Array with: 1 @ 2 with: nil with: 3 @ -1).
%

method: NeoJSONReaderTests
testArrayOfPoints
	| reader |
	reader := [ :string | 
		(NeoJSONReader on: string readStream) 
			for: Point do: [ :mapping |
				mapping mapInstVars: #(x y) ];
			for: #ArrayOfPoints customDo: [ :mapping |
				mapping listOfElementSchema: Point ];
			nextAs: #ArrayOfPoints ].
	self assert: (reader value: '[ { "x":1, "y":2 }, { "x":-1, "y":-2 } ]') equals: (Array with: 1@2 with: -1@ -2) . 
	self assert: (reader value: '[ ]') equals: #().
	self assert: (reader value: '[ { } ]') equals: (Array with: Point new)
%

method: NeoJSONReaderTests
testArrayOfPointsUsingNextListAs
