		#selector -> 'testPass'.
		#status -> 'success'.
		#result -> 'Passed'.
		#shouldPass -> true.
		#expectedFailure -> false
	} asDictionary.
	self assert: jsonData equals: expectedJson.
	
	^ domainObject
