method: Point
max: aPoint
	"Answer the lower right corner of the rectangle uniquely defined by the receiver and the argument, aPoint."
	"((100@200) max: (330@400)) >>> (330@400)"
	"((100@200) max: (30@400)) >>> (100@400)"
	^ (x max: aPoint x) @ (y max: aPoint y)
