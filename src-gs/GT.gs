method: GtLExampleWithResultStatusesExamples
domainObjectWithErrorExample
	<gtExample>
	<return: #GtLExampleWithResultStatuses>
	| domainObject errorStatus jsonData |
	
	errorStatus := self createExampleStatusFor: (GtLExampleRunDummyExamples >> #errorExample) withObjectId: nil.
	
	domainObject := GtLExampleWithResultStatuses new
		exampleWithStatuses: { errorStatus };
		notFoundClassNames: #().
	
	self 
		assertStatusesDomainObject: domainObject 
		total: 1 
		skipped: 0 
		success: 0 
		failure: 0 
		error: 1 
		notFound: #().
	
	self 
		assertExampleStatus: errorStatus 
		isSuccess: false 
		isFailure: false 
		isError: true 
		isSkipped: false.
	
	self 
		assertExampleStatus: errorStatus 
		hasClassName: 'GtLExampleRunDummyExamples' 
		selector: 'errorExample' 
		status: 'error' 
		objectId: nil.
	
	jsonData := domainObject llmJsonObject.
	self 
		assertLlmJsonObject: jsonData 
		hasTotal: 1 
		successes: 0 
		failures: 0 
		errors: 1 
		skips: 0 
		notFound: #() 
		detailsCount: 1.
	
	^ domainObject
