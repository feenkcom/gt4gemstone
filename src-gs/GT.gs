category: 'accessing'
method: GtLACPSessionRegistryToolElement
gtInspectorTargetModels
	^ registry ifNil: [ #() ] ifNotNil: [ {registry} ]
%

method: GtLACPSessionRegistryToolElement
playgroundElement
	^ self childNamed: #playgroundPage
%

method: GtLACPSessionRegistryToolElement
registry
	^ registry
%

method: GtLACPSessionRegistryToolElement
registry: aRegistry
	registry := aRegistry.
	self updateToolbarActions.
	self updateContainedViews.
	self updatePlayground
%

method: GtLACPSessionRegistryToolElement
viewsContainerElement
	^ self childNamed: #viewsContainer
%

category: 'building'
method: GtLACPSessionRegistryToolElement
buildHeaderElement
	^ BrHorizontalPane new
		padding: (BlInsets left: 5);
		vFitContent;
		hMatchParent;
		alignCenterLeft;
		addChild: self buildToolLabel as: #toolLabel;
		addChild: (BrFrame new
				hMatchParent;
				vExact: 0;
				yourself);
		addChild: self buildToolbar as: #toolbar;
		yourself
%

method: GtLACPSessionRegistryToolElement
buildPlaygroundPageElement
	| element |
	element := (GtInspector environment at: GtInspector embeddedPlaygroundName) new.
	element collapse.
	^ element
%

method: GtLACPSessionRegistryToolElement
buildToolLabel
	^ BrLabel new
		aptitude: (BrGlamorousLabelAptitude new glamorousRegularFontAndSize
				foreground: Color gray;
				fontSize: 12);
		text: 'ACP Sessions'
%

method: GtLACPSessionRegistryToolElement
buildToolbar
	^ BrToolbar new
		aptitude: BrGlamorousToolbarAptitude new;
		fitContent
%

category: 'collecting'
method: GtLACPSessionRegistryToolElement
collectToolActions
	registry ifNil: [ ^ #() ].
	^ GtPhlowActionsCollector new
		pragmaName: #gtToolAction;
		fromObject: registry;
		selectUsing: [ :anAction | (anAction isKindOf: GtPhlowNoAction) not ];
		collect
%

method: GtLACPSessionRegistryToolElement
collectToolViews
	| views |
	registry ifNil: [ ^ #() ].
	views := GtPhlowViewsCollector new
			fromObject: registry;
			pragmaNames: GtLSettings messageViewPragmaNames;
			context: GtPhlowContext new;
			collect.
	GtPhlowUtility sortByPriority: views.
	^ views
%

category: 'initialization'
method: GtLACPSessionRegistryToolElement
initialize
	super initialize.
	self layout: BlLinearLayout vertical.
	self
		constraintsDo: [ :c | 
			c horizontal matchParent.
			c vertical matchParent ].
	self padding: (BlInsets all: 5).
	self addChild: self buildHeaderElement as: #header.
	self addChild: BrFrame new matchParent as: #viewsContainer.
	self addChild: self buildPlaygroundPageElement as: #playgroundPage.
	self phlow
		accessTool: (GtPhlowToolClassType forClass: GtLACPSessionRegistry)
		viewModel: #registry
		object: #registry
%

category: 'updating'
method: GtLACPSessionRegistryToolElement
updateContainedViews
	| compositeView |
	self viewsContainerElement removeChildren.
	registry ifNil: [ ^ self ].
	compositeView := GtPhlowCompositeView new views: self collectToolViews.
	compositeView
		asElementDo: [ :element | self viewsContainerElement addChild: element ]
%

method: GtLACPSessionRegistryToolElement
updatePlayground
	registry ifNil: [ ^ self ].
	self playgroundElement objectHolder: (GtInspectorObject new object: registry)
%

method: GtLACPSessionRegistryToolElement
updateToolbarActions
	| toolbar |
	toolbar := (self childNamed: #header) childNamed: #toolbar.
	toolbar removeAllItems.
	self collectToolActions
		do: [ :anAction | 
			anAction
				asElement: [ :element | toolbar addItem: element ]
				withHostElement: self ]
%

category: 'api'
method: GtLDataSourceOpenAiResponsesResponseParser
parseResponse: requestResponse message: message for: aMessageConstructor
	| response |

	response := (GtLOpenAIResponse from: requestResponse result)
		requestResponse: requestResponse.
	response hasToolCalls ifTrue:
		[ self parseToolResponse: requestResponse to: message response: response for: aMessageConstructor
		"See GtLModelProvider>>#performToolCallsIn:with:" ]
	ifFalse:
		[ self parseAssistantResponse: requestResponse to: message response: response for: aMessageConstructor ].
%

category: 'private'
method: GtLDataSourceOpenAiResponsesResponseParser
parseAssistantResponse: requestResponse to: inputMessage response: response for: aMessageConstructor
	| newMessage chat assistantRawData result compactionMessages partitionedCompactionMessages |

	chat := aMessageConstructor chat.
	assistantRawData := requestResponse result.
	result := (GtLModelResponse from: assistantRawData)
		requestResponse: requestResponse.
	compactionMessages := chat provider
		automaticCompactionMessagesFrom: result
		inputMessage: inputMessage.
	partitionedCompactionMessages := chat provider
		partitionAutomaticCompactionMessages: compactionMessages
		from: result
		inputMessage: inputMessage.
	partitionedCompactionMessages first do: [ :each |
		inputMessage ifNotNil: [ each updateDataFromMessage: inputMessage ].
		chat addCompactionMessage: each ].

	newMessage := chat provider assistantMessageClass new.
	newMessage
		requestResponse: requestResponse;
		rawData: assistantRawData.
	chat addAssistantMessage: newMessage.

	partitionedCompactionMessages second do: [ :each |
		inputMessage ifNotNil: [ each updateDataFromMessage: inputMessage ].
		chat addPostExecutionMessage: each ].
	^ newMessage
%

method: GtLDataSourceOpenAiResponsesResponseParser
parseToolResponse: requestResponse to: index response: response for: aMessageConstructor
	| toolMessages chat |

	chat := aMessageConstructor chat.
	toolMessages := response toolCalls asArray
			withIndexCollect: [ :aToolCall :anIndex | 
				| toolMessage |
				toolMessage := GtLToolMessage new 
					toolCall: aToolCall;
					requestResponse: (GtLToolPreviousRequestResponse new
						previousRequestResponse: response requestResponse;
						toolCallIndex: anIndex) ].
	toolMessages do: [ :toolMessage |
		chat addToolMessage: toolMessage ].
%

category: 'accessing'
method: GtExampleProcessor
context
	^ context
%

method: GtExampleProcessor
context: anObject
	^ context := anObject
%

method: GtExampleProcessor
example
	^ example
%

method: GtExampleProcessor
example: anObject
	example := anObject
%

category: 'initialization'
method: GtExampleProcessor
initialize
	super initialize.
	context := GtExampleRuntimeContext new
%

category: 'private'
method: GtExampleProcessor
basicProcess: anExample 
	^ self subclassResponsibility
%

method: GtExampleProcessor
process: anExample
	<return: #GtExampleResult>
	^ self basicProcess: anExample
%

method: GtExampleProcessor
withContextDo: aBlock
	^ GtCurrentExampleContext use: context during: aBlock
%

category: 'public'
method: GtExampleProcessor
value 
	<return: #GtExampleResult>
	^ self withContextDo: [ self process: self example ]
%

