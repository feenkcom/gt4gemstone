category: 'initialization'
method: GtMagritteOverviewElement
initialize
	super initialize.
	overviews := BrHorizontalGrid new
			columnCount: 2;
			fitContent.
			
	self initializeOverallStatus.
	self initializeExecutionStatus.

	self addChild: overviews.

	self fitContent
%

method: GtMagritteOverviewElement
initializeExecutionStatus
	| statusContainer |
	executionStatus := self newLabelObserving: #label.
	statusContainer := self
			newContainerWithStatus: executionStatus
			spawning: [ :aMemento | aMemento executionStatus valueOrNil ].


	overviews
		addChild: ((self newTitle: 'Execution status')
				in: [ :aLabel | aLabel margin: (BlInsets top: 10) + aLabel margin ];
				yourself).

	overviews addChild: (self newLabel: 'Activity status:').
	overviews addChild: statusContainer as: #executionStatus
%

method: GtMagritteOverviewElement
initializeOverallStatus
	| statusContainer |
	changedStatus := self newLabelObserving: #isChanged.
	validStatus := self newLabelObserving: #isValid.
	activityStatus := self
			newLabelObserving: [ :aStatus | aStatus executionStatus label ].

	statusContainer := self
			newContainerWithStatus: activityStatus
			spawning: [ :aMemento | 
				aMemento overallStatus valueOrNil ifNotNil: [ :aStatus | aStatus executionStatus ] ].


	overviews addChild: (self newTitle: 'Overall status').

	overviews addChild: (self newLabel: 'Is value changed:').
	overviews addChild: changedStatus as: #isValueChanged.

	overviews addChild: (self newLabel: 'Is value valid:').
	overviews addChild: validStatus as: #isValueValid.

	overviews addChild: (self newLabel: 'Activity status:').
	overviews addChild: statusContainer as: #activityStatus
%

method: GtMagritteOverviewElement
newContainerWithStatus: anElement spawning: aSpawnBlock
	| aContainer aButton |
	aContainer := BrHorizontalPane new fitContent.

	anElement constraintsDo: [ :c | c linear vertical alignCenter ].

	aButton := BrButton new
			fitContent;
			beMiniSize;
			aptitude: BrGlamorousButtonWithIconAptitude;
			icon: BrGlamorousVectorIcons inspect;
			label: 'Inspect';
			constraintsDo: [ :c | c linear vertical alignCenter ];
			margin: (BlInsets left: 5);
			action: [ :theButton | 
				self memento
					ifNotNil: [ :aMemento | 
						(aSpawnBlock cull: aMemento)
							ifNotNil: [ :anObject | theButton phlow spawnObject: anObject ] ] ].

	aContainer
		addChild: anElement;
		addChild: aButton.
	^ aContainer
%

method: GtMagritteOverviewElement
newLabel: aString
	^ BrLabel new
		aptitude: (BrGlamorousLabelAptitude new
				foreground: BrGlamorousColors disabledButtonTextColor);
		text: aString;
		margin: (BlInsets
				top: 0
				right: 10
				bottom: 10
				left: 0)
%

method: GtMagritteOverviewElement
newLabelObserving: aSelector
	^ BrLabel new
		text: '?';
		aptitude: BrGlamorousLabelAptitude;
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :theLabel :aSink | 
					| aValue |
					aValue := aSink value.

					theLabel text: (aValue ifNotNil: aSelector ifNil: [ '?' ]) asString ] ]
%

method: GtMagritteOverviewElement
newTitle: aString
	^ (self newLabel: aString)
		aptitudeDo: [ :anAptitude | 
			anAptitude
				foreground: BrGlamorousColors defaultHeaderTextColor;
				fontSize: 18;
				bold ];
		constraintsDo: [ :c | c grid horizontal span: 2 ]
%

category: 'private - hooks'
method: GtMagritteOverviewElement
onMementoChanged

	self updateOverviews
%

category: 'private - updating'
method: GtMagritteOverviewElement
updateOverviews
	self memento overallStatus observe: changedStatus asyncSink.
	self memento overallStatus observe: validStatus asyncSink.
	self memento overallStatus observe: activityStatus asyncSink.
	self memento executionStatus observe: executionStatus asyncSink
%

category: 'accessing'
method: GtMagriteStringStreamDataCreationVisitor
currentObject
	"we have this state because magritte does not return the value of the accepting a visitor"
	^ currentObject
%

method: GtMagriteStringStreamDataCreationVisitor
currentObject: anObject
	currentObject := anObject
%

method: GtMagriteStringStreamDataCreationVisitor
stringStream

	^ stringStream
%

method: GtMagriteStringStreamDataCreationVisitor
stringStream: anObject

	stringStream := anObject
%

category: 'visiting-description'
method: GtMagriteStringStreamDataCreationVisitor
visitPriorityContainer: aContainer
	aContainer children
		do: [ :aDescription | aDescription acceptMagritte: self ]
		separatedBy: [ self stringStream space ]
%

method: GtMagriteStringStreamDataCreationVisitor
visitStringDescription: aStringDescription
	| aString |
	aString := aStringDescription read: self currentObject.

	self stringStream nextPutAll: aString asString
%

method: GtMagriteStringStreamDataCreationVisitor
visitToManyRelationDescription: aDescription
	| result |
	result := aDescription read: self currentObject.
	result
		do: [ :eachObject | 
			| visitor |
			visitor := GtMagriteStringStreamDataCreationVisitor new
					currentObject: eachObject;
					stringStream: self stringStream.
			eachObject magritteDescription acceptMagritte: visitor ]
		separatedBy: [ self stringStream space ]
%

method: GtMagriteStringStreamDataCreationVisitor
visitToOneRelationDescription: aDescription
	| result visitor |
	result := aDescription read: self currentObject.
	visitor := GtMagriteStringStreamDataCreationVisitor new
			currentObject: result;
			stringStream: self stringStream.
	result magritteDescription acceptMagritte: visitor
%

