	<magritteDescription>
	^ MAStringDescription new
		  accessor: #city;
		  default: '';
		  priority: 2;
		  beRequired;
		  addCondition: [ :aValue | aValue trimBoth isNotEmpty ]
		  labelled: 'City must be non empty';
		  addCondition: [ :aValue | aValue allSatisfy: #isLetter ]
		  labelled: 'City must include letters only'
