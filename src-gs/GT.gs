category: 'private'
method: GtPhlowChatToolElement
buildHeaderElement
	^ BrVerticalPane new
		padding: (BlInsets left: 5);
		vFitContent;
		hMatchParent;
		addChild: self buildToolLabel as: #toolLabel;
		yourself
