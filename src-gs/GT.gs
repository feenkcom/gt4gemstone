	self baseUrl: self defaultBaseUrl.
	self version: self defaultVersion.
	
	history := GtLRequestHistory new.
	clientBuilder := GtLAnthropicClientZincBuilder new.
%

method: GtLAnthropicClient
initializeClient

	^ clientBuilder
		apiKey: apiKey;
		version: version;
		create
