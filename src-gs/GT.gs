	scripter
		assertStep: [ :step | 
			step
				id: #'acp-final-content';
				satisfies: [ :pane | 
					(self editorsIn: pane)
						anySatisfy: [ :child | (child isKindOf: BrEditor) and: [ child text asString = text ] ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-final-preview';
				notExists ].
	scripter click
		id: #'acp-final-toggle';
		play.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-final-preview';
				exists ].
	^ scripter
