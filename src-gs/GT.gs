category: 'initialization'
method: GtLOllamaCreateModelContext
fromModelFile: anOllamaModelFile
	| attributeMapping |

	attributeMapping := {
		'FROM' -> [ :value | value text = model name ifFalse: [ self error: 'File from (', value text asString, ') doesn''t match model name (', model name asString, ')' ] ].
		'LICENSE' -> [ :value | self license: value text ].
		'MESSAGE' -> [ :value | self messages add: { 'role' -> value text. 'message' -> value messageText } asDictionary ].
		'NAME' -> [ :value | self name: value text ].
		'PARAMETER' -> [ :value | self parameters at: value text put: value value ].
		'QUANTIZE' -> [ :value | self quantize: value text ].
		'SYSTEM' -> [ :value | self system: value text ].
		'TEMPLATE' -> [ :value | self template: value text ].
		} asDictionary.
	anOllamaModelFile directives do: [ :directive |
		(attributeMapping at: directive directiveKind) value: directive ].
%

category: 'examples'
method: GtLSmaCCParserUpdateResultExamples
basicUpdateResult
	<gtExample>
	| result oldGrammar newGrammar |
	oldGrammar := GtSmaCCGrammar forDefinition: '<token>: \d+; Expr: <token>;'.
	newGrammar := GtSmaCCGrammar forDefinition: '<token>: \d+; Expr: <token> <token>;'.
	result := GtLSmaCCParserUpdateResult new
		parserClass: #TestParser;
		oldGrammar: oldGrammar;
		newGrammar: newGrammar.
	
	self assert: result parserClass equals: #TestParser.
	self assert: result oldGrammar equals: oldGrammar.
	self assert: result newGrammar equals: newGrammar.
	self assert: result isErrorDomainObject not.
	^ result
%

method: GtLSmaCCParserUpdateResultExamples
updateResultDataViewSerialization
	<gtExample>
	| result compositeView dataBlock jsonData |
	result := self basicUpdateResult.
	compositeView := result llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assert: dataBlock isNotNil.
	self assert: dataBlock dataBlocks size equals: 1.
	
	jsonData := dataBlock compositeJsonData.
	self assert: (jsonData at: #parserClass) equals: #TestParser.
	"oldGrammar and newGrammar are not serialized via Magritte"
	
	^ dataBlock
%

