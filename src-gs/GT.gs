category: '*GToolkit4OpenAPI'
method: NeoJSONReader
peekPropertyName
	"We want to figure out what object we want to read 
	based on the first parameter name (dictionary key)."

	| stream |
	stream := readStream clone.

	[ stream atEnd not and: [ stream peek isSeparator ] ]
		whileTrue: [ stream next ].

	(stream peekFor: ${) ifFalse: [ self error: '{ expected' ].

	[ stream atEnd not and: [ stream peek isSeparator ] ]
		whileTrue: [ stream next ].

	(stream peekFor: $")
		ifFalse: [ (stream peekFor: $})
				ifFalse: [ self error: '" or } expected' ]
				ifTrue: [ ^ '' ] ].
				
	^ stream upTo: $"
%

method: NeoJSONReader
peekPropertyNames
	"We want to figure out what object we want to read
	based on the first parameter name (dictionary key)."

	| stream parsedValue |
	stream := self
		gtDo: [ readStream clone ]
		gemstoneDo: [ readStream shallowCopy ].

	parsedValue := self parseValue.
	readStream := stream.
	^ parsedValue keys
%

category: 'accessing'
method: NeoJSONReader
listClass
	"Return the collection type to use for JSON lists"
	
	^ listClass ifNil: [ Array ]
%

method: NeoJSONReader
mapClass
	"Return the collection type to use for JSON maps"
	
	^ mapClass ifNil: [ Dictionary ]
%

method: NeoJSONReader
next
	"Primary interface to parse a JSON value.
	Return either primitives, a listClass or a mapClass instance."
	
	^ self 
		consumeWhitespace; 
		parseValue
%

method: NeoJSONReader
nextAs: schema
	"Secondary interface to parse JSON.
	Return an object according to schema.
	If schema is nil, act like #next"
	
	| mapping |
	schema ifNil: [ ^ self next ].
	self consumeWhitespace.
	mapping := self mappingFor: schema.
	^ mapping readFrom: self
%

method: NeoJSONReader
nextListAs: schema
	"Secondary interface to parse JSON.
	Return a list of objects, each element according to schema."
	
	^ self listClass streamContents: [ :stream |
			self parseListDo: [ 
				stream nextPut: (self nextAs: schema) ] ]
%

method: NeoJSONReader
upToEnd
	"Parse and collect JSON values from my stream until it ends, returning the collection.
	This supports Newline delimited JSON (application/x-ndjson) & JSON Lines (application/jsonl).
	Warning: though each element is valid JSON, taken as a whole the result is non-valid JSON."
	
	^ Array streamContents: [ :out |
		[ self atEnd ] whileFalse: [ out nextPut: self next ] ]
%

