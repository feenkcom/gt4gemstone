option: anId name: aName category: aCategory value: aValue choices: choices
	^ {'id' -> anId.
		'name' -> aName.
		'category' -> aCategory.
		'type' -> 'select'.
		'currentValue' -> aValue.
		'options' -> choices} asDictionary
