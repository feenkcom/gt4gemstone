category: 'examples'
method: GtLMagritteToolForFilesContentsExamples
filesContentsForExistingFiles
	<gtExample>
	| fileOne fileTwo |
	fileOne := FileReference newTempFilePrefix: 'GtLMagritteToolForFilesContents' suffix: 'one.txt'.
	fileTwo := FileReference newTempFilePrefix: 'GtLMagritteToolForFilesContents' suffix: 'two.txt'.
	[ | tool call targetObject |
		fileOne writeStreamDo: [ :stream | stream nextPutAll: 'First file' ].
		fileTwo writeStreamDo: [ :stream | stream nextPutAll: 'Second file' ].
		tool := GtLMagritteToolForFilesContents new.
		call := self
			executeTool: tool
			withArguments: {
				'filePaths' -> { 
					{'pathString' -> fileOne pathString} asDictionary.
					{'pathString' -> fileTwo pathString} asDictionary } asArray } asDictionary.
		targetObject := call result targetObject.
		self assert: targetObject files size equals: 2.
		self assert: targetObject files first path equals: fileOne pathString.
		self assert: targetObject files first contents equals: 'First file' asByteArray base64Encoded.
		self assert: targetObject files second path equals: fileTwo pathString.
		self assert: targetObject files second contents equals: 'Second file' asByteArray base64Encoded.
		^ call ]
		ensure: [
			fileOne exists ifTrue: [ fileOne delete ].
			fileTwo exists ifTrue: [ fileTwo delete ] ]
%

method: GtLMagritteToolForFilesContentsExamples
filesContentsForMissingFile
	<gtExample>
	| missingPath existingFile |
	missingPath := (FileLocator temp / 'gt-llm-missing-file.txt') pathString.
	existingFile := FileReference newTempFilePrefix: 'GtLMagritteToolForFilesContents' suffix: 'existing.txt'.
	[ | tool call targetObject |
		existingFile writeStreamDo: [ :stream | stream nextPutAll: 'Existing file' ].
		tool := GtLMagritteToolForFilesContents new.
		call := self
			executeTool: tool
			withArguments: { 'filePaths' -> { {'pathString' -> missingPath} asDictionary.
				{'pathString' -> existingFile pathString} asDictionary } asArray } asDictionary.
		targetObject := call result targetObject.
		self assert: targetObject files size equals: 2.
		self assert: targetObject files first isErrorDomainObject.
		self assert: targetObject files first objectName equals: missingPath.
		self assert: targetObject files second contents equals: 'Existing file' asByteArray base64Encoded.
		^ call ]
		ensure: [ existingFile exists ifTrue: [ existingFile delete ] ]
%

method: GtLMagritteToolForFilesContentsExamples
filesContentsWithEmptyPath
	<gtExample>
	| tool call targetObject |
	tool := GtLMagritteToolForFilesContents new.
	call := self
		executeTool: tool
		withArguments: { 'filePaths' -> { { 'pathString' -> '' } asDictionary } asArray } asDictionary.
	targetObject := call result targetObject.
	self assert: targetObject files size equals: 1.
	self assert: targetObject files first isErrorDomainObject.
	self assert: (targetObject files first isKindOf: GtLMissingDomainObject).
	self assert: targetObject files first objectName equals: ''.
	^ call
%

method: GtLMagritteToolForFilesContentsExamples
filesContentsWithNilPath
	<gtExample>
	| tool call |
	tool := GtLMagritteToolForFilesContents new.
	call := self
		executeTool: tool
		withArguments: { 'filePaths' -> { nil } asArray } asDictionary.
	self 
		assertJSONSchemaValidationError: call result targetObject 
		withPath: #('filePaths' 1) 
		errorMessage: '@[filePaths/1] object expected'.
	^ call
%

method: GtLMagritteToolForFilesContentsExamples
filesContentsWithoutPaths
	<gtExample>
	| tool call |
	tool := GtLMagritteToolForFilesContents new.
	call := self
		executeTool: tool
		withArguments: Dictionary new.
	self 
		assertMissingRequiredProperties: call result targetObject 
		withPropertyNames: #('filePaths') 
		path: #(nil) 
		errorMessage: 'required properties missing [filePaths]'.
	^ call
%

category: 'as yet unclassified'
method: GtLToolForChatMethodSearch
chat
	| chat |
	chat := GtLChat new.
	provider ifNotNil: [ chat provider: provider ].
	chat
		addResponseFormatForMagritte: GtLPharoScript named: 'PharoScript';
		pageExplanation: 'Querying with GT search filters by example'.
	^ chat
%

method: GtLToolForChatMethodSearch
description
	^ 'Search for methods that match a searchPrompt.
	
Examples can be:

```
methods that are in {{gtClass:BlElement}} and also refer to `assert:description:`
```

```
methods that are annotated with `gtView` pragmas
```'
%

method: GtLToolForChatMethodSearch
name
	^ 'promptedMethodSearch'
%

method: GtLToolForChatMethodSearch
provider: aProvider 
	"useful for stubbing purposes"
	provider := aProvider
%

method: GtLToolForChatMethodSearch
searchPromptDescription
	<magritteDescription>

	^ MAStringDescription new
		label: 'Search prompt';
		accessor: #searchPrompt;
		beRequired
%

category: 'private'
method: GtLToolForChatMethodSearch
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| argument chat semaphore timeout |
	argument := aToolCall arguments anyOne.
	chat := self chat.
	aToolCall at: #innerChat putRuntimeValue: chat.
	semaphore := Semaphore new.
	chat announcer
		when: GtLThreadRunIsDoneAnnouncement
		send: #signal
		to: semaphore.
	chat
		sendWith: [ :msg | 
			msg
				markdown: 'Produce a PharoScript with the following search filter: ' , argument ].	"weak"
	timeout := semaphore waitTimeoutSeconds: 120.
	chat announcer unsubscribe: semaphore.
	timeout
		ifTrue: [ ^ GtLProblemDomainObject new
				description: 'Could not produce a PharoScript with a search filter on time' ].

	[ | filter result promise |
	filter := Object compiler
			evaluate: (chat messages last finalMessage responseModels at: 'PharoScript') content.
	promise := filter result toArray
			await: GtLSettings futureExecutionConfiguration.
	result := promise wait.
	^ GtLMethodsSearchResult fromReferences: (result first: (100 min: result size)) ]
		on: Error
		do: [ :anException | ^ GtLExceptionDomainObject freeze: anException ]
%

