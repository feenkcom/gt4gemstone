category: 'api'
method: GtLCrossEncoderReranker
reRank: matchingEmbeddings in: aLepiterRagContext
	| crossEncoder rankings updatedEmbeddings offset |

	crossEncoder := GtLSentenceTransformerCrossEncoder default.
	rankings := crossEncoder
		reRankQuery: aLepiterRagContext queryString
		documents: (matchingEmbeddings collect: #document).
	"The cross-encoder has highest value as best match,
	while we are using distance, i.e. closer is better.
	Update the cross-encoder values to be a 'distance'."
	updatedEmbeddings := GtLNearestEmbeddingGroup new items: 
		(matchingEmbeddings collect: #copy).
	offset := rankings first second + 1.
	rankings do: [ :anArray |
		(updatedEmbeddings at: anArray first + 1) distance: (offset - anArray second) ].
	^ updatedEmbeddings
%

category: 'examples'
method: GtLACPWorkGraphExamples
connectionsFlowDownward
	<gtExample>
	| scripter graph |
	scripter := self nestedWorkDisplayed.
	graph := scripter model.
	(graph rows select: [ :row | row sourceLane ~~ row targetLane ])
		do: [ :row | 
			scripter
				assertStep: [ :step | 
					step
						id: ('acp-work-graph-row-' , row index asString) asSymbol;
						satisfies: [ :element | 
							| line |
							line := element childNamed: #'acp-work-graph-connection'.
							line class = BlManhattanLineElement
								and: [ line fromPosition x = row sourceLane x
										and: [ line toPosition x = row targetLane x
												and: [ line fromPosition y < line toPosition y
														and: [ line toDirection y > 0
																and: [ line geometry cornerRadius > 0
																		and: [ line hasToHead not and: [ line hasFromHead not ] ] ] ] ] ] ] ] ] ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

method: GtLACPWorkGraphExamples
emptyConversation
