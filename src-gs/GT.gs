category: 'private'
method: GtLToolForLepiterPageCreate
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments title targetDatabase page databaseId baseDatabase |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	title := arguments at: 'title'.
	(title trimBoth isEmpty)
		ifTrue: [ ^ GtLMissingArgumentDomainObject new
			arguments: arguments;
			missingArgument: 'title' ].
	databaseId := arguments at: 'databaseId'.
	(databaseId trimBoth isEmpty)
		ifTrue: [ ^ GtLMissingArgumentDomainObject new
			arguments: arguments;
			missingArgument: 'databaseId' ].
	baseDatabase := self database.
	targetDatabase := (baseDatabase respondsTo: #databaseWithID:ifNone:)
		ifTrue: [ baseDatabase databaseWithID: databaseId ifNone: [ nil ] ]
		ifFalse: [ (baseDatabase respondsTo: #uuid)
				ifTrue: [ baseDatabase uuid asString = databaseId
						ifTrue: [ baseDatabase ]
						ifFalse: [ nil ] ]
				ifFalse: [ nil ] ].
	targetDatabase ifNil: [ ^ GtLProblemDomainObject new
			description: 'Database with ' , databaseId asString , ' not found' ].
	page := targetDatabase pageBuilder title: title; add.
	^ GtLLepiterPageCreateDomainObject new
		status: 'created';
		databaseId: databaseId;
		pageUid: page uidString;
		title: page title;
		page: page
%

category: 'accessing'
method: GtLWebFetchTool
description
	^ 'Fetch a single web page by URL and return its content.
	
Example JSON arguments:
{ "url": "https://example.com" }

Example JSON response:
{
  "title": "Example Domain",
	"content": "<!doctype html>...</html>",
  "links": [ "https://example.com" ]
}'
%

method: GtLWebFetchTool
name

	^ 'WebFetch'
%

category: 'as yet unclassified'
method: GtLWebFetchTool
formattedLinksIn: doc

	^ (doc allElementsNamed: 'a') collect: [ :element |
		String streamContents: [ :stream |
			stream
				<< '[';
				<< element contentString asString;
				<< '](';
				<< (element attributeNodeAt: 'href') value asString;
				<< ')' ] ]
		as: Array.
%

method: GtLWebFetchTool
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| url |

	url := aToolCall arguments at: 'url'
		ifAbsent: [ | rawArgs |
			rawArgs := aToolCall rawArguments.
			rawArgs isString ifTrue:
				[ rawArgs := NeoJSONReader fromString: rawArgs ].
				rawArgs at: 'url' ifAbsent: [ ] ].
	url ifNil: [ ^ 'No url argument found.  The arguments should be of the form { "url": "https://..." }' ].
	^ self get: url.
%

method: GtLWebFetchTool
titleIn: doc
	^ (doc allElementsNamed: 'title') first
		ifNil: [ 'no title' ]
		ifNotNil: [ :anObject | anObject contentString ]
%

category: 'magritte'
method: GtLWebFetchTool
urlDescription
	<magritteDescription>
	^ MAStringDescription new
		label: 'URL to fetch';
		accessor: #url;
		beRequired
%

category: 'private'
method: GtLWebFetchTool
get: aUrl
	| url znClient znResponse result doc title links response |

	url := aUrl.
	((url beginsWith: 'http://') or:
	[ url beginsWith: 'https://' ]) ifFalse:
		[ self error: 'The supplied URL must begin with http:// or https://' ].

	znClient := ZnClient new.
	znClient get: url.
	znResponse := znClient response.
	znResponse isSuccess ifFalse:
		[ znResponse inspect.
		 ^ {
			'error' -> 'Unable to retrieve the URL'.
			} asDictionary. ].
	result := znResponse contents.
	doc := XMLHTMLParser parse: result.
	links := self formattedLinksIn: doc.
	title := self titleIn: doc.

	response := NeoJSONWriter toString: {
		'title' -> title.
		'content' -> result.
		'links' -> links.
		} asDictionary.

	^ GtLPlainJson forString: response
%

