category: 'accessing'
method: NeoJSONObjectTests
exampleJSONSchema
	^ NeoJSONObject fromString: '{
  "$id" : "https://example.com/schemas/address",
  "type" : "object",
  "properties" : {
    "street_address" : { "$anchor" : "street_address", "type" : "string" },
    "city" : { "type" : "string" },
    "state" : { "type" : "string" }
  }, 
  "required" : ["street_address", "city", "state"],
  "$defs" : {
    "country" : { "type" : "object", "$anchor" : "country", "enum" : ["us","canada","gb"] }
  }
}'
%

category: 'testing'
method: NeoJSONObjectTests
testArray
	| jsonArray array |
	jsonArray := '[1,2,3]'.
	array := NeoJSONObject fromString: jsonArray.
	self assert: array asString equals: jsonArray.
	self assertCollection: array hasSameElements: #(1 2 3).
	array at: 1 add: 0.
	array at: #- add: 4.
	self assertCollection: array hasSameElements: #(0 1 2 3 4).
	array removeKey: 5.
	array removeKey: 1.
	self assertCollection: array hasSameElements: #(1 2 3)
%

method: NeoJSONObjectTests
testAtAt
	| object |
	object := NeoJSONObject new.
	self assert: (object at: #foo) isNil.
	self assert: (object at: #foo at: #bar) isNil.
	object at: #foo at: #bar put: 123.
	self assert: (object at: #foo) notNil.
	self assert: (object at: #foo at: #bar) equals: 123.
	self assert: object foo bar equals: 123.
	object at: #foo at: #bar put: -1.
	self assert: (object at: #foo at: #bar) equals: -1.
	self assert: (object at: #foo at: #foo) isNil
%

method: NeoJSONObjectTests
testAtPath
	| object |
	object := NeoJSONObject newFrom:  (Array with:  #one -> ( NeoJSONObject newFrom:  (Array with:  #two -> ( NeoJSONObject newFrom: (Array with:  #three -> 42) ) ) )).
	self assert: (object atPath: #(one two three)) equals: 42.
	self assert: (object atPath: #(one two three)) equals: object one two three.	
	self assert: (object atPath: #(missing)) equals: nil.
	self assert: (object atPath: #(one missing)) equals: nil.
	self assert: (object atPath: #(one two missing)) equals: nil.
	self assert: (object atPath: #(one two missing)) equals: object one two missing.
	
	object := NeoJSONObject newFrom:  (Array with: #foo -> 42).
	self assert: (object atPath: #(foo)) equals: 42.
	self assert: (object atPath: #(foo)) equals: object foo.
	self assert: (object atPath: #(foo)) equals: (object at: #foo).
	self assert: (object atPath: #()) equals: object.
	
%

method: NeoJSONObjectTests
testAtPathPut
	| object |
	object := NeoJSONObject new.
	object atPath: #(one test) put: 42.
	self assert: (object atPath: #(one test)) equals: 42.
	self assert: object one test equals: 42.
	object atPath: #(one two three) put: #foo.
	self assert: (object atPath: #(one two three)) equals: #foo.
	self assert: object one two three equals: #foo.
	object atPath: #(one two threeBis) put: #bar.
	self assert: (object atPath: #(one two threeBis)) equals: #bar.
	self assert: object one two threeBis equals: #bar.
	
	self assert: object foo isNil.
	self assert: (object atPath: #() put: 1) equals: object.
	self assert: (object atPath: #(foo) put: 1) equals: 1.
	self assert: (object atPath: #(foo)) equals: 1.
	self assert: object foo equals: 1
	 
%

method: NeoJSONObjectTests
testCRUD
	| object |
	object := NeoJSONObject new.
	self assert: object isEmpty.
	self assert: object foo equals: nil.
	object foo: 123.
	self assert: object foo equals: 123.
	self assert: object printString equals: '{"foo":123}'.
	object name: 'test'.
	object value: Float pi.
	self assert: object name equals: 'test'.
	self assert: (object value closeTo: Float pi).
	self assert: object keys asSet equals: #(foo name value) asSet.
	object removeKey: #foo.
	self assert: object foo equals: nil.
	object removeAll.
	self assert: object isEmpty
%

method: NeoJSONObjectTests
testFindPath
	| json path |
	json := self exampleJSONSchema.
	
	path := json findPath: [ :object | object isDictionary and: [ (object at: '$anchor') = 'street_address' ] ].
	self deny: path isNil.
	self assert: path equals: #(properties street_address).
	self assert: ((json atPath: path) at: '$anchor') equals: 'street_address'.
		
	path := json findPath: [ :object | object isDictionary and: [ (object at: 'foo') = 'bar' ] ].
	self assert: path isNil.
	
	path := json findPath: [ :object | object isDictionary and: [ (object at: '$anchor') = 'country' ] ].
	self deny: path isNil.
	self assert: path equals: #('$defs' country).
	self assert: ((json atPath: path) at: '$anchor') equals: 'country'.
	
	json := NeoJSONObject new at: '$anchor' put: 'top'; yourself.
	self 
		assert: (json findPath: [ :object | object isDictionary and: [ (object at: '$anchor') = 'top' ] ])
		equals: #(())
%

method: NeoJSONObjectTests
testFindPaths
	| json paths |
	json := self exampleJSONSchema.
	
	paths := json findPaths: [ :object | object isDictionary and: [ object includesKey: '$anchor' ] ].
	self deny: paths isEmpty.
	self assert: paths asArray equals: #((properties street_address) ('$defs' country)).
	self assert: ((json atPath: paths first) at: '$anchor') equals: 'street_address'.
	self assert: ((json atPath: paths second) at: '$anchor') equals: 'country'.
			
	paths := json findPaths: [ :object | object isDictionary and: [ (object at: 'foo') = 'bar' ] ].
	self assert: paths isEmpty.
	
	paths := json findPaths: [ :object | object isDictionary and: [ object includesKey: #type ] ].
	self deny: paths isEmpty.
	paths do: [ :path |
		self assert: (#(string object) includes: ((json atPath: path) at: #type)) ].
		
	paths := json findPaths: [ :_ | true ].
	paths do: [ :each | 
		self assert: (json atPath: each) notNil ]
%

method: NeoJSONObjectTests
testJSON
	| data  json object |
	data := NeoJSONObject newFrom: (Array with: #foo->1 with: #bar->2 with: #str->'Str!' with: #bool->true with: #flt->1.5).
	json := NeoJSONWriter toString: data .
	object := NeoJSONObject fromString: json.
	self assert: object class equals: NeoJSONObject.
	self assert: object equals: data.
	json := (NeoJSONWriter toString: object).
	self assert: (NeoJSONObject fromString: json) equals: object
%

method: NeoJSONObjectTests
testPathAccess
	| data |
	data := NeoJSONObject fromString: '{"foo":1,"bar":2,"array":[{"a":1},{"b":2}]}'.
	self assert: (data atPath: #(array 1 a)) equals: 1.
	self assert: (data atPath: #(array 2 b)) equals: 2.
	self assert: (data atPath: #(missing 1)) equals: nil.
	data atPath: #(missing) put: 7.
	self assert: (data atPath: #(missing)) equals: 7.
	self assert: (data atPath: #(array 3)) equals: nil.
	data := NeoJSONObject fromString: '[{"c":1},{"c":2},{"c":3}]'.
	self assert: (data atPath: #(2 c)) equals: 2.
	self assert: (data atPath: #(10 c)) equals: nil.
	self assert: (data atPath: #(3 missing)) equals: nil.
	data atPath: #(3 missing) put: #found.
	self assert: (data atPath: #(3 missing)) equals: #found.
	(data at: 3) removeKey: #missing.
	self assert: (data atPath: #(3 missing)) equals: nil.
	data atPath: #(3 missing x) put: #found.
	self assert: (data atPath: #(3 missing x)) equals: #found.
%

category: 'examples'
method: GtLMessageTableStylerExamples
annotationCellPreservesTree
	<gtExample>
	| table cell source positions styled |
	table := (LeParser parse: '| Class | Summary |', String lf, '|---|---|', String lf,
		'| {{gtClass:BlElement}} | Summary |') parts first.
	cell := table rows first cells first.
	source := cell source.
	positions := cell allTokens collect: #startPosition.
	"Populate cached positions before copying, as a real editor does."
	cell withAllNodesDo: [ :node | node startPosition. node stopPosition ].
	{ GtLMessageStyler new.
		LeSnippetStyler new snippetViewModel: LeTextSnippet new asSnippetViewModel; yourself } do: [ :styler |
		styled := styler tableCellTextFor: cell.
		self assert: styled asString equals: source trimBoth.
		self assert: cell source equals: source.
		self assert: (cell allTokens collect: #startPosition) equals: positions.
		self assert: cell parts second annotation parent == cell parts second.
		self assert: cell parts second annotation nameNode source equals: 'BlElement' ].
	^ styled
%

method: GtLMessageTableStylerExamples
annotationInTableHeader
	<gtExample>
	| text preview list scripter |
	text := ('| Something | {{gtClass:Object}} |' , String lf , '| :-- | :-- |'
			, String lf , '| aValue | anotherValue |') asRopedText.
	GtLMessageStyler new privateStyle: text.
	text
		findAttributesSuchThat: [ :each | (each isKindOf: BrTextAdornmentDynamicAttribute) and: [ each shouldAppend ] ]
		indicesDo: [ :start :end :each | preview := each ].
	list := preview stencil build.
	list hExact: 800.
	scripter := BlScripter new element: list.
	scripter
		assertStep: [ :step | 
			step
				label: 'Class annotation in the header materializes its link button';
				satisfies: [ :element | 
					| header button |
					header := (element query // #columnHeader2) anyOne.
					button := (header query // BrButton) anyOne.
					button label asString = 'Object' ] ].
	^ scripter
%

method: GtLMessageTableStylerExamples
boldCellPreservesTree
	<gtExample>
	| table cell source start styled |
	table := LeMarkdownTableExamples new sample.
	cell := table rows fourth cells third.
	source := cell source.
	start := cell startPosition.
	styled := GtLMessageStyler new tableCellTextFor: cell.
	self assert: styled asString equals: source trimBoth.
	self assert: (styled hasAttributeSuchThat: [ :each | each isKindOf: BlFontWeightAttribute ]).
	self assert: cell source equals: source.
	self assert: cell startPosition equals: start.
	self assert: cell parent == table rows fourth.
	self assert: (GtLMessageStyler new tableCellTextFor: nil) isEmpty.
	^ styled
%

method: GtLMessageTableStylerExamples
classSummaries
	<gtExample>
	| source text preview list |
	source := '| Class | Summary |', String lf,
		'|---|---|', String lf,
		'| {{gtClass:BlElement}} | The fundamental building block for visual interfaces in Bloc, supporting properties such as background, border, size, and opacity. Elements compose into parent–child trees to build complex interfaces from smaller parts. |', String lf,
		'| {{gtClass:BlSpace}} | Represents a logical window independently of the underlying host platform. It holds the root element and coordinates input processing, layout, and rendering. |', String lf,
		'| {{gtClass:BlLayout}} | Defines the common API for layout strategies that measure elements and position their children. Concrete layouts use constraints to control sizing, spacing, and alignment within an element. |', String lf.
	text := source asRopedText.
	GtLMessageStyler new privateStyle: text.
	text findAttributesSuchThat: [ :each |
		(each isKindOf: BrTextAdornmentDynamicAttribute) and: [ each shouldAppend ] ] indicesDo: [ :start :end :each | preview := each ].
	self assert: preview isNotNil.
	list := preview stencil build.
	self assert: list columns size equals: 2.
	self assert: list items size equals: 3.
	self assert: text asString equals: source.
	list hExact: 800.
	^ list
%

method: GtLMessageTableStylerExamples
indentedTableWithTrailingSpaces
	<gtExample>
	| table text previews |
	table := LeMarkdownTableExamples new indentedTableWithTrailingSpaces.
	text := table source asRopedText.
	GtLMessageStyler new privateStyle: text.
	previews := OrderedCollection new.
	text
		findAttributesSuchThat: [ :each | each isKindOf: BrTextAdornmentDynamicAttribute ]
		indicesDo: [ :start :end :each | each shouldAppend ifTrue: [ previews add: each ] ].
	self assert: previews size equals: 1.
	self assert: text asString equals: table source.
	^ text
%

method: GtLMessageTableStylerExamples
nativeHeadersAlignWithBody
	<gtExample>
	| scripter |
	scripter := BlScripter new element: self sampleList.
	scripter assertStep: [ :step |
		step label: 'Native headers align with body cell editors';
			satisfies: [ :list |
				| headers rows |
				headers := (list query // #'column-header') anyOne children.
				rows := (list query // #scrollable) anyOne children.
				rows notEmpty and: [ rows allSatisfy: [ :row |
					(1 to: headers size) allSatisfy: [ :index |
						| header cell editor |
						header := (headers at: index) bounds inSpace asRectangle.
						cell := row children at: index.
						editor := (cell query // #tableCellEditor) anyOne bounds inSpace asRectangle.
						(header left - editor left) abs < 1 and: [ (header right - editor right) abs < 1 ] ] ] ] ] ].
	^ scripter
%

method: GtLMessageTableStylerExamples
renderedClassSummaries
	<gtExample>
	| scripter |
	scripter := BlScripter new element: self classSummaries.
	scripter assertStep: [ :step |
		step label: 'Class annotations materialize as link buttons inside editors';
			satisfies: [ :list |
				| buttons editors |
				buttons := (list query // BrButton) all collect: [ :button | button label asString ].
				editors := (list query // #tableCellEditor) all.
				buttons asArray = #('BlElement' 'BlSpace' 'BlLayout') and: [ editors size = 6 ] ] ].
	scripter assertStep: [ :step |
		step label: 'Long summaries wrap to multiple lines';
			satisfies: [ :list |
				| editors |
				editors := (list query // #tableCellEditor) all.
				#(2 4 6) allSatisfy: [ :index | (editors at: index) height > (editors at: index - 1) height ] ] ].
	^ scripter
%

method: GtLMessageTableStylerExamples
sampleList
