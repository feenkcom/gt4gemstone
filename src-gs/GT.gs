method: OrderedDictionaryTest
testAtUpdateInitial
	| dict |
	dict := OrderedDictionary  newFrom: {2->10. 100->5} .
	dict at: 5 update: [ :v | v+1 ] initial: 17.
	dict at: 2 update: [ :v | v+10 ] initial: [0].
