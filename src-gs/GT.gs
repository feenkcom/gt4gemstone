category: 'api - serializing'
method: GtLTestCasesWithResultStatuses
llmRawDataViewFor: aDataView
	<gtLlmDataView>
	
	^ aDataView 
			title: 'Example results';
			jsonObject: [ :json | 
				json 
					at: #runCount put: self runCount;
					at: #successes put: self passedCount;
					at: #failures put: self failureCount;
					at: #errors put: self errorCount;
					at: #skips put: self skippedCount;
					at: #unexpectedPasses put: self unexpectedPassCount;
					at: #unexpectedFailures put: self unexpectedFailureCount;
					at: #unexpectedErrors put: self unexpectedErrorCount;
					at: #expectedPasses put: self expectedPassCount;
					at: #expectedDefects put: self expectedDefectCount;
					at: #notFound put: self notFoundClassNames;
					at: #notTestCaseClasses put: self notTestCaseClasses;
					at: #details
						put: (self testCases 
							collect: [ :each | each serializeToLlmJsonObject] 
							as: Array);
					yourself ]
%

category: 'gt - extensions'
method: GtLTestCasesWithResultStatuses
gtTestCasesFor: aView
	<gtView>
	<gtLlmView>
	testCases ifNil: [ ^ aView empty ].
	^ aView columnedList
		title: 'TestCases';
		items: [ self testCases ];
		column: 'Class'
			text: [ :eachTestCase | eachTestCase testCase class ]
			weight: 2;
		column: 'Method'
			text: [ :eachTestCase | eachTestCase testCase selector ]
			weight: 2;
		column: 'State' text: [ :eachTestCase | eachTestCase statusText ];
		column: 'Expected defect'
			text: [ :eachTestCase | 
				GtPhlowOverviewItem new
					boolean: eachTestCase isExpectedDefectResult;
					description ]
%

category: 'examples'
method: GtLFunctionToolExamples
additionToolCall
	"Execute a function tool call and verify result"
	<gtExample>
	| tool call result |
	tool := self additionTool.
	call := GtLFunctionToolCall new.
	call rawArguments: {
		'a' -> 3.
		'b' -> 5
	} asDictionary.
	
	result := tool performToolCall: call.
	
	self assert: call tool == tool.
	self assert: result targetObject object equals: 8.
	
	^ call
%

method: GtLFunctionToolExamples
additionToolDataViewSerialization
	"Verify the data view serialization of function tool result"
	<gtExample>
	| tool call result compositeView dataBlock jsonData objectValue |
	tool := self additionTool.
	call := GtLFunctionToolCall new.
	call rawArguments: {
		'a' -> 10.
		'b' -> 20
	} asDictionary.
	
	result := tool performToolCall: call.
	
	compositeView := result targetObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews isNotEmpty.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assert: dataBlock isNotNil.
	
	jsonData := dataBlock llmJsonData.
	objectValue := jsonData at: #objectValue.
	self assert: (objectValue at: 'objectClassName') equals: 'SmallInteger'.
	self assert: (objectValue at: 'objectPrintString') equals: '30'.
	
	^ dataBlock
%

