method: GtLPrimitiveCompositeJsonDataBlock
llmJsonData
	^self dataKey
		ifNil: [ self condensedJsonBlock llmJsonData] 
		ifNotNil: [
			Dictionary new 
				at: self dataKey put: self condensedJsonBlock llmJsonData;
				yourself]
%

method: GtLPrimitiveCompositeJsonDataBlock
