	^ self tasks
		ifEmpty: [
			GtNestedTreeNode new
				name: self name;
				leaves: {
					GtNestedTreeItemLeaf new 
					item: self;
					weight: [ :aTask | aTask durationInMilliseconds ] } ]
		ifNotEmpty: [ :theTasks |
			GtNestedTreeNode new 
				name: self name;
				nodes: (theTasks collect: [ :eachTask | eachTask gtNestedTree ] as: Array) ]
