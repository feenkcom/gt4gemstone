category: 'convenience'
method: GtLChat
saveToTimestampFile
	"Convenience method to save the chat to a timestamped file"
	| filename now |
	
	now := DateAndTime now.
	filename := (String streamContents: [ :stream |
		stream
			<< now asDate iso8601;
			<< '_';
			<< now asTime hhmmss24;
			<< '_chat.jsonl' ])
				asFileReference.
	GtLDataSourceEncoderDecoder
		saveClientHistory: provider client history
		to: filename.
	^ filename
%

