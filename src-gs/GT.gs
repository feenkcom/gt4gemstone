category: 'message performing'
method: GtLDataView
ensureContext

	(self buildContext notNil and: [ 
		 self buildContext hasContext ]) ifTrue: [ 
		^ self buildContext context ].

	^ GtPhlowContext new
%

method: GtLDataView
errorViewWithException: anException isFrozen: aBoolean
	^ self errorViewWithException: anException reason: nil isFrozen: aBoolean
%

method: GtLDataView
errorViewWithException: anException reason: anExceptionReason isFrozen: aBoolean
	| errorName frozenException |
	
	frozenException := aBoolean 
		ifTrue: [ anException ]
		ifFalse: [ GtSystemUtility freeze: anException ].
		
	errorName := self title isNotNil
		ifTrue: [ self title asString, ' (Error)' ] 
		ifFalse: [ 'Error' ].
		
	^ GtLDataViewWithError new
		title: errorName;
		exception: frozenException;
		errorReason: anExceptionReason
%

method: GtLDataView
on: anObject perform: aMessageSymbol
	<return: #GtLDataView>
	<gtCollector>
	
	^ self 
		on: anObject 
		perform: aMessageSymbol 
		withSomeArguments: { 
			  self.
			  self ensureContext }
%

method: GtLDataView
on: anObject perform: aMessageSymbol withArguments: aCollectionOfArguments
	<return: #GtLDataView>
	<gtCollector>
	
	^ [ 
			self 
				basicOn: anObject 
				perform: aMessageSymbol 
				withArguments: aCollectionOfArguments
	] 
		on: self class handledExceptions do: [ :anException |
			self 
				errorViewWithException: anException 
				reason: ('Error executing the view method {1} on the class {2}' 
					format: {
						aMessageSymbol.
						anObject class name })
				isFrozen: false ]
%

method: GtLDataView
on: anObject perform: aMessageSymbol withContext: aContext
	<return: #GtLDataView>
	<gtCollector>
	
	^ self 
		on: anObject 
		perform: aMessageSymbol 
		withSomeArguments: { self. aContext }
%

method: GtLDataView
on: anObject perform: aMessageSymbol withSomeArguments: aCollectionOfArguments
	<return: #GtLDataView>
	<gtCollector>
	| newCollectionOfArguments |
	
	aCollectionOfArguments size = aMessageSymbol numArgs ifTrue: [ 
		^ self 
			on: anObject 
			perform: aMessageSymbol 
			withArguments: aCollectionOfArguments ].
			
	newCollectionOfArguments := aCollectionOfArguments 
		copyFrom: 1 
		to: aMessageSymbol numArgs.
		
	^ self 
		on: anObject 
		perform: aMessageSymbol 
		withArguments: newCollectionOfArguments
%

method: GtLDataView
performComputation: aBlockClosure onErrorDataDo: anErrorBlock withReason: anErrorReason withBuilder: aBuilder
	^self 
		performComputation: aBlockClosure
		onErrorView: [ :anErrorView |
			^ anErrorBlock cull: ((anErrorView 
					errorReason: anErrorReason) 
						serializeToLlmPrimiteDataOn: aBuilder) ].
%

method: GtLDataView
performComputation: aBlockClosure onErrorView: anErrorBlock
	^aBlockClosure
		on: Error 
		do: [ :anError |
			^anErrorBlock value: (self 
				errorViewWithException: anError 
				reason: nil
				isFrozen: false) ].
%

