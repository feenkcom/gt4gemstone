	| fromEdgePairs |
	fromEdgePairs := self from edges
			collect: [ :anEdge | anEdge fromNode label -> anEdge toNode label ].
	^ self to edges
		reject: [ :anEdge | fromEdgePairs includes: anEdge fromNode label -> anEdge toNode label ]
