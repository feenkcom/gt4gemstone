category: 'private'
method: GtLMessageStyler
storedRegistryObjectForId: anIdString ifPresent: aPresentBlock ifAbsent: anAbsentBlock
	| string36 |
	anIdString ifNil: [ ^anAbsentBlock value ].
	objectRegistry ifNil: [ ^anAbsentBlock value ].
	string36 := (anIdString includes: $-)
				ifTrue: [(UUID fromString: anIdString) asString36]
				ifFalse: [anIdString].
	^objectRegistry
		storedObjectAt: string36
		ifPresent: aPresentBlock
		ifAbsent: anAbsentBlock
%

method: GtLMessageStyler
styleButton: anAnnotation for: object defaultLabel: aLabelBlock withTool: aBlock
	"Style the buttons for gtClass and gtMethod annotations"

	| attribute anId isValid |
	anId := LeTextSnippetAttributeLabelElementId indexed: self nextUniqueId.
	isValid := anAnnotation nameNode
		ifNil: [ true ]
		ifNotNil: [ :node | node isDefined ].

	attribute := GtButtonAttribute new
			beAppend;
			stencil: [ | button label |
				label := object
						ifNil: [ anAnnotation nameNode
								ifNil: [ '' ]
								ifNotNil: [ :name | (name value ifNil: [ name ]) source ] ]
						ifNotNil: [ :obj | 
							anAnnotation labelNode
								ifNil: [ aLabelBlock value: obj ]
								ifNotNil: [ :node | node labelFor: obj ] ].
				button := LeSnippetStylerVisitor
						textLinkButtonPadding: (BlInsets top: 2)
						margin: BlInsets empty
						valid: isValid.
				button aptitude glamorousCodeFont.
				button
					id: anId;
					beSmallSize;
					label: label;
					action: [ :aButton | aButton phlow spawnTool: (aBlock cull: aButton) ].

				button viewModel
					when: BlClickEvent
					do: [ :anEvent | 
						anEvent modifiers isPrimaryModifier
							ifTrue: [ | aTool aSpace |
								aTool := aBlock cull: button.
								aSpace := BlSpace new.
								aSpace title: self gtDisplayString.
								aSpace icon: aTool icon.
								aSpace extent: 1200 @ 600.
								aSpace root background: Color transparent.
								aSpace inPager: aTool.
								aSpace withSceneDriller.
								aSpace showFrom: button ] ].
				button viewModel
					when: BlMouseEnterEvent
					do: [ :anEvent | 
						anEvent consumed: true.
						anEvent modifiers isPrimaryModifier
							ifTrue: [ anEvent target mouseCursor: BlCopyCursor new ]
							ifFalse: [ anEvent target mouseCursor: nil ].
						anEvent target requestFocus ].
				button ].

	self text
		attribute: attribute
		from: anAnnotation parent startPosition
		to: anAnnotation parent stopPosition
%

category: 'private - tables'
method: GtLMessageStyler
tableElementFor: aTable
	"Use native headers with editors that materialize inline adornments.
	Column justification remains in the AST and is not applied here."

	| list |
	list := BrColumnedList new.
	list hMatchParent.
	list vFitContentLimited.
	aTable header cells
		withIndexDo: [ :cell :index | 
			list column
				title: (self tableCellTextFor: cell);
				weight: 1;
				stencil: [ :row | self tableEditorFor: (row cells at: index ifAbsent: [ nil ]) ] ].
	list items: aTable rows.
	list
		withHeadersDo: [ :header | 
			header
				labelStencil: [ :column | 
					BrEditor new
						id: #tableHeaderEditor;
						aptitude: BrGlamorousRegularEditorAptitude;
						beReadOnlyWithSelection;
						hMatchParent;
						vFitContentLimited;
						padding: (BlInsets top: 5 bottom: 5);
						text: column title;
						yourself ] ].
	^ list
%

category: 'styling'
method: GtLMessageStyler
styleAutoHiding: leftRange and: rightRange whenOutside: nodeInterval
	| anAttribute marker1 marker2 cursorAttribute |
	marker1 := BrTextInvisibleMarkerAttribute new.
	marker2 := BrTextInvisibleMarkerAttribute new.
	self text
		attribute: marker1
		from: leftRange first
		to: leftRange last.
	self text
		attribute: marker2
		from: rightRange first
		to: rightRange last.
	anAttribute := BrTextAdornmentDynamicAttribute new
			beReplace;
			stencil: [ :aTBrTextEditorTextualPiece :anEditorElement | #() ].
	self text
		attribute: anAttribute
		from: leftRange first
		to: leftRange last.
	self text
		attribute: anAttribute
		from: rightRange first
		to: rightRange last.
	cursorAttribute := BrTextCursorDynamicAttribute new
			enterAction: [ :aTextEditor | 
				| left right |
				aTextEditor text
					findAttribute: marker1
					indicesDo: [ :start :end | left := start ].
				aTextEditor text
					findAttribute: marker2
					indicesDo: [ :start :end | right := end ].
				(left notNil and: [ right notNil ])
					ifTrue: [ | cursorIndex |
						cursorIndex := aTextEditor cursors first position.
						(cursorIndex between: left - 2 and: right)
							ifTrue: [ aTextEditor text
									clearAttributes: left
									to: right
									if: [ :eachAttribute | eachAttribute == anAttribute ] ] ] ];
			leaveAction: [ :aTextEditor | 
				| left right |
				aTextEditor text
					findAttribute: marker1
					indicesDo: [ :start :end | left := start to: end ].
				aTextEditor text
					findAttribute: marker2
					indicesDo: [ :start :end | right := start to: end ].
				(left notNil and: [ right notNil ])
					ifTrue: [ aTextEditor text
							attributes: {anAttribute}
							from: left first
							to: left last.
						aTextEditor text
							attributes: {anAttribute}
							from: right first
							to: right last ] ].
	self text
		attribute: cursorAttribute
		from: nodeInterval first - 1
		to: nodeInterval last
%

category: 'tables'
method: GtLMessageStyler
styleTableCellText: aText ast: aCell
	"Style an already parsed cell, not a new document."
	text := aText.
	self accept: aCell.
	^ aText
%

method: GtLMessageStyler
tableCellTextFor: aCell
	"Reuse the grammar-produced AST without reparsing or altering the source
	tree. A fresh visitor preserves this message visitor's current text."
	| source cellText localCell tokens offset first last visitor |
	aCell ifNil: [ ^ '' asRopedText ].
	source := aCell contentSource.
	source trimBoth isEmpty ifTrue: [ ^ '' asRopedText ].
	cellText := source asRopedText.
	localCell := aCell copy.
	localCell parent: nil.
	localCell fixParentPointers.
	offset := aCell startPosition - 1.
	tokens := IdentitySet withAll: localCell allTokens.
	tokens do: [ :token | token startPosition: token startPosition - offset ].
	localCell withAllNodesDo: [ :node |
		node removeAttributeNamed: #startPosition; removeAttributeNamed: #stopPosition ].
	localCell completeSource: source.
	visitor := self class new objectRegistry: self objectRegistry; yourself.
	visitor styleTableCellText: cellText ast: localCell.
	first := 1.
	last := source size.
	[ (source at: first) isSeparator ] whileTrue: [ first := first + 1 ].
	[ (source at: last) isSeparator ] whileTrue: [ last := last - 1 ].
	^ cellText copyFrom: first to: last
%

method: GtLMessageStyler
tableEditorFor: aCell
	"An editor materializes annotation adornments and wraps long cell content.
	The preview is selectable but editing remains in the original Markdown."
	^ BrEditor new
		id: #tableCellEditor;
		aptitude: BrGlamorousRegularEditorAptitude;
		beReadOnlyWithSelection;
		hMatchParent;
		vFitContentLimited;
		padding: (BlInsets top: 5 bottom: 5);
		text: (self tableCellTextFor: aCell);
		yourself
%

method: GtLMessageStyler
tableLabelFor: aCell
	"Compatibility entry point; table cells now use editors."
	^ self tableEditorFor: aCell
%

category: 'visiting'
method: GtLMessageStyler
accept: anObject
	(anObject isKindOf: SmaCCParseNode) ifTrue: [ ^ self acceptNode: anObject ].
	(anObject isKindOf: Collection)
		ifTrue: [ anObject do: [ :each | self accept: each ] ].
	^ anObject
%

method: GtLMessageStyler
acceptNode: aSmaCCParseNode
	aSmaCCParseNode isNil
		ifTrue: [ ^ nil ].
	^ aSmaCCParseNode acceptVisitor: self
%

method: GtLMessageStyler
acceptNodes: aCollection
	aCollection do: [ :each | self acceptNode: each ].
	^ aCollection
%

method: GtLMessageStyler
visitObjectReferenceAnnotation: anObjectAnnotation
	| uuid storedObject object isValid aLinkColor adapter |
	uuid := anObjectAnnotation uuid.
	self 
		storedRegistryObjectForId: uuid 
		ifPresent: [ :aStoredObject |
			isValid := true. 
			storedObject := aStoredObject.
			object := aStoredObject storedValue ] 
		ifAbsent: [
			isValid := false. 
			storedObject := nil.
			object := nil ].
	
	aLinkColor := isValid
				ifTrue: [BrGlamorousColors textMarkupColor]
				ifFalse: [BrGlamorousColors linkWithErrorColor].
	(self text from: anObjectAnnotation parent startPosition
		to: anObjectAnnotation parent stopPosition) foreground: aLinkColor.
	uuid ifNotNil: [self styleAutoHidingAnnotation: anObjectAnnotation].
	adapter := LeObjectReferenceAnnotationAdapter
				annotation: anObjectAnnotation
				object: object.
	self styleButton: adapter withTool: [GtInspectorTool forObject: storedObject].
	isValid
		ifTrue: [self 
			styleExpandingObject: adapter 
			withDefault: LepiterConstants defaultShowSelector]
%

method: GtLMessageStyler
visitSmaCCError: aSmaCCError
	^ self visitSmaCCParseNode: aSmaCCError
%

method: GtLMessageStyler
visitSmaCCParseNode: aSmaCCParseNode
	self acceptNodes: aSmaCCParseNode sortedChildren.
	^ aSmaCCParseNode
%

method: GtLMessageStyler
visitTable: aTable
	"Keep editable Markdown and append a native columned-list preview.
	Style inline cell nodes only in the preview's local text coordinates."
	| sourceText |
	sourceText := text from: aTable startPosition to: aTable stopPosition.
	sourceText glamorousCodeFont.
	self styleAutoHiding: aTable sourceInterval text: sourceText.
	(text from: aTable stopPosition to: aTable stopPosition)
		attribute: (BrTextAdornmentDynamicAttribute new
			beAppend;
			stencil: [ self tableElementFor: aTable ]).
	^ aTable
%

category: 'generated'
classmethod: GtLMessageStyler
textLinkButtonPadding: additionalPadding margin: additionalMargin
	"Answer a button used for in-text links in Lepiter.
	This sets a common font, size, color and style for the button"

	^ self textLinkButtonPadding: additionalPadding margin: additionalMargin valid: true
%

classmethod: GtLMessageStyler
textLinkButtonPadding: additionalPadding margin: additionalMargin valid: isValid
	"Answer a button used for in-text links in Lepiter.
	This sets a common font, size, color and style for the button"
	| color button |

	button := BrButton new.
	button connector beVisualSource.

	color := isValid 
		ifTrue: [ BrGlamorousColors linkColor ]
		ifFalse: [ BrGlamorousColors linkWithErrorColor ].

	button 
		addAptitude: (BrGlamorousButtonLabelAptitude new 
			defaultColor: color;
			hoveredColor: color muchDarker);
		placeholderAlignment: #alignBottom;
		padding: (BlInsets top: 0 left: 0 bottom: -1 right: 0) + additionalPadding;
		margin: (BlInsets top: 0 left: 0 bottom: 0 right: 0) + additionalMargin;
		icon: BrGlamorousVectorIcons inspect;
		beNoneSize;
		layout: BlLinearLayout horizontal;
		constraintsDo: [ :c |
			c horizontal fitContent.
			c vertical fitContent. ].
	^ button
%

