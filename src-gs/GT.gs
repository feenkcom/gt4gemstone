category: 'executing'
method: GtLSmaCCCreateParser
createGrammar
	^ (GtSmaCCGrammar forDefinition: self definition)
		package: package;
		parserClassName: self parserClass;
		scannerClassName: self scannerClass;
		yourself
%

category: 'validation'
method: GtLSmaCCCreateParser
validateOnError: aBlock
	#(parserClass scannerClass package definition)
		do: [ :each | 
			(self perform: each) isEmptyOrNil
				ifTrue: [ ^ aBlock
						value: (GtLMissingArgumentDomainObject new
								arguments: nil;
								missingArgument: each) ] ].
	#(parserClass scannerClass)
		do: [ :each | 
			| name |
			name := self perform: each.
			((RBScanner isVariable: name) and: [ name first isUppercase ])
				ifFalse: [ ^ aBlock
						value: (GtLProblemDomainObject new description: each , ' is not a valid class name') ] ].
	[ SmaCCDefinitionParser
		parseStream: (SmaCCLineNumberStream on: self definition readStream) ]
		on: Error
		do: [ :ex | 
			^ aBlock
				value: (GtLProblemDomainObject new
						description: 'Invalid syntax in definition string near line: '
								, ex parser lineNumber printString , ', column: '
								, ex parser columnNumber printString) ]
%

category: 'examples'
method: GtLNotSourceSearchableMethodExamples
methodWithNotSearchableSourceObjectFromCompiledMethodClassSide
	<gtExample>
	| methodObject |
	methodObject := GtLNotSourceSearchableMethod
		fromCompiledMethod: (GtLMethodReference class>>#fromCompiledMethod:).

	self
		assert: methodObject methodName
		equals: #fromCompiledMethod:.
	self
		assert: methodObject methodClassName
		equals: #GtLMethodReference.
	self
		assert: methodObject isClassSide
		equals: true.
	self
		assert: methodObject methodClass
		equals: GtLMethodReference class.
	self
		assert: methodObject compiledMethod
		equals: (GtLMethodReference class>>#fromCompiledMethod:).
	self
		assert: methodObject sourceCode
		equals: '<not searchable method>'.

	^ methodObject
%

method: GtLNotSourceSearchableMethodExamples
methodWithNotSearchableSourceObjectFromCompiledMethodClassSideDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| domainObject compositeView dataBlock expected methodRefJson |
	domainObject := self methodWithNotSearchableSourceObjectFromCompiledMethodClassSide.
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	methodRefJson := NeoJSONObject new
		at: #methodName put: 'fromCompiledMethod:';
		at: #methodClassName put: 'GtLMethodReference';
		at: #classSide put: true;
		yourself.
	expected := Dictionary new
		at: #methodReference put: methodRefJson;
		at: #sourceCode put: '<not searchable method>';
		yourself.
	self assertDataBlock: dataBlock hasLlmJsonData: expected.
	
	^ dataBlock
%

