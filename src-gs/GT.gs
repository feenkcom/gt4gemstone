		and: [ Date today
				< (Date
						year: 2024
						month: 9
						day: 23) and: [ numberOfTokens < 2000000 ] ])
		ifTrue: [ ^ GtTCurrencyMoney new
				amount: 0;
				currency: GtTCurrency usd ].

	^ GtTCurrencyMoney new
		amount: numberOfTokens * self pricePerToken;
		currency: GtTCurrency usd
