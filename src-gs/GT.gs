method: GtLToolForClassViews
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| className targetClass pragmas |
	className := aToolCall arguments at: 'className'.
	targetClass :=  className
			asClassIfAbsent: [ ^ GtLMissingDomainObject new objectName: className ].

	pragmas := Pragma
			allNamed: #gtView
			from: targetClass
			toButExcluding: Object.

	^ GtLClassMethodsDomainObject new
		targetClass: targetClass;
		methods: (pragmas collect: [ :each | each method ])
%

category: 'accessing'
method: GtLOpenAIGenerateResponseAPICommand
buildEntity
	| entity input |
	input := OrderedCollection new.
	self messages
		messagesDo: [ :aMessage | 
			aMessage isToolMessage
				ifTrue: [ aMessage toolCall isFinished
						ifTrue: [ input add: aMessage toolCall responseInputForOpenAIResponsesAPI.
							input add: aMessage serializeForOpenAIResponsesAPI ] ]
				ifFalse: [ input add: aMessage serializeForOpenAIResponsesAPI ] ].
	entity := {'model' -> self model.
			'stream' -> isStreaming.
			'input' -> input} asDictionary.

	format
		ifNotNil: [ entity
				at: 'text'
				put: {'format'
							-> {'type' -> 'json_schema'.
									'name' -> 'JsonSchema'.
									'schema' -> format} asDictionary} asDictionary ].

	tools isEmptyOrNil
		ifFalse: [ entity
				at: 'tools'
				put: (self tools collect: [ :aTool | aTool functionOpenAI ]) ].

	instructions ifNotNil: [ entity at: 'instructions' put: instructions ].

	^ entity
%

