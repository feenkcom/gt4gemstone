category: '*GToolkit4Magritte-Core'
method: MADescription
announcerSubscriptionsDo: aBlock
	"Iterates over all subscriptions"

	self
		propertyAt: #announcerSubscriptions
		ifPresent: [ :aCollection | 
			aCollection do: aBlock ]
		ifAbsent: [ "ignore" ]
