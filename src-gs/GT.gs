category: 'api - message'
method: GtLChat
addAssistantMessage: aMessage
	"Add assistant message.
	Assistant messages are held in a reply message."

	| aReplyMessage |
	self updateLastUpdate.

	aMessage chat: self.
	aReplyMessage := self ensureReplyMessage.
	aReplyMessage finalMessage: aMessage
%

method: GtLChat
addCompactionMessage: aMessage
	"Add a compaction message.
	Compaction messages are held in a reply message."

	| aReplyMessage |
	self updateLastUpdate.

	aMessage chat: self.
	aReplyMessage := self ensureReplyMessage.
	aReplyMessage addCompactionMessage: aMessage.
	objectStorage purgeRedundantObjectsForChat: self.
%

method: GtLChat
addErrorMessage: anErrorMessage
	"Add error message.
	Error messages are held in a reply message."

	self updateLastUpdate.

	self
		lastReplyMessageDo: [ :aReplyMessage | 
			anErrorMessage chat: self.
			aReplyMessage finalMessage: anErrorMessage ]
		ifAbsent: [ self addMessage: anErrorMessage ]
%

method: GtLChat
addMessage: aMessage
	self assert: [ (messages includes: aMessage) not ].

	self updateLastUpdate.

	aMessage chat: self.
	messages add: aMessage.
	self notifyMessageAdded: aMessage
%

method: GtLChat
addToolMessage: aMessage
	"Add tool message.
	Tool messages are held in a reply message."

	| aReplyMessage |
	self updateLastUpdate.

	aMessage chat: self.
	aReplyMessage := self ensureReplyMessage.
	aReplyMessage addToolMessage: aMessage
%

method: GtLChat
addUserMessage: aMessage
	self addMessage: aMessage.
	self ensureReplyMessage.
%

method: GtLChat
allMessages
	^ Array
		streamContents: [ :aStream | self messages messagesDo: [ :eachMessage | aStream nextPut: eachMessage ] ]
%

method: GtLChat
currentMessage
	"Return a last message that should be used
	to receive a LLM server response."

	<return: #GtLChatMessage>
	| aMessage |
	aMessage := self messages last currentMessage.
	^ aMessage
%

method: GtLChat
ensureReplyMessage
	| aReplyMessage |
	
	messages
		reverseDo: [ :eachMessage | 
			eachMessage isReplyMessage ifTrue: [
				^ eachMessage ].

			eachMessage isUserMessage ifTrue: [ 
				aReplyMessage := GtLReplyMessage new
					summarizersRegistry: self summarizersRegistry copy;
					userMessage: eachMessage.
				self addMessage: aReplyMessage.
				^ aReplyMessage ] ].

	aReplyMessage := GtLReplyMessage new.
	aReplyMessage summarizersRegistry: self summarizersRegistry copy.
	self addMessage: aReplyMessage.
	
	^ aReplyMessage
%

method: GtLChat
firstMessage
	^ self messages
		ifNotNil: [ :aCollection | aCollection ifNotEmpty: #first ifEmpty: [ nil ] ]
		ifNil: [ nil ]
%

method: GtLChat
lastReplyMessageDo: aDoBlock ifAbsent: anAbsentBlock
	messages
		reverseDo: [ :eachMessage | 
			eachMessage isReplyMessage ifTrue: [
				^ aDoBlock value: eachMessage ].

			eachMessage isUserMessage ifTrue: [ 
				^ anAbsentBlock value ] ].

	^ anAbsentBlock value
%

method: GtLChat
messages
	^ messages
%

category: 'api - sending'
method: GtLChat
sendFiles: aCollectionOfFiles withMessage: aMessageContent
	| wrappedFiles |
	wrappedFiles := aCollectionOfFiles collect: [ :aFile |
		| mimeType wrapperClass |
		mimeType := ZnMimeType
			forFilenameExtension: aFile extension asLowercase
			ifAbsent: [ self error: 'Unsupported file type: ', aFile basename ].
		wrapperClass := mimeType main = 'image'
			ifTrue: [ GtLImageFile ]
			ifFalse: [
				(mimeType matches: ZnMimeType applicationPdf)
					ifTrue: [ GtLPdfFile ]
					ifFalse: [
						mimeType isBinary
							ifTrue: [ self error: 'Unsupported file type: ', aFile basename ]
							ifFalse: [ GtLTextFile ] ] ].
		wrapperClass fileReference: aFile ].
	self sendWith: [ :message |
		message
			markdown: aMessageContent;
			addWrappedObjects: wrappedFiles ]
%

