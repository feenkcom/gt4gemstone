method: GtLChatSessionWriterExamples
idleWithoutNewRequestsWritesNothing
	"An idle announcement after the immediate startup write does not duplicate history."

	<gtExample>
	<return: #GtLChatSessionWriter>
	| writer contents |
	writer := self writerForChat.
	contents := writer file contents.
	writer chat signalExecutionStateChanged.
	self assert: writer file contents equals: contents.
	^ writer
%

method: GtLChatSessionWriterExamples
nonIdleStateWritesNothing
	"Non-idle attachment and announcements do not write history."

	<gtExample>
	| writer |
	{GtLProviderState scheduled.
		GtLProviderState running.
		GtLProviderState stopping}
		do: [ :aState | 
			| chat file |
			chat := self chatWithTwoRequests.
			chat provider privateExecutionState: aState.
			file := self memoryFile.
			writer := GtLChatSessionWriter forChat: chat file: file.
			[ chat signalExecutionStateChanged.
			self assert: file exists not.
			self assert: writer lastRequestResponse isNil ]
				ensure: [ writer unsubscribe ] ].
	^ writer
%

method: GtLChatSessionWriterExamples
partialEncodingDoesNotTouchFile
	<gtExample>
	| writer encoder before failed |
	writer := self writerForChat.
	writer unsubscribe.
	before := writer file binaryContents.
	self addRequestText: 'three' to: writer chat.
	encoder := GtLChatSessionWriterExampleEncoder new.
	encoder
		beforeEncode: [ :record :stream | 
			stream nextPutAll: '{incomplete'.
			Error signal: 'Injected partial encoding failure' ].
	writer instVarNamed: 'encoder' put: encoder.
	failed := false.
	[ writer writeLatest ]
		on: Error
		do: [ :error | 
			self assert: error messageText equals: 'Injected partial encoding failure'.
			failed := true ].
	self assert: failed.
	self assert: writer file binaryContents equals: before.
	encoder beforeEncode: nil.
	writer writeLatest.
	self assert: (self requestTextsIn: writer file) equals: #('one' 'two' 'three').
	^ writer
%

method: GtLChatSessionWriterExamples
partialWriteRollback
	<gtExample>
	^ self
		retryAfter: #write
		on: self memoryFile
		withExistingRecord: true
%

method: GtLChatSessionWriterExamples
reconstructionWithAutomaticSessionWriter
	"Replaying a file must not write historical messages or duplicate writers."

	<gtExample>
	| previous source file chat writer output original result |
	previous := GtLChat startSessionWriter.
	[ GtLChat startSessionWriter: false.
	source := self chatWithTwoRequests.
	source provider client history
		do: [ :record | 
			record request
				entity: (ZnStringEntity
						json: (record request entity contents
								copyReplaceAll: '{"model"'
								with: '{"tools":[],"model"')).
			record result: record response asGtJson jsonObject ].
	file := self memoryFile.
	file
		writeStreamDo: [ :stream | 
			GtLDataSourceEncoderDecoder
				saveClientHistory: source provider client history
				toStream: stream ].
	original := file contents.
	GtLChat startSessionWriter: true.
	chat := GtLChat new provider: GtLOpenAiResponsesProvider new.
	self assert: chat sessionWriters size equals: 1.
	writer := chat sessionWriters anyOne.
	output := FileSystem memory root / 'continued.jsonl'.
	writer file: output.
	result := GtLDataSourceEncoderDecoder recreateChatFrom: file chat: chat.
	self assert: result == chat.
	self assert: chat messages isEmpty not.
	self assert: chat sessionWriters size equals: 1.
	self assert: chat sessionWriters anyOne == writer.
	self assert: file contents equals: original.
	self assert: output exists not.
	chat signalExecutionStateChanged.
	self assert: output exists not.
	self addRequestText: 'continued' to: chat.
	chat signalExecutionStateChanged.
	self assert: (self requestTextsIn: output) equals: #('continued').
	self assert: file contents equals: original ]
		ensure: [ chat ifNotNil: [ chat stopAllSessionWriters ].
			GtLChat startSessionWriter: previous ].
	^ chat
%

method: GtLChatSessionWriterExamples
rollbackFailureDisablesWriter
	<gtExample>
	| writer chat before failure |
	chat := self chatWithTwoRequests.
	writer := GtLChatSessionWriterExampleWriter forChat: chat file: self memoryFile.
	writer unsubscribe.
	self addRequestText: 'three' to: chat.
	before := writer lastRequestResponse.
	writer failureMode: #rollback.
	[ writer writeLatest ]
		on: GtLChatSessionWriterRecoveryError
		do: [ :error | failure := error ].
	self assert: failure notNil.
	self assert: failure writeError messageText equals: 'Injected write failure'.
	self
		assert: failure rollbackError messageText
		equals: 'Injected rollback failure'.
	self assert: writer lastRequestResponse == before.
	before := writer file binaryContents.
	writer failureMode: nil.
	[ writer writeLatest.
	self error: 'Expected disabled writer' ]
		on: GtLChatSessionWriterRecoveryError
		do: [ :error | self assert: error == failure ].
	self assert: writer file binaryContents equals: before.
	^ writer
%

method: GtLChatSessionWriterExamples
unsubscribedWriterWritesNothing
	<gtExample>
	| writer contents |
	writer := self writerForChat.
	contents := writer file contents.
	writer unsubscribe.
	self addRequestText: 'three' to: writer chat.
	writer chat signalExecutionStateChanged.
	self assert: writer file contents equals: contents.
	^ writer
%

method: GtLChatSessionWriterExamples
writerForChat
	"Attaching to an idle chat immediately writes its existing history."

	<gtExample>
	<return: #GtLChatSessionWriter>
	| chat file writer |
	chat := self chatWithTwoRequests.
	file := self memoryFile.
	writer := GtLChatSessionWriter forChat: chat file: file.
	self assert: writer chat == chat.
	self assert: writer file equals: file.
	self assert: file exists.
	self assert: (self requestTextsIn: file) equals: #('one' 'two').
	self assert: writer lastRequestResponse == chat provider client history last.
	^ writer
%

category: 'examples - setup'
method: GtLChatSessionWriterExamples
chatWithTwoRequests
	<gtExample>
	<return: #GtLChat>
	| chat |
	chat := GtLChat new provider: GtLOpenAiResponsesProvider new.
	self addRequestText: 'one' to: chat.
	self addRequestText: 'two' to: chat.
	self assert: chat provider client history size equals: 2.
	self
		assert: (chat state
				ifCanStop: [ false ]
				ifStopping: [ false ]
				ifIdle: [ true ]).
	^ chat
%

method: GtLChatSessionWriterExamples
memoryFile
	<gtExample>
	<return: #FileReference>
	| file |
	file := FileSystem memory / 'session_chat.jsonl'.
	self assert: file exists not.
	^ file
%

category: 'private'
method: GtLChatSessionWriterExamples
addRequestText: aString to: aGtLChat
	"Add a request / response pair to the chat's client history, simulating a completed LLM call"

	| request response |
	request := ZnRequest post: 'https://api.openai.com/v1/responses'.
	request
		entity: (ZnStringEntity
				json: '{"model":"gpt-4.1","input":[{"role":"user","content":[{"type":"input_text","text":"'
						, aString , '"}]}]}').
	response := ZnResponse
			ok: (ZnStringEntity
					json: '{"output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Reply to '
							, aString , '"}]}]}').
	^ aGtLChat provider client history addRequest: request response: response
%

method: GtLChatSessionWriterExamples
requestTextsIn: aFileReference
	"Answer the user input text of each request recorded in aFileReference"

	^ (GtLDataSourceEncoderDecoder loadClientHistoryFrom: aFileReference)
		collect: [ :each | 
			(((STONJSON fromString: each request contents) at: 'input') first at: 'content')
				first at: 'text' ]
		as: Array
%

method: GtLChatSessionWriterExamples
retryAfter: failureMode on: file withExistingRecord: hasRecord
	| chat writer first second before failed |
	chat := GtLChat new provider: GtLOpenAiResponsesProvider new.
	writer := GtLChatSessionWriterExampleWriter forChat: chat file: file.
	writer unsubscribe.
	hasRecord
		ifTrue: [ first := self addRequestText: 'café ýžřč' to: chat.
			writer writeLatest ].
	before := file exists ifTrue: [ file binaryContents ] ifFalse: [ #[] ].
	second := self addRequestText: 'string ščřž é' to: chat.
	writer failureMode: failureMode.
	failed := false.
	[ writer writeLatest ]
		on: Error
		do: [ :error | 
			self assert: error messageText equals: 'Injected ' , failureMode , ' failure'.
			failed := true ].
	self assert: failed.
	self assert: file binaryContents equals: before.
	self assert: writer lastRequestResponse == first.
	writer failureMode: nil.
	writer writeLatest.
	self assert: writer lastRequestResponse == second.
	self
		assert: (self requestTextsIn: file)
		equals: (hasRecord ifTrue: [ #('café ýžřč' 'string ščřž é') ] ifFalse: [ #('string ščřž é') ]).
	writer writeLatest.
	self
		assert: (self requestTextsIn: file) size
		equals: (hasRecord ifTrue: [ 2 ] ifFalse: [ 1 ]).
	^ writer
%

category: '*GToolkit-Extensions'
method: GtExampleGroup
buildListViewFor: aView
	| aListView |
	aListView := aView columnedList
			title: 'Examples List';
			priority: 11;
			items: [ self examples sorted: GtMethodsSortFunction new ];
			column: '' translated
				do: [ :aColumn | 
					aColumn
						width: 24;
						cellStencil: [ BlElement new
								size: 14 @ 14;
								padding: (BlInsets top: 3 bottom: 3);
								margin: (BlInsets top: 3 bottom: 3);
								addAptitude: (GtPhlowLabelTooltipAptitude2 text: 'Click to run example');
								when: BlClickEvent
									do: [ :anEvent | 
										anEvent currentTarget userData
											at: #example
											ifPresent: [ :anExample | 
												anEvent consumed: true.
												[ anExample run.
												anEvent currentTarget phlow
													selectObject: anExample result returnValue ] asAsyncPromise ]
											ifAbsent: [  "do nothing" ] ] ];
						dataBinder: [ :aLabel :anExample :aRowIndex :aRowHolder :aCellIndex | 
							| aHandler |
							aLabel userData
								at: #exampleAnnouncementHandler_buildListViewFor_Status
								ifPresent: [ :anOldHandler | 
									aLabel userData
										at: #example
										ifPresent: [ :anOldExample | anOldExample announcer unsubscribe: anOldHandler ]
										ifAbsent: [  "do nothing" ] ]
								ifAbsent: [  "do nothing" ].

							aHandler := GtExampleColorHandler new element: aLabel.
							aLabel userData
								at: #exampleAnnouncementHandler_buildListViewFor_Status
								put: aHandler.

							anExample announcer weak
								when: GtExampleExecuted
								send: #onAnnouncement:
								to: aHandler.

							aLabel background: anExample color.
							aLabel userData at: #example put: anExample ] ];
			column: 'Class' translated
				text: [ :eachExample :anIndex | eachExample example classLabel ];
			column: 'Selector' translated
				text: [ :eachExample :anIndex | eachExample example selector asString ];
			column: 'Result' translated
				do: [ :aColumn | 
					aColumn
						cellStencil: [ BrLabel new
								aptitude: BrGlamorousListLabelAptitude;
								addAptitude: (GtPhlowLabelTooltipAptitude2 text: 'Click to display result details');
								fitContent;
								when: BlClickEvent
									do: [ :anEvent | 
										anEvent currentTarget userData
											at: #example
											ifPresent: [ :anExample | 
												anExample hasResult
													ifTrue: [ | aResult |
														aResult := anExample result returnValue.
														(aResult isKindOf: BlElement) ifTrue: [ aResult removeFromParent ].
														anEvent currentTarget phlow spawnObject: aResult.
														anEvent consumed: true ] ]
											ifAbsent: [  "do nothing" ] ] ];
						dataBinder: [ :aLabel :anExample :aRowIndex :aRowHolder :aCellIndex | 
							| aHandler |
							aLabel userData
								at: #exampleAnnouncementHandler_buildListViewFor_Result
								ifPresent: [ :anOldHandler | 
									aLabel userData
										at: #example
										ifPresent: [ :anOldExample | anOldExample announcer unsubscribe: anOldHandler ]
										ifAbsent: [  "do nothing" ] ]
								ifAbsent: [  "do nothing" ].

							aHandler := GtExampleLabelTextHandler new element: aLabel.
							aLabel userData
								at: #exampleAnnouncementHandler_buildListViewFor_Result
								put: aHandler.

							anExample announcer weak
								when: GtExampleExecuted
								send: #onAnnouncement:
								to: aHandler.

							aLabel text: anExample resultOrErrorName asRopedText.
							aLabel userData at: #example put: anExample ] ].
	^ aListView
%

method: GtExampleGroup
gtExamplesFor: aView context: aPhlowContext
	<gtView>
	| anExampleViewModel |
	anExampleViewModel := GtPharoCoderUIUtility
			exampleViewModelCachedAs: #exampleViewModelHandler_gtExamplesForContext
			inPhlowContext: aPhlowContext.

	anExampleViewModel pharoExampleSuite stream: self examples asAsyncStream.

	^ aView explicit
		title: 'List';
		priority: 11;
		actionStencil: [ :aBrTab | 
			GtPharoCoderUIUtility newExamplesDropdownButtonForViewModel: anExampleViewModel ];
		actionUpdateButtonTooltip: 'Update example list';
		stencil: [ | aContainer aButtonsContainer aListView |
			aContainer := BlElement new
					layout: BlLinearLayout vertical;
					constraintsDo: [ :c | 
						c padding: (BlInsets all: 3).
						c horizontal matchParent.
						c vertical matchParent ].
			aButtonsContainer := BlElement new
					layout: (BlLinearLayout horizontal cellSpacing: 3);
					constraintsDo: [ :c | 
						c padding: (BlInsets all: 3).
						c horizontal fitContent.
						c vertical fitContent.
						c linear horizontal alignCenter ].
			aContainer addChild: aButtonsContainer.
			aListView := self buildListViewFor: aView.
			aListView
				asElementDo: [ :anElement | 
					| aBuilder anUpdater |
					aBuilder := [ self
							buildButtonsContainer: aButtonsContainer
							listWidget: anElement ].
					anUpdater := BrElementUpdater new
							element: anElement;
							action: (MessageSend receiver: aBuilder selector: #value).

					anElement userData
						at: #exampleAnnouncementHandler_gtExamplesFor
						put: anUpdater.

					self announcer weak
						when: GtExamplesExecuted , GtExampleExecuted
						send: #requestUpdate
						to: anUpdater.
					aContainer addChild: anElement.
					self buildButtonsContainer: aButtonsContainer listWidget: anElement ].
			aContainer ]
%

method: GtExampleGroup
gtExpandableExamplesFor: aView context: aPhlowContext
	<gtView>
	| anExampleViewModel |
	anExampleViewModel := GtPharoCoderUIUtility
			exampleViewModelCachedAs: #exampleViewModelHandler_gtExamplesForContext
			inPhlowContext: aPhlowContext.

	anExampleViewModel pharoExampleSuite stream: self examples asAsyncStream.

