method: GtLACPCodexStoredSession
createdAtRecord
	| selected |
	selected := nil.
	self rolloutRecords
		do: [ :record | record createdAt ifNotNil: [ selected := record ] ].
	^ selected
%

method: GtLACPCodexStoredSession
