method: GtLACPToolCall
withMcpToolCallIfPresent: aPresentBlock ifAbsent: anAbsentBlock
	^ (self mcpToolMessageIn: GtLACPSession mcpServer)
		ifNotNil: aPresentBlock
		ifNil: anAbsentBlock
%

