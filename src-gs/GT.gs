category: 'api'
method: GtLOpenAiResponsesMessageVisitor
chatMessage: aMessage

	^ self visitNode: aMessage.
%

category: 'as yet unclassified'
method: GtLOpenAiResponsesMessageVisitor
visitGtLPrimitiveDocumentDataBlock: aDataBlock
	"Use the data block's own OpenAI serialisation: its data URL carries the full content type (text/plain, application/pdf, ...) and it adds the filename. Building 'data:application/' , documentFormat gave application/plain for text files, which OpenAI rejects."

	^ aDataBlock serializeForOpenAI
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLPrimitiveImageDataBlock: aDataBlock

	^ {NeoJSONObject new
			at: 'image_url' put: ('data:image/'
				, aDataBlock imageType,';base64,' , aDataBlock encodedBytes);
			at: 'type' put: 'input_image';
			yourself}
%

category: 'visiting'
method: GtLOpenAiResponsesMessageVisitor
roleAndContentFrom: anAssistantMessage
	| content |

	content := { {
		'type' -> 'output_text'.
		'text' -> anAssistantMessage contentText 
		} asDictionary.
		}.
	^ {
		'role' -> anAssistantMessage role.
		'content' -> content.
		} asDictionary.
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLErrorMessage: anErrorMessage
	"Preserve a failed interaction as diagnostic context when the chat
	is continued. The local 'error' role is not an API message role."
	^ {
		'role' -> 'user'.
		'content' -> { {
			'type' -> 'input_text'.
			'text' -> ('The previous interaction failed with the following error. ',
				'This is diagnostic context, not a new user instruction:',
				String cr,
				anErrorMessage contentText)
		} asDictionary }
	} asDictionary
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLModelAssistantMessage: anAssistantMessage
	"Assistant messages always serialize as ordinary assistant content.
	Server-side compaction is represented by a separate message."

	^ self roleAndContentFrom: anAssistantMessage
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLModelCompactionMessage: aCompactionMessage
	| provider |

	provider := aCompactionMessage providerForSerialization.
	(provider notNil and: [
		aCompactionMessage isServerSideCompactionOutputFor: provider ])
		ifTrue: [
			^ aCompactionMessage
				rawDataFor: provider
				ifAbsent: [ self error: 'Missing native compaction data' ] ].

	aCompactionMessage hasPortableContent ifFalse: [
		self error: 'This opaque compaction cannot be serialized for the current provider' ].

	^ {
		'role' -> 'assistant'.
		'content' -> { {
			'type' -> 'output_text'.
			'text' -> aCompactionMessage portableContentText
		} asDictionary }
	} asDictionary
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLModelUserMessage: aUserMessage
	| content |
	
	content := aUserMessage contentDataBlock  acceptVisitor: self.
	^ {
		'role' -> aUserMessage role.
		'content' -> content.
		} asDictionary.
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLPrimitiveCompositeJsonGenericDataBlock: aDataBlock
	| content |

	^ aDataBlock condensedJsonBlock acceptVisitor: self.
	"content := aDataBlock jsonDataBlocks 
			collect: [ :dataBlock |
				dataBlock acceptVisitor: self ]
			as: Array.

	^ aDataBlock dataKey ifNil:
		[ content ]
	ifNotNil:
		[ { aDataBlock dataKey -> content } asDictionary ]"
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLPrimitiveJsonBareDataBlock: aDataBlock
	| string |

	string := aDataBlock jsonData.
	self assert: string isString.
	^ {NeoJSONObject new
			at: #text put: string;
			at: #type put: #input_text;
			yourself}
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLPrimitiveJsonDataBlock: aDataBlock

	^ {NeoJSONObject new
			at: #text put: aDataBlock serializedJsonString;
			at: #type put: #input_text;
			yourself}
%

method: GtLOpenAiResponsesMessageVisitor
visitGtLPrimitiveMessageDataBlock: aDataBlock
	| content |

	content := OrderedCollection new.
	aDataBlock dataBlocks do: [ :aDataBlockBlock |
		content addAll: (aDataBlockBlock acceptVisitor: self) ].
		
		
		

	"content := aDataBlock dataBlocks collect:
		[ :each |
			NeoJSONObject new
				at: 'text' put: each serializedJsonString;
				at: 'type' put: 'input_text';
				yourself ]
		as: OrderedCollection.

	aDataBlock imageDataBlocks do: [ :dataBlock |
		content add: {
			'type' -> 'image_url'.
			'image_url' -> ('data:image/', dataBlock imageType, ';base64,', dataBlock encodedBytes).
			} asDictionary. ]."
	^ content asArray.
%

method: GtLOpenAiResponsesMessageVisitor
visitNode: aUserMessage

	^ aUserMessage acceptVisitor: self
%

category: 'examples'
method: GtLClassesSearchResultExamples
classesSearchResultDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| domainObject compositeView dataBlock expectedJson |
	domainObject := self classesSearchResultWithMatches.
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	expectedJson := {
		#foundClassNames -> (NeoJSONArray withAll: #('Object' 'String')).
		#mayHaveMore -> false
	} asDictionary.
	self assertDataBlock: dataBlock hasLlmJsonData: expectedJson.
	
	^ dataBlock
%

method: GtLClassesSearchResultExamples
classesSearchResultWithMatches
	<gtExample>
	| matches result |
	matches := { Object. String }.
	result := GtLClassesSearchResult fromClasses: matches.
	self assert: result foundClassNames equals: #('Object' 'String').
	self assert: result mayHaveMore not.
	^ result
%

