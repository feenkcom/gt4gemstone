category: 'initialization'
method: GtLSerializedObjectValue
initializeFromObject: anObject
	"Initialize from an object by extracting class info, views, and slots.
	The GemStone variant prints through a PrintStream limited to 50000 characters."

		"Capture a headless object snapshot, including named instance variables."
	| slotNames |
	objectClassName := anObject class name asString.
	superclassName := anObject class superclass ifNil: [ '' ] ifNotNil: [ :aClass | aClass name asString ].
	packageName := anObject class category asString.
	objectPrintString := [ self class printStringOf: anObject limitedTo: 50000 ] on: Error do: [ :error | 'Error printing object' ].
	phlowViews := #().
	slotNames := anObject class allInstVarNames.
	allInstanceSlots := (1 to: slotNames size) collect: [ :index |
		| slotValue |
		slotValue := [ anObject instVarAt: index ] on: Error do: [ :error | nil ].
		GtLSerializedSlotInfo new
			name: (slotNames at: index) asString;
			valueClassName: slotValue class name asString;
			valuePrintString: ([ ((slotValue isKindOf: CharacterCollection) or: [ slotValue isKindOf: Character ])
					ifTrue: [ slotValue asString ]
					ifFalse: [ self class printStringOf: slotValue limitedTo: 50000 ] ]
				on: Error do: [ :error | 'Error converting to string' ]);
			yourself ].
%

category: 'printing'
classmethod: GtLSerializedObjectValue
printStringOf: anObject limitedTo: limit
	"Print an object's description within limit characters."

		| aStream printed |
	aStream := PrintStream printingOn: String new maxSize: limit + 1.
	anObject printOn: aStream.
	printed := aStream contents.
	printed size <= limit ifTrue: [ ^ printed ].
	^ (printed copyFrom: 1 to: limit - 4) , '[..]'
%

category: 'examples'
method: GtLMagritteToolForMethodsCompilationExamples
compileInstanceSideMethodsWithExistingSources
		<gtExample>
	| call targetClass selectorOne selectorTwo sourceBeforeOne sourceBeforeTwo |
	targetClass := GtLMagritteToolForMethodsCompilationExamples.
	selectorOne := #gtMagritteCompiledExampleExistingOne.
	selectorTwo := #gtMagritteCompiledExampleExistingTwo.
	sourceBeforeOne := 'gtMagritteCompiledExampleExistingOne ^ 10'.
	sourceBeforeTwo := 'gtMagritteCompiledExampleExistingTwo ^ 20'.
	targetClass compileMethod: sourceBeforeOne category: 'examples' environmentId: 0.
	targetClass compileMethod: sourceBeforeTwo category: 'examples' environmentId: 0.
	[
		call := self
			executeTool: GtLMagritteToolForMethodsCompilation new
			withArguments: {
				'methods' -> {
					{
						'methodClassName' -> 'GtLMagritteToolForMethodsCompilationExamples'.
						'sourceCode' -> 'gtMagritteCompiledExampleExistingOne ^ 11'.
						'protocol' -> 'examples'.
						'classSide' -> false
					} asDictionary.
					{
						'methodClassName' -> 'GtLMagritteToolForMethodsCompilationExamples'.
						'sourceCode' -> 'gtMagritteCompiledExampleExistingTwo ^ 21'.
						'protocol' -> 'examples'.
						'classSide' -> false
					} asDictionary
				}
			} asDictionary.
		self assert: (call result targetObject isKindOf: GtLMethodsCompilationResult).
		self assert: call result targetObject methods size equals: 2.
		self assert: call result targetObject methods first oldMethod sourceCode equals: sourceBeforeOne.
		self assert: call result targetObject methods second oldMethod sourceCode equals: sourceBeforeTwo.
		self assert: call result targetObject methods first newMethod sourceCode equals: 'gtMagritteCompiledExampleExistingOne ^ 11'.
		self assert: call result targetObject methods second newMethod sourceCode equals: 'gtMagritteCompiledExampleExistingTwo ^ 21'
	] ensure: [
		(targetClass includesSelector: selectorOne)
			ifTrue: [ targetClass removeSelector: selectorOne ].
		(targetClass includesSelector: selectorTwo)
			ifTrue: [ targetClass removeSelector: selectorTwo ] ].
