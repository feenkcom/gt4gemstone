	^ aView explicit
		title: 'Markdown';
		priority: 5;
		stencil: [ | text |
			text := GtLMessageStyler new
					objectRegistry: aPhlowContext objectRegistry;
					privateStyle: self text asRopedText.
			BrEditor new
				id: #'acp-final-text';
				aptitude: BrGlamorousRegularEditorAptitude;
				beReadOnlyWithSelection;
				hMatchParent;
				vFitContentLimited;
				text: text;
				yourself ]
