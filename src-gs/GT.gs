	messageViewModel ifNil: [ ^ self ].
	messageViewModel contents: aBlText asString source: self
%

method: GtLNewMessageElement
updateContentsElement
	contentsElement
		text: messageViewModel contents;
		styler: messageViewModel styler.

	completer strategy: self messageViewModel completionStrategy
%

method: GtLNewMessageElement
updateElement
	self updateContentsElement.
	self updateImagesElement.
	self updateStopButton.
	self updateSendButton.
	self updateConnectionsButton
%

method: GtLNewMessageElement
updateImagesElement
	imagesElement removeChildren.

	self messageViewModel files
		do: [ :aFile | 
			imagesElement
				addChild: (BrDeletableFileWidget new
						vExact: 100;
						hExact: 100;
						isDeletable: true;
						file: aFile;
						onDeletion: [ :aFileForDeletion | 
							self threadMessageViewModel files remove: aFileForDeletion.
							self updateImagesElement ]) ]
%

method: GtLNewMessageElement
updateSendButton
	self messageViewModel ifNil: [ ^ self ].
	self messageViewModel chat ifNil: [ ^ self ].
	self messageViewModel chat state
		ifCanStop: [ sendButton
				disable;
				visibility: BlVisibility gone ]
		ifStopping: [ sendButton
				disable;
				visibility: BlVisibility gone ]
		ifIdle: [ sendButton
				enable;
				visibility: BlVisibility visible ]
%

method: GtLNewMessageElement
updateSendMessageError: anError
	| maxIndex |
	maxIndex := 0.
	toolbarElement items
		do: [ :eachElement | 
			((eachElement isKindOf: GtLExceptionElement) and: [ eachElement id isIndexed ])
				ifTrue: [ maxIndex := maxIndex max: eachElement id index ] ].

	toolbarElement
		addItem: (GtLExceptionElement new
				id: (#'chat--new-exception' asBlocElementId indexed: maxIndex + 1);
				freeze: anError;
				closeAction: [ :anExceptionElement | toolbarElement removeItem: anExceptionElement ];
				hFitContentLimited;
				vFitContent)
%

method: GtLNewMessageElement
updateStopButton
	self messageViewModel ifNil: [ ^ self ].
	self messageViewModel chat ifNil: [ ^ self ].
	self messageViewModel chat state
		ifCanStop: [ stopButton
				visibility: BlVisibility visible;
				enable ]
		ifStopping: [ stopButton
				visibility: BlVisibility visible;
				disable ]
		ifIdle: [ stopButton
				visibility: BlVisibility gone;
				disable ]
%

