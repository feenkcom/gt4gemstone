category: 'management'
classmethod: GtLOllamaMigrationExamples
embeddingsSourceFrom: anArray selector: aSymbol
	"Generate the source code that will recreate the supplied array of embeddings.
	Store the required data as an array:
	{ embeddings input. embeddings embeddings. queryEmbeddings input. queryEmbeddings embeddings. }.
	embeddings and queryEmbeddings are both instances of GtLModelEmbeddings."
	| embeddings queryEmbeddings |

	embeddings := anArray first.
	queryEmbeddings := anArray second.
	
	^ String streamContents: [ :stream |
		stream
			<< aSymbol; lf;
			lf;
			tab; << '^ '.
		stream nextPutAll: {
			embeddings input.
			embeddings rawData at: 'embeddings'.
			queryEmbeddings input.
			queryEmbeddings rawData at: 'embeddings'.
			} storeString. ].
%

category: '*GToolkit-Extensions'
method: BlDevScripterAssertionFailure
gtInspectScripterFor: anAction
	<gtAction>
	self scripter ifNil: [ ^ anAction empty ].
	^ anAction button
		icon: BrGlamorousVectorIcons inspect;
		label: 'Scripter';
		tooltip: 'Inspect Scripter';
		priority: 100;
		action: [ :aButton | aButton phlow spawnObject: self scripter ]
%

method: BlDevScripterAssertionFailure
gtLiveFor: aView
	<gtView>
	^ (super gtLiveFor: aView)
		priority: 2
%

method: BlDevScripterAssertionFailure
gtMessageTextFor: aView
	<gtView>
	self exception ifNil: [ ^ aView empty ].
	^ aView forward
		title: 'Message';
		priority: 1;
		object: [ self exception ];
		view: #gtMessageTextFor:
