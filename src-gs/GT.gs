method: GtLOpenAiResponsesExamples
openAiResponsesMarkdownChat
	"Check operation of the Ollama endpoint using a fake client"
	<gtExample>
	| executor provider chat |

	executor := GtLOpenAiResponsesExampleExecutor new.
	executor loadExpectedHistoryFrom: self openAiResponsesMarkdownChatHistory.
	provider := executor provider.
	provider modelName: 'gpt-5.4'.
	chat := executor chat.
	chat markdownResponse.

	chat sendMarkdown: 'Hi, who are you?'.
	executor waitTimeoutSeconds: 60.
	executor assertChatResponseOK: chat.
	executor assertResponseResponsesMarkdownContent: chat messages last.
	self compareIfKnownShapes: chat messages
		with: executor expectedHistory
		in: chat
		selector: #openAiResponsesMarkdownChatHistory.

	^ chat
%

method: GtLOpenAiResponsesExamples
openAiServerSideCompaction
	"Have a conversation with ChatGPT with server-side compaction."
	<gtExample>
	"noTest as compaction messages are currently incorrectly grouped before the final assistant message."
	"<noTest>"
	| executor provider chat message entity |

	executor := GtLOpenAiResponsesExampleExecutor new.
	executor loadExpectedHistoryFrom: self openAiServerSideCompactionHistory.
	provider := executor provider.
	provider compactionStrategy: ((GtLOpenAiServerSideCompactionStrategy forProvider: provider)
		thresholdTokensLimit: 5000).
	chat := executor chat.
	chat 
		markdownResponse;
		tools: GtLTools gt;
		sendMarkdown: 'Use tools and give me a description of the class BlElement'.
	executor waitTimeoutSeconds: 120.

	chat tools removeAll.
	chat sendMarkdown: 'Based on the information already obtained, and not using any additional tools, what is the superclass of {{gtClass:BlElement}}?'.
	executor waitTimeoutSeconds: 120.
	self assert: chat messages size equals: 4.
	executor assertChatResponseOK: chat.

	message := chat messages at: 1.
	entity := NeoJSONReader fromString:message requestResponse request contents.
	self assert: ((entity at: 'context_management') first at: 'compact_threshold') equals: 5000.

	message := (chat messages at: 2) finalMessage.
	self assert: message isAssistantRole.
	self assert: (provider assistantMessageHasCompactionResponse: message).

	message := (chat messages at: 4) finalMessage.
	self assert: message isAssistantRole.
	self deny: (provider assistantMessageHasCompactionResponse: message).
	self assert: (message contentText includesSubstring: 'Object').

	self compareIfKnownShapes: chat messages 
		with: executor expectedHistory
		in: chat
		selector: #openAiServerSideCompactionHistory.

	^ chat.
%

method: GtLOpenAiResponsesExamples
openAiServerSideMultipleCompaction
	"Have a conversation with ChatGPT with server-side compaction.
	Note that the response is gibberish since the token limit is much too small for the requested task, however it does have tool calls with compaction responses."
	<gtExample>
	| executor provider chat message |

	executor := GtLOpenAiResponsesExampleExecutor new.
	executor loadExpectedHistoryFrom: self openAiServerSideMultipleCompactionHistory.
	provider := executor provider.
	provider compactionStrategy: ((GtLOpenAiServerSideCompactionStrategy forProvider: provider)
		thresholdTokensLimit: 5000).
	chat := executor chat.
	chat 
		markdownResponse;
		tools: GtLTools gt;
		sendMarkdown: 'Please look at https://github.com/feenkcom/gtoolkit/issues/5139 and propose a fix.'.
	executor waitTimeoutSeconds: 120.

	message := (chat messages at: 2) finalMessage.
	self assert: message isAssistantRole.
	self assert: (provider assistantMessageHasCompactionResponse: message).

	self compareIfKnownShapes: chat messages 
		with: executor expectedHistory
		in: chat
		selector: #openAiServerSideMultipleCompactionHistory.

	^ chat.
%

category: 'examples - compaction'
method: GtLOpenAiResponsesExamples
assistantMessageIgnoresAutomaticCompactionResponse
	<gtExample>
	| provider input result assistant compactionMessages |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	result := GtLModelResponse from: {
		'output' -> {
			{
				'type' -> 'compaction'.
				'encrypted_content' -> 'automatic' } asDictionary.
			{ 'type' -> 'message' } asDictionary }
	} asDictionary.

	assistant := provider
		responseTypeForResult: result
		fromInputMessage: input.
	compactionMessages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.

	self deny: assistant hasCompactionResponse.
	self assert: compactionMessages size equals: 1.
	self assert: compactionMessages first hasCompactionResponse.

	^ assistant
%

method: GtLOpenAiResponsesExamples
automaticCompactionMessagesFromResponse
	<gtExample>
	| provider input result firstOutput secondOutput messages |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	firstOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'first'
	} asDictionary.
	secondOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'second'
	} asDictionary.
	result := GtLModelResponse from: {
		'output' -> {
			firstOutput.
			{ 'type' -> 'message' } asDictionary.
			secondOutput }
	} asDictionary.

	messages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.

	self assert: messages size equals: 2.
	self assert: messages first rawData == firstOutput.
	self assert: messages second rawData == secondOutput.
	self
		assert: (messages first providerDataFor: provider ifAbsent: [ nil ])
		== firstOutput.
	self
		assert: (messages second providerDataFor: provider ifAbsent: [ nil ])
		== secondOutput.
	self assert: messages first requestResponse == result requestResponse.
	self assert: messages second requestResponse == result requestResponse.

	^ messages
%

method: GtLOpenAiResponsesExamples
automaticCompactionMessagesPartitionedAroundAssistantMessage
	<gtExample>
	| provider input result firstOutput secondOutput messages partition |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	firstOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'first'
	} asDictionary.
	secondOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'second'
	} asDictionary.
	result := GtLModelResponse from: {
		'output' -> {
			firstOutput.
			{ 'type' -> 'message' } asDictionary.
			secondOutput }
	} asDictionary.

	messages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.
	partition := provider
		partitionAutomaticCompactionMessages: messages
		from: result
