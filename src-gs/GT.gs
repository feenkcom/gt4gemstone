category: 'api'
method: GtLDataSourceOpenAiCompletionsResponseParser
parseResponse: requestResponse message: message for: aMessageConstructor
	| jsonResponse responseEntity response |

	jsonResponse := requestResponse response asGtJson jsonObject.
	responseEntity := GtLOllamaCompletionsResponseEntity rawData: jsonResponse.
	response := (GtLModelResponse 
		from: requestResponse result
		model: model)
			requestResponse: requestResponse.
	response hasToolCalls ifTrue:
		[ self parseToolResponse: requestResponse to: message response: response for: aMessageConstructor
		"See GtLModelProvider>>#performToolCallsIn:with:" ]
	ifFalse:
		[ self parseAssistantResponse: requestResponse to: message response: response for: aMessageConstructor ].
%

category: 'private'
method: GtLDataSourceOpenAiCompletionsResponseParser
parseAssistantResponse: requestResponse to: request response: response for: aMessageConstructor
	| newMessage chat |
	
	chat := aMessageConstructor chat.
	newMessage := chat provider assistantMessageClass new.
	newMessage
		requestResponse: requestResponse;
		rawData: requestResponse result.
	chat addAssistantMessage: newMessage.
	^ newMessage
%

method: GtLDataSourceOpenAiCompletionsResponseParser
parseToolResponse: requestResponse to: request response: response for: aMessageConstructor
	| toolMessages chat |

	chat := aMessageConstructor chat.
	toolMessages := response toolCalls asArray
			withIndexCollect: [ :aToolCall :anIndex | 
				| toolMessage |
				toolMessage := GtLToolMessage new 
					toolCall: aToolCall;
					tools: request tools;
					requestResponse: (GtLToolPreviousRequestResponse new
						previousRequestResponse: response requestResponse;
						toolCallIndex: anIndex) ].
	toolMessages do: [ :toolMessage |
		chat addToolMessage: toolMessage ].
	chat messages last tools: request tools.
%

