method: GtLLepiterContentExporter
export
	stream := WriteStream on: ''.
	level := 0.
	toExport do: [ :each | 
		[ self visit: each ]
			on: Error
			do: [ :ex |
				strictMode ifTrue:
					[ ex pass ]
				ifFalse:
					[ self errorPages add: each -> ex freeze ] ] ].
	^ stream contents
%

