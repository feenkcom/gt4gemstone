category: 'accessing'
method: GtBPEDemoMergeProxy
gtBeforeAndAfterFor: aView
	<gtView>
	^ aView explicit
		title: 'Before and after';
		priority: 1;
		stencil: [ BrHorizontalPane new matchParent
				addChild: (GtLlmTokenizedStringEditor new
						decorationBlock: [ :aNameLabel :aNumberLabel :aToken :anIndex | 
							(self replacedIndices includes: anIndex)
								ifTrue: [ aNameLabel background: BrGlamorousColors newsBackgroundColor.
									aNumberLabel background: BrGlamorousColors newsBackgroundColor ] ];
						result: self before_text;
						background: Color white;
						addAptitude: BrShadowAptitude;
						padding: (BlInsets all: 5));
				addChild: (GtLlmTokenizedStringEditor new
						decorationBlock: [ :aNameLabel :aNumberLabel :aToken :anIndex | 
							aToken number = self number
								ifTrue: [ aNameLabel background: BrGlamorousColors newsBackgroundColor.
									aNumberLabel background: BrGlamorousColors newsBackgroundColor ] ];
						result: self after_text;
						padding: (BlInsets all: 5)) ]
%

method: GtBPEDemoMergeProxy
replacedIndices
	"we return the indices of both parts of the replaced pair. Python is 0-indexed, Pharo 1-indexed, so we need to increment the numbers"
	^ self performed_merges
		flatCollect: [ :aTuple | 
			{aTuple first + 1.
				aTuple first + 2} ]
%

category: 'accessing'
classmethod: GtBPEDemoMergeProxy
pythonClass
	^ 'gtoolkit_bridge.PythonBridge.python_bridge.BPEMerge'
%

category: 'accessing'
method: GtLStringDiff
fromString
	^ fromString
%

method: GtLStringDiff
fromString: aString
	fromString := aString
%

method: GtLStringDiff
toString
	^ toString
%

method: GtLStringDiff
toString: aString
	toString := aString
%

category: 'computing'
method: GtLStringDiff
differences
	^ GtDiffBuilder
		computeDifferencesFrom: self fromString
		to: self toString
		using: GtCharacterGroupDiffSplitter words ignoreWhitespace
%

category: 'gt-views'
method: GtLStringDiff
gtDiffFor: aView
	<gtView>
	<gtLlmView>
	^ (aView forward)
		title: 'Diff';
		priority: 2;
		object: [ self differences ];
		view: #gtTextView:
%

category: 'magritte'
method: GtLStringDiff
fromStringDescription
	<magritteDescription>

	^ MAStringDescription new
		label: 'From';
		accessor: #fromString;
		beRequired
%

