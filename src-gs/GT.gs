idle: aChild
 self update: { 'sessionUpdate' -> 'subagent_update'. 'sessionId' -> aChild remoteSessionId.
  'state' -> { 'state' -> 'idle'. 'stopReason' -> 'end_turn' } asDictionary } asDictionary
  for: aChild parentSubagent parentSession
%

method: GtLACPSubagentExamples
reply: aString in: aSession
 self update: { 'sessionUpdate' -> 'agent_message_chunk'.
  'content' -> { 'type' -> 'text'. 'text' -> aString } asDictionary } asDictionary for: aSession
%

method: GtLACPSubagentExamples
task: text from: parent to: child id: anId
 self update: { 'sessionUpdate' -> 'session_message'. 'messageId' -> anId.
  'senderSessionId' -> parent remoteSessionId. 'recipientSessionId' -> child remoteSessionId.
  'recipientMessageId' -> (anId, '-incoming').
  'content' -> { { 'type' -> 'text'. 'text' -> text } asDictionary } } asDictionary for: parent.
 self update: { 'sessionUpdate' -> 'session_message'. 'messageId' -> (anId, '-incoming').
  'senderSessionId' -> parent remoteSessionId. 'recipientSessionId' -> child remoteSessionId.
  'senderMessageId' -> anId.
  'content' -> { { 'type' -> 'text'. 'text' -> text } asDictionary } } asDictionary for: child
%

method: GtLACPSubagentExamples
update: update for: aSession
 aSession connection transport receive: {
  'jsonrpc' -> '2.0'. 'method' -> 'session/update'.
  'params' -> { 'sessionId' -> aSession remoteSessionId. 'update' -> update } asDictionary } asDictionary
%

category: 'updating'
method: GtLACPSubagentExamples
expandedAgentRefreshIsLocal
	<gtExample>
	| scripter root child nested hash nestedHash parentRow childElement nestedElement siblingHeader siblingHash |
	scripter := self runningAgentsChat.
	root := scripter model.
	child := root childSessions first.
	nested := child childSessions first.
	hash := child currentTurn identityHash asString.
	nestedHash := nested currentTurn identityHash asString.
	siblingHash := root childSessions second currentTurn identityHash asString.
	scripter click
		id: ('acp-agent-toggle-' , hash) asSymbol;
		play.
	scripter click
		id: ('acp-agent-work-toggle-' , hash) asSymbol;
		play.
	scripter click
		id: ('acp-agent-toggle-' , nestedHash) asSymbol;
		play.
	scripter click
		id: ('acp-agent-work-toggle-' , nestedHash) asSymbol;
		play.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-message-2';
				satisfies: [ :row | 
					parentRow := row.
					true ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-section-' , hash) asSymbol;
				satisfies: [ :agent | 
					childElement := agent messageElement.
					childElement class = GtLACPAssistantMessageElement
						and: [ childElement parent == (agent childNamed: #content) ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-section-' , nestedHash) asSymbol;
				satisfies: [ :agent | 
					nestedElement := agent messageElement.
					nestedElement class = GtLACPAssistantMessageElement
						and: [ nestedElement parent == (agent childNamed: #content) ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-header-' , siblingHash) asSymbol;
				satisfies: [ :header | 
					siblingHeader := header.
					true ] ].
	scripter
		doStep: [ :step | 
			step
				label: 'Stream only into the nested worker';
				block: [ self
						update: {'sessionUpdate' -> 'agent_thought_chunk'.
								'content'
									-> {'type' -> 'text'.
											'text' -> 'A new nested observation.'} asDictionary} asDictionary
						for: nested ] ].
	scripter pulseUntilReady.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-message-2';
				satisfies: [ :row | row == parentRow ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-section-' , hash) asSymbol;
				satisfies: [ :agent | agent messageElement == childElement ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-section-' , nestedHash) asSymbol;
				satisfies: [ :agent | agent messageElement == nestedElement ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-header-' , siblingHash) asSymbol;
				satisfies: [ :header | header == siblingHeader ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-work-content-' , nestedHash) asSymbol;
				satisfies: [ :pane | 
					(GtLACPSessionExamples new editorsIn: pane)
						anySatisfy: [ :editor | editor text asString = 'A new nested observation.' ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-header-' , hash) asSymbol;
				notExists ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-header-' , nestedHash) asSymbol;
				notExists ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

