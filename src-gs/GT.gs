	^ self messages
		ifNotNil: [ :aCollection | aCollection ifNotEmpty: #first ifEmpty: [ nil ] ]
		ifNil: [ nil ]
%

method: GtLChat
lastReplyMessageDo: aDoBlock ifAbsent: anAbsentBlock
	messages
		reverseDo: [ :eachMessage | 
			eachMessage isReplyMessage ifTrue: [
				^ aDoBlock value: eachMessage ].

			eachMessage isUserMessage ifTrue: [ 
				^ anAbsentBlock value ] ].

	^ anAbsentBlock value
%

