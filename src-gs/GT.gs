method: GtLModelExamplesExecutor
initialize

	super initialize.
	semaphore := Semaphore new.
%

category: 'private'
method: GtLModelExamplesExecutor
signalSemaphoreOnFinished: aStateChange

	aStateChange state
		ifCanStop: [] 
		ifStopping: [] 
		ifIdle: [ semaphore signal ].
%

category: 'testing'
method: GtLModelExamplesExecutor
isLive
	"Return true if an example should be execute against a real OpenAI server.
	Return false, if a stub client should be used."

	^ isLive ifNil: [ self class isLive ]
%

category: 'accessing'
classmethod: GtLModelExamplesExecutor
isLive
	"Return true if an example should be execute against a real OpenAI server.
	Return false, if a stub client should be used."

	^ self
		gtDo: [ IsLive ifNil: [ IsLive := false ] ]
		gemstoneDo: [ SessionTemps current at: #GtLModelExamplesExecutor_IsLive ifAbsent: [ false ] ]
%

classmethod: GtLModelExamplesExecutor
isLive: anObject
	self
		gtDo: [ IsLive := anObject ]
		gemstoneDo: [ SessionTemps current at: #GtLModelExamplesExecutor_IsLive put: anObject ]
%

classmethod: GtLModelExamplesExecutor
isSynchronous
	^ self
		gtDo: [ IsSynchronous ]
		gemstoneDo: [ SessionTemps current
				at: #GtLModelExamplesExecutor_IsSynchronous
				ifAbsent: [  ] ]
%

classmethod: GtLModelExamplesExecutor
isSynchronous: anObject
	self
		gtDo: [ IsSynchronous := anObject ]
		gemstoneDo: [ SessionTemps current at: #GtLModelExamplesExecutor_IsSynchronous put: anObject ]
%

category: 'assertions'
method: GtLDomainObjectExamples
assertDataBlock: aDataBlock hasLlmJsonData: expectedJsonData
	"Assert that aDataBlock llmJsonData equals expectedJsonData."
	self assert: aDataBlock llmJsonData equals: expectedJsonData
%

method: GtLDomainObjectExamples
assertDataBlockHasOnlyJsonData: dataBlock
	"Assert that the data block is valid and contains only JSON data (no images or secondary blocks)"
	self assert: dataBlock isNotNil.
	self assert: dataBlock class equals: GtLPrimitiveMessageDataBlock.
	self assert: dataBlock imageDataBlocks isEmpty.
	self assert: dataBlock documentDataBlocks isEmpty.
	self assert: dataBlock secondaryDataBlocks isEmpty.
	self assert: dataBlock dataBlocks size equals: 1.
	self assert: dataBlock dataBlocks first == dataBlock compositeJsonDataBlock
%

method: GtLDomainObjectExamples
assertJsonData: jsonData hasExpectedKeys: expectedKeys
	self assert: jsonData keys sorted equals: expectedKeys sorted
%

category: 'assertions - composite views'
method: GtLDomainObjectExamples
assertCompositeDataView: aDataView hasTitle: aTitle dataKey: aDataKey viewsCount: aCount
	"Assert that the data view is a composite view with the expected title, data key and number of contained views"
	self assert: aDataView class equals: GtLCompositeDataView.
	self assert: aDataView title equals: aTitle.
	self assert: aDataView dataKey equals: aDataKey.
	self assert: aDataView dataViews size equals: aCount
%

method: GtLDomainObjectExamples
assertCompositeDataView: aDataView hasTitle: aTitle viewsCount: aCount
	"Assert that the data view is a composite view with the expected title, nil data key and number of contained views"
	self assertCompositeDataView: aDataView hasTitle: aTitle dataKey: nil viewsCount: aCount
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasEmptyDataViewWithDataKey: aDataKey
	"Assert that there is an empty view in the given composite with the given dataKey."
	
	self assert: (aCompositeView dataViews  
		anySatisfy: [:aView |
			aView class = GtLEmptyDataView and: [
				aView dataKey = aDataKey]])
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasInnerCompositeWithViewCount: anInteger
	"Assert that aCompositeView is a composite containing another composite with the given number of views."
	| innerComposite |
	self assert: aCompositeView isNotNil.
	self assert: aCompositeView class equals: GtLCompositeDataView.
	self assert: aCompositeView dataViews size equals: 1.
	
	innerComposite := aCompositeView dataViews first.
	self assert: innerComposite class equals: GtLCompositeDataView.
	self assert: innerComposite dataViews size equals: anInteger.
	
	^ innerComposite
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasJsonDataViewWithDataKey: aDataKey
	"Assert that there is a view in the given composite that is a json view with the given dataKey."
	
	self assert: (aCompositeView dataViews  
		anySatisfy: [:aView |
			aView class = GtLJsonDataView and: [
				aView dataKey = aDataKey]])
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasJsonDataViewsWithDataKeys: anArray
	"Assert that the composite view contains JSON data views with the given data keys."
	self assert: aCompositeView dataViews size equals: anArray size.
	
	aCompositeView dataViews do: [ :each |
		self assert: each class equals: GtLJsonDataView ]. 
	self 
		assert: (aCompositeView dataViews 
			collect: [ :each  | each dataKey ])  asSet
		equals: anArray asSet.
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasJsonForwardDataViewWithDataKey: aDataKey targetObject: anObject
	"Assert that there is a view in the given composite that is a forward view with the given dataKey."
	
	self assert: (aCompositeView dataViews  
		anySatisfy: [:aView |
			aView class = GtLForwardObjectDataView and: [
				aView dataKey = aDataKey and: [
					aView targetObject = anObject ]]])
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasMagritteDataViewWithDataKey: aDataKey
	"Assert that there is a view in the given composite that is a magritte view with the given dataKey."
	
	self assert: (aCompositeView dataViews  
		anySatisfy: [:aView |
			aView class = GtLMagritteDataView and: [
				aView dataKey = aDataKey]])
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasSingleJsonDataViewWithDataKey: aDataKey
	"Assert that aCompositeView is a GtLCompositeDataView with exactly one GtLJsonDataView having the given dataKey."
	self assert: aCompositeView isNotNil.
	self assert: aCompositeView class equals: GtLCompositeDataView.
	self assert: aCompositeView dataViews size equals: 1.
	self assert: aCompositeView isWithArraySerialization not.
	self assert: aCompositeView dataViews first class equals: GtLJsonDataView.
	self assert: aCompositeView dataViews first dataKey equals: aDataKey
%

method: GtLDomainObjectExamples
assertCompositeView: aCompositeView hasSingleMagritteDataViewWithDataKey: aDataKey
	"Assert that aCompositeView is a GtLCompositeDataView with exactly one GtLMagritteDataView having the given dataKey."
	self assert: aCompositeView isNotNil.
	self assert: aCompositeView class equals: GtLCompositeDataView.
	self assert: aCompositeView dataViews size equals: 1.
	self assert: aCompositeView dataViews first class equals: GtLMagritteDataView.
	self assert: aCompositeView dataViews first dataKey equals: aDataKey
