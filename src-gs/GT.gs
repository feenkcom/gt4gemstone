method: GtLMessagesGroup
messagesSelect: aBlock
	| all |
	all := self species new.
	self messagesDo: [ :eachMessage | 
		(aBlock value: eachMessage) ifTrue: [ all add: eachMessage ] ].
	^ all
%

method: GtLMessagesGroup
messagesWithAndAfter: aMessage
