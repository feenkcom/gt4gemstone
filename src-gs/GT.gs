method: GtLOllamaCompletionsMessageVisitor
chatMessage: aMessage
	| content role |

	content := self visitNode: aMessage.
	role := aMessage isCompactionMessage
		ifTrue: [ 'assistant' ]
		ifFalse: [ aMessage role ].
	^ {
		'role' -> role.
		'content' -> content
	} asDictionary
