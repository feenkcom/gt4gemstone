method: GtMagritteAddItemViewModel
onClick: anElement
	| aNewItem anExistingItems aNewItems |
	self memento ifNil: [ ^ self ].
	self description ifNil: [ ^ self ].
	self stencil ifNil: [ ^ self ].

	aNewItem := self stencil create.	
	
