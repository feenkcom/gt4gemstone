method: GtPhlowChatToolElement
buildPlaygroundPageElement
	| playgroundElement |
	playgroundElement := (GtInspector environment
		at: GtInspector embeddedPlaygroundName) new.
	playgroundElement collapse.
	^ playgroundElement
%

method: GtPhlowChatToolElement
buildToolLabel
	^ BrLabel new
		aptitude: (BrGlamorousLabelAptitude new glamorousRegularFontAndSize
			foreground: Color gray;
			fontSize: 12);
		text: 'Chat'
%

method: GtPhlowChatToolElement
buildViewsContainerElement
	^ BrFrame new
		matchParent
%

method: GtPhlowChatToolElement
collectToolViews
	| collectedViews |
	collectedViews := Array
		streamContents: [ :aStream |

			self gtInspectorTargetModels do: [ :eachTargetModel |
				aStream nextPutAll: (GtPhlowViewsCollector new
					fromObject: eachTargetModel;
					pragmaNames: GtLSettings messageViewPragmaNames;
					context: (GtPhlowContext new 
							objectRegistry: self chat objectStorage);
					collect) ] ].

	GtPhlowUtility sortByPriority: collectedViews.

	^ collectedViews
%

method: GtPhlowChatToolElement
gtInspectorTargetModels
	^ {self chat}, self chat gtInspectorTargetModels
%

method: GtPhlowChatToolElement
playgroundElement
	^ self childNamed: #playgroundPage
%

method: GtPhlowChatToolElement
updateContainedViews
	| compositeView tabGroup |
	self chat
		ifNil: [ self viewsContainerElement removeChildren.
			^ self ].
	compositeView := GtPhlowCompositeView new views: self collectToolViews.
	tabGroup := compositeView asElementDo: [ :element | element ].
	GtLPhlowSummarizersChangedListener
		installOnCompositeElement: tabGroup
		forRegistry: self chat summarizersRegistry.
	self viewsContainerElement
		removeChildren;
		addChild: tabGroup
%

method: GtPhlowChatToolElement
updatePlayground
	self chat ifNil: [ ^ self ].
	self playgroundElement
		objectHolder: (GtInspectorObject new
			object: self chat)
%

method: GtPhlowChatToolElement
viewsContainerElement
	^ self childNamed: #viewsContainer
%

