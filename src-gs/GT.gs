category: 'accessing'
method: GtLMagritteToolForClassLookup
description
	^ 'Get the details of a class as JSON.

Arguments:
- className: string

Return values:
- currentClassName: class name string
- superclassName: superclass name string or nil
- comment: class comment
- packageName: package name
- instanceSlotNames: array of instance slot names
- classSlotNames: array of class slot names
- allInstanceMethodNames: array of selectors
- allClassMethodNames: array of selectors

Example JSON arguments:
{
  "className": "Collection"
}

Example JSON response:
{
  "currentClassName": "Collection",
  "superclassName": "SequenceableCollection",
  "comment": "...",
  "packageName": "Collections-Sequenceable",
  "instanceSlotNames": ["array"],
  "classSlotNames": [],
  "allInstanceMethodNames": ["at:", "size"],
  "allClassMethodNames": ["withAll:"]
}'
%

method: GtLMagritteToolForClassLookup
name
	^ 'lookupClass'
%

category: 'magritte'
method: GtLMagritteToolForClassLookup
classNameDescription
	<magritteDescription>
	^ MAStringDescription new
		label: 'Class name';
		accessor: #className;
		beRequired
%

category: 'private'
method: GtLMagritteToolForClassLookup
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments className class |
	arguments := aToolCall arguments.
	
	className := arguments at: 'className'.
	class := className
		asClassIfAbsent: [ ^ GtLMissingDomainObject new objectName: className ].

	^ GtLClassDescription fromClass: class
%

category: 'examples'
method: GtLForwardToForwardViewExamples
forwardToChainOfForwarders
	<gtExample>
	"Test forwarding through a chain of three forwarders to reach a JSON view."
	| forwarder3 forwardDataView |
	forwarder3 := self chainOfThreeForwarders.
	
	forwardDataView := GtLForwardObjectDataView new
		object: [ forwarder3 ];
		view: #gtLlmForwardViewFor:.
	
	self assert: forwardDataView targetObject equals: forwarder3.
	
	"The forward view should resolve through all forwarders to the final JSON view"
	self 
		assertCompositeView: forwardDataView targetDataView 
		hasSingleJsonDataViewWithDataKey: #jsonContent.
	
	^ forwardDataView
%

