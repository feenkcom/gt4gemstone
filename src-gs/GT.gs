method: GtLMcpClientExamples
callToolResultPreservesStructuredContent
	<gtExample>
	| client expected result |
	client := self simpleClientWithTransport.
	expected := {
		'content' -> {{'type' -> 'text'. 'text' -> 'ok'} asDictionary}.
		'structuredContent' -> {
			'answer' -> 42.
			'nested' -> {'value' -> true} asDictionary
		} asDictionary.
		'isError' -> false
	} asDictionary.
	client transport
		addMessage: {'result' -> expected} asDictionary.

	result := client
		callToolResult: 'example'
		withArguments: {'value' -> 1} asDictionary.

	self assert: result equals: expected.

	^ result
%

method: GtLMcpClientExamples
llmFunctionToolPreservesInputSchemaAndCompleteResult
	<gtExample>
	| client schema definition tools tool expected call result |
	client := self simpleClientWithTransport.
	schema := {
		'type' -> 'object'.
		'properties' -> {
			'request' -> {
				'type' -> 'object'.
				'properties' -> {
					'service_id' -> {'type' -> 'string'} asDictionary
				} asDictionary.
				'required' -> #('service_id')
			} asDictionary
		} asDictionary.
		'required' -> #('request')
	} asDictionary.
	definition := {
		'name' -> 'get_service_dependencies'.
		'description' -> 'Return dependencies for a service.'.
		'inputSchema' -> schema
	} asDictionary.

	client transport addMessage:
		{'result' -> {'tools' -> {definition}} asDictionary} asDictionary.

	tools := client llmFunctionTools.
	self assert: tools size equals: 1.
	tool := tools first.

	self assert: tool class equals: GtLMcpFunctionTool.
	self assert: tool parametersJsonSchemaDictionary equals: schema.
	self assert: (tool functionOpenAI at: 'parameters') equals: schema.

	expected := {
		'content' -> {{'type' -> 'text'. 'text' -> 'fallback'} asDictionary}.
		'structuredContent' -> {
			'outcome' -> 'ANSWERED'.
			'claims' -> #()
		} asDictionary.
		'isError' -> false
	} asDictionary.
	client transport addMessage:
		{'result' -> expected} asDictionary.

	call := GtLFunctionToolCall new
		name: tool name;
		arguments: {
			'request' -> {'service_id' -> 'service:order-service'} asDictionary
		} asDictionary;
		yourself.

	result := tool performToolCall: call.

	self assert: result model class equals: GtLPlainJson.
	self assert: result model jsonValue equals: expected.

	^ result
%

category: 'accessing'
classmethod: ZnResourceMetaUtils
querySafeSet
	"See RFC 3986 section 3.4. The safe set for the query part consists of
	the basic safe set #rfc3986SafeSet plus the 'sub-delimiters' !$&''()*+,;=
	plus : and @ plus / and ?"

	^ 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~!$&''()*+,;=:@/?'
%

classmethod: ZnResourceMetaUtils
rfc3986SafeSet
	"Return the unreserved characters according to RFC 3986 section 2.3.
	This is the most narrow safe set to be used in a better safe than sorry approach."

	^ ZnPercentEncoder rfc3986UnreservedCharacters
%

classmethod: ZnResourceMetaUtils
urlPathSafeSet
	"See RFC 3986 section 3.3. The safe set for the path consists of
	the basic safe set #rfc3986SafeSet plus the 'sub-delimiters' !$&''()*+,;= plus : and @"

	^ 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~!$&''()*+,;=:@'
%

category: 'converting'
classmethod: ZnResourceMetaUtils
decodePercent: string
	^ ZnPercentEncoder new
		decodePlusAsSpace: false;
		decode: string
%

classmethod: ZnResourceMetaUtils
decodePercentForQuery: string
	^ ZnPercentEncoder new
		decodePlusAsSpace: true;
		decode: string
%

classmethod: ZnResourceMetaUtils
encodePercent: string safeSet: safeSet encoder: encoder
	^ ZnPercentEncoder new
		characterEncoder: encoder;
		safeSet: (self perform: safeSet);
		encode: string
%

classmethod: ZnResourceMetaUtils
parseQueryFrom: stream
	| string index fields |
	fields := ZnMultiValueDictionary new.
	[ stream atEnd ] whileFalse: [
		string := stream upTo: $&.
		index := string indexOf: $=.
		index > 0
			ifFalse: [ fields at: (self decodePercentForQuery: string) put: nil ]
			ifTrue: [
				fields
					at: (self decodePercentForQuery: (string copyFrom: 1 to: index - 1))
					add: (self decodePercentForQuery: (string copyFrom: index + 1 to: string size)) ] ].
	^ fields
%

classmethod: ZnResourceMetaUtils
writeQueryFields: dictionary on: stream
	self writeQueryFields: dictionary withEncoder: ZnCharacterEncoder utf8 on: stream
%

classmethod: ZnResourceMetaUtils
writeQueryFields: dictionary withEncoder: encoder on: stream
	| first |
	first := true.
	dictionary keysAndValuesDo: [ :key :value |
		first ifFalse: [ stream nextPut: $& ].
		first := false.
		stream nextPutAll: (self encodePercent: key safeSet: #queryKeyValueSafeSet encoder: encoder).
		value ifNotNil: [
			stream
				nextPut: $=;
				nextPutAll: (self encodePercent: value safeSet: #queryKeyValueSafeSet encoder: encoder) ] ]
%

