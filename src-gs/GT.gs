	lastRequestResponse := nil.
	self subscribe.
	"A writer can be attached during chat initialization, before a provider exists."
	chat provider ifNotNil: [ :provider | 
		provider state
				ifCanStop: [  ]
				ifStopping: [  ]
				ifIdle: [ self writeLatest ] ].
