category: 'accessing'
method: GtLToolForExampleMethodRun
description
	^ 'Execute a gtExample method. It returns:
- status: Succeess, Error, Failure, Skipped.
- and the result:
  1. if it succeeds: 
    - the resulting object as one or more JSON or image entries, each representing a view of the resulting object. Look at all of them to interpret the result.
    - the object id that you can use as reference for other tool calls.
    - the playgroundPageReference to the contextual playground page. Use that page to look for object specific snippets and explanations.
  2. if there is an exception, it gets the errorDetails (errorMessage, stackTrace, errorClass). It can also get other JSON or image entries each representing a view of the exception. Look at all of them to interpret the result.'
%

method: GtLToolForExampleMethodRun
name
	^ 'exampleMethodRun'
%

category: 'execution'
method: GtLToolForExampleMethodRun
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments exampleReference |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	exampleReference := arguments at: 'exampleReference'.
	
	^ exampleReference 
		compiledMethodIfPresent: [ :aMethod | 
			self 
				runExample: aMethod 
				fromReference: exampleReference 
				inContext: anExecutionContext 
				toolCall: aToolCall ]
		ifMissing: [ :anErrorResult | anErrorResult ]
%

category: 'magritte'
method: GtLToolForExampleMethodRun
exampleReferenceDescription
	<magritteDescription>
	
	^ MAToOneRelationDescription new
		accessor: #exampleReference;
		classes: {GtLExampleReference};
		beRequired
%

category: 'private'
method: GtLToolForExampleMethodRun
runExample: method fromReference: exampleReference inContext: anExecutionContext toolCall: aToolCall
	^self 
		runExample: method 
		fromReference: exampleReference 
		inContext: anExecutionContext 
		toolCall: aToolCall 
		ifError: [ :anError | anError ]
%

category: 'running'
method: GtLToolForExampleMethodRun
runExample: method fromReference: exampleReference inContext: anExecutionContext toolCall: aToolCall ifError: anErrorBlock
	| example exampleResult objectId |
	
	method isGTExampleMethod
		ifFalse: [ ^ GtLMethodIsNotExampleDomainObject new method: method ].
	example := method gtExample asExampleWithResult.
	example ifNil: [ ^ anErrorBlock cull: (GtLMethodIsNotExampleDomainObject new
		 method: method) ].
	
	[ exampleResult := example run ]
		on: Error
		do: [ :ex | 
			^ anErrorBlock cull: (GtLExceptionDomainObject new
					freeze: ex;
					description: ('Example execution failed: {1}' format: {method name})) ].
				
	objectId := anExecutionContext objectStorage ifNotNil: [ :aStorage |
		aStorage
			addNewObject: exampleResult returnValue
			reason: (GtLStoredObjectExampleMethodReason toolCall: aToolCall) ].
			
	^ GtLExampleWithResult new
		exampleWithResult: example;
		objectId: objectId;
		updatePlaygroundPageReferenceForDatabase: anExecutionContext lepiterDatabase;
		yourself
%

category: 'accessing'
method: GtLToolForSearchFilter
description
	^ 'Use GT filters to find methods'
%

method: GtLToolForSearchFilter
name
	^ 'gtSearchFilter'
%

method: GtLToolForSearchFilter
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments query |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	(arguments includesKey: 'query')
		ifFalse: [ ^ GtLMissingArgumentDomainObject new
				arguments: arguments;
				missingArgument: 'query' ].
	query := (arguments at: 'query') asString.
	^ [ | result allItems someItems |
	result := OpalCompiler new
			source: query;
			evaluate.
	allItems := result contents.
	someItems := allItems
			first: (self class maximumResultItemCount min: allItems size).

	GtLSearchFilterDomainObject new
		query: query;
		filter: result;
		items: someItems;
		mayHaveMore: allItems size > someItems size ]
		on: Error
		do: [ :error | 
			GtLExceptionDomainObject new
				freeze: error;
				errorReason: 'There was an error when evaluating the query: ' , error printString ]
%

method: GtLToolForSearchFilter
queryDescription
	<magritteDescription>

	^ MAStringDescription new
		label: 'Query';
		accessor: #query;
		beRequired
%

