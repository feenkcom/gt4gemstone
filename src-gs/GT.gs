method: GtLRefactoringToolForMethodImplementorsExamples
toolWithExampleHierarchy
	| namespace tool baseClass childClass |
	namespace := GtRBNamespace new.
	namespace defineClass: 'Object subclass: #GtLRefactoringMethodImplementorsBase
		instanceVariableNames: ''''''
		classVariableNames: ''''''
		package: ''DemoTest''' .
	namespace defineClass: 'GtLRefactoringMethodImplementorsBase subclass: #GtLRefactoringMethodImplementorsChild
		instanceVariableNames: ''''''
		classVariableNames: ''''''
		package: ''DemoTest''' .
	baseClass := namespace classNamed: 'GtLRefactoringMethodImplementorsBase'.
	childClass := namespace classNamed: 'GtLRefactoringMethodImplementorsChild'.
	baseClass compile: 'example
	^ 1' classified: 'examples'.
	childClass compile: 'example
	^ super example + 1' classified: 'examples'.
	tool := GtLRefactoringToolForMethodImplementors new.
	tool model: namespace.
	^ tool
%

category: 'examples'
method: GtLMagritteToolForFileInformationExamples
fileInformationForExistingFile
	<gtExample>
	| fileReference |
	fileReference := FileReference newTempFilePrefix: 'GtLMagritteToolForFileInformation' suffix: '.txt'.
	[ | tool call targetObject |
		fileReference writeStreamDo: [ :stream | stream nextPutAll: 'Metadata' ].
		tool := GtLMagritteToolForFileInformation new.
		call := self
			executeTool: tool
			withArguments: {
				'filePath' -> { 'pathString' -> fileReference pathString } asDictionary
			} asDictionary.
		targetObject := call result targetObject.
		self assert: (targetObject isKindOf: GtLFileInformation).
		self assert: targetObject path equals: fileReference pathString.
		self assert: targetObject size equals: fileReference size.
		self assert: targetObject type equals: 'file'.
		self assert: targetObject permissions equals: fileReference permissions printString.
		^ call ]
		ensure: [ fileReference exists ifTrue: [ fileReference delete ] ]
%

