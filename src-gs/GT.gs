	self unsubscribeFromExamples.
	examples := aCollection collect: [ :each | each asExampleWithResult ].
	self subscribeToExamples.
	
%

method: GtExplicitExampleGroup
size
	^ examples size
%

category: 'announcement handling'
method: GtExplicitExampleGroup
handleExampleAnnouncement: aGtExampleAnnouncement
	self ignoreAnnouncements ifTrue: [ ^ self ].
	self hasAnnouncer ifFalse: [ ^ self ].
	self announcer announce: aGtExampleAnnouncement.
%

category: 'initialization'
method: GtExplicitExampleGroup
initialize
	super initialize.
	examples := #().
%

category: 'subscriptions'
method: GtExplicitExampleGroup
subscribeToExamples
	self examples ifNil: [ ^ self ].
	self examples
		do: [ :eachExample | 
			eachExample announcer weak
				when: GtExampleAnnouncement
				send: #handleExampleAnnouncement:
				to: self ]
%

method: GtExplicitExampleGroup
unsubscribeFromExamples
	self examples ifNil: [ ^ self ].
	self examples do: [ :eachExample | eachExample unsubscribe: self ].
%

category: 'accessing'
classmethod: GtExplicitExampleGroup
leJsonV4Name

	^ #gtExplicitExampleGroup
%

category: 'examples'
classmethod: GtExplicitExampleGroup
gtExampleExplicitEmptyGroup
	<gtExample>
	^ self new examples: #()
%

category: 'jsonV3'
classmethod: GtExplicitExampleGroup
leJsonV4AttributeMapping

	^ super leJsonV4AttributeMapping
		add: #examples -> #examples;
		yourself.
%

category: 'accessing'
method: GtMagritteAsyncActionExecutor
isWithFutureResponse
	^ self action isWithFutureResponse
%

method: GtMagritteAsyncActionExecutor
usedProcess
	^ self action usedProcess
%

category: 'execution'
method: GtMagritteAsyncActionExecutor
execute
	self usedProcess executeAction: self
%

method: GtMagritteAsyncActionExecutor
executeInActiveProcess
	self executeActionWithCallbacks
%

method: GtMagritteAsyncActionExecutor
executeInFutureProcess
	<return: #TAsyncPromise>
	| aFuture aPromise |
	self element
		ifNil: [ self executeInActiveProcess.
			^ nil ].

	aFuture := (MessageSend 
		receiver: self 
		selector: #executeActionWithCallbacks)
			asAsyncFuture.
	aPromise := aFuture
			await: (GtMagritteBuilderUtility executionConfiguration
				errorHandler: AsyncPassExceptionHandler new).

	self element enqueueTask: (BlPromiseTask new promise: aPromise).

	^ aPromise
%

method: GtMagritteAsyncActionExecutor
executeInUIProcess
	self element ifNil: [ 
		self executeInActiveProcess.
		^ self ].

	self element inUIProcessDo: [ self executeActionWithCallbacks ]
%

category: 'accessing'
method: GtMagritteActionExecutor
futureConfiguration
	<return: #AsyncFutureExecutionConfiguration>
	^ futureConfiguration ifNil: [ futureConfiguration := self defaultFutureConfiguration ]
%

method: GtMagritteActionExecutor
futureConfiguration: aFutureExecutionConfiguration
	futureConfiguration := aFutureExecutionConfiguration
%

method: GtMagritteActionExecutor
isWithCallbacks
	^ isWithCallbacks ifNil: [ false ]
%

method: GtMagritteActionExecutor
isWithCallbacks: aBoolean
	isWithCallbacks := aBoolean
%

method: GtMagritteActionExecutor
isWithStatusUpdates
	^ isWithStatusUpdates ifNil: [ false ]
%

method: GtMagritteActionExecutor
isWithStatusUpdates: anObject
	isWithStatusUpdates := anObject
%

category: 'execution'
method: GtMagritteActionExecutor
execute
	self isWithStatusUpdates ifTrue: [ 
		self memento executionStatus: GtMagritteExecutionStatus executing ].
	super execute
%

method: GtMagritteActionExecutor
registerCallback: aCallback error: anException
	callbackErrors
		add: (GtMagritteCallbackError new
				callback: aCallback;
				exception: (GtMagritteActionUtility freeze: anException))
%

category: 'initialization'
method: GtMagritteActionExecutor
defaultFutureConfiguration
	^ GtPhlowUtility defaultFutureExecutionConfiguration
%

method: GtMagritteActionExecutor
initialize
	super initialize.
	callbackErrors := AsyncSharedOrderedCollection new
%

category: 'private - execution'
method: GtMagritteActionExecutor
attachFutureTask: anAsyncFuture
	| aPromise |
	self element ifNil: [ ^ self ].
	
	aPromise := anAsyncFuture asAsyncFuture await: self futureConfiguration.
	self element enqueueTask: (BlPromiseTask new promise: aPromise)
%

method: GtMagritteActionExecutor
executeCallback: aCallback object: anException
	GtMagritteCallbackExecutor new 
		action: aCallback asGtMagritteCallback;
		object: anException;
		memento: self memento;
		description: self description;
		actionExecutor: self;
		element: element;
		execute
%

method: GtMagritteActionExecutor
executeErrorCallbacks: anException
	self isWithCallbacks ifFalse: [ 
		anException pass.
		^ self ].

	self description onErrorCallbacks do: [ :aCallback | 
		self 
			executeCallback: aCallback 
			object: anException ]
%

method: GtMagritteActionExecutor
executeSuccessCallbacks: aResult
	self isWithCallbacks ifFalse: [ ^ self ].

	self description onSuccessCallbacks
		do: [ :aCallback | self executeCallback: aCallback object: aResult ]
%

category: 'private - hooks'
method: GtMagritteActionExecutor
onExecutionError: anException
	super onExecutionError: anException.
	self isWithCallbacks ifTrue: [ self executeErrorCallbacks: anException ].
	self isWithStatusUpdates ifTrue: [ 
		self memento executionStatus: (GtMagritteExecutionStatus exception: (GtMagritteActionUtility freeze: anException)) ]
%

method: GtMagritteActionExecutor
onExecutionFinished: aResult
	super onExecutionFinished: aResult.
	self isWithStatusUpdates ifTrue: [ 
		callbackErrors asArray
			ifEmpty: [
				self memento executionStatus: 
					GtMagritteExecutionStatus inactive ]
			ifNotEmpty: [ :anArray | 
				"If we execute callbacks asynchronously,
				the action executor may not be notified on time.
				As a consequence users will obtain a visual notification
				of an async callback error."
				self memento executionStatus: (
					GtMagritteExecutionStatus callbackExceptions: anArray) ] ]
%

method: GtMagritteActionExecutor
onExecutionStarted
	super onExecutionStarted.
	self isWithStatusUpdates ifTrue: [ 
		self memento executionStatus: GtMagritteExecutionStatus executing ]
%

method: GtMagritteActionExecutor
onMainActionFinished: aResult
	super onMainActionFinished: aResult.
	self isWithFutureResponse ifTrue: [ self attachFutureTask: aResult ].
	self isWithCallbacks ifTrue: [ self executeSuccessCallbacks: aResult ]
%

category: 'accessing'
method: GtMagritteCallbackExecutor
actionExecutor
	^ actionExecutor
%

method: GtMagritteCallbackExecutor
actionExecutor: anObject
	actionExecutor := anObject
%

category: 'private - hooks'
method: GtMagritteCallbackExecutor
onExecutionError: anException
	super onExecutionError: anException.
	self actionExecutor ifNotNil: [ :anExecutor | 
		anExecutor registerCallback: self action error: anException ]
%

