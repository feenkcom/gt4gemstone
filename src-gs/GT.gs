method: GtLMessageStyler
visitExampleAnnotation: anExampleAnnotation
	| anExample |
	self visitAnnotation: anExampleAnnotation.
	self styleName: anExampleAnnotation.
	anExample := self exampleFor: anExampleAnnotation imageObject.
	anExample ifNil: [ ^ self ].
	self styleAutoHidingAnnotation: anExampleAnnotation.
	anExampleAnnotation hasLabel
		ifTrue: [
			self
				styleButton: anExampleAnnotation
				forValuable: (MessageSend receiver: anExample selector: #returnValue)
				defaultLabel: #printString
				withTool: [ GtInspectorTool new
						valuable: (MessageSend receiver: anExample selector: #returnValue) ] ]
		ifFalse: [ self styleExpandingExample: anExampleAnnotation ]
%

method: GtLMessageStyler
visitFileReferenceAnnotation: aFileReferenceAnnotation
	"Show the annotation in the code font with the markup colour.
	Its nodes belong to the gtFileReference grammar, so I do not descend into them."

	(self text
		from: aFileReferenceAnnotation parent startPosition
		to: aFileReferenceAnnotation parent stopPosition)
		glamorousCodeFont;
		foreground: BrGlamorousColors textMarkupColor.

	^ aFileReferenceAnnotation
%

method: GtLMessageStyler
visitObjectReferenceAnnotation: anObjectAnnotation
	| uuid storedObject object isValid aLinkColor adapter |
	uuid := anObjectAnnotation uuid.
	self 
		storedRegistryObjectForId: uuid 
		ifPresent: [ :aStoredObject |
			isValid := true. 
			storedObject := aStoredObject.
			object := aStoredObject storedValue ] 
		ifAbsent: [
			isValid := false. 
			storedObject := nil.
			object := nil ].
	
	aLinkColor := isValid
				ifTrue: [BrGlamorousColors textMarkupColor]
				ifFalse: [BrGlamorousColors linkWithErrorColor].
	(self text from: anObjectAnnotation parent startPosition
		to: anObjectAnnotation parent stopPosition) foreground: aLinkColor.
	uuid ifNotNil: [self styleAutoHidingAnnotation: anObjectAnnotation].
	adapter := LeObjectReferenceAnnotationAdapter
				annotation: anObjectAnnotation
				object: object.
	self styleButton: adapter withTool: [GtInspectorTool forObject: storedObject].
	isValid
		ifTrue: [self 
			styleExpandingObject: adapter 
			withDefault: LepiterConstants defaultShowSelector]
%

method: GtLMessageStyler
visitPageAnnotation: aPageAnnotation
	| page label attribute anId |
	self visitAnnotation: aPageAnnotation.
	page := self pageForAnnotation: aPageAnnotation.
	label := aPageAnnotation isLinkByLabel
			ifTrue: [ aPageAnnotation labelName ]
			ifFalse: [ page
					ifNotNil: [ page title ]
					ifNil: [ aPageAnnotation pageName
							ifEmpty: [ aPageAnnotation pageUidString ifNil: [ '' ] ] ] ].
	label ifEmpty: [ ^ self ].
	self styleAutoHidingAnnotation: aPageAnnotation.
	anId := LeTextSnippetAttributeLabelElementId indexed: self nextUniqueId.
	attribute := GtButtonAttribute new
			beAppend;
			stencil: [ | button |
				button := LeSnippetStylerVisitor
						textLinkButtonPadding: (BlInsets top: 2)
						margin: BlInsets empty
						valid: page isNotNil.
				button
					id: anId;
					beSmallSize;
					label: label;
					enabled: page isNotNil.
				page
					ifNotNil: [ button
							action: [ :aButton | aButton phlow spawnTool: (LePagePhlowTool page: page) ] ].
				button ].
	self text
		attribute: attribute
		from: aPageAnnotation parent startPosition
		to: aPageAnnotation parent stopPosition.
	self
		styleExpandingObject: aPageAnnotation
		for: page
		withDefault: #gtLiveFor:
%

