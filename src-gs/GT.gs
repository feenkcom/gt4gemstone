method: GtLDataSourceEncoderDecoderExamples
writingClientHistoryCanBeUndone
	"Writing a client history to a method compiles it through a recorded change:
	one undo restores the previous method and keeps the changes recorded before it"

	<gtExample>
	<return: #CompiledMethod>
	^ GtRefactoryChangeManager
		isolatedInstanceDuring: [ :aChangeManager |
			| environment realClass |
			environment := GtPharoDummiesGenerator withPackages: 1 classes: 1.
			[ realClass := environment anyDummyClass realClass.
			(RBAddMethodChange
				compile: 'recordedHistory
	^ #[]'
				in: realClass
				classified: 'private - data') gtExecuteWithUndo.

			GtLDataSourceEncoderDecoder
				writeClientHistory: #()
				to: realClass
				selector: #recordedHistory.
			self assert: realClass new recordedHistory notEmpty.

			aChangeManager undoChange.
			self assert: realClass new recordedHistory isEmpty.
			self assert: aChangeManager hasUndoableOperations.
			realClass >> #recordedHistory ] ensure: [ environment removeFromSystem ] ]
%

category: 'private'
method: GtLDataSourceEncoderDecoderExamples
assertConfiguredChatReconstructionUsingCompletions: completions
	| provider chat liveTools instructions format storage history request response file result calls rejected |
	provider := completions
		ifTrue: [ GtLOllamaProvider new completions; modelName: 'qwen3.5:9b' ]
		ifFalse: [ GtLOpenAiResponsesProvider new modelName: 'gpt-4.1' ].
	chat := GtLChat new provider: provider.
	liveTools := GtLTools new items: { GtLMagritteToolForMethodsSource new }.
	chat tools: liveTools.
	instructions := chat instructions.
	format := chat format.
	storage := chat objectStorage.
	request := ZnRequest post: 'http://localhost/example'.
	request entity: (ZnStringEntity json: (completions
		ifTrue: [ '{"model":"qwen3.5:9b","tools":[{"type":"function","function":{"name":"historical","description":"recorded","parameters":{"type":"object","properties":{}}}}],"messages":[{"role":"user","content":[{"type":"text","text":"hello"}]}]}' ]
		ifFalse: [ '{"model":"gpt-4.1","tools":[{"type":"function","name":"historical","description":"recorded","parameters":{"type":"object","properties":{}}}],"input":[{"role":"user","content":[{"type":"input_text","text":"hello"}]}]}' ])).
	response := ZnResponse ok: (ZnStringEntity json: (completions
		ifTrue: [ '{"choices":[{"message":{"role":"assistant","content":null,"tool_calls":[{"id":"call","type":"function","function":{"name":"historical","arguments":"{}"}}]},"finish_reason":"tool_calls"}]}' ]
		ifFalse: [ '{"output":[{"type":"function_call","call_id":"call","name":"historical","arguments":"{}"}]}' ])).
	history := GtLRequestHistory new.
	(history addRequest: request response: response) result: response asGtJson jsonObject.
	file := FileSystem memory root / 'chat.jsonl'.
	file writeStreamDo: [ :stream | GtLDataSourceEncoderDecoder saveClientHistory: history toStream: stream ].
	result := GtLDataSourceEncoderDecoder recreateChatFrom: file chat: chat.
	self assert: result == chat.
	self assert: chat tools == liveTools.
	self assert: chat provider == provider.
	self assert: chat instructions == instructions.
	self assert: chat format == format.
	self assert: chat objectStorage == storage.
	calls := chat messages messagesSelect: [ :each | each isToolMessage ].
	self assert: calls size equals: 1.
	self assert: (calls first toolCall tool isKindOf: GtLJsonPlaceholderTool).
	self assert: calls first toolCall tool name equals: 'historical'.
	self assert: calls first tools first name equals: 'historical'.
	rejected := false.
	[ GtLDataSourceEncoderDecoder recreateChatFrom: file chat: chat ] on: AssertionFailure do: [ :error | rejected := true ].
	self assert: rejected.
	^ chat
%

category: '*GToolkit4NeoJSON'
method: NeoJSONArray
gtJsonFor: aView
	<gtView>
	^ aView explicit
		title: 'JSON';
		priority: 10;
		stencil: [ | editorElement textEditor text |
			textEditor := BrTextEditorModel new.
			textEditor styler: JSONParser gtStyler.
			editorElement := BrEditorElement new.
			editorElement editor: textEditor.
			text := (NeoJSONWriter toStringPretty: self) asRopedText.
			text glamorousCodeFontDo: #beNotOverwritableByStyler; glamorousCodeSizeDo: #beNotOverwritableByStyler.
			textEditor text: text.
			editorElement
				padding: (BlInsets all: 10);
				constraintsDo: [ :c | 
					c horizontal matchParent.
					c vertical matchParent ].
			editorElement ]
%

category: 'accessing'
method: NeoJSONArray
atPath: keyCollection
	"Use each key in keyCollection recursively, return nil when a key is missing.
	Note how keys can also be indexes to arrays."

	| value |
	value := self.
	keyCollection do: [ :each |
		value := value at: each ifAbsent: [ ^ nil ] ].
	^ value
%

method: NeoJSONArray
atPath: keyCollection put: newValue
	"Use each key in keyCollection recursively, create new levels when needed.
	Note how keys can also be indexes to arrays."

	| target |
	keyCollection ifEmpty: [ ^ self ].
	target := self.
	keyCollection allButLastDo: [ :each |
		target := target 
			at: each
			ifAbsent: [ target at: each put: target species new ] ].
	^ target at: keyCollection last put: newValue
%

method: NeoJSONArray
findPath: conditionBlock
	"Find and return the first path to an object in the graph that I represent 
	for which conditionBlock holds. Return nil when not found."

	(conditionBlock value: self) ifTrue: [ ^ #(()) ].
	self doWithIndex: [ :value :index |
		(conditionBlock value: value) ifTrue: [ ^ { index } ].
		(value isCollection and: [ value isString not ]) ifTrue: [
			(value findPath: conditionBlock) ifNotNil: [ :subPath |
				^ { index } , subPath ] ] ].
	^ nil
%

method: NeoJSONArray
findPaths: conditionBlock
	"Find and return all paths to objects in the graph that I represent 
	for which conditionBlock holds. Return an empty collection when none are found."

	| found |
	found := OrderedCollection new.	
	self doWithIndex: [ :value :index |
		(conditionBlock value: value) ifTrue: [ found add: { index } ].
		(value isCollection and: [ value isString not ]) ifTrue: [
			(value findPaths: conditionBlock) do: [ :subPath |
				found add: { index } , subPath ] ] ].
	^ found
%

category: 'adding'
method: NeoJSONArray
at: index add: object
	^ index = '-'
		ifTrue: [ self addLast: object ]
		ifFalse: [ self insert: object before: index ]
%

method: NeoJSONArray
atPath: keyCollection add: newValue
	"Use each key in keyCollection recursively, create new levels when needed.
	Note how keys can also be indexes to arrays.
	This variant will insert/add to arrays"

	| target |
	keyCollection ifEmpty: [ ^ self ].
	target := self.
	keyCollection allButLastDo: [ :each |
		target := target 
			at: each
			ifAbsent: [ target at: each add: target species new ] ].
	^ target at: keyCollection last add: newValue
%

category: 'print'
method: NeoJSONArray
printOn: stream
	"I use my JSON representation when printing myself"

	[ (NeoJSONWriter on: stream) nextPut: self ]
		on: Error
		do: [ :exception |
			stream
				nextPutAll: ' Error printing JSON: ';
				print: exception ]
%

category: 'removing'
method: NeoJSONArray
removeKey: index
	"Polymorphic with NeoJSONObject: remove the element at index"

	^ self removeAt: index
%

category: 'example'
classmethod: NeoJSONArray
exampleNumbers
	<gtExample>
	| numbers |
	numbers := self new: 128 withAll: nil.
	0 to: 127 do: [ :n | 
		numbers
			at: n + 1
			put: (NeoJSONObject new
					integer: n;
					decimal: (n printStringBase: 10);
					octal: (n printStringBase: 8);
					hexadecimal: (n printStringBase: 16);
					binary: (n printStringBase: 2);
					roman: n printStringRoman;
					words: n asWords;
					prime: n isPrime;
					character: n asCharacter asString) ].
	^ numbers
