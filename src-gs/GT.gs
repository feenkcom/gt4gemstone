method: GtJsonShapeComparison
compare: aJsonObject with: anotherJsonObject atPath: aPath
	| leftKind rightKind |
	leftKind := self jsonKindOf: aJsonObject.
	rightKind := self jsonKindOf: anotherJsonObject.
	leftKind = rightKind
		ifFalse: [ ^ self addDifferenceAt: aPath message: 'expected ', leftKind asString, ' but found ', rightKind asString ].
	leftKind = #object
		ifTrue: [ ^ self compareObject: aJsonObject with: anotherJsonObject atPath: aPath ].
	leftKind = #array
		ifTrue: [ ^ self compareArray: aJsonObject with: anotherJsonObject atPath: aPath ].
%

method: GtJsonShapeComparison
compareArray: aCollection with: anotherCollection atPath: aPath
	aCollection size = anotherCollection size
		ifFalse: [ self addDifferenceAt: aPath message: 'expected array size ', aCollection size asString, ' but found ', anotherCollection size asString ].
	1 to: (aCollection size min: anotherCollection size) do: [ :eachIndex |
		self
			compare: (aCollection at: eachIndex)
			with: (anotherCollection at: eachIndex)
			atPath: (self path: aPath index: eachIndex) ]
%

method: GtJsonShapeComparison
compareObject: aDictionary with: anotherDictionary atPath: aPath
	"Keys are compared by content: a Symbol and a String with the same characters are the same key
	(see GtJsonUtility class>>#key:matches:)."

	| leftKeys rightKeys missingKeys extraKeys commonKeys |
	leftKeys := self normalizedKeysOf: aDictionary.
	rightKeys := self normalizedKeysOf: anotherDictionary.
	missingKeys := leftKeys keys asSet difference: rightKeys keys asSet.
	extraKeys := rightKeys keys asSet difference: leftKeys keys asSet.
	missingKeys asSortedCollection
		do: [ :eachKey | self addDifferenceAt: (self path: aPath key: eachKey) message: 'missing key' ].
	extraKeys asSortedCollection
		do: [ :eachKey | self addDifferenceAt: (self path: aPath key: eachKey) message: 'extra key' ].
	commonKeys := leftKeys keys asSet intersection: rightKeys keys asSet.
	commonKeys asSortedCollection
		do: [ :eachKey | 
			self
				compare: (aDictionary at: (leftKeys at: eachKey))
				with: (anotherDictionary at: (rightKeys at: eachKey))
				atPath: (self path: aPath key: eachKey) ]
%

category: 'initialization'
method: GtJsonShapeComparison
initialize
	super initialize.
	differences := OrderedCollection new
%

category: 'printing'
method: GtJsonShapeComparison
printOn: aStream
	super printOn: aStream.
	aStream
		nextPutAll: '(';
		nextPutAll: (self matches ifTrue: [ 'matching shape' ] ifFalse: [ differences size asString, ' differences' ]);
		nextPutAll: ')'
%

category: 'private'
method: GtJsonShapeComparison
addDifferenceAt: aPath message: aMessage
	differences add: aPath -> aMessage
%

method: GtJsonShapeComparison
jsonKindOf: anObject
	anObject isNil
		ifTrue: [ ^ #null ].
	anObject isDictionary
		ifTrue: [ ^ #object ].
	(anObject isArray or: [ anObject class name = #NeoJSONArray ])
		ifTrue: [ ^ #array ].
	anObject isString
		ifTrue: [ ^ #string ].
	anObject isBoolean
		ifTrue: [ ^ #boolean ].
	anObject isNumber
		ifTrue: [ ^ #number ].
	^ anObject class name asSymbol
%

method: GtJsonShapeComparison
normalizedKeysOf: aDictionary
	"Answer a Dictionary mapping each normalized (String) key of aDictionary to its original key"

	| aMapping |
	aMapping := Dictionary new.
	aDictionary
		keysDo: [ :eachKey | aMapping at: (GtJsonUtility normalizedKey: eachKey) put: eachKey ].
	^ aMapping
%

