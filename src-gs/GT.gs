		withArguments: {
			'objectId' -> 'missing'
		} asDictionary.
	self
		assertMissingRequiredProperties: call result targetObject
		withPropertyNames: #('viewSelector')
		path: #(nil)
		errorMessage: 'required properties missing [viewSelector]'.
	^ call
