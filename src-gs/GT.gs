method: GtLACPChatViewModel
messageViewModels
	^ Array
		streamContents: [ :stream | 
			session turns copy
				do: [ :turn | 
					turn inputMessages
						do: [ :input | 
							| model |
							model := messageCache
									at: input
									ifAbsentPut: [ input asChatMessageViewModel
											turn: turn;
											yourself ].
							model message: input.
							stream nextPut: model ].
					(turn activity notEmpty
						or: [ turn assistantMessage hasWork or: [ turn isActive or: [ turn isFailed ] ] ])
						ifTrue: [ | model |
							model := messageCache
									at: turn
									ifAbsentPut: [ turn assistantMessage asChatMessageViewModel ].
							model message: turn assistantMessage.
							stream nextPut: model ] ] ]
%

method: GtLACPChatViewModel
session
 ^ session
%

method: GtLACPChatViewModel
session: anObject
 session ifNotNil: [ session announcer unsubscribe: self ].
 session := anObject.
 messageCache := IdentityDictionary new.
 session announcer weak
  when: GtLACPSessionChanged send: #onSessionChanged: to: self
%

method: GtLACPChatViewModel
statusText
 | pending |
 pending := session turns sum: [ :turn | turn permissionRequests count: [ :each | each state = #pending ] ].
 pending > 0 ifTrue: [ ^ session state asString, ' · awaiting permission' ].
 ^ session state asString
%

category: 'actions'
method: GtLACPChatViewModel
send
 | turn |
 self canSend ifFalse: [ ^ nil ].
 lastError := nil.
 [ turn := session prompt: self draft ]
 on: Error do: [ :ex | lastError := ex messageText. session announceChanged. ^ nil ].
 self draft: ''.
 session announceChanged.
 ^ turn
%

method: GtLACPChatViewModel
stop
 lastError := nil.
 [ session cancelTurn ] on: Error do: [ :ex | lastError := ex messageText. session announceChanged ]
%

category: 'navigation'
method: GtLACPChatViewModel
revealInteraction: aRequest
	| models index |
	models := self messageViewModels.
	index := models
			findFirst: [ :model | 
				model message == model turn assistantMessage
					and: [ model turn includesInteraction: aRequest ] ].
	index = 0 ifTrue: [ ^ nil ].
	(models at: index) revealInteraction: aRequest.
	^ index
%

