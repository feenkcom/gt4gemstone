	<gtExample>
	"Creates multiple snippets where all fail with different errors"
	| call targetObject tool page |
	tool := self toolOnLogicalDatabase.
	page := self pageInLogicalDatabase.
	
	call := self
		executeTool: tool
		withArguments: {
			'snippets' -> {
				Dictionary new
					at: 'TextSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'snippetText' put: '';
						yourself);
					yourself.
				Dictionary new
					at: 'PharoSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'pharoCode' put: '';
						yourself);
					yourself.
				Dictionary new
					at: 'PythonSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'pythonCode' put: '';
						yourself);
					yourself.
				Dictionary new
					at: 'ShellSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'shellCode' put: '';
