category: 'copying'
method: GtMagritteValue
copyWithCurrentValue: anObject

	^ self copy
		  currentValue: anObject;
		  validation: nil
%

method: GtMagritteValue
copyWithOriginalValue: anObject
	"Create a new instance of myself with a new original value.
	If am not changed, then I change both, current and original values."

	| aCopy |
	aCopy := self copy.

	aCopy isChanged
		ifTrue: [ 
			aCopy originalValue: anObject ]
		ifFalse: [ 
			aCopy
				currentValue: anObject;
				originalValue: anObject;
				validation: nil ].

	^ aCopy
%

