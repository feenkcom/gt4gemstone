category: 'api - ui'
method: GtLDemoMathReasoningStep
addContentOneLineSummaryTo: aWriteStream
	self explanation
		ifNotNil: [ :aString | 
			aWriteStream nextPutAll: aString asString.
			aWriteStream nextPutAll: ': ' ].

	self output ifNotNil: [ :aString | 
		aWriteStream nextPutAll: aString asString ]
