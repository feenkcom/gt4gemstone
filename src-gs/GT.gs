method: GtLMcpServer
toolCallIdFrom: aJsonRpc
	"Try harness-specific conventions in order. Never substitute the JSON-RPC id."
	self claudeCodeToolCallIdFrom: aJsonRpc ifPresent: [ :identifier | ^ identifier ].
	self codexToolCallIdFrom: aJsonRpc ifPresent: [ :identifier | ^ identifier ].
	^ nil
%

category: 'public'
method: GtLMcpServer
createAcceptedResponse
	^ ZnResponse new
		statusLine: (ZnStatusLine new
				code: 202;
				reason: 'Accepted';
				version: 'HTTP/1.1');
		headers: (ZnHeaders new contentLength: 0);
		entity: (ZnByteArrayEntity bytes: ByteArray new);
		yourself
%

method: GtLMcpServer
createBadRequestResponseForError: anError fromRequest: request
	| errorMessage |
	errorMessage := String streamContents: 
					[:out |
					out
						<< 'Bad Request ';
						<< request method;
						space.
					request uri printPathQueryFragmentOn: out.
					anError description
						ifNotNil: 
							[:anExceptionMessage |
							out
								<< '; ';
								<< anExceptionMessage]].
	^ZnResponse 
		badRequest: request 
		entity: (ZnEntity textCRLF: errorMessage)
%

method: GtLMcpServer
createResponseForResult: aJsonRpcResult forRpc: aJsonRpc
	aJsonRpc isNotification ifTrue: [ ^ self createAcceptedResponse ].

	^ ((GtLMcpJsonRpc new)
		id: aJsonRpc id;
		result: aJsonRpcResult) asZnResponse
%

