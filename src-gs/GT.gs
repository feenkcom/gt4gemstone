category: 'accessing'
classmethod: ZnResourceMetaUtils
querySafeSet
	"See RFC 3986 section 3.4. The safe set for the query part consists of
	the basic safe set #rfc3986SafeSet plus the 'sub-delimiters' !$&''()*+,;=
	plus : and @ plus / and ?"

	^ 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~!$&''()*+,;=:@/?'
%

classmethod: ZnResourceMetaUtils
rfc3986SafeSet
	"Return the unreserved characters according to RFC 3986 section 2.3.
	This is the most narrow safe set to be used in a better safe than sorry approach."

	^ ZnPercentEncoder rfc3986UnreservedCharacters
%

classmethod: ZnResourceMetaUtils
urlPathSafeSet
	"See RFC 3986 section 3.3. The safe set for the path consists of
	the basic safe set #rfc3986SafeSet plus the 'sub-delimiters' !$&''()*+,;= plus : and @"

	^ 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~!$&''()*+,;=:@'
%

category: 'converting'
classmethod: ZnResourceMetaUtils
decodePercent: string
	^ ZnPercentEncoder new
		decodePlusAsSpace: false;
		decode: string
%

classmethod: ZnResourceMetaUtils
decodePercentForQuery: string
	^ ZnPercentEncoder new
		decodePlusAsSpace: true;
		decode: string
%

classmethod: ZnResourceMetaUtils
encodePercent: string safeSet: safeSet encoder: encoder
	^ ZnPercentEncoder new
		characterEncoder: encoder;
		safeSet: (self perform: safeSet);
		encode: string
%

classmethod: ZnResourceMetaUtils
parseQueryFrom: stream
	| string index fields |
	fields := ZnMultiValueDictionary new.
	[ stream atEnd ] whileFalse: [
		string := stream upTo: $&.
		index := string indexOf: $=.
		index > 0
			ifFalse: [ fields at: (self decodePercentForQuery: string) put: nil ]
			ifTrue: [
				fields
					at: (self decodePercentForQuery: (string copyFrom: 1 to: index - 1))
					add: (self decodePercentForQuery: (string copyFrom: index + 1 to: string size)) ] ].
	^ fields
%

classmethod: ZnResourceMetaUtils
writeQueryFields: dictionary on: stream
	self writeQueryFields: dictionary withEncoder: ZnCharacterEncoder utf8 on: stream
%

classmethod: ZnResourceMetaUtils
writeQueryFields: dictionary withEncoder: encoder on: stream
	| first |
	first := true.
	dictionary keysAndValuesDo: [ :key :value |
		first ifFalse: [ stream nextPut: $& ].
		first := false.
		stream nextPutAll: (self encodePercent: key safeSet: #queryKeyValueSafeSet encoder: encoder).
		value ifNotNil: [
			stream
				nextPut: $=;
				nextPutAll: (self encodePercent: value safeSet: #queryKeyValueSafeSet encoder: encoder) ] ]
%

category: 'examples'
method: GtLCouldNotCreateClassDomainObjectExamples
basicCouldNotCreateClassDomainObject
	<gtExample>
	<return: #GtLCouldNotCreateClassDomainObject>
	| domainObject |
	domainObject := GtLCouldNotCreateClassDomainObject new
		targetClassName: 'MyNewClass';
		superclass: Object;
		packageName: 'MyPackage';
		packageTagName: 'Core';
		instanceVariableNames: 'slot1 slot2';
		classVariableNames: 'SharedVar';
		exception: (Error new messageText: 'Superclass not found');
		yourself.
	self assert: domainObject targetClassName equals: 'MyNewClass'.
	self assert: domainObject superclassName equals: #Object.
	self assert: domainObject packageName equals: 'MyPackage'.
	self assert: domainObject packageTagName equals: 'Core'.
	self assert: domainObject instanceVariableNames equals: 'slot1 slot2'.
	self assert: domainObject classVariableNames equals: 'SharedVar'.
	self assert: domainObject messageText equals: 'Class creation error: Superclass not found'.
	self assert: domainObject isErrorDomainObject.
	^ domainObject
%

method: GtLCouldNotCreateClassDomainObjectExamples
couldNotCreateClassDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| domainObject compositeView dataBlock expectedJson |
	
	domainObject := self basicCouldNotCreateClassDomainObject.
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	expectedJson := {
		#targetClassName -> 'MyNewClass'.
		#superclassName -> #Object.
		#packageName -> 'MyPackage'.
		#packageTagName -> 'Core'.
		#instanceVariableNames -> 'slot1 slot2'.
		#classVariableNames -> 'SharedVar'.
		#messageText -> 'Class creation error: Superclass not found'
	} asDictionary.
	self assertDataBlock: dataBlock hasLlmJsonData: expectedJson.
	
	^ dataBlock
%

method: GtLCouldNotCreateClassDomainObjectExamples
emptyCouldNotCreateClassDomainObject
	<gtExample>
	<return: #GtLCouldNotCreateClassDomainObject>
	| domainObject compositeView dataBlock jsonData expectedJson |
	
	domainObject := GtLCouldNotCreateClassDomainObject new.
	self assert: domainObject targetClassName isNil.
	self assert: domainObject superclass isNil.
	self assert: domainObject exception isNil.
	self assert: domainObject messageText equals: 'Class creation error: unknown error'.
	
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock compositeJsonData.
	expectedJson := {
		#targetClassName -> nil.
		#superclassName -> nil.
		#packageName -> nil.
		#packageTagName -> nil.
		#instanceVariableNames -> nil.
		#classVariableNames -> nil.
		#messageText -> 'Class creation error: unknown error'
	} asDictionary.
	self assert: jsonData equals: expectedJson.
	
	^ domainObject
%

