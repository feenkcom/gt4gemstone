category: 'public'
method: GtExampleEvaluator
result
	<return: #GtExampleResult>
	self do: [ result := self runManaged ] on: GtExampleResult signalableExceptions do: [ :anException | result := (self newResultFor: self example) exampleException: (GtSystemUtility freeze: anException) ]. ^ result
