							(mapping 
								mapProperty: #x 
								getter: [ :object | object x ] 
								setter: [ :object :value | object setX: value setY: object y ])
								valueSchema: #AsString.
							(mapping
								mapProperty: #y
								getter: [ :object | object y ]
								setter: [ :object :value | object setX: object x setY: value ]) 
								valueSchema: #AsString ];
				for: #AsString
					customDo: [ :mapping | 
							mapping
