category: 'initialization'
method: GtLSerializedObjectValue
initializeFromObject: anObject
		| slotNames |
	"Capture a headless object snapshot, including named instance variables."
	objectClassName := anObject class name asString.
	superclassName := anObject class superclass ifNil: [ '' ] ifNotNil: [ :aClass | aClass name asString ].
	packageName := anObject class category asString.
	objectPrintString := [ anObject printString ] on: Error do: [ :error | 'Error printing object' ].
	phlowViews := #().
	slotNames := anObject class allInstVarNames.
	allInstanceSlots := (1 to: slotNames size) collect: [ :index |
		| slotValue |
		slotValue := [ anObject instVarAt: index ] on: Error do: [ :error | nil ].
		GtLSerializedSlotInfo new
			name: (slotNames at: index) asString;
			valueClassName: slotValue class name asString;
			valuePrintString: ([ slotValue asString ] on: Error do: [ :error | 'Error converting to string' ]);
			yourself ].
%

category: 'private'
method: GtExampleMethodResolver
methodClass
	^ self methodClassName isClass ifTrue: [ self methodClassName ] ifFalse: [ System myUserProfile symbolList objectNamed: self methodClassName asSymbol ]
%

category: 'instance creation'
classmethod: GtLClassDescription
fromClass: aClass
		^ self new
		currentClassName: aClass name;
		superclassName: (aClass superclass ifNil: [ nil ] ifNotNil: [ :aSuperclass | aSuperclass name ]);
		comment: aClass comment;
		packageName: aClass category;
		packageTagName: nil;
		instanceSlotNames: aClass instVarNames;
		classSlotNames: aClass class instVarNames;
		allInstanceMethodNames: aClass selectors asArray;
		allClassMethodNames: aClass class selectors asArray;
		yourself
%

