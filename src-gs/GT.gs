category: 'printing'
method: GtLClassDescription
printOn: aStream
	super printOn: aStream.
	aStream parenthesize: [
		self currentClassName ifNotNil: [ :aName |
			aStream nextPutAll: aName ].
		self packageName ifNotNil: [ :aPackage |
			aStream nextPutAll: ' — ';
				nextPutAll: aPackage ] ]
%

category: 'instance creation'
classmethod: GtLClassDescription
fromClass: aClass
	^ self new
		currentClassName: aClass name;
		superclassName: (aClass superclass ifNil: [ nil ] ifNotNil: [ :aSuperclass | aSuperclass name ]);
		comment: aClass instanceSide comment;
		packageName: aClass package name;
		packageTagName: (aClass packageTag isRoot ifTrue: [ nil ] ifFalse: [ aClass packageTag name ]);
		instanceSlotNames: aClass slotNames;
		classSlotNames: aClass class slotNames;
		allInstanceMethodNames: (aClass methods asArray collect: [ :aMethod | aMethod selector ]);
		allClassMethodNames: (aClass class methods asArray collect: [ :aMethod | aMethod selector ]);
		yourself
%

category: 'accessing'
method: GtLlmTokenizer
tokenize: aString usingModel: aModel
	| aTokenizerResult |
	PBApplication isRunning ifFalse: [ PBApplication start ].
	PBApplication uniqueInstance installModule: 'gtoolkit_tiktokenize'.

	aTokenizerResult := PBApplication
			do: [ :anApplication | 
				anApplication newCommandStringFactory
					bindingAt: #string put: aString;
					bindingAt: #model put: aModel;
					script: 'import gtoolkit_tiktokenize';
					resultExpression: 'gtoolkit_tiktokenize.tokenize(string, model)';
					sendAndWait ].

	^ aTokenizerResult
		input: aString;
		model: aModel
%

method: GtLlmTokenizer
tokenizeMessages: aMessageGroup usingModel: aModel
	^ self
		tokenize: ('' join: (aMessageGroup collect: #asTokenizableString))
		usingModel: aModel
%

