category: 'primitives'
method: GtExampleEvaluator
primitiveProcessExample: anExample withEvaluationContext: anEvaluationContext
	"Perform an example using a provider context and return its result"
	^ anEvaluationContext provider 
		perform: anExample method selector 
		withArguments: anEvaluationContext arguments
%

category: 'private'
method: GtExampleEvaluator
basicProcess: anExample
	<return: #GtExampleResult>
	| currentResult anEvaluationContext dependencies |
	context example: anExample.

	dependencies := self dependenciesFor: anExample.
	currentResult := self newResultFor: anExample.
	anEvaluationContext := anExample evaluationContext.

	GtProcessStackOverflowChecker currentCheckerClass checkDuring:
		[ [ currentResult successValue: (self primitiveProcessExample: anExample withEvaluationContext: anEvaluationContext) ] 
			ensure: [ 
				self processAfter: anExample withDependencies: dependencies andEvaluationContext: anEvaluationContext ] ].
	
	^ currentResult
%

method: GtExampleEvaluator
do: aBlock on: anException do: anotherBlock
	"I give a chance to my subclass to not handle the exception is needed"
	aBlock
		on: anException
		do: anotherBlock
%

method: GtExampleEvaluator
handleDependencyErrorFor: anExample
	^ (GtExampleDependencyError new
		example: anExample;
		defined: anExample arguments;
		expected: anExample methodArgumentNames;
		invalid: #();
		yourself) signal
%

method: GtExampleEvaluator
newResultFor: anExample
	^ GtExampleResult new 
		example: anExample;
		context: self context
%

method: GtExampleEvaluator
processAfter: anExample withDependencies: exampleDependencies andEvaluationContext: anEvaluationContext
	self processAfterMethodFor: anExample withEvaluationContext: anEvaluationContext.
	exampleDependencies reversed do: [ :anotherExample |
		self processAfterMethodFor: anotherExample withEvaluationContext: anEvaluationContext ]
%

method: GtExampleEvaluator
processAfterMethodFor: anExample withEvaluationContext: anEvaluationContext
	anExample after ifNil: [ ^ self ].
	anEvaluationContext provider
		perform: anExample after method selector 
		withArguments: #()
%

method: GtExampleEvaluator
startMcpServerWith: anException
	| onDemandServer semaphore debugInfo message |

	onDemandServer := GtLOnDemandMcpServer instance.
	semaphore := Semaphore new.
	debugInfo := {
		'exception' -> anException.
		'evaluator' -> self.
		'holdingSemaphore' -> semaphore.
		} asDictionary.
	onDemandServer objectStorage
		addNewObject: debugInfo reason:
			(GtLStoredObjectStringReason text: 'example_', self example checkName asString).
	message := String streamContents: [ :stream |
		stream
			<< 'MCP server available on port: ';
			print: onDemandServer port;
			<< ', running: ';
			print: onDemandServer isRunning;
			<< ' on: ';
			print: anException printString. ].
	Stdio stdout
		<< message;
		lf;
		flush.
	StringSignal emit: message.
	semaphore wait.
%

category: 'public'
method: GtExampleEvaluator
runManaged
