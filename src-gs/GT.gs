method: GtExampleEvaluator
processAfter: anExample withDependencies: exampleDependencies andEvaluationContext: anEvaluationContext
	self processAfterMethodFor: anExample withEvaluationContext: anEvaluationContext.
	exampleDependencies reversed do: [ :anotherExample |
		self processAfterMethodFor: anotherExample withEvaluationContext: anEvaluationContext ]
%

method: GtExampleEvaluator
processAfterMethodFor: anExample withEvaluationContext: anEvaluationContext
	anExample after ifNil: [ ^ self ].
	anEvaluationContext provider
		perform: anExample after method selector 
		withArguments: #()
%

method: GtExampleEvaluator
startMcpServerWith: anException
	| onDemandServer semaphore debugInfo message |

	onDemandServer := GtLOnDemandMcpServer instance.
	semaphore := Semaphore new.
	debugInfo := {
		'exception' -> anException.
		'evaluator' -> self.
		'holdingSemaphore' -> semaphore.
		} asDictionary.
	onDemandServer objectStorage
		addNewObject: debugInfo reason:
			(GtLStoredObjectStringReason text: 'example_', self example checkName asString).
	message := String streamContents: [ :stream |
		stream
			<< 'MCP server available on port: ';
			print: onDemandServer port;
			<< ', running: ';
			print: onDemandServer isRunning;
			<< ' on: ';
			print: anException printString. ].
	Stdio stdout
		<< message;
		lf;
		flush.
	StringSignal emit: message.
	semaphore wait.
%

