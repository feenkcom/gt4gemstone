category: 'adding'
method: GtLConnectionRegistry
addConnection: aConnection
	| allConnections |
	connections
		lock: [ :aCollection | 
			(aCollection includes: aConnection) ifTrue: [ ^ self ].
			aCollection add: aConnection.
			allConnections := aCollection copy ].

	announcer
		announce: (GtLConnectionRegistryConnectionAdded new
				connectionRegistry: self;
				connection: aConnection;
				connections: allConnections)
%

category: 'api - hooks'
method: GtLConnectionRegistry
onRemovedAsUniqueInstance
	self unsubscribeFromSystem.

	announcer
		announce: (GtLConnectionRegistryUniqueInstanceRemoved new
				connectionRegistry: self;
				newConnectionRegistry: self class uniqueInstance)
%

category: 'cleanup'
method: GtLConnectionRegistry
clearConnections
	connections
		lock: [ :aCollection | 
			aCollection removeAll.
			defaultConnection := nil ].

	announcer
		announce: (GtLConnectionRegistryConnectionsChanged new
				connectionRegistry: self;
				connections: #())
%

