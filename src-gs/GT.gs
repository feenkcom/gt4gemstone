category: 'examples'
method: GtLToolForSearchFilterExamples
searchFilterForExampleMethods
	<gtExample>
	| call targetObject |
	call := self
		executeTool: GtLToolForSearchFilter new
		withArguments: {
			'query' -> 'GtLToolForSearchFilterExamples gtMethodsInClass & #gtExample gtPragmas'
		} asDictionary.
	targetObject := call result targetObject.
	self assert: (targetObject isKindOf: GtLSearchFilterDomainObject).
	self assert: targetObject isErrorDomainObject not.
	self assert: targetObject items isNotEmpty.
	self assert: (targetObject items anySatisfy: [ :eachMethod |
		eachMethod methodClass = GtLToolForSearchFilterExamples
			and: [ eachMethod selector = #searchFilterForExampleMethods ] ]).
	^ call
%

method: GtLToolForSearchFilterExamples
searchFilterWithError
	<gtExample>
	| call targetObject |
	call := self
		executeTool: GtLToolForSearchFilter new
		withArguments: {
			'query' -> 'self error: ''boom'''
		} asDictionary.
	targetObject := call result targetObject.
	self assert: targetObject isErrorDomainObject.
	self assert: (targetObject description beginsWith: 'There was an error when evaluating the query: ').
	self assert: (targetObject description includesSubstring: 'boom').
	^ call
%

method: GtLToolForSearchFilterExamples
searchFilterWithMissingQuery
	<gtExample>
	| call |
	call := self
		executeTool: GtLToolForSearchFilter new
		withArguments: Dictionary new.
	self
		assertMissingRequiredProperties: call result targetObject
		withPropertyNames: #('query')
		path: #(nil)
		errorMessage: 'required properties missing [query]'.
	^ call
%

category: 'examples - data views'
method: GtLToolForSearchFilterExamples
searchFilterDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| call domainObject compositeView dataBlock jsonData |
	call := self searchFilterForExampleMethods.
	domainObject := call result targetObject.
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock llmJsonData.
	self assert: (jsonData at: #query) equals: 'GtLToolForSearchFilterExamples gtMethodsInClass & #gtExample gtPragmas'.
	self assert: (jsonData at: #itemsAsPrintStrings) isNotEmpty.
	self assert: ((jsonData at: #itemsAsPrintStrings) anySatisfy: [ :item | 
		item includesSubstring: 'searchFilterForExampleMethods' ]).
	
	^ dataBlock
%

category: 'accessing'
method: GtLOverallSUnitTestExecutionsSummarizer
latestStatuses
	^ latestStatusesByTestCase values asArray
%

method: GtLOverallSUnitTestExecutionsSummarizer
numberOfTests
	^ runsByTestCase size
%

method: GtLOverallSUnitTestExecutionsSummarizer
overallStatusSummaries
	^ self statusCounts associations
		asSortedCollection: [ :a :b | a key asString <= b key asString ]
%

method: GtLOverallSUnitTestExecutionsSummarizer
overallSummaryEntries
	| entries |
	entries := OrderedCollection new.
	entries add: ({ 
		#label -> 'Tests'. 
		#value -> self numberOfTests. 
		#object -> [ self latestStatuses ] } asDictionary).
	entries add: ({ 
		#label -> 'Test runs'. 
		#value -> self totalRuns. 
		#object -> [ 
				runsByTestCase values 
					inject: OrderedCollection new 
					into: [ :all :each | all addAll: each; yourself ] 
			] } asDictionary).
	self statusCounts keysAndValuesDo: [ :key :value |
		entries add: ({ 
			#label -> (key capitalized, ' runs'). 
			#value -> value. 
			#object -> [ 
				| matchingRuns |
				matchingRuns := OrderedCollection new.
				runsByTestCase valuesDo: [ :eachStatuses |
					eachStatuses do: [ :eachStatus |
						eachStatus statusText = key ifTrue: [ matchingRuns add: eachStatus ] ] ].
				matchingRuns ] } asDictionary) ].
	^ entries
%

method: GtLOverallSUnitTestExecutionsSummarizer
relevantToolCalls
	^ relevantToolCalls ifNil: [ #() ]
%

method: GtLOverallSUnitTestExecutionsSummarizer
runsOf: aTestReference
	^ runsByTestCase at: aTestReference ifAbsent: [ #() ]
%

method: GtLOverallSUnitTestExecutionsSummarizer
statusCounts
	| counts |
	counts := OrderedDictionary new.
	runsByTestCase valuesDo: [ :eachStatuses |
		eachStatuses do: [ :eachStatus |
			counts
				at: eachStatus statusText
				put: ((counts at: eachStatus statusText ifAbsent: [ 0 ]) + 1) ] ].
	^ counts
%

method: GtLOverallSUnitTestExecutionsSummarizer
testRunSummaries
	^ runsByTestCase associations collect: [ :eachAssociation |
		| statuses |
		statuses := eachAssociation value.
		{ 
			#testReference -> eachAssociation key.
			#runs -> statuses.
			#passes -> (statuses select: [ :each | each isPassedResult ]).
			#failures -> (statuses select: [ :each | each isFailureResult ]).
			#errors -> (statuses select: [ :each | each isErrorResult ]).
			#skipped -> (statuses select: [ :each | each isSkippedResult ])
		} asDictionary ]
%

method: GtLOverallSUnitTestExecutionsSummarizer
totalRuns
	^ runsByTestCase values
		inject: 0
		into: [ :sum :each | sum + each size ]
%

