completeChatWithModel: aGtLModel andMessages: aCollection andFormat: aFormat andTools: someTools andInstructions: aStringOrNil

	^ (self 
		apiClientWithModel: aGtLModel 
		andMessages: aCollection 
		andFormat: aFormat 
		andTools: someTools 
		andInstructions: aStringOrNil)
			perform
