category: 'asserting'
method: NeoJSONSchemaTests
assertValid: jsonObject
	| validator errors |
	validator := schema validator.
	validator validate: jsonObject.
	errors := validator validationErrors.
	self assert: validator isValid.
	self assert: errors isEmpty.
	^ validator
