status
	^ status
%

method: GtLClassCommentChangeResult
status: aString
	status := aString
%

method: GtLClassCommentChangeResult
targetClassName
	^ self changedClassName
%

method: GtLClassCommentChangeResult
updatedClass
	^ updatedClass
%

method: GtLClassCommentChangeResult
updatedClass: aClass
	updatedClass := aClass
%

method: GtLClassCommentChangeResult
updatedDefinitionWithCommentString
	^self updatedClass 
		ifNil: [ '' ]
		ifNotNil: [ :each |
			each asDefinitionWithCommentString ] 
%

category: 'gt - extensions'
method: GtLClassCommentChangeResult
asDiffElement
	| newSource oldSource |
	oldSource := self oldClassComment.
	newSource := self newClassComment.
	^ GtDiffElementWithLabelStencil new
		fromLabelText: 'Old comment for ', (self changedClassName);
		toLabelText: 'New comment for '	, (self changedClassName);
		change: (GtDiffBuilder
				computeDifferencesFrom: oldSource
				to: newSource
				using: GtSmaCCDiffSplitter forPharo);
		asElement
%

method: GtLClassCommentChangeResult
gtDiffFor: aView
	<gtView>
	<gtCodeChangeView>
	^ aView diff
		title: 'Diff';
		priority: 5;
		from: [ self oldClassComment ];
		to: [ self newClassComment ];
		fromLabel: 'Old comment:';
		toLabel: 'New comment:'
%

method: GtLClassCommentChangeResult
gtViewChangeDescriptionElement
	^ GtLClassCommentChangeDescriptionElement new
		updateForChangeObject: self
%

category: 'llm - views'
method: GtLClassCommentChangeResult
llmRawDataViewFor: aDataView
	<gtLlmDataView>
	
	^ aDataView magritteObject: [ self ]
%

category: 'magritte'
method: GtLClassCommentChangeResult
changedClassNameDescription
	<magritteDescription>
	^ MAStringDescription new
		label: 'Class name';
		accessor: #changedClassName;
		beRequired
%

method: GtLClassCommentChangeResult
statusDescription
	<magritteDescription>
	^ MAStringDescription new
		label: 'Status';
		accessor: #status;
		beRequired
