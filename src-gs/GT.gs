method: GtLExponentialBackoff
initialDelay: seconds
	self
		assert: (seconds isNumber and: [ seconds > 0 and: [ seconds <= maximumDelay ] ]).
	initialDelay := seconds
%

method: GtLExponentialBackoff
maxRetries: anInteger
	self assert: (anInteger isInteger and: [ anInteger >= 0 ]).
	maxRetries := anInteger
%

method: GtLExponentialBackoff
maximumDelay: seconds
	self assert: (seconds isNumber and: [ seconds >= initialDelay ]).
	maximumDelay := seconds
%

method: GtLExponentialBackoff
randomBlock: aBlock
	randomBlock := aBlock
%

method: GtLExponentialBackoff
waitBlock: aBlock
	waitBlock := aBlock
%

category: 'calculating'
method: GtLExponentialBackoff
delayForRetry: retryNumber minimum: minimumSeconds
	"Equal jitter: half the capped exponential delay plus up to another half.
	Server minima are floors, not subject to the exponential cap. Add jitter above
	the floor so clients do not all wake at the reset instant. Retry numbers start at 1."

	| exponential half sample |
	self assert: (retryNumber isInteger and: [ retryNumber > 0 ]).
	exponential := initialDelay.
	2
		to: retryNumber
		do: [ :index | exponential := exponential * 2 min: maximumDelay ].
	half := exponential / 2.
	sample := randomBlock value.
	self assert: (sample isNumber and: [ sample >= 0 and: [ sample <= 1 ] ]).
	^ (half max: (minimumSeconds max: 0)) + (half * sample)
%

category: 'executing'
method: GtLExponentialBackoff
execute: anOperation on: anExceptionClass retryIf: retryPredicate minimumDelay: minimumBlock
	"Retry only exceptions accepted by the caller. Exhaustion passes the last
	exception unchanged. All counters are local to this execution."

	| retries |
	retries := 0.
	^ [ anOperation value ]
		on: anExceptionClass
		do: [ :error | 
			((retryPredicate value: error) and: [ retries < maxRetries ])
				ifFalse: [ error pass ].
			retries := retries + 1.
			waitBlock
				value: (self delayForRetry: retries minimum: (minimumBlock value: error)).
			error retry ]
%

category: 'initialization'
method: GtLExponentialBackoff
initialize
	| random |
	super initialize.
	initialDelay := 1.
	maximumDelay := 60.
	maxRetries := 5.
	random := Random new.
	randomBlock := [ random next ].
	waitBlock := [ :seconds | (Delay forMilliseconds: (seconds * 1000) ceiling) wait ]
%

category: 'accessing'
method: GtLMagritteToolForMethodReferences
description
	^ 'Search the image for the senders of the given selector.

Arguments:
- methodName: string

Return values:
- foundMethods: array of method references
- mayHaveMore: boolean indicating if there are more matches than returned

Example JSON arguments:
{
  "methodName": "value"
}

Example JSON response:
{
  "foundMethods": [
    {
      "methodClassName": "Object",
      "methodName": "value",
      "classSide": false
    }
  ],
  "mayHaveMore": false
}'
%

method: GtLMagritteToolForMethodReferences
methodNameDescription
	<magritteDescription>

	^ MAStringDescription new
		label: 'Method name';
		accessor: #methodName;
		beRequired
%

method: GtLMagritteToolForMethodReferences
name
	^ 'methodReferences'
%

category: 'private'
method: GtLMagritteToolForMethodReferences
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments methodName selector references |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	methodName := arguments at: 'methodName'.

	(methodName trimBoth isEmpty)
		ifTrue: [ ^ GtLMissingArgumentDomainObject new
				arguments: arguments;
				missingArgument: 'methodName' ].

	selector := methodName asSymbol.
	references := self
		gtDo: [ (selector gtReferences result toArray
			await: GtLSettings futureExecutionConfiguration) wait ]
		gemstoneDo: [ (ClassOrganizer gtDefault referencesTo: selector) first ].

	^ GtLMethodsSearchResult fromReferences: references
%

