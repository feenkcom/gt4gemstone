category: 'initialization'
method: GtLACPMessageTextElement
initialize
	super initialize.
	self
		hMatchParent;
		vFitContentLimited.
	editor := BrEditor new
			aptitude: BrGlamorousRegularEditorAptitude;
			padding: (BlInsets
					top: 5
					left: 5
					bottom: 0
