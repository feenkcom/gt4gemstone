method: GtLFunctionTool
method
	| split class methodName |
	self name ifNil: [ ^ nil ].

	split := '_' split: self name.
	class := split first asClassIfAbsent: [ ^ nil ].
	methodName := ':' join: split allButFirst.
	^ [ class >> methodName asSymbol ] on: Error do: [ nil ]
