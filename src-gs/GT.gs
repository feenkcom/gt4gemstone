	call := GtLlmFunctionToolCall new.
	call function: {
		'name' -> tool name.
		'arguments' -> {
			'classNames' -> 'GtLlmExampleDummyPassingTest GtLlmExampleDummyMixedTest' } asDictionary } asDictionary.
