method: GtLReplyMessage
includesMessage: aMessage
	^ (self executionMessages anySatisfy: [ :each | each = aMessage ])
		or: [ finalMessage = aMessage
			or: [ self postExecutionMessages anySatisfy: [ :each | each = aMessage ] ] ]
