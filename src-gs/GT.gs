		logStream close.
		logStream := nil ].
	^ self logFile exists
		ifTrue: [ self logFile contents ] 
		ifFalse: [ 'log file is empty' ]
%

method: NeoJSONValidation
ensureLog
	logStream ifNil: [ 
		logStream := self logFile ensureDelete; writeStream. 
		logStream setToEnd ]
	
%

method: NeoJSONValidation
