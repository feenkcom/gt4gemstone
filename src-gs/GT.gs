category: 'gt - extensions'
method: GtLObjectStorageValueResult
gtObjectFor: aView
	<gtView>
	<gtLlmView>
	^ self
		gtDo: [ aView explicit
				title: 'Object';
				priority: 10;
				stencil: [ | container |
					container := BrVerticalPane new.
					container matchParent
						addAptitude: (BrLayoutResizerAptitude new common: [ container children ]);
						background: BrGlamorousColors backdropColor;
						addChild: (object gtDefaultInspectorTool asElement
								margin: (BlInsets all: 10);
								background: Color white;
								addAptitude: BrShadowAptitude;
								vFitContentLimited;
								hMatchParent) ] ]
		gemstoneDo: [ aView explicit
				title: 'Object';
				priority: 10;
				declarativeStencil: [
					GtPhlowNamedStencil new
						stencilClassName: #GtLObjectValueResultGemStoneStencil;
						stencilData: { #object -> (GtRsrProxyServiceServer object: object) } asDictionary;
						dataSerializationStrategy: GtPhlowStencilDataSerializationStrategy
							forMixedProxyDataEncoding ] ]
%

category: 'printing'
method: GtLObjectStorageValueResult
printOn: aStream
	
	self object printOn: aStream.
	aStream
		nextPutAll: '; id=';
		nextPutAll: (self objectId ifNil: [ '' ] ifNotNil: [ self objectId ])
%

category: 'updating'
method: GtLObjectStorageValueResult
updateForToolCall: aToolCall withExecutionContext: anExecutionContext 
	| newId |
	super updateForToolCall: aToolCall withExecutionContext: anExecutionContext .
	
 newId := (anExecutionContext objectStorage ifNotNil: [ :aStorage | 
			aStorage
					addNewObject: object
					reason: (GtLStoredObjectCodeExecutionReason toolCall: aToolCall)]).
	self objectId: (newId ifNil: [ '' ])
%

category: 'instance creation'
classmethod: GtLObjectStorageValueResult
forObject: anObject withId: anObjectId
	^ (self forObject: anObject)
			objectId: anObjectId
