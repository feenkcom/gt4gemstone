category: 'llm-generated'
method: GtLlmRefactoringToolForClassReferencesExamples
classReferencesForExistingClass
	<gtExample>
	| tool call result |
	tool := self toolWithExampleReferences.
	call := GtLlmFunctionToolCall new.
	call function: {
		'name' -> tool name.
		'arguments' -> {'className' -> 'GtLlmRefactoringClassReferencesTarget'} asDictionary
	} asDictionary.
	result := tool performToolCall: call.
	self assert: call tool == tool.
	self assert: (result includesSubstring: 'GtLlmRefactoringClassReferencesHolder').
	^ tool
%

method: GtLlmRefactoringToolForClassReferencesExamples
classReferencesForUnknownClass
	<gtExample>
	| tool call result |
	tool := self toolWithExampleReferences.
	call := GtLlmFunctionToolCall new.
	call function: {
		'name' -> tool name.
		'arguments' -> {'className' -> 'UnknownClassName'} asDictionary
	} asDictionary.
	result := tool performToolCall: call.
	self assert: call tool == tool.
	self assert: result equals: 'Class not found'.
	^ tool
%

method: GtLlmRefactoringToolForClassReferencesExamples
toolWithExampleReferences
	| namespace tool targetClass holderClass |
	namespace := GtRBNamespace new.
	namespace defineClass: 'Object subclass: #GtLlmRefactoringClassReferencesTarget
		instanceVariableNames: ''''''
		classVariableNames: ''''''
		package: ''Gt4Llm-Refactoring-Examples''' .
	namespace defineClass: 'Object subclass: #GtLlmRefactoringClassReferencesHolder
		instanceVariableNames: ''''''
		classVariableNames: ''''''
		package: ''Gt4Llm-Refactoring-Examples''' .
	targetClass := namespace classNamed: 'GtLlmRefactoringClassReferencesTarget'.
	holderClass := namespace classNamed: 'GtLlmRefactoringClassReferencesHolder'.
	holderClass compile: 'reference
	^ GtLlmRefactoringClassReferencesTarget new' classified: 'accessing'.
	tool := GtLlmRefactoringToolForClassReferences new.
	tool model: namespace.
	^ tool
%

category: 'examples'
method: GtSimpleInMemoryVectorDatabaseExamples
queryReturnsHighestMatch
	<gtExample>
	<noTest>
	| database matches |
	database := GtSimpleInMemoryVectorDatabase new.
	database addDocument: 'Our refund policy lasts 30 days.' key: #refunds.
	database addDocument: 'You can change your password from account settings.' key: #password.
	database addDocument: 'Shipping usually takes 5 to 7 business days.' key: #shipping.
	matches := database query: 'How long does delivery take?' maxMatches: 2.
	self assert: matches first embedding key equals: #shipping.
	^ matches
%

