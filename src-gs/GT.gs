category: 'accessing'
method: GtLMagritteToolForDirectoryContents
description
	^ 'Gets the files and directories inside a directory. Arguments must provide a directory path string.

Example JSON arguments:
{
  "directoryPath": "/path/to/directory"
}

Example JSON response:
{
  "directoryPath": "/path/to/directory",
  "files": [
    {"pathString": "/path/to/directory/file-one.txt"},
    {"pathString": "/path/to/directory/file-two.txt"}
  ],
  "directories": [
    {"pathString": "/path/to/directory/sub-directory"}
  ]
}'
%

method: GtLMagritteToolForDirectoryContents
name
	^ 'getDirectoryContents'
%

category: 'magritte'
method: GtLMagritteToolForDirectoryContents
directoryPathDescription
	<magritteDescription>

	^ MAStringDescription new
		label: 'Directory';
		accessor: #directoryPath;
		beRequired
%

category: 'private'
method: GtLMagritteToolForDirectoryContents
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments path directoryReference |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	path := arguments at: 'directoryPath'.
	path isEmpty ifTrue: [ ^ GtLMissingDomainObject new objectName: path ].
	
	(directoryReference := path asFileReference) exists
		ifFalse: [ ^ GtLMissingDomainObject new objectName: path ].
		
	^ self directoryContentsFor: directoryReference pathString
%

category: 'processing'
method: GtLMagritteToolForDirectoryContents
directoryContentsFor: aPathString
	| reference files directories |
	reference := aPathString asFileReference.
	reference isDirectory
		ifFalse: [ ^ GtLIncorrectArgumentTypeDomainObject new
			argumentName: 'directoryPath';
			argumentValue: aPathString;
			expectedArgumentValueKind: AbstractFileReference ].
	files := reference files
		collect: [ :each | GtLFilePathReference new pathString: each pathString ].
	directories := reference directories
		collect: [ :each | GtLFilePathReference new pathString: each pathString ].
	^ GtLDirectoryContents new
		directoryPath: aPathString;
		files: files asArray;
		directories: directories asArray
%

category: 'as yet unclassified'
method: GtLOpenAiResponsesExamples
relevantHistoryStartsAtLatestCompaction
	<gtExample>
	| provider chat strategy firstUser firstCompaction assistant
	  secondUser secondCompaction lastUser relevant |

	provider := GtLOpenAiResponsesProvider new.
	chat := GtLChat new provider: provider.
	strategy := GtLOpenAiServerSideCompactionStrategy forProvider: provider.

	firstUser := GtLModelUserMessage new.
	chat addUserMessage: firstUser.

	firstCompaction := GtLModelCompactionMessage new.
	firstCompaction
		rawData: {
			'type' -> 'compaction'.
			'encrypted_content' -> 'first'
		} asDictionary
		for: provider.
	chat addCompactionMessage: firstCompaction.

	assistant := GtLModelAssistantMessage new.
	chat addAssistantMessage: assistant.

	secondUser := GtLModelUserMessage new.
	chat addUserMessage: secondUser.

	secondCompaction := GtLModelCompactionMessage new.
	secondCompaction
		rawData: {
			'type' -> 'compaction'.
			'encrypted_content' -> 'second'
		} asDictionary
		for: provider.
	chat addCompactionMessage: secondCompaction.

	lastUser := GtLModelUserMessage new.
	chat addUserMessage: lastUser.

	relevant := strategy relevantChatMessagesFor: chat.

	self assert: relevant size equals: 2.
	self assert: relevant first == secondCompaction.
	self assert: (relevant at: 2) == lastUser.
	self deny: (relevant includes: firstUser).
	self deny: (relevant includes: firstCompaction).
	self deny: (relevant includes: assistant).
	self deny: (relevant includes: secondUser).

	^ relevant
%

method: GtLOpenAiResponsesExamples
responseWithoutAutomaticCompaction
	<gtExample>
	| provider input result messages |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	result := GtLModelResponse from: {
		'output' -> {
			{ 'type' -> 'message' } asDictionary }
	} asDictionary.

	messages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.

	self assert: messages isEmpty.
	^ messages
%

category: 'examples'
method: GtLOpenAiResponsesExamples
copyOpenAICompactionMessage
	<gtExample>
	<return: #GtLOpenAICompactionMessage>
	| originalChat newChat compactionMessage copiedCompaction |
	
	originalChat := GtLChat new.
	originalChat provider: GtLOpenAiResponsesProvider new.
	
	newChat := GtLChat new.
	newChat provider: GtLOpenAIProvider new.
	
	compactionMessage := GtLModelCompactionMessage new.
	compactionMessage rawData: Dictionary new for: originalChat provider.
	compactionMessage chat: originalChat.
	copiedCompaction := compactionMessage copyForIndependentRequestInChat: newChat.
	
	GtLOpenAIProviderCopyChatExamples new
		assertCopiedChatMessage: copiedCompaction 
		isCopyOf: compactionMessage forChat: newChat.
	self assert: compactionMessage chat == originalChat.
	
	^ copiedCompaction
%

