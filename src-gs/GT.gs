	<magritteDescription>
	^ MABooleanDescription new
		  label: 'Primary';
		  accessor: #isPrimary;
		  default: false;
		  priority: 10;
		  trueString: 'is primary';
		  falseString: '';
		  updateOn: GtMagritteDummyPostalAddressIsPrimaryChanged from: [ self ];
		  blocActionString: 'set as primary';
		  blocUseDropdown: true
