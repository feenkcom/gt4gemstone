category: 'api'
method: GtLDataSourceOpenAiResponsesRequestParser
parseRequest: requestResponse for: aMessageConstructor

	| jsonRequest request messagesEntity role message chat |

	chat := aMessageConstructor chat.
	jsonRequest := requestResponse request asGtJson jsonObject.
	request := GtLOpenAiResponsesRequestEntity rawData: jsonRequest.
	chat provider model ifNil:
		[ chat provider modelName: request model ].
	messagesEntity := request input last.
	messagesEntity hasRole ifTrue:
	[ role := messagesEntity role.
	role = 'user' ifTrue:
		[ message := self parseUserRequest: requestResponse messagesEntity: messagesEntity for: aMessageConstructor ].
	role = 'tool' ifTrue: [ ^ nil ].
	message ifNil:
		[ self error: 'Unknown role: ', role asString ].

	request tools ifNotNil: [ :toolsEntity |
		aMessageConstructor addToolsFrom: toolsEntity to: message ].
].
	^ message
%

category: 'private'
method: GtLDataSourceOpenAiResponsesRequestParser
parseUserRequest: requestResponse messagesEntity: messagesEntity for: aMessageConstructor
	| contentEntity type message chat inputModel |
	
	chat := aMessageConstructor chat.
	contentEntity := messagesEntity content first.
	type := contentEntity type.
	type = 'input_text' ifFalse: [ self error: 'Unknown type: ', type asString ].
	inputModel := self inputModelFrom: contentEntity text.
	message := chat provider userMessageClass new 
			addInputModel: inputModel;
			requestResponse: requestResponse.
	chat addUserMessage: message.
	^ message
%

category: 'accessing'
method: GtLTokenizer
tokenize: aString usingModel: aModel
	| aTokenizerResult |
	PBApplication isRunning ifFalse: [ PBApplication start ].
	PBApplication uniqueInstance installModule: 'gtoolkit_tiktokenize'.

	aTokenizerResult := PBApplication
			do: [ :anApplication | 
				anApplication newCommandStringFactory
					bindingAt: #string put: aString;
					bindingAt: #model put: aModel;
					script: 'import gtoolkit_tiktokenize';
					resultExpression: 'gtoolkit_tiktokenize.tokenize(string, model)';
					sendAndWait ].

	^ aTokenizerResult
		input: aString;
		model: aModel
%

method: GtLTokenizer
tokenizeMessages: aMessageGroup usingModel: aModel
	^ self
		tokenize: ('' join: (aMessageGroup collect: #asTokenizableString))
		usingModel: aModel
%

