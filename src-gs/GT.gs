		column: 'Subscribed'
			text: [ :anAction | 
				| isSubscribed |
				isSubscribed := false.
				subscriptionHandlers
					ifNotNil: [ :aDictionary | (aDictionary includesKey: anAction) ifTrue: [ isSubscribed := true ] ].
				isSubscribed
