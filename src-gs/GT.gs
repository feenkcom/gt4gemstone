		id: #'acp-work-toggle';
		play.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-message-2';
				satisfies: [ :row | 
					originalRow := row.
					originalModel := row viewModel.
					true ] ].
	scripter
		doStep: [ :step | 
			step
				block: [ :element | 
					GtLACPExamples new
						sendUpdate: {'sessionUpdate' -> 'agent_message_chunk'.
								'content'
									-> {'type' -> 'text'.
											'text' -> ' More progress.'} asDictionary} asDictionary
						to: session.
					element updateMessages ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-message-2';
				satisfies: [ :row | row == originalRow and: [ row viewModel == originalModel ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-section';
				satisfies: #isExpanded ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-tool-tool-1';
				exists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-final-section';
				notExists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-content';
				satisfies: [ :pane | 
					(self editorsIn: pane)
						anySatisfy: [ :child | 
							(child isKindOf: BrEditor)
								and: [ child text asString endsWith: ' More progress.' ] ] ] ].
	self assertNoRenderingErrorsIn: scripter.
	^ scripter
%

