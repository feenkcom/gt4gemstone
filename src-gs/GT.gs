category: 'comparing'
method: Point
< aPoint
	"Answer whether the receiver is above and to the left of aPoint."
	"((100@200) < (330@400)) >>> true"
	"((100@200) < (330@100)) >>> false"

	^ x < aPoint x and: [y < aPoint y]
