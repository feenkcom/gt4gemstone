method: GtLACPSessionExamples
assistantSectionChoicesSurviveMessageUpdates
	<gtExample>
	| element session scripter |
	element := self completedChat.
	session := element viewModel session.
	scripter := BlScripter new
			model: session;
			element: element;
			yourself.
	scripter click
		id: #'acp-final-toggle';
		play.
	scripter
		doStep: [ :step | 
			step
				block: [ :chat | 
					GtLACPExamples new
						sendUpdate: {'sessionUpdate' -> 'agent_thought_chunk'.
								'content'
									-> {'type' -> 'text'.
											'text' -> 'Reasoning continues.'} asDictionary} asDictionary
						to: session.
					GtLACPExamples new
						sendUpdate: {'sessionUpdate' -> 'agent_message_chunk'.
								'content'
									-> {'type' -> 'text'.
											'text' -> 'A new final reply.'} asDictionary} asDictionary
						to: session ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-section';
				satisfies: #isCollapsed ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-final-section';
				satisfies: #isCollapsed ].
	scripter click
		id: #'acp-final-toggle';
		play.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-final-content';
				satisfies: [ :pane | 
					(self editorsIn: pane)
						anySatisfy: [ :child | (child isKindOf: BrEditor) and: [ child text asString = 'A new final reply.' ] ] ] ].
	^ scripter
%

