category: 'examples'
method: GtLACPSessionGroupExamples
connectionConversationTreeDisplayed
	<gtExample>
	| root element scripter |
	root := GtLACPExamples new session.
	element := (root connection gtConversationTreeFor: GtPhlowView empty)
			asElementDo: [ :widget | 
				widget
					background: Color white;
					yourself ].
	scripter := BlScripter new
			extent: 1100 @ 700;
			model: root connection;
			element: element;
			yourself.
	scripter
		assertStep: [ :step | 
			step
				onPhlowCellWithString: 'Codex';
				exists ].
	scripter
		doStep: [ :step | 
			step
				block: [ GtLACPSubagentExamples new
						announce: 'group-live-child'
						title: 'Group worker'
						in: root ] ].
	scripter pulseUntilReady.
	scripter
		assertStep: [ :step | 
			step
				onPhlowCellWithString: 'Group worker';
				exists ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

method: GtLACPSessionGroupExamples
conversationTreeDisplayed
	<gtExample>
	| group element scripter |
	group := self nestedSessions.
	element := ((group gtConversationTreeFor: GtPhlowView empty)
			expandAll;
			yourself)
			asElementDo: [ :widget | 
				widget
					background: Color white;
					yourself ].
	scripter := BlScripter new
			extent: 1100 @ 700;
			model: group;
			element: element;
			yourself.
	#('Codex' 'Code reviewer' 'Test investigator' 'API researcher')
		do: [ :title | 
			scripter
				assertStep: [ :step | 
					step
						onPhlowCellWithString: title;
						exists ] ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

method: GtLACPSessionGroupExamples
conversationTreeWithMultipleTurns
	<gtExample>
	| group root secondTurn cache node turnNodes |
	group := self nestedSessions.
	root := group first.
	secondTurn := root prompt: 'Check the follow-up'.
	cache := IdentityDictionary new.
	node := root asConversationTreeNode.
	turnNodes := (node childrenIn: cache) select: [ :each | each kind = 'Turn' ].
	self assert: (turnNodes collect: #object) equals: root turns.
	self assert: turnNodes last label equals: 'Turn 2: Check the follow-up'.
	self assert: turnNodes last state equals: secondTurn stateName.
	self assert: turnNodes last messageCount equals: secondTurn messages size.
	turnNodes
		do: [ :each | 
			self
				assert: ((each childrenIn: cache) collect: #object)
				equals: each object conversationTreeItems ].
	self
		assert: ((node childrenIn: cache) select: [ :each | each kind = 'Turn' ]) first
				== turnNodes first.
	^ group
%

