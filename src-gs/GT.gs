category: 'initialization'
method: GtLClassDefinitionDescription
initializeFromClass: aClass
	 self
 currentClassName: aClass name asString;
 superclassName: (aClass superclass ifNil: [ nil ] ifNotNil: [ :each | each name asString ]);
 comment: aClass comment;
 packageName: aClass category;
 packageTagName: nil;
 instanceSlotNames: (aClass instVarNames collect: #asString);
 classSlotNames: (aClass class instVarNames collect: #asString);
 classVariableNames: (aClass classVarNames collect: #asString);
 traitCompositionString: '{}'
%

category: 'private'
method: GtLMagritteToolForClassCreation
createClassFromRequest: aRequest
		| className superclassName superclass packageName traitComposition variables createdClass description |
	(aRequest isKindOf: GtLTraitCreationRequest)
		ifTrue: [ ^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait creation' ].
	className := (aRequest targetClassName ifNil: [ '' ]) asString trimBoth.
	className isEmpty ifTrue: [ ^ GtLMissingDomainObject new objectName: 'targetClassName' ].
	(GsSession currentSession objectNamed: className asSymbol) notNil
		ifTrue: [ ^ GtLUnexpectedDomainObject new objectName: className ].
	superclassName := (aRequest superclassName ifNil: [ '' ]) asString trimBoth.
	superclassName = 'Trait'
		ifTrue: [ ^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait creation' ].
	superclassName isEmpty ifTrue: [ ^ GtLMissingDomainObject new objectName: 'superclassName' ].
	superclass := GsSession currentSession objectNamed: superclassName asSymbol.
	superclass ifNil: [ ^ GtLMissingDomainObject new objectName: superclassName ].
	packageName := (aRequest package ifNil: [ '' ]) asString trimBoth.
	packageName isEmpty ifTrue: [ ^ GtLMissingDomainObject new objectName: 'package' ].
	traitComposition := (aRequest traitCompositionString ifNil: [ '' ]) asString trimBoth.
	(traitComposition isEmpty or: [ traitComposition = '{}' ]) ifFalse: [
		^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait composition' ].
	variables := [ :value | value ifNil: [ #() ] ifNotNil: [
		value isString
			ifTrue: [ value asString subStrings ]
			ifFalse: [ value collect: [ :each | each asString ] ] ] ].
	[
		createdClass := superclass
			subclass: className asSymbol
			instVarNames: (variables value: aRequest instanceVariables)
			classVars: (variables value: aRequest classVariables)
			classInstVars: (variables value: aRequest classInstanceVariables)
			poolDictionaries: #()
			category: packageName
			inDictionary: System myUserProfile symbolList first
			options: #().
		ClassOrganizer gtDefault addClass: createdClass.
		aRequest comment ifNotNil: [ :comment | createdClass comment: comment asString trimBoth ].
		description := GtLClassDefinitionDescription new
			currentClassName: createdClass name asString;
			superclassName: superclass name asString;
			comment: createdClass comment;
			packageName: createdClass category;
			packageTagName: nil;
			instanceSlotNames: (createdClass instVarNames collect: [ :each | each asString ]);
			classSlotNames: (createdClass class instVarNames collect: [ :each | each asString ]);
			classVariableNames: (createdClass classVarNames collect: [ :each | each asString ]);
			traitCompositionString: '{}';
			yourself
	] on: Error do: [ :error | ^ GtLProblemDomainObject new errorMessage: error description ].
	^ GtLClassModificationResult new
		originalClass: nil;
		updatedClass: description;
		yourself
%

category: '*Magritte-Model'
method: Class
label
	"Answer a human-readable name of the receiving class. This implementation tries to be smart and return a nice label, unfortunately for a lot of classes this doesn't work well so subclasses might want to override this method and return soemthing more meaningfull to end-users."
	<gsCode: nil>
	| start input |

	start := self name findFirst: [ :each | each isLowercase ].
	input := (self name copyFrom: (1 max: start - 1) to: self name size)
		readStream.
	^ String streamContents: [ :stream |
		[ input atEnd ] whileFalse: [
			stream nextPut: input next.
			(input atEnd or: [ input peek isLowercase ])
				ifFalse: [ stream nextPut: Character space ] ] ]
%

category: 'private'
method: GtLMagritteToolForClassSearch
privatePerformToolCall: aToolCall inContext: anExecutionContext
		| arguments query matches |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	query := arguments at: 'query'.
	query isEmpty ifTrue: [ ^ GtLClassesSearchResult fromClasses: #() ].
	matches := IdentitySet new.
	System myUserProfile symbolList do: [ :dictionary |
		dictionary valuesDo: [ :each |
			(each isClass and: [
				(each name asString findPatternNoCase: { query } startingAt: 1) > 0 ])
				ifTrue: [ matches add: each ] ] ].
	^ GtLClassesSearchResult fromClasses:
		(matches asArray sort: [ :a :b | a name <= b name ])
%

category: 'initialization'
method: GtLSerializedSlotInfo
initializeFromSlot: aSlot ofObject: anObject
	"Initialize from a slot and its owning object.
	The GemStone variant uses bounded printing for non-string values."

		"Initialize from a slot and its owning object."
	| slotValue slotIndex |
	slotIndex := (anObject class allInstVarNames collect: [ :each | each asString ])
		indexOf: aSlot name asString.
	slotValue := [ anObject instVarAt: slotIndex ]
		on: Error do: [ :e | nil ].
	self name: aSlot name asString.
	self valueClassName: slotValue class name asString.
	self valuePrintString: ([ 
		((slotValue isKindOf: CharacterCollection) or: [ slotValue isKindOf: Character ])
			ifTrue: [ slotValue asString ]
			ifFalse: [ GtLSerializedObjectValue printStringOf: slotValue limitedTo: 50000 ] ]
		on: Error do: [ :e | 'Error converting to string' ])
%

