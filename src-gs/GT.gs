method: GtLChatLiveExamples
waitForChatCompletion: anInteger then: aBlock
	"Wait for a chat completion a given number of times."
	self isSynchronous ifFalse: [ ^ self ].
	
	anInteger timesRepeat: [ self waitForChatCompletion ].
	aBlock value
