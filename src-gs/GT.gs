			name: 'Compressed';
			value: self compressed.
		GtPhlowOverviewItem new
			name: 'Expanded';
			value: self expanded.
		GtPhlowOverviewItem new
			name: 'Floor';
			value: self floor.
		GtPhlowOverviewItem new
			name: 'Rounded';
			value: self rounded.
		GtPhlowOverviewItem new
			name: 'Has positive extent';
			boolean: self hasPositiveExtent.
		GtPhlowOverviewItem new
			name: 'Is tall';
			boolean: self isTall.
		GtPhlowOverviewItem new
			name: 'Is wide';
			boolean: self isWide.
		GtPhlowOverviewItem new
			name: 'Is zero';
			value: self isZero.
		GtPhlowOverviewItem new
			name: 'Is integer rectangle';
			boolean: self isIntegerRectangle.
		GtPhlowOverviewItem new
			name: 'Corners';
			value: self corners.
		GtPhlowOverviewItem new
			name: 'Inner corners';
			value: self innerCorners}
%

