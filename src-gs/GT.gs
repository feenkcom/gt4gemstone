method: GtLDataSourceEncoderDecoderExamples
writingClientHistoryCanBeUndone
	"Writing a client history to a method compiles it through a recorded change:
	one undo restores the previous method and keeps the changes recorded before it"

	<gtExample>
	<return: #CompiledMethod>
	^ GtRefactoryChangeManager
		isolatedInstanceDuring: [ :aChangeManager |
			| environment realClass |
			environment := GtPharoDummiesGenerator withPackages: 1 classes: 1.
			[ realClass := environment anyDummyClass realClass.
			(RBAddMethodChange
				compile: 'recordedHistory
	^ #[]'
				in: realClass
				classified: 'private - data') gtExecuteWithUndo.

			GtLDataSourceEncoderDecoder
				writeClientHistory: #()
				to: realClass
				selector: #recordedHistory.
			self assert: realClass new recordedHistory notEmpty.

			aChangeManager undoChange.
			self assert: realClass new recordedHistory isEmpty.
			self assert: aChangeManager hasUndoableOperations.
			realClass >> #recordedHistory ] ensure: [ environment removeFromSystem ] ]
%

category: 'private'
method: GtLDataSourceEncoderDecoderExamples
assertConfiguredChatReconstructionUsingCompletions: completions
	| provider chat liveTools instructions format storage history request response file result calls rejected |
	provider := completions
		ifTrue: [ GtLOllamaProvider new completions; modelName: 'qwen3.5:9b' ]
		ifFalse: [ GtLOpenAiResponsesProvider new modelName: 'gpt-4.1' ].
	chat := GtLChat new provider: provider.
	liveTools := GtLTools new items: { GtLMagritteToolForMethodsSource new }.
	chat tools: liveTools.
	instructions := chat instructions.
	format := chat format.
	storage := chat objectStorage.
	request := ZnRequest post: 'http://localhost/example'.
	request entity: (ZnStringEntity json: (completions
		ifTrue: [ '{"model":"qwen3.5:9b","tools":[{"type":"function","function":{"name":"historical","description":"recorded","parameters":{"type":"object","properties":{}}}}],"messages":[{"role":"user","content":[{"type":"text","text":"hello"}]}]}' ]
		ifFalse: [ '{"model":"gpt-4.1","tools":[{"type":"function","name":"historical","description":"recorded","parameters":{"type":"object","properties":{}}}],"input":[{"role":"user","content":[{"type":"input_text","text":"hello"}]}]}' ])).
	response := ZnResponse ok: (ZnStringEntity json: (completions
		ifTrue: [ '{"choices":[{"message":{"role":"assistant","content":null,"tool_calls":[{"id":"call","type":"function","function":{"name":"historical","arguments":"{}"}}]},"finish_reason":"tool_calls"}]}' ]
		ifFalse: [ '{"output":[{"type":"function_call","call_id":"call","name":"historical","arguments":"{}"}]}' ])).
	history := GtLRequestHistory new.
	(history addRequest: request response: response) result: response asGtJson jsonObject.
	file := FileSystem memory root / 'chat.jsonl'.
	file writeStreamDo: [ :stream | GtLDataSourceEncoderDecoder saveClientHistory: history toStream: stream ].
	result := GtLDataSourceEncoderDecoder recreateChatFrom: file chat: chat.
	self assert: result == chat.
	self assert: chat tools == liveTools.
	self assert: chat provider == provider.
	self assert: chat instructions == instructions.
	self assert: chat format == format.
	self assert: chat objectStorage == storage.
	calls := chat messages messagesSelect: [ :each | each isToolMessage ].
	self assert: calls size equals: 1.
	self assert: (calls first toolCall tool isKindOf: GtLJsonPlaceholderTool).
	self assert: calls first toolCall tool name equals: 'historical'.
	self assert: calls first tools first name equals: 'historical'.
	rejected := false.
	[ GtLDataSourceEncoderDecoder recreateChatFrom: file chat: chat ] on: AssertionFailure do: [ :error | rejected := true ].
	self assert: rejected.
	^ chat
%

category: 'accessing'
method: GtLTestCaseWithResultDomainObject
llmRawDataViewFor: aDataView
	<gtLlmDataView>
	^ aDataView
		jsonObject: [ :aJson | 
			aJson
				at: #className put: self testCase class name asString;
				at: #selector
					put: (self testCase selector
							ifNil: [ '' ]
							ifNotNil: [ :anObject | anObject asString ]);
				at: #status put: self statusText;
				at: #result put: self messageText;
				at: #shouldPass put: self testCase shouldPass;
				at: #expectedFailure put: self testCase isExpectedFailure ]
%

method: GtLTestCaseWithResultDomainObject
llmResultExceptionViewFor: aDataView
	<gtLlmDataView>
	
	(self isErrorResult or: [ self isFailureResult  ]) ifFalse: [
		^ aDataView emptyData ].
	
	^aDataView forwardObject
			title: 'Exception details';
			dataKey: #exception;
			object: [ 
				self result exception  ]
%

method: GtLTestCaseWithResultDomainObject
messageText
	self isSkippedResult ifTrue: [ ^ 'Skipped' ].
	self isErrorResult ifTrue: [ ^ 'Error' ].
	self isFailureResult ifTrue: [ ^ 'Failure' ].
	self isSuccessResult ifTrue: [ ^ 'Passed' ].

	^ 'Unknown status'
%

method: GtLTestCaseWithResultDomainObject
result
	^ testCaseWithResult result
%

method: GtLTestCaseWithResultDomainObject
statusText
	self isSkippedResult ifTrue: [ ^ 'skipped' ].
	self isErrorResult ifTrue: [ ^ 'error' ].
	self isFailureResult ifTrue: [ ^ 'failure' ].
	self isSuccessResult ifTrue: [ ^ 'success' ].

	^ 'unknown'
%

method: GtLTestCaseWithResultDomainObject
testCase
	^ testCaseWithResult testCase
%

method: GtLTestCaseWithResultDomainObject
testCaseWithResult
	^testCaseWithResult
%

method: GtLTestCaseWithResultDomainObject
testCaseWithResult: anObject
	testCaseWithResult := anObject
%

category: 'api - testing'
method: GtLTestCaseWithResultDomainObject
isErrorResult
	^ self result isError
%

method: GtLTestCaseWithResultDomainObject
isExpectedDefectResult
	^ self result isExpectedDefect
%

method: GtLTestCaseWithResultDomainObject
isExpectedPassResult
	^ self isPassedResult and: [ self testCase shouldPass ]
%

method: GtLTestCaseWithResultDomainObject
isFailureResult
	^ self result isFailure
%

method: GtLTestCaseWithResultDomainObject
isPassedResult
	^ self result isPassed
%

method: GtLTestCaseWithResultDomainObject
isSkippedResult
	^ self result isSkipped
%

method: GtLTestCaseWithResultDomainObject
isSuccessResult
	^ self isPassedResult
%

method: GtLTestCaseWithResultDomainObject
isUnexpectedErrorResult
	^ self isErrorResult and: [ self testCase shouldPass ]
%

method: GtLTestCaseWithResultDomainObject
isUnexpectedFailureResult
	^ self isFailureResult and: [ self testCase shouldPass ]
%

method: GtLTestCaseWithResultDomainObject
isUnexpectedPassResult
	^ self isPassedResult and: [ self testCase shouldPass not ]
%

category: 'gt - extensions'
method: GtLTestCaseWithResultDomainObject
gtSourceCodeFor: aView
	<gtView>
	<gtLlmView>
	self testCase ifNil: [ ^ aView empty ].
	
	^ aView forward
