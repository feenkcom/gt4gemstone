method: GtClassExampleGroup
exampleClassName: aSymbol
	| cls |

	aSymbol ifNil: [ ^ self ].
	cls := (aSymbol endsWith: ' class')
		ifTrue: [ (aSymbol copyFrom: 1 to: aSymbol size - 6) asSymbol asClass class ]
		ifFalse: [ aSymbol asSymbol asClass ].
	self exampleClass: cls.
%

