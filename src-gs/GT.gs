method: NeoJSONSchemaValidationError
messageText
	^ messageText ifNil: [ 
		messageText := self location
			ifNil: [ self message ] 
			ifNotNil: [ | prefix |
				prefix := '@[{1}] ' format: { $/ join: self location }.
				prefix , self message ] ]
%

method: NeoJSONSchemaValidationError
pushLocation: element
	location ifNil: [ location := OrderedCollection new ].
	location addFirst: element
