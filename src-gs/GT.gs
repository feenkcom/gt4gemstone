	"Just like with:collect: except that the iteration index supplies the second argument to the block."

	"(#(10 20 30) withIndexCollect: [:each :index | each + (index * 2)]) >>> #(12 24 36)"
	<gtGsExtension>

	| result |
	result := self species new: self size.
	1 to: self size do:
