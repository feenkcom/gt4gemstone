category: 'extent functions'
method: Point
guarded
	"Return a positive nonzero extent."
	"(100@200) guarded >>> (100@200)"
	"(0@5) guarded >>> (1@5)"

	^self max: 1@1
%

category: 'geometry'
method: Point
sideOf: otherPoint
	"Returns #left, #right or #center if the otherPoint lies to the left, right or on the line given by the vector from 0@0 to self"
	"((0@0) sideOf: (100@100)) >>> #center"

	| side |
	side := (self crossProduct: otherPoint) sign.
	^ { #right . #center . #left } at: side + 2
%

method: Point
to: end1 intersects: start2 to: end2
	"Returns true if the linesegment from start1 (=self) to end1 intersects with the segment from start2 to end2, otherwise false."

	| start1 sideStart sideEnd |
	start1 := self.
	(((start1 = start2 or: [ end1 = end2 ]) or: [ start1 = end2 ]) or: [ start2 = end1 ]) ifTrue: [ ^ true ].
	sideStart := start1
		to: end1
		sideOf: start2.
	sideEnd := start1
		to: end1
		sideOf: end2.
	sideStart = sideEnd ifTrue: [ ^ false ].
	sideStart := start2
		to: end2
		sideOf: start1.
	sideEnd := start2
		to: end2
		sideOf: end1.
	sideStart = sideEnd ifTrue: [ ^ false ].
	^ true
%

method: Point
to: end sideOf: otherPoint
	"Returns #left, #right, #center if the otherPoint lies to the left, right or on the line given by the vector from self to end"
	^ end - self sideOf: otherPoint - self
%

method: Point
triangleArea: b with: c
	"Returns twice the area of the oriented triangle (a, b, c), i.e., the area is positive if the triangle is oriented counterclockwise"
	^ b x - self x * (c y - self y) - (b y - self y * (c x - self x))
%

category: 'interpolating'
method: Point
interpolateTo: end at: amountDone
	"Interpolate between the instance and end after the specified amount has been done (0 - 1)."

	^ self * (1 - amountDone) + (end * amountDone)
%

category: 'point functions'
method: Point
crossProduct: aPoint
	"Answer a number that is the cross product of the receiver and the argument, aPoint."

	^ (x * aPoint y) - (y * aPoint x)
%

method: Point
directionToLineFrom: p1 to: p2
	"Answer the direction of the line from the receiver position.
	< 0 => left (receiver to right)
	= => on line
	> 0 => right (receiver to left)."

	^((p2 x - p1 x) * (self y - p1 y)) - ((self x - p1 x) * (p2 y - p1 y))
%

method: Point
dotProduct: aPoint
	"Answer a number that is the dot product of the receiver and the argument, aPoint. That is, the two points are multipled and the coordinates of the result summed."

	^ (x * aPoint x) + (y * aPoint y)
%

method: Point
eightNeighbors
	^ { self + (1 @ 0) . self + (1 @ 1) .  self + (0 @ 1) . self + (-1 @ 1) . self + (-1 @ 0) .
		 self + (-1 @ -1) . self + (0 @ -1) . self + (1 @ -1)}
%

method: Point
flipBy: direction centerAt: c
	"Answer a Point which is flipped according to the direction about the point c. Direction must be #vertical or #horizontal."
	direction == #vertical ifTrue: [ ^ x @ (c y * 2 - y) ].
	direction == #horizontal ifTrue:  [^ (c x * 2 - x) @ y ].
	self error: 'unrecognizable direction'
%

method: Point
fourDirections
	"Return vertices for a square centered at 0 asPoint with the receiver as first corner.
	Returns the four rotation of the reciever in counter clockwise order with the receiver appearing last."

	^ Array with: self leftRotated
			with: self negated
			with: self rightRotated
			with: self
%

method: Point
fourNeighbors
	^ Array with: self + (1 @ 0)
		with: self + (0 @ 1)
		with: self + (-1 @ 0)
		with: self + (0 @ -1)
%

method: Point
grid: aPoint
	"Answer a Point to the nearest rounded grid modules specified by aPoint."
	| newX newY |
	newX := x + (aPoint x // 2) truncateTo: aPoint x.
	newY := y + (aPoint y // 2) truncateTo: aPoint y.
	^ newX @ newY
%

method: Point
insideTriangle: p1 with: p2 with: p3
	"Return true if the receiver is within the triangle defined by the three coordinates.
	Note: This method computes the barycentric coordinates for the receiver and tests those coordinates."

	| p0 b0 b1 b2 b3 |
	p0 := self.
	b0 := (p2 x - p1 x) * (p3 y - p1 y) - ((p3 x - p1 x) * (p2 y - p1 y)).
	b0 isZero ifTrue: [ ^ false ].	"degenerate"
	b0 := 1.0 / b0.
	b1 := ((p2 x - p0 x) * (p3 y - p0 y) - ((p3 x - p0 x) * (p2 y - p0 y))) * b0.
	b2 := ((p3 x - p0 x) * (p1 y - p0 y) - ((p1 x - p0 x) * (p3 y - p0 y))) * b0.
	b3 := ((p1 x - p0 x) * (p2 y - p0 y) - ((p2 x - p0 x) * (p1 y - p0 y))) * b0.
	b1 < 0.0 ifTrue: [ ^ false ].
	b2 < 0.0 ifTrue: [ ^ false ].
	b3 < 0.0 ifTrue: [ ^ false ].
	^ true
%

method: Point
leftRotated
	"Return the receiver rotated 90 degrees. i.e., self rotateBy: #left centerAt: 0 asPoint. Compare to transposed and normal."
	^ y  @x negated
%

method: Point
nearestPointAlongLineFrom: p1 to: p2
	"Note this will give points beyond the endpoints."

	| x21 y21 t x1 y1 |
	p1 x = p2 x ifTrue: [ ^ p1 x @ y ].
	p1 y = p2 y ifTrue: [ ^ x @ p1 y ].
	x1 := p1 x asFloat.
	y1 := p1 y asFloat.
	x21 := p2 x asFloat - x1.
	y21 := p2 y asFloat - y1.
	t := ((y asFloat - y1) / x21 + ((x asFloat - x1) / y21)) / (x21 / y21 + (y21 / x21)).
	^ (x1 + (t * x21)) @ (y1 + (t * y21))
%

method: Point
nearestPointOnLineFrom: p1 to: p2
	"This will not give points beyond the endpoints"
	^ (self nearestPointAlongLineFrom: p1 to: p2)
		adhereTo: (p1 rectangle: p2)
%

method: Point
octantOf: otherPoint
	"Return 1..8 indicating relative direction to otherPoint.
	1=ESE, 2=SSE, ... etc. clockwise to 8=ENE"

	| quad moreHoriz |
	(x = otherPoint x and: [ y > otherPoint y ]) ifTrue: [ ^ 6 ].
	"special case"
	(y = otherPoint y and: [ x < otherPoint x ]) ifTrue: [ ^ 8 ].
	quad := self quadrantOf: otherPoint.
	moreHoriz := (x - otherPoint x) abs >= (y - otherPoint y) abs.
	^ (quad even eqv: moreHoriz)
		ifTrue: [ quad * 2 ]
		ifFalse: [ quad * 2 - 1 ]
%

method: Point
quadrantOf: otherPoint
	"Return 1..4 indicating relative direction to otherPoint.
	1 is downRight, 2=downLeft, 3=upLeft, 4=upRight"
	^ x <= otherPoint x
		ifTrue: [ y < otherPoint y ifTrue: [1] ifFalse: [4] ]
		ifFalse: [ y <= otherPoint y ifTrue: [2] ifFalse: [3] ]
%

method: Point
reflectedAbout: aPoint
	"Answer a new point that is the reflection of the receiver about the given point."

	^ (self - aPoint) negated + aPoint
%

method: Point
rightRotated
	"Return the receiver rotated 90 degrees, i.e. self rotateBy: #right centerAt: 0 asPoint. Compare to transposed and normal."
	^ y negated @ x
%

method: Point
sign
	^ (x sign @ y sign)
%

method: Point
sortsBefore: otherPoint
	"Return true if the receiver sorts before the other point"
	^ y = otherPoint y
		ifTrue: [ x <= otherPoint x ]
		ifFalse: [ y <= otherPoint y ]
%

method: Point
squaredDistanceTo: aPoint
	"Answer the distance between aPoint and the receiver."
	| delta |
	delta := aPoint - self.
	^ delta dotProduct: delta
%

method: Point
transposed
	^ y @ x
%

category: 'printing'
method: Point
printOn: aStream
	"The receiver prints on aStream in terms of infix notation."

	aStream nextPut: $(.
	x printOn: aStream.
	aStream nextPut: $@.
	(y isNotNil and: [y negative])
		ifTrue: [
			"Avoid ambiguous @- construct"
			aStream space].
	y printOn: aStream.
	aStream nextPut: $)
%

category: 'private'
method: Point
bitShiftPoint: bits
	x := x bitShift: bits.
	y := y bitShift: bits
%

method: Point
setX: xValue setY: yValue
	x := xValue.
	y := yValue
%

category: 'rectangle creation'
method: Point
corner: aPoint
	"Answer a Rectangle whose origin is the receiver and whose corner is aPoint. This is one of the infix ways of expressing the creation of a rectangle."
	"(10@10 corner: 100@100) >>> (10@10 corner: 100@100)"

	^ Rectangle origin: self corner: aPoint
%

method: Point
extent: aPoint
	"Answer a Rectangle whose origin is the receiver and whose extent is aPoint. This is one of the infix ways of expressing the creation of a rectangle."

	^ Rectangle origin: self extent: aPoint
%

method: Point
rectangle: aPoint
	"Answer a Rectangle that encompasses the receiver and aPoint. This is the most general infix way to create a rectangle."

	^ Rectangle
		point: self
		point: aPoint
%

category: 'self evaluating'
method: Point
isSelfEvaluating
	^ self class == Point
%

category: 'storing'
method: Point
storeOn: aStream
	"x@y printed form is good for storing too"
	aStream nextPut: $(.
	self printOn: aStream.
	aStream nextPut: $)
%

category: 'testing'
method: Point
isFloatPoint
	"Return true if both of my x and y coordinates
	are represented by float values, otherwise false"
	"(1@2) isFloatPoint >>> false"
	"(1@2.2) isFloatPoint >>> false"
	"(1.3@2.2) isFloatPoint >>> true"
	"((1/3)@(2/2)) isFloatPoint >>> false"

	^ x isFloat and: [ y isFloat ]
%

method: Point
isInsideCircle: a with: b with: c
	"Returns true if self is inside the circle defined by the points a, b, c. See Guibas and Stolfi (1985) p.107"
	^ (a dotProduct: a)
		* (b triangleArea: c with: self) - ((b dotProduct: b)
			* (a triangleArea: c with: self)) + ((c dotProduct: c)
			* (a triangleArea: b with: self)) - ((self dotProduct: self)
			* (a triangleArea: b with: c)) > 0.0
%

method: Point
isInsideRectangle: aRectangle
	"Answer true whether the receiver is inside the argument (following Rectangle>>#containsPoint: semantics"

	"(50@50 isInsideRectangle: (0@0 corner: 100@100)) >>> true"
	"(0@0 isInsideRectangle: (0@0 corner: 100@100)) >>> true"
	"(0@10 isInsideRectangle: (0@0 corner: 100@100)) >>> true"
	"(100@100 isInsideRectangle: (0@0 corner: 100@100))>>> false"
	"(100@90 isInsideRectangle: (0@0 corner: 100@100))>>> false"

	^ aRectangle containsPoint: self
%

method: Point
isIntegerPoint
	"Return true if both of my x and y coordinates
	are represented by integer values, otherwise false"
	^ x isInteger and: [ y isInteger ]
%

method: Point
isPoint
	^ true
%

method: Point
isZero
	^ x isZero and: [ y isZero ]
%

category: 'transforming'
method: Point
adhereTo: aRectangle
	"If the receiver lies outside aRectangle, return the nearest point on the boundary of the rectangle, otherwise return self."

	(aRectangle containsPoint: self) ifTrue: [^ self].
	^ ((x max: aRectangle left) min: aRectangle right)
		@ ((y max: aRectangle top) min: aRectangle bottom)
%

method: Point
negated
	"Answer a point whose x and y coordinates are the negatives of those of the receiver."
	^ (0 - x) @ (0 - y)
%

method: Point
scaleBy: factorPoint
	"Answer a Point scaled by factor (an instance of Point)."
	 "(200@200 scaleBy: 2@3) >>> (400@600)"
	^(factorPoint x * x) @ (factorPoint y * y)
%

method: Point
scaleFrom: rect1 to: rect2
	"Produce a point stretched according to the stretch from rect1 to rect2"

	^ rect2 topLeft +
			(((x-rect1 left) * rect2 width // rect1 width)
				@ ((y-rect1 top) * rect2 height // rect1 height))
%

method: Point
scaleTo: anExtent
	"Return a Point scalefactor for shrinking a thumbnail of the receiver's extent to fit within anExtent. self and anExtent are expected to have positive nonZero x and y."
    "(200@200 scaleTo: 400@400) >>> (2.0@2.0)"
	 "(40@40 scaleTo: 400@400) >>> (10.0@10.0)"

    | factor  sX sY |
    factor :=  3.0 reciprocal. "EccentricityThreshhold reciprical"
    sX := anExtent x / self  x asFloat.
    sY :=  anExtent y / self  y asFloat.
    sX = sY ifTrue: [ ^ sX @ sY ]. "Same aspect ratio"
    ^ sX < sY
        ifTrue: [ sX @ (sX max: sY * factor) ]
        ifFalse: [ (sY max: sX * factor ) @ sY  ]
%

method: Point
translateBy: delta
	"Answer a Point translated by delta (an instance of Point)."
	"((100@200) translateBy: 5@10) >>> (105@210)"

	^ (delta x + x) @ (delta y + y)
%

category: 'truncation and round off'
method: Point
ceiling
	"Answer a Point that is the receiver's x and y ceiling. Answer the receiver if its coordinates are already integral."
	"(100@200) ceiling >>> (100@200)"
	"(100.1@200.9) ceiling >>> (101@201)"

	self isIntegerPoint ifTrue: [ ^ self ].
	^ x ceiling @ y ceiling
%

method: Point
floor
	"Answer a Point that is the receiver's x and y floor. Answer the receiver if its coordinates are already integral."
	"(100@200) floor >>> (100@200)"
	"(100.1@200.9) floor >>> (100@200)"

	self isIntegerPoint ifTrue: [ ^ self ].
	^ x floor @ y floor
%

method: Point
roundDownTo: grid
	"Answer a Point that is the receiver's x and y rounded to grid x and
	grid y by lower value (toward negative infinity)."

	| gridPoint |
	gridPoint := grid asPoint.
	^ (x roundDownTo: gridPoint x) @ (y roundDownTo: gridPoint y)
%

method: Point
roundTo: grid
	"Answer a Point that is the receiver's x and y rounded to grid x and
	grid y."

	| gridPoint |
	gridPoint := grid asPoint.
	^ (x roundTo: gridPoint x) @ (y roundTo: gridPoint y)
%

method: Point
roundUpTo: grid
	"Answer a Point that is the receiver's x and y rounded to grid x and
	grid y by upper value (toward infinity)."

	| gridPoint |
	gridPoint := grid asPoint.
	^ (x roundUpTo: gridPoint x) @ (y roundUpTo: gridPoint y)
%

method: Point
rounded
	"Answer a Point that is the receiver's x and y rounded. Answer the receiver if its coordinates are already integral."

	self isIntegerPoint ifTrue: [ ^ self] .
	^ x rounded @ y rounded
%

method: Point
truncateTo: grid
	"Answer a Point that is the receiver's x and y truncated to grid x and grid y."
	| gridPoint |
	gridPoint := grid asPoint.
	^ (x truncateTo: gridPoint x) @ (y truncateTo: gridPoint y)
%

method: Point
truncated
	"Answer a Point whose x and y coordinates are integers. Answer the receiver if its coordinates are already integral."

	self isIntegerPoint ifTrue: [ ^ self ].
	^ x truncated @ y truncated
%

category: '*GToolkit-BlocGraph-Layouts'
classmethod: Point
gtR: radius theta: angle
	^ (radius * angle cos) @ (radius * angle sin)
%

category: '*Lepiter-Store'
classmethod: Point
deSerializeAllImplementorsInstances

	^ { 1@2 }
%

classmethod: Point
leFromJsonV4Dictionary: aDictionary
	"Create a new instance of the receiver from the supplied dictionary."
	| pointString splitString |

	pointString := aDictionary at: #pointString.
	splitString := $@ split: pointString.
	^ self
		x: (Number gtReadAllFrom: splitString first)
		y: (Number gtReadAllFrom: splitString second).
%

classmethod: Point
leJsonV4MappingFor: aNeoJSONMapper
	"Points are encoded as their type and a single string in x@y format"

	aNeoJSONMapper for: self do: [ :mapping | 
		mapping
			mapProperty: #'__type' 
			getter: [ :object | object class leJsonV4Name ] 
			setter: [ :um | self error: 'Objects should not be read here' ].
		mapping 
			mapProperty: #pointString
			getter: [ :object | object x asString, '@', object y asString ]
			setter: [ :um | self error: 'Objects should not be read here' ] ].
%

classmethod: Point
leJsonV4Name

	^ #point
%

category: '*Math-Operations-Extensions'
classmethod: Point
r: rho degrees: degrees
	"Answer an instance of me with polar coordinates rho and theta."

	^ self basicNew setR: rho degrees: degrees
%

category: '*NewTools-Finder'
classmethod: Point
approvedSelectorsForMethodFinder

	^ self selectors
%

category: '*Roassal-Layouts'
classmethod: Point
r: radius theta: angle
	^ (radius * angle cos) @ (radius * angle sin)
%

category: '*System-Settings-Browser'
classmethod: Point
settingInputWidgetForNode: aSettingNode
	^ aSettingNode inputWidgetForPoint
%

category: 'instance creation'
classmethod: Point
x: xInteger y: yInteger
	"Answer an instance of me with coordinates xInteger and yInteger."

	^ self basicNew setX: xInteger setY: yInteger
%

category: 'accessing'
method: GtLACPChatElement
actionButton
 ^ actionButton
%

method: GtLACPChatElement
endMarker
 ^ endMarker ifNil: [ endMarker := GtLACPChatEndMarker new ]
%

method: GtLACPChatElement
errorLabel
 ^ errorLabel
%

method: GtLACPChatElement
inputElement
 ^ inputElement
%

method: GtLACPChatElement
listElement
 ^ listElement
%

method: GtLACPChatElement
viewModel
 ^ viewModel
%

method: GtLACPChatElement
viewModel: aViewModel
	viewModel ifNotNil: [ viewModel session announcer unsubscribe: self ].
	viewModel := aViewModel.
	self updateInputStyler.
	inputElement text: viewModel draft.
	viewModel session announcer weak
		when: GtLACPSessionChanged
		send: #onSessionChanged:
		to: self.
	viewModel session announcer weak
		when: GtLACPCommandsChanged
		send: #onCommandsChanged:
		to: self.
	self updateMessages
%

category: 'actions'
method: GtLACPChatElement
sendDraft
 | turn |
 viewModel ifNil: [ ^ self ].
 viewModel draft: inputElement text asString.
 turn := viewModel send.
 turn ifNotNil: [ inputElement text: viewModel draft ].
 self updateMessages.
 ^ turn
%

method: GtLACPChatElement
sendOrStop
 viewModel ifNil: [ ^ self ].
 viewModel canStop
  ifTrue: [ self stopTurn ]
  ifFalse: [ self sendDraft ]
%

method: GtLACPChatElement
stopTurn
 viewModel ifNotNil: [ viewModel stop. self updateControls ]
%

category: 'announcing'
method: GtLACPChatElement
onSessionChanged: anAnnouncement
 self enqueueTask: (BlTaskAction new action: [ listUpdater requestUpdate ])
%

category: 'building'
method: GtLACPChatElement
buildComposer
	| composer toolbar |
	inputElement := BrEditor new
			id: #'acp-input';
			aptitude: BrGlamorousRegularEditorAptitude;
			hMatchParent;
			vFitContentLimited;
			padding: (BlInsets all: 5);
			yourself.
	inputElement editor
		when: BrTextEditorModifiedEvent
		do: [ :event | 
			viewModel
				ifNotNil: [ viewModel draft: event text asString.
					self updateControls ] ].
	inputElement
		addShortcut: (BrEditorShortcut new
				name: 'Send message';
				description: 'Send the prompt to the ACP agent';
				combination: BlKeyCombination primaryReturn;
				performBlock: [ :editor | self sendDraft ];
				yourself).
	actionButton := BrButton new
			id: #'acp-action';
			aptitude: BrGlamorousButtonWithIconAptitude;
			beSmallSize;
			label: 'Send';
			icon: BrGlamorousVectorIcons accept;
			action: [ self sendOrStop ];
			disable;
			margin: (BlInsets all: 3);
			yourself.
	toolbar := BrHorizontalPane new
			hMatchParent;
			vFitContent;
			addChild: actionButton;
			yourself.
	composer := BrVerticalPane new
			hMatchParent;
			vFitContent;
			padding: (BlInsets all: 5);
			margin: (BlInsets
					top: 8
					bottom: 4
					left: 2
					right: 2);
			background: self theme default contentBackground;
			addAptitude: BrGlamorousFocusableShadowAptitude new;
			yourself.
	composer
		addChild: inputElement;
		addChild: toolbar.
	^ composer
%

method: GtLACPChatElement
initializeScrollFollowing
	self messageViewport
		when: BlElementLayoutComputedEvent
		do: [ :event | 
			self followStreamAfterLayout.
			self revealInteractionAfterLayout ].
	self messageViewport
		when: BlElementScrolledEvent
		do: [ :event | event delta y < 0 ifTrue: [ followEndRequested := false ] ].
	self messageViewport
		addEventFilter: (BlEventHandler
				on: BlMouseDownEvent
				do: [ :event | followEndRequested := false ])
%

category: 'initialization'
method: GtLACPChatElement
initialize
	super initialize.
	renderedVersions := IdentityDictionary new.
	followEndRequested := false.
	self
		hMatchParent;
		vMatchParent;
		padding: (BlInsets all: 3).
	errorLabel := BrEditor new
			aptitude: BrGlamorousRegularEditorAptitude;
			beReadOnlyWithSelection;
			hMatchParent;
			vFitContent;
			visibility: BlVisibility gone;
			yourself.
	listElement := BrSimpleList vertical
			hMatchParent;
			vMatchParent;
			items: OrderedCollection new;
			yourself.
	self configureMessageList.
	self initializeScrollFollowing.
	listUpdater := BrElementUpdater new
			element: self selector: #updateMessages;
			postponedDuration: 150 milliseconds;
			yourself.
	self addChild: listElement as: #'acp-messages'.
	self addChild: errorLabel as: #'acp-error'.
	self addChild: self buildComposer as: #'acp-composer'
%

category: 'lifecycle'
method: GtLACPChatElement
onRemovedFromSceneGraph
 viewModel ifNotNil: [ viewModel session announcer unsubscribe: self ].
 super onRemovedFromSceneGraph
%

category: 'navigation'
method: GtLACPChatElement
revealInteraction: aRequest
	| index |
	index := viewModel revealInteraction: aRequest.
	index ifNil: [ ^ self ].
	interactionToReveal := aRequest.
	self updateMessages.
	followEndRequested := false.
	listElement scrollToIndex: index
%

method: GtLACPChatElement
revealInteractionAfterLayout
	| target row index offset |
	interactionToReveal ifNil: [ ^ self ].
	self messageViewport
		withAllChildrenBreadthFirstDo: [ :each | 
			each id asSymbol = interactionToReveal interactionElementId
				ifTrue: [ target := each ] ].
	target ifNil: [ ^ self ].
	target := target attentionTarget.
	target height = 0 ifTrue: [ ^ self ].
	row := target.
	[ row hasParent and: [ row parent ~~ self messageViewport ] ]
		whileTrue: [ row := row parent ].
	row parent == self messageViewport ifFalse: [ ^ self ].
	index := listElement items indexOf: row viewModel.
	index = 0 ifTrue: [ ^ self ].
	offset := target bounds inSpace top - row bounds inSpace top.
	interactionToReveal := nil.
	followEndRequested := false.
	listElement scrollToIndex: index offset: 32 - offset
%

category: 'scrolling'
method: GtLACPChatElement
followStreamAfterLayout
 (followEndRequested and: [ self isAtStreamEnd not ]) ifTrue: [
  listElement scrollToItem: self endMarker ]
%

method: GtLACPChatElement
isAtStreamEnd
 listElement items isEmpty ifTrue: [ ^ true ].
 ^ self messageViewport canScrollDown not
%

method: GtLACPChatElement
messageViewport
 ^ listElement childNamed: #scrollable
%

category: 'updating'
method: GtLACPChatElement
configureMessageList
	listElement padding: (BlInsets all: 5).
	listElement
		itemId: [ :item :index | item id ];
		itemType: [ :factory :item :index | factory named: item renderingKey ];
		itemStencil: [ :type | type name first asElement ];
		itemDataBinder: [ :element :item :index | 
			(element isKindOf: GtLACPAssistantMessageElement) ifTrue: [ element refresh ].
			element id: (item elementIdAt: index) ]
%

method: GtLACPChatElement
onAddedToSceneGraph
	super onAddedToSceneGraph.
	viewModel
		ifNotNil: [ viewModel session announcer unsubscribe: self.
			viewModel session announcer weak
				when: GtLACPSessionChanged
				send: #onSessionChanged:
				to: self.
			viewModel session announcer weak
				when: GtLACPCommandsChanged
				send: #onCommandsChanged:
				to: self.
			listUpdater requestUpdate ]
%

method: GtLACPChatElement
onCommandsChanged: anAnnouncement
	self enqueueTask: (BlTaskAction new action: [ self updateInputStyler ])
%

method: GtLACPChatElement
updateControls
	| error |
	viewModel ifNil: [ ^ self ].
	viewModel session isPrompting
		ifTrue: [ actionButton
				label: (viewModel canStop ifTrue: [ 'Stop' ] ifFalse: [ 'Stopping…' ]);
				icon: BrGlamorousVectorIcons stop.
			viewModel canStop
				ifTrue: [ actionButton enable ]
				ifFalse: [ actionButton disable ] ]
		ifFalse: [ actionButton
				label: 'Send';
				icon: BrGlamorousVectorIcons accept.
			viewModel canSend
				ifTrue: [ actionButton enable ]
				ifFalse: [ actionButton disable ] ].
	(viewModel session isSubagent or: [ viewModel session isClosed ])
		ifTrue: [ inputElement beReadOnlyWithSelection ]
		ifFalse: [ inputElement beEditable ].
	actionButton
		visibility: ((viewModel session isSubagent and: [ viewModel canStop not ])
				ifTrue: [ BlVisibility gone ]
				ifFalse: [ BlVisibility visible ]).
	inputElement
		visibility: (viewModel session isSubagent
				ifTrue: [ BlVisibility gone ]
				ifFalse: [ BlVisibility visible ]).
	(self childNamed: #'acp-composer')
		visibility: ((viewModel session isSubagent and: [ viewModel canStop not ])
				ifTrue: [ BlVisibility gone ]
				ifFalse: [ BlVisibility visible ]).
	error := viewModel errorText.
	errorLabel text: error.
	errorLabel
		visibility: (error isEmpty ifTrue: [ BlVisibility gone ] ifFalse: [ BlVisibility visible ])
%

method: GtLACPChatElement
updateInputStyler
	| styler |
	styler := GtLACPInputStyler new session: viewModel session.
	inputElement
		styler: (BlCompositeStyler new
				stylers: {GtLMessageStyler new.
						styler});
		completionStrategy: styler completionStrategy
%

method: GtLACPChatElement
updateMessages
	| items previous follow source oldCount changed versions |
	viewModel ifNil: [ ^ self ].
	follow := followEndRequested or: [ self isAtStreamEnd ].
	items := viewModel messageViewModels.
	versions := items collect: #renderingVersion.
	previous := listElement items.
	oldCount := previous size - 1.
	(oldCount >= 0
		and: [ previous last == self endMarker
				and: [ oldCount <= items size
						and: [ (1 to: oldCount)
								allSatisfy: [ :index | (previous at: index) == (items at: index) ] ] ] ])
		ifFalse: [ followEndRequested := follow and: [ items notEmpty ].
			listElement
				items: (items asOrderedCollection
						add: self endMarker;
						yourself).
			renderedVersions removeAll.
			items
				withIndexDo: [ :item :index | renderedVersions at: item put: (versions at: index) ].
			self updateControls.
			self followStreamAfterLayout.
			^ self ].
	changed := (1 to: oldCount)
			select: [ :index | 
				| item |
				item := items at: index.
				(renderedVersions at: item) ~= (versions at: index) ].
	followEndRequested := follow and: [ items notEmpty ].
	items
		withIndexDo: [ :item :index | renderedVersions at: item put: (versions at: index) ].
	source := self messageViewport dataSource.
	items size > oldCount
		ifTrue: [ previous removeLast.
			previous addAll: (items copyFrom: oldCount + 1 to: items size).
			previous add: self endMarker.
			source notifyItemsInserted: (oldCount + 1 to: items size) ].
	changed do: [ :index | source notifyItemsChanged: (index to: index) ].
	self updateControls.
	self followStreamAfterLayout
%

