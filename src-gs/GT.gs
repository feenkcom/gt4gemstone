category: 'private'
method: MAStringWriter
defaultWriteStream
	^ WriteStream on: String new
%

method: MAStringWriter
printObjectDescribedBy: aDescription

	| string |
	string := aDescription displayStringFor: self object.
	self stream nextPutAll: string.
%

category: 'visiting'
method: MAStringWriter
write: anObject description: aDescription to: aStream
	^ anObject 
		ifNil: [ 
			aStream
				nextPutAll: aDescription undefined;
				contents ]
		ifNotNil: [ super write: anObject description: aDescription to: aStream ].
%

category: 'visiting-description'
method: MAStringWriter
visitBooleanDescription: aDescription
	self stream nextPutAll: (self object
		ifTrue: [ aDescription trueString ]
		ifFalse: [ aDescription falseString ])
%

method: MAStringWriter
visitColorDescription: aDescription
	stream nextPut: $#.
	stream nextPutAll: ((255 * self object red) asInteger
		printPaddedWith: $0 to: 2 base: 16).
	stream nextPutAll: ((255 * self object green) asInteger
		printPaddedWith: $0 to: 2 base: 16).
	stream nextPutAll: ((255 * self object blue) asInteger
		printPaddedWith: $0 to: 2 base: 16)
%

method: MAStringWriter
visitContainer: aDescription
	aDescription 
		do: [ :each |
			each isVisible ifTrue: [
				each stringWriter
					write: (self object readUsing: each)
					description: each to: stream ] ]
		separatedBy: [ stream nextPut: $- ]
%

method: MAStringWriter
visitElementDescription: aDescription
	self printObjectDescribedBy: aDescription
%

method: MAStringWriter
visitMultipleOptionDescription: aDescription
	self object isEmpty
		ifTrue: [ self stream nextPutAll: aDescription undefined ]
		ifFalse: [
			self object
				do: [ :each | self stream nextPutAll: (aDescription labelForOption: each) ]
				separatedBy: [ self stream nextPutAll: ', ' ] ]
%

method: MAStringWriter
visitSingleOptionDescription: aDescription
	self stream nextPutAll: (aDescription labelForOption: self object)
%

method: MAStringWriter
visitTimeStampDescription: aDescription
	self stream print: self object asDate; space.
	self stream print: self object asTime
%

method: MAStringWriter
visitToManyRelationDescription: aDescription
	self object
		do: [ :each | self stream nextPutAll: (aDescription reference toString: each) ]
		separatedBy: [ self stream nextPutAll: ', ' ]
%

method: MAStringWriter
visitToOneRelationDescription: aDescription
	self stream nextPutAll: (aDescription reference toString: self object)
%

method: MAStringWriter
visitTokenDescription: aDescription
	self object
		do: [ :each | self object: each during: [ self visit: aDescription reference ] ]
		separatedBy: [ self stream nextPut: aDescription separators first ]
%

category: 'accessing'
method: GtLRefactoringChangeTargets
classNameAfterChangesFor: aClassName
	"Return the name under which the class named aClassName exists once the changes are applied"

	| aName visited |
	aName := aClassName asString.
	visited := Set new.
	[ (classRenames includesKey: aName) and: [ (visited includes: aName) not ] ]
		whileTrue: [ visited add: aName.
			aName := classRenames at: aName ].
	^ aName
%

method: GtLRefactoringChangeTargets
classNames
	"Return the names (as known before applying the changes) of the affected classes"

	^ classNames
%

method: GtLRefactoringChangeTargets
classRenames
	"Return a dictionary mapping old class names to new class names"

	^ classRenames
%

method: GtLRefactoringChangeTargets
methodReferences
	"Return the references (as known before applying the changes) of the affected methods"

	^ methodReferences
%

category: 'adding'
method: GtLRefactoringChangeTargets
addClassNamed: aClassName
	"Add the instance side class named aClassName, unless it is already present"

	| aString |
	aClassName ifNil: [ ^ self ].
	aString := aClassName asString.
	(classNames includes: aString) ifFalse: [ classNames add: aString ]
%

method: GtLRefactoringChangeTargets
addMethodNamed: aSelector inClassNamed: aClassName isMeta: aBoolean
	"Add the method and its (instance side) class"

	| aReference |
	(aSelector isNil or: [ aClassName isNil ]) ifTrue: [ ^ self ].
	aReference := GtLMethodReference new
			methodClassName: aClassName asString;
			methodName: aSelector asString;
			classSide: aBoolean = true;
			yourself.
	(methodReferences includes: aReference)
		ifFalse: [ methodReferences add: aReference ].
	self addClassNamed: aClassName
%

method: GtLRefactoringChangeTargets
addRemovedClassNamed: aClassName
	"Add a class that is going to be removed, together with its subclasses
	and all their local methods on both sides, so that the removed methods can be reported"

	| aClass |
	self addClassNamed: aClassName.
	aClass := Smalltalk globals classNamed: aClassName asString.
	(aClass notNil and: [ aClass isBehavior ]) ifFalse: [ ^ self ].
	aClass instanceSide withAllSubclasses
		do: [ :eachClass | 
			self addClassNamed: eachClass name.
			{eachClass.
				eachClass classSide}
				do: [ :eachBehavior | 
					eachBehavior localSelectors asSortedCollection
						do: [ :eachSelector | 
							self
								addMethodNamed: eachSelector
								inClassNamed: eachClass name
								isMeta: eachBehavior isClassSide ] ] ]
%

method: GtLRefactoringChangeTargets
addTargetsOfChange: aRefactoryChange
	aRefactoryChange gtLlmAddChangeTargetsTo: self
%

method: GtLRefactoringChangeTargets
renameClassNamed: anOldName to: aNewName
	"Record a class rename, so that the snapshot taken after applying the changes
	looks the class (and its methods) up under the new name"

	(anOldName isNil or: [ aNewName isNil ]) ifTrue: [ ^ self ].
	classRenames at: anOldName asString put: aNewName asString.
	self addClassNamed: anOldName
%

category: 'initialization'
method: GtLRefactoringChangeTargets
initialize
	super initialize.
	methodReferences := OrderedCollection new.
	classNames := OrderedCollection new.
	classRenames := Dictionary new
%

category: 'printing'
method: GtLRefactoringChangeTargets
printOn: aStream
	super printOn: aStream.
	aStream
		parenthesize: [ aStream
				print: methodReferences size;
				nextPutAll: ' methods, ';
				print: classNames size;
				nextPutAll: ' classes' ]
%

category: 'snapshots'
method: GtLRefactoringChangeTargets
snapshotAfterChanges
	"Take a snapshot of the affected methods and classes, looking renamed classes up under their new names.
	Call me after applying the changes."

	^ GtLCodeSnapshot
		forTargets: self
		classNameMapping: [ :aClassName | self classNameAfterChangesFor: aClassName ]
%

method: GtLRefactoringChangeTargets
snapshotBeforeChanges
	"Take a snapshot of the affected methods and classes under their current names.
	Call me before applying the changes."

	^ GtLCodeSnapshot
		forTargets: self
		classNameMapping: [ :aClassName | aClassName ]
%

category: 'testing'
method: GtLRefactoringChangeTargets
isEmpty
	^ methodReferences isEmpty and: [ classNames isEmpty ]
%

category: 'views'
method: GtLRefactoringChangeTargets
gtTargetsFor: aView
	<gtView>
	^ aView columnedList
		title: 'Targets';
		priority: 10;
		items: [ (classNames
				collect: [ :each | 
					'Class'
						-> ((classRenames includesKey: each)
								ifTrue: [ each , ' -> ' , (self classNameAfterChangesFor: each) ]
								ifFalse: [ each ]) ])
				, (methodReferences collect: [ :each | 'Method' -> each methodSignature ]) ];
		column: 'Kind'
			text: [ :each | each key ]
			width: 80;
		column: 'Target' text: [ :each | each value ]
%

category: 'instance creation'
classmethod: GtLRefactoringChangeTargets
forChange: aRefactoryChange
	"Collect the methods and classes affected by aRefactoryChange.
	This must be done before the change is applied."

	^ self new
		addTargetsOfChange: aRefactoryChange;
		yourself
%

category: 'examples'
method: GtLUnexpectedDomainObjectExamples
basicUnexpectedDomainObject
	<gtExample>
	<return: #GtLUnexpectedDomainObject>
	| domainObject |
	domainObject := GtLUnexpectedDomainObject new
		objectName: 'ExistingClass';
		yourself.
	self assert: domainObject objectName equals: 'ExistingClass'.
	self assert: domainObject messageText equals: 'ExistingClass already exists'.
	self assert: domainObject isErrorDomainObject.
	^ domainObject
%

method: GtLUnexpectedDomainObjectExamples
emptyUnexpectedDomainObject
	<gtExample>
	<return: #GtLUnexpectedDomainObject>
	| domainObject compositeView dataBlock jsonData expectedJson |
	
	domainObject := GtLUnexpectedDomainObject new.
	self assert: domainObject objectName isNil.
	self assert: domainObject messageText equals: 'nil already exists'.
	
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock compositeJsonData.
	expectedJson := {
		#objectName -> nil.
		#messageText -> 'nil already exists'
	} asDictionary.
	self assert: jsonData equals: expectedJson.
	
	^ domainObject
%

method: GtLUnexpectedDomainObjectExamples
unexpectedDomainObjectDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| domainObject compositeView dataBlock expectedJson |
	
	domainObject := self basicUnexpectedDomainObject.
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	expectedJson := {
		#objectName -> 'ExistingClass'.
		#messageText -> 'ExistingClass already exists'
	} asDictionary.
	self assertDataBlock: dataBlock hasLlmJsonData: expectedJson.
	
	^ dataBlock
%

