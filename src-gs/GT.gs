%

method: MAMemoryFileModel
contents: aByteArray
	super contents: aByteArray.
	contents := aByteArray asByteArray
%

category: 'comparing'
method: MAMemoryFileModel
= anObject
    ^ super = anObject and: [ self contents = anObject contents ]
%

method: MAMemoryFileModel
hash
	^ super hash bitXor: self contents hash
%

category: 'initialization'
method: MAMemoryFileModel
finalize
	super finalize.
