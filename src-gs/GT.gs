category: 'comparing'
method: GtLSerializedSlotInfo
= anObject
	self == anObject ifTrue: [ ^ true ].
	self class = anObject class ifFalse: [ ^ false ].
	^ name = anObject name
		and: [ valueClassName = anObject valueClassName
			and: [ valuePrintString = anObject valuePrintString ] ]
