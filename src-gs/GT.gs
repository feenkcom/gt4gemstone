category: 'assertions'
method: GtLPrimitiveDataBlockExamples
assertSerializationForDataBlock: aDataBlock dataPartsCount: expectedSize
	"Assert that all LLM serialization methods return arrays of the expected size.
	This ensures consistency across different LLM providers (Anthropic, OpenAI, Bedrock, etc.)."
	
	| pragmas |
	pragmas := Pragma
		allNamed: #llmSerialization:
		from: aDataBlock class
		to: Object.
	
	self assert: pragmas isNotEmpty description: 'Data block should have LLM serialization methods'.
	
	pragmas do: [ :eachPragma |
		| result llmName |
		llmName := eachPragma arguments first.
		result := aDataBlock perform: eachPragma methodSelector.
		self 
			assert: result size = expectedSize
			description: ('Serialization for {1} should return array of size {2}, but got {3}' 
				format: { llmName. expectedSize. result size }) ]
%

method: GtLPrimitiveDataBlockExamples
assertSerializationForDataBlockWithOneDataPart: aDataBlock
	self assertSerializationForDataBlock: aDataBlock dataPartsCount: 1
%

method: GtLPrimitiveDataBlockExamples
assertSerializationForDataBlockWithTwoDataParts: aDataBlock
	self assertSerializationForDataBlock: aDataBlock dataPartsCount: 2
%

category: 'converting'
method: SortFunction
, aSortFunction
	"Return a new SortFunction which is the concatenation of aSortFunction to me, I will be the primary sort, but if I compare equal, I will defer to the argument."

	^ChainedSortFunction startWith: self then: aSortFunction asSortFunction
%

method: SortFunction
asSortFunction

	^self
%

method: SortFunction
reversed
	"Return new sort function with reverse sort order."

	^ReverseSortFunction on: self
%

method: SortFunction
undefinedFirst
	"Return a new SortFunction that sort all the nil first, an non nil with myself."
	^(UndefinedSortFunction on: self) undefinedFirst
%

method: SortFunction
undefinedLast
	"Return a new SortFunction that sort all the nil last, an non nil with myself."
	^(UndefinedSortFunction on: self) undefinedLast
%

category: 'evaluating'
method: SortFunction
collate: anObject1 with: anObject2
	"Do a three-way comparison between the anObject1 and anObject2, returning
	-1 if anObject1 < anObject2
	0 if anObject1 = anObject2
	1 if anObject1 > anObject2
	This assumes a total order in accordance with the mathematical law of trichotomy.
	See also:  http://en.wikipedia.org/wiki/Three-way_comparison"
	self subclassResponsibility
%

method: SortFunction
value: anObject1 value: anObject2
	"Masquerade as a two argument block, used by many of the sorting APIs,
	by returning whether anObject1 should be placed before anObject2 or not"

	| result |
	result := self collate: anObject1 with: anObject2.
	^result <= 0
%

