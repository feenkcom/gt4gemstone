				 at: #key1 at: #key2 put: 23;
				 at: #key1 at: #key2)
		equals: 23.

	dictionary keysAndValuesDo: [ :key :value |
		self
			assert: key equals: #key1;
			assert: (value at: #key2) equals: 23 ]
