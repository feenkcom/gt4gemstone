method: GtLACPWorkGraph
laneFor: aSession
	^ laneBySession
		at: aSession
		ifAbsentPut: [ | lane |
			lane := GtLACPWorkGraphLane new
					object: aSession;
					index: lanes size;
					yourself.
			lanes add: lane.
			lane ]
