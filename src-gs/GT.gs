method: Point
- arg
	"Answer a Point that is the difference of the receiver and arg."
	"((2@2) - (100@200)) >>> (-98@ -198)"
	"((2@2) - 200) >>> (-198@ -198)"

	arg isPoint ifTrue: [^ (x - arg x) @ (y - arg y)].
