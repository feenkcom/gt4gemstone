category: 'gt - extensions'
method: GtLValueSerializerResult
gtInputViewFor: aView context: aContext
	<gtView>
	| aNewView |
	aNewView := inputViewStencilBuilder
			object: self input;
			originalView: aView;
			context: aContext;
			build.

	aNewView
		priority: 2;
		title: 'Input'.
	^ aNewView
%

method: GtLValueSerializerResult
gtOutputViewFor: aView context: aContext
	<gtView>
	| aNewView |
	aNewView := outputViewStencilBuilder
			object: self output;
			originalView: aView;
			context: aContext;
			build.

	aNewView
		priority: 1;
		title: 'Output'.
	^ aNewView
%

category: 'initialization'
