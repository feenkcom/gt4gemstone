category: 'lifecycle'
method: GtLACPClient
stop
 connections do: #stop
%

category: 'private - lifecycle'
method: GtLACPClient
restartConnection: aConnection in: aDirectory
	"Keep the connection and its subscribers; replace only the stopped transport."

	aConnection isStopped
		ifFalse: [ self error: 'Only a stopped connection can be restarted' ].
	configuration validate.
	aConnection
		requestTimeout: configuration requestTimeout;
		transport: (transportFactory value: configuration value: aDirectory);
		lastError: nil.
	[ aConnection start.
	configuration authenticationMethod
		ifNotNil: [ :method | aConnection authenticate: method ] ]
		on: Error
		do: [ :error | 
			aConnection stop.
			error pass ].
	^ aConnection
%

category: 'sessions'
method: GtLACPClient
applyPreferencesTo: aSession
 configuration mode ifNotNil: [ :value | aSession setMode: value ].
 configuration model ifNotNil: [ :value | aSession setModel: value ]
%

method: GtLACPClient
connectionIn: aDirectory
 | aConnection |
 configuration validate.
 aConnection := GtLACPConnection new
  requestTimeout: configuration requestTimeout;
  transport: (transportFactory value: configuration value: aDirectory);
  yourself.
 connections add: aConnection.
 [ aConnection start.
 configuration authenticationMethod ifNotNil: [ :method | aConnection authenticate: method ] ]
  on: Error do: [ :ex | aConnection stop. ex pass ].
 ^ aConnection
%

method: GtLACPClient
loadSession: anId in: aDirectory
 | aConnection aSession |
 aDirectory asFileReference isDirectory ifFalse: [ self error: 'Session directory must exist' ].
 aConnection := self connectionIn: aDirectory asFileReference asAbsolute.
 [ aSession := self newSessionIn: aDirectory connection: aConnection.
 aSession load: anId ]
 on: Error do: [ :ex | aConnection stop. ex pass ].
 ^ aSession
%

method: GtLACPClient
newSessionIn: aDirectory connection: aConnection
	| aSession |
	aSession := GtLACPSession new
			client: self;
			directory: aDirectory asFileReference asAbsolute;
			connection: aConnection;
			yourself.
	sessions add: aSession.
	^ aSession
%

method: GtLACPClient
startSessionIn: aDirectory
	^ self startSessionIn: aDirectory onCreated: [ :aSession |  ]
%

method: GtLACPClient
startSessionIn: aDirectory onCreated: aBlock
	"Expose the local session before waiting for session/new and preferences."

	| aReference aConnection aSession |
	aReference := aDirectory asFileReference asAbsolute.
	aReference isDirectory ifFalse: [ self error: 'Session directory must exist' ].
	aConnection := self connectionIn: aReference.
	[ aSession := self newSessionIn: aReference connection: aConnection.
	aBlock value: aSession.
	aSession create.
	self applyPreferencesTo: aSession ]
		on: Error
		do: [ :ex | 
			aConnection stop.
			ex pass ].
	^ aSession
%

