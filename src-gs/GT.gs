method: GtLACPToolCallExamples
outputViewWithString
	<gtExample>
	| call output view |
	output := '{' , String lf , String tab , '"code": "s contents",' , String lf
			, String tab , '"errorDetails": {"stackTrace": "first\nsecond"}' , String lf
			, '}'.
	call := GtLACPToolCall new
