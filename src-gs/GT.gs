method: GtLEntity
gtViewRawDataFor: aView
	<gtView>
	self rawData ifNil: [^ aView empty ].

	^ aView forward
		title: 'Raw data';
		priority: 20;
		object: [ self rawData ];
		view: #gtTreeFor:
%

method: GtLEntity
rawData
	^ rawData
%

method: GtLEntity
rawData: anObject
	rawData := anObject
