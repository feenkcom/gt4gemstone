	"Creates multiple snippets of different types: Text, Pharo, Python, Shell"
	| call targetObject tool page |
	tool := self toolOnLogicalDatabase.
	page := self pageInLogicalDatabase.
	
	call := self
		executeTool: tool
		withArguments: {
			'snippets' -> {
				Dictionary new
					at: 'TextSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'snippetText' put: 'Introduction text';
						yourself);
					yourself.
				Dictionary new
					at: 'PharoSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'pharoCode' put: '1 + 2';
						yourself);
					yourself.
				Dictionary new
					at: 'PythonSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'pythonCode' put: 'x = 42';
						yourself);
					yourself.
				Dictionary new
					at: 'ShellSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'shellCode' put: 'ls -la';
						yourself);
					yourself
			}
		} asDictionary.
	targetObject := call result targetObject.
	
	self assert: targetObject snippets size equals: 4.
	self assert: (targetObject snippets allSatisfy: [ :each | each status = 'created' ]).
	
	^ call
%

method: GtLToolForLepiterSnippetsCreateExamples
successfulNestedSnippetCreate
	<gtExample>
	| call targetObject childSnippets tool page parentSnippet childSnippet |
	tool := self toolOnLogicalDatabase.
	page := self pageInLogicalDatabase.
	parentSnippet := page snippetBuilder
		string: 'Parent snippet text';
		add.
	
	call := self
		executeTool: tool
		withArguments: {
			'snippets' -> {
				Dictionary new
					at: 'PharoSnippet'
					put: (Dictionary new
						at: 'pageUid' put: page uidString;
						at: 'parentSnippetUid' put: parentSnippet uidString;
						at: 'pharoCode' put: 'Transcript show: 1';
						yourself);
					yourself
			}
		} asDictionary.
	targetObject := call result targetObject.
	self assert: (targetObject isKindOf: GtLLepiterSnippetsDomainObject).
	childSnippets := targetObject snippets.
	self assert: childSnippets size equals: 1.
	
	self assert: page children size equals: 1.
	self assert: parentSnippet children size equals: 1.
	childSnippet := parentSnippet children anyOne.
	self assert: childSnippet uidString equals: childSnippets anyOne snippetUid.
	
	^ call
%

