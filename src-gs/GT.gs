method: GtLOpenAiResponsesExamples
equivalentProviderReusesNativeCompaction
	<gtExample>
	| originatingProvider replacementProvider chat output message serialized |

	originatingProvider := GtLOpenAiResponsesProvider new.
	replacementProvider := GtLOpenAiResponsesProvider new.
	chat := GtLChat new provider: originatingProvider.
	output := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'opaque-data'
	} asDictionary.
	message := GtLModelCompactionMessage new.
	message rawData: output for: originatingProvider; chat: chat.

	chat provider: replacementProvider.
	self assert: message hasResponse.
	serialized := GtLOpenAiResponsesMessageVisitor new chatMessage: message.

	self assert: serialized == output.
	self assert: message providerForSerialization == replacementProvider.
	^ serialized
%

method: GtLOpenAiResponsesExamples
independentCopyOfServerSideCompactionMessage
	<gtExample>
	<return: #GtLModelCompactionMessage>
	| original provider equivalentProvider output copied |

	original := self opaqueServerSideCompactionMessage.
	provider := GtLOpenAiResponsesProvider new.
	output := original rawData.
	copied := original copyForIndependentRequestInChat: nil.

	self assert: copied ~~ original.
	self
		assert: (copied providerDataFor: provider ifAbsent: [ nil ])
		== output.

	equivalentProvider := GtLOpenAiResponsesProvider new.
	self
		assert: (copied providerDataFor: equivalentProvider ifAbsent: [ nil ])
		== output.
	copied providerData: Dictionary new for: equivalentProvider.
	self assert: original rawData == output.
	^ copied
%

method: GtLOpenAiResponsesExamples
opaqueServerSideCompactionMessage
	<gtExample>
	<return: #GtLModelCompactionMessage>
	| provider output message |

	provider := GtLOpenAiResponsesProvider new.
	output := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'opaque-data'
	} asDictionary.

	message := GtLModelCompactionMessage new.
	message rawData: output for: provider.

	self assert: (message providerDataFor: provider ifAbsent: [ nil ]) == output.
	self assert: message rawData == output.
	self assert: message content equals: #().
	self assert: message contentText equals: ''.
	self deny: message hasContent.
	self assert: message hasResponse.
	self assert: message isServerSideCompactionOutput.

	^ message
%

method: GtLOpenAiResponsesExamples
portableCompactionSwitchesFromOpenAiToOllama
	<gtExample>
	| openAi ollama chat message serialized |

	openAi := GtLOpenAiResponsesProvider new.
	ollama := GtLOllamaProvider new.
	ollama completions.
	chat := GtLChat new provider: openAi.
	message := GtLModelCompactionMessage new.
	message
		rawData: Dictionary new for: openAi;
		portableContentText: 'portable summary';
		chat: chat.

	self assert: message hasResponse.
	chat provider: ollama.
	self deny: message hasResponse.
	serialized := GtLOllamaCompletionsMessageVisitor new chatMessage: message.

	self assert: (serialized at: 'role') equals: 'assistant'.
	self
		assert: (((serialized at: 'content') first) at: 'text')
		equals: 'portable summary'.
	self assert: message providerForSerialization == ollama.
	^ serialized
%

method: GtLOpenAiResponsesExamples
serializeServerSideCompactionMessage
	<gtExample>
	| provider chat output message serialized |

	provider := GtLOpenAiResponsesProvider new.
	chat := GtLChat new provider: provider.
	output := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'opaque-data'
	} asDictionary.
	message := GtLModelCompactionMessage new.
	message rawData: output for: provider; chat: chat.

	serialized := GtLOpenAiResponsesMessageVisitor new
		chatMessage: message.

