category: 'private'
method: GtLMagritteToolForClassCreation
createClassFromRequest: aRequest
		| className superclassName superclass packageName traitComposition variables createdClass description |
	(aRequest isKindOf: GtLTraitCreationRequest)
		ifTrue: [ ^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait creation' ].
	className := (aRequest targetClassName ifNil: [ '' ]) asString trimBoth.
	className isEmpty ifTrue: [ ^ GtLMissingDomainObject new objectName: 'targetClassName' ].
	(GsSession currentSession objectNamed: className asSymbol) notNil
		ifTrue: [ ^ GtLUnexpectedDomainObject new objectName: className ].
	superclassName := (aRequest superclassName ifNil: [ '' ]) asString trimBoth.
	superclassName = 'Trait'
		ifTrue: [ ^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait creation' ].
	superclassName isEmpty ifTrue: [ ^ GtLMissingDomainObject new objectName: 'superclassName' ].
	superclass := GsSession currentSession objectNamed: superclassName asSymbol.
	superclass ifNil: [ ^ GtLMissingDomainObject new objectName: superclassName ].
	packageName := (aRequest package ifNil: [ '' ]) asString trimBoth.
	packageName isEmpty ifTrue: [ ^ GtLMissingDomainObject new objectName: 'package' ].
	traitComposition := (aRequest traitCompositionString ifNil: [ '' ]) asString trimBoth.
	(traitComposition isEmpty or: [ traitComposition = '{}' ]) ifFalse: [
		^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait composition' ].
	variables := [ :value | value ifNil: [ #() ] ifNotNil: [
		value isString
			ifTrue: [ value asString subStrings ]
			ifFalse: [ value collect: [ :each | each asString ] ] ] ].
	[
		createdClass := superclass
			subclass: className asSymbol
			instVarNames: (variables value: aRequest instanceVariables)
			classVars: (variables value: aRequest classVariables)
			classInstVars: (variables value: aRequest classInstanceVariables)
			poolDictionaries: #()
			category: packageName
			inDictionary: System myUserProfile symbolList first
			options: #().
		ClassOrganizer gtDefault addClass: createdClass.
		aRequest comment ifNotNil: [ :comment | createdClass comment: comment asString trimBoth ].
		description := GtLClassDefinitionDescription new
			currentClassName: createdClass name asString;
			superclassName: superclass name asString;
			comment: createdClass comment;
			packageName: createdClass category;
			packageTagName: nil;
			instanceSlotNames: (createdClass instVarNames collect: [ :each | each asString ]);
			classSlotNames: (createdClass class instVarNames collect: [ :each | each asString ]);
			classVariableNames: (createdClass classVarNames collect: [ :each | each asString ]);
			traitCompositionString: '{}';
			yourself
	] on: Error do: [ :error | ^ GtLProblemDomainObject new errorMessage: error description ].
	^ GtLClassModificationResult new
		originalClass: nil;
		updatedClass: description;
		yourself
%

category: 'serialization'
method: GtLWrappedObjectModel
serializeForMCPResponseOutput
		"Serialize domain models without the Pharo data-view collector."
	^ {NeoJSONObject new
		at: 'type' put: 'text';
		at: 'text' put: ((self model respondsTo: #llmJsonObject)
			ifTrue: [ NeoJSONWriter toString: self model llmJsonObject ]
			ifFalse: [ (GtMagritteJSONDataExporter forObject: self model) exportObjectAsJsonString ]);
		yourself}
%

category: 'accessing'
method: GsNMethod
gtExample
	self gtExamplesFactory exampleMethod: self do: [ :example | ^ example ].
	^ nil
%

category: 'accessing'
method: GsNMethod
gtExampleReturnValueClass
	| returnValue |
	returnValue := self gtExample result returnValue.
	(returnValue isKindOf: Exception)
		ifTrue: [ ReturnPragmasRefactoringError
				signal: 'An  example failed'
				failingExample: self ].
	^ returnValue class
%

category: 'accessing'
method: GsNMethod
gtExampleValue
	^ self gtExample returnValue
%

category: 'accessing'
method: GsNMethod
gtExampleWithProviderClass: aProviderClass
	self gtExamplesFactory
		exampleFromMethod: self
		withProviderClass: aProviderClass
		do: [ :example | ^ example ].
	^ nil
%

category: 'accessing'
method: GsNMethod
gtExampleWithResult
	"GemStone does not support compiled-method properties or Pharo weak references."
	| anExample |
	anExample := self gtExample.
	^ anExample ifNotNil: [ anExample asExampleWithResult ]
%

category: 'accessing'
method: GsNMethod
gtExampleWithResultForExample: anExample
	"GemStone does not support compiled-method properties or Pharo weak references."
	self
		assert: [ anExample receiverClass ~= anExample methodClass ]
		description: [ 'Example provider and method classes must be different. Call anExample asCachedExampleWithResult instead' ].
	self
		assert: [ anExample exists and: [ anExample method = self ] ]
		description: [ 'I can be called only with examples that represents me. Call anExample asCachedExampleWithResult instead' ].
	^ anExample asExampleWithResult
%

category: 'accessing'
method: GsNMethod
gtExamples
	^ self gtExample
		ifNotNil: [ :example | { example } ]
		ifNil: [ #() ]
%

category: 'accessing'
method: GsNMethod
gtExamplesFactory
	^ self methodClass instanceSide gtExamplesFactory
%

category: 'testing'
method: GsNMethod
isGTExampleMethod
	^ (self pragmas anySatisfy: [ :each | each isGTExamplePragma ])
		and: [ self numArgs = 0 ]
%

category: 'accessing'
method: GsNMethod
methodClass
	^ self inClass
%

category: '*GToolkit-Examples'
method: Pragma
isGTExamplePragma
	^ self keyword = #gtExample or: [ self keyword = #gtExample: ]
%

category: 'private'
method: GtLMagritteToolForMethodsRemoval
removeMethodFromDescriptor: methodDescriptor
	 | className targetClass behavior selector removedMethod classDescription |
 className := methodDescriptor methodClassName.
 className = 'Trait' ifTrue: [
 ^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait modification' ].
 targetClass := GsSession currentSession objectNamed: className asSymbol.
 targetClass ifNil: [ ^ GtLMissingDomainObject new objectName: className ].
 targetClass isBehavior ifFalse: [ ^ GtLProblemDomainObject new errorMessage: 'Target must be a class' ].
 targetClass isTrait ifTrue: [
 ^ GtLProblemDomainObject new errorMessage: 'GemStone does not support Trait modification' ].
 behavior := methodDescriptor isClassSide ifTrue: [ targetClass class ] ifFalse: [ targetClass ].
 selector := methodDescriptor methodName asSymbol.
 (behavior includesSelector: selector environmentId: 0) ifFalse: [
 ^ GtLMissingDomainObject new objectName: methodDescriptor methodSignature ].
 removedMethod := GtLMethodWithSource new
 methodReference: methodDescriptor;
 sourceCode: (behavior compiledMethodAt: selector environmentId: 0) sourceString;
 yourself.
 classDescription := GtLClassDefinitionDescription fromClass: targetClass.
 [ behavior removeSelector: selector environmentId: 0 ]
 on: Error do: [ :error |
 ^ GtLExceptionDomainObject new
 freeze: error;
 errorReason: 'Error while removing method' ].
 ^ GtLMethodRemovalResult new
 targetClass: classDescription;
 removedMethod: removedMethod;
 status: 'removed';
 yourself
%

category: 'visiting-description'
method: GtMagriteJSONDataCreationVisitor
visitToOneRelationDescription: aDescription
		| result visitor |
	result := self currentObject perform: aDescription accessor readSelector.
	result ifNil: [ ^ jsonResult := nil ].
	visitor := GtMagriteJSONDataCreationVisitor new currentObject: result.
	result magritteDescription acceptMagritte: visitor.
	^ jsonResult := visitor jsonResult
%

