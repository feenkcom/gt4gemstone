	self phlowView title ifNil: [ ^ self ].

	aStream
		nextPut: $(;
		nextPutAll: self phlowView title asString;
		nextPut: $)
%

category: 'views'
method: GtLPhlowViewDomainObject
gtLivePhlowViewFor: aView
	<gtView>
	<gtLlmView>
	^ aView explicit
		title: 'Phlow view';
		priority: 1;
		stencil: [ | container viewParent |
			viewParent := phlowViewForm asElement asCanvassableElement
					margin: (BlInsets all: 10);
					background: Color white;
					aptitude: BrShadowAptitude;
					constraintsDo: [ :c | 
						c horizontal matchParent.
						c vertical matchParent ].
			container := BrVerticalPane new.
			container matchParent
				addAptitude: (BrLayoutResizerAptitude new common: [ container children ]);
				background: BrGlamorousColors backdropColor;
				addChild: self phlowViewSourceCoder;
				addChild: viewParent ]
%

method: GtLPhlowViewDomainObject
phlowViewSourceCoder
	^ (GtPharoMethodCoder new
				forMethod: self phlowView definingMethod compiledMethod;
				subscribeToSystem;
				asExpandedOnlyElement)
				margin: (BlInsets all: 10);
				background: Color white;
				addAptitude: BrShadowAptitude;
				vFitContentLimited
%

category: 'instance creation'
classmethod: GtLPhlowViewDomainObject
phlowView: aPhlowView viewMethodClassName: aClassName viewMethodSourceCode: aSourceCode
	| form |
	[ aPhlowView
		asElementDo: [ :anElement | 
			| rootElement targetExtent |
			targetExtent := 1600 @ 1200.
			rootElement := BlScripter new
					element: (BrFrame new 
						border: (BlBorder paint: Color gray);
						extent: targetExtent;
						addChild: anElement) ;
					extent: targetExtent;
					elementWithoutParent.
			form := BlExporter png
					element: rootElement;
					doExport: [ :aCanvas | aCanvas asForm ] ] ]
		on: Error
		do: [ :e | ^ GtLExceptionDomainObject new freeze: e ].

	^ self new
		phlowView: aPhlowView;
		phlowViewForm: form;
		viewMethodClassName: aClassName;
		viewMethodSourceCode: aSourceCode;
		yourself
%

category: 'views'
method: GtLRemotePhlowViewDomainObject
phlowViewSourceCoder
	^ (self phlowView definingMethod gtViewCoderFor: GtPhlowView empty) 
			asElementDo: [ :anElement | anElement ]
%

