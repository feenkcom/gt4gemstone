method: GtLPrimitiveMessageDataBuilder
addJsonDataBlockFor: aJsonData  dataKey: aDataKey from: aDataView
	aJsonData isString ifTrue: [
		self addJsonDataBlock: (GtLPrimitiveJsonBareDataBlock new
			jsonData: aJsonData;
			dataKey: aDataKey;
			sourceDataView: aDataView).
