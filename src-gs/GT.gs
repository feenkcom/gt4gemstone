category: 'instance creation'
classmethod: GtL
chat
	^ GtLChatRegistry current newChat
%

classmethod: GtL
gt
	^ GtLChatRegistry current newGtChat
%

classmethod: GtL
gtChat
	^ self gt
%

classmethod: GtL
gtDevelopmentChat
	^ GtLChatRegistry current newGtDevelopmentChat
%

classmethod: GtL
lastChat
	^ GtLChatRegistry current lastChat
