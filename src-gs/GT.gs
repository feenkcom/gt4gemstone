category: 'accessing'
method: MACompositeAccessor
kind
	^ kind
%

method: MACompositeAccessor
kind: aClass
	kind := aClass
%

category: 'model'
method: MACompositeAccessor
read: aModel
	| elements values |
	elements := self elementsFrom: aModel.
	values := elements collect: [ :e | self next read: e ].
	^ values asSet size > 1
		ifTrue: [ MACompositeConflict new kind: self kind; yourself  ]
		ifFalse: [ values first ].
	
%

method: MACompositeAccessor
write: anObject to: aModel
	^ (self elementsFrom: aModel) do: [ :e | 
		(anObject isKindOf: MACompositeConflict) ifFalse: [ self next write: anObject to: e ] ]
%

category: 'testing'
method: MACompositeAccessor
canRead: aModel
	^ (self accessor canRead: aModel) and: [ (self elementsFrom: aModel) allSatisfy: [ :e | self next canRead: e ] ]
%

method: MACompositeAccessor
canWrite: aModel
	^ (self accessor canRead: aModel) and: [ (self elementsFrom: aModel) allSatisfy: [ :e | self next canWrite: e ] ]
%

method: MACompositeAccessor
elementsFrom: aModel
	^ self accessor read: aModel
%

category: 'instance creation'
classmethod: MACompositeAccessor
via: anAccessor using: aDescription
	| result |
	result := (self on: aDescription accessor asAccessor accessor: anAccessor asAccessor)
		kind: aDescription kind;
		yourself.
	aDescription hasLabel ifTrue: [ aDescription label: (result accessor defaultLabelFor: aDescription) , '::' , aDescription label ].
	aDescription accessor: result.
	^ result
%

category: 'examples'
method: GtLMcpServerExamples
claudeCodeToolCallIdIfPresent
	<gtExample>
	| server rpc received result |
	server := GtLMcpServer new.
	rpc := GtLMcpJsonRpc new params:
		{'_meta' -> {'claudecode/toolUseId' -> 'toolu_example'} asDictionary} asDictionary.
	result := server claudeCodeToolCallIdFrom: rpc ifPresent: [ :identifier |
		received := identifier.
		'block result' ].
	self assert: received equals: 'toolu_example'.
	self assert: result equals: 'block result'.
	{nil. Dictionary new.
		{'_meta' -> {'claudecode/toolUseId' -> ''} asDictionary} asDictionary.
		{'_meta' -> {'claudecode/toolUseId' -> 17} asDictionary} asDictionary}
		do: [ :params |
			rpc params: params.
			result := server claudeCodeToolCallIdFrom: rpc
				ifPresent: [ :identifier | self error: 'Must not invoke block without a valid identifier' ].
			self assert: result isNil ].
	^ server
%

