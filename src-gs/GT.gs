category: 'private'
method: MAStringReader
isFalseUsing: aDescription
	^ aDescription falseString = self contents
		or: [ aDescription falseStrings anySatisfy: [ :e | e asLowercase = self contents asLowercase ] ]
%

method: MAStringReader
isTrueUsing: aDescription
	^ aDescription trueString = self contents
		or: [ aDescription trueStrings anySatisfy: [ :e | e asLowercase = self contents asLowercase ] ]
%

method: MAStringReader
nextMatchAll: aCollection on: aStream
	"Tries to match ==aCollection== on ==aStream==. Answer ==true== if ==aCollection== was consumed, otherwise ==false==."

	| position |
	(aCollection isNil or: [ aCollection isEmpty ])
		ifTrue: [ ^ false ].
	position := aStream position.
	aCollection do: [ :char |
		(aStream atEnd or: [ aStream next ~= char ]) ifTrue: [
			aStream position: position.
			^ false ] ].
	^ true
%

category: 'visiting'
method: MAStringReader
read: aStream description: aDescription
	(aStream atEnd or: [ self nextMatchAll: aDescription undefined on: aStream ])
		ifTrue: [ ^ nil ].
	^ super read: aStream description: aDescription
%

category: 'visiting-description'
method: MAStringReader
visitBooleanDescription: aDescription
	(self isTrueUsing: aDescription)
			ifTrue: [ ^ self object: true ].
	(self isFalseUsing: aDescription)
			ifTrue: [ ^ self object: false ].
	MAReadError signal
%

method: MAStringReader
visitClassDescription: aDescription
	self shouldNotImplement
%

method: MAStringReader
visitColorDescription: aDescription
	(self contents notEmpty and: [ self contents allSatisfy: [ :each | '#0123456789ABCDEFabcdef.' includes: each ] ])
		ifFalse: [ MAReadError signal ].
	self object: (aDescription kind fromString: self contents)
%

method: MAStringReader
visitContainer: anObject
	self shouldNotImplement
%

method: MAStringReader
visitDurationDescription: aDescription
	| contents |
	contents := self contents.
	contents isEmpty
		ifTrue: [ MAReadError signal ].
	(contents occurrencesOf: $-) > 1
		ifTrue: [ MAReadError signal ].
	(contents indexOf: $-) > 1
		ifTrue: [ MAReadError signal ].
	(contents occurrencesOf: $.) > 1
		ifTrue: [ MAReadError signal ].
	(contents allSatisfy: [:each | '-0123456789.:' includes: each])
		ifFalse: [ MAReadError signal ].
	super visitDurationDescription: aDescription
%

method: MAStringReader
visitElementDescription: aDescription
	"This implementation can be very dangerous and might lead to a potential security hole (this is tested), since the default implementation of #readFrom: in Object evaluates the expression to find its value. Most subclasses like Number, Date, Time, ... override this implementation, but some others (like Boolean) do not."

	self object: ([ aDescription kind readFrom: self stream ]
		on: Error do: [ :err | MAReadError signal: err messageText ])
%

method: MAStringReader
visitFileDescription: aDescription
	self shouldNotImplement
%

method: MAStringReader
visitMultipleOptionDescription: aDescription
	self object: (Array streamContents: [ :output |
		[ self stream atEnd ] whileFalse: [
			output nextPut: (aDescription reference
				fromString: (self stream upTo: $,)).
			self stream peek = Character space
				ifTrue: [ self stream next ] ] ])
%

method: MAStringReader
visitNumberDescription: aDescription
	| isContentsValid |
	isContentsValid := NumberParser isValidNumber: self contents.
	isContentsValid ifFalse: [ MAReadError signal ].
	super visitNumberDescription: aDescription
%

method: MAStringReader
visitRelationDescription: aDescription
	self shouldNotImplement
%

method: MAStringReader
visitSingleOptionDescription: aDescription
	aDescription propertyAt: #labels ifPresent: [ :labels |
		labels keysAndValuesDo: [ :key :value |
			(self nextMatchAll: value on: self stream)
				ifTrue: [ ^ self object: key ] ] ].
	self visit: aDescription reference
%

method: MAStringReader
visitStringDescription: aDescription
	self object: self contents
%

method: MAStringReader
visitSymbolDescription: aDescription
	self object: self contents asSymbol
%

method: MAStringReader
visitTableDescription: aDescription
	self shouldNotImplement
%

method: MAStringReader
visitTimeDescription: aDescription
	| string |
	string := self contents.
	(string notEmpty and: [ string allSatisfy: [ :each | '0123456789: apm' includes: each ] ])
		ifFalse: [ MAReadError signal ].
	self object: (aDescription kind readFrom: string readStream)
%

method: MAStringReader
visitTokenDescription: aDescription
	| token |
	self object: (aDescription kind streamContents: [ :output |
		[ self stream atEnd ] whileFalse: [
			token := WriteStream on: String new.
			[ self stream atEnd or: [ aDescription separators includes: self stream peek ] ]
				whileFalse: [ token nextPut: self stream next ].
			self stream atEnd 
				ifFalse: [ self stream next ].
			token contents isEmpty
				ifFalse: [ output nextPut: (aDescription reference fromString: token contents) ] ] ])
%

method: MAStringReader
visitUrlDescription: aDescription
	self object: self contents asUrl
%

category: 'accessing'
method: GtMagriteJSONSchemaCreationVisitor
currentSchema
	"we have this state because magritte does not return the value of the accepting a visitor"
	^ currentSchema
%

method: GtMagriteJSONSchemaCreationVisitor
extractAnyOfSchemaForClasses: aCollectioOfClasses 
	| individualSchema |
	
 	individualSchema :=	aCollectioOfClasses 
 		collect: [ :aClass |
 			self extractSingleSchemaForClass: aClass ]
 		as: NeoJSONArray.
 		
 	^ NeoJSONObject  new 
		at: 'anyOf' put: individualSchema;
		yourself.
%

method: GtMagriteJSONSchemaCreationVisitor
extractSchemaForClasses: aCollectioOfClasses
	^ (aCollectioOfClasses size = 1)
		ifTrue: [ self extractSingleSchemaForClass: aCollectioOfClasses anyOne ] 
		ifFalse: [ self extractAnyOfSchemaForClasses: aCollectioOfClasses ]
%

method: GtMagriteJSONSchemaCreationVisitor
extractSchemaWithExplicitContainersForClasses: aCollectioOfClasses 
	| individualSchema |
	
 	individualSchema :=	aCollectioOfClasses 
 		collect: [ :aClass |
			| singleSchema containerSchema propertiesSchema |
			singleSchema := self extractSingleSchemaForClass: aClass.
 			
			containerSchema := NeoJSONObject new
				at: 'type' put: 'object';
			yourself.
			propertiesSchema := NeoJSONObject new.
			propertiesSchema at: aClass jsonSchemaLabel put: singleSchema.
			
			containerSchema 
				at: 'properties' put: propertiesSchema;
				at: 'required'put: (NeoJSONArray withAll: {aClass jsonSchemaLabel});
				at: 'additionalProperties' put: false.
			containerSchema ]
 		as: NeoJSONArray.
 				
 	^ NeoJSONObject  new 
		at: 'anyOf' put: individualSchema;
		yourself.
%

method: GtMagriteJSONSchemaCreationVisitor
extractSingleSchemaForClass: aClass
	| itemsDescription |
	itemsDescription := aClass new 
			magritteDescription.
	itemsDescription acceptMagritte:  self.
	^ self currentSchema
%

method: GtMagriteJSONSchemaCreationVisitor
markAllAsRequired
	shouldMarkAllAsRequired := true
%

method: GtMagriteJSONSchemaCreationVisitor
shouldMarkAllAsRequired
	^ shouldMarkAllAsRequired ifNil: [ false ]
%

method: GtMagriteJSONSchemaCreationVisitor
shouldMarkAllAsRequired: aBoolean
	shouldMarkAllAsRequired := aBoolean
%

category: 'visiting'
method: GtMagriteJSONSchemaCreationVisitor
visitBooleanDescription: aBooleanDescription
	| schema |
	schema := NeoJSONObject new
		at: 'type' put: 'boolean';
		yourself.
	aBooleanDescription hasComment ifTrue: [
		schema at: 'description' put: aBooleanDescription comment ].
	^ currentSchema := schema
%

method: GtMagriteJSONSchemaCreationVisitor
visitNumberDescription: aBooleanDescription
	| schema |
	schema := NeoJSONObject new
		at: 'type' put: 'number';
		yourself.
	aBooleanDescription hasComment ifTrue: [
		schema at: 'description' put: aBooleanDescription comment ].
	^ currentSchema := schema
%

category: 'visiting-description'
method: GtMagriteJSONSchemaCreationVisitor
visitDateAndTimeDescription: aDateTimeDescription
	| schema |
	
	schema := NeoJSONObject  new 
			at: 'type' put: 'string';
			at: 'format' put: 'date-time';
			yourself.
	
	schema 
		at: 'description' 
		put: ((aDateTimeDescription hasComment 
			ifTrue: [ aDateTimeDescription comment, '. '] ifFalse: [ '' ]),
				'ISO-8601 timestamp (RFC3339) like 2026-03-05T14:30:00Z').
			
	^ currentSchema := schema
%

method: GtMagriteJSONSchemaCreationVisitor
visitPriorityContainer: aContainer
	| schema propertiesSchema |
	schema := NeoJSONObject new
			at: 'type' put: 'object';
			yourself.
	propertiesSchema := NeoJSONObject new.
	aContainer hasComment ifTrue: [
		schema at: 'description' put: aContainer comment	].

	(aContainer children
		sorted: [ :a :b | a accessor readSelector <= b accessor readSelector ])
		do: [ :aDescription | 
			aDescription acceptMagritte: self.
			propertiesSchema
				at: aDescription accessor readSelector asString
				put: self currentSchema ].
			
	schema at: 'properties' put: propertiesSchema.
	self shouldMarkAllAsRequired 
		ifTrue: [
			schema
				at: 'required'
				put: (aContainer children
					collect: [ :aDescription | aDescription accessor readSelector asString ]
					as: NeoJSONArray) sorted] 
		ifFalse: [
			schema
				at: 'required'
				put: ((aContainer children
					select: [:aDescription | aDescription isRequired])
						collect: [ :aDescription | aDescription accessor readSelector asString ]
						as: NeoJSONArray) sorted ].
		schema at: 'additionalProperties' put: false.

	^ currentSchema := schema
%

method: GtMagriteJSONSchemaCreationVisitor
visitStringDescription: aStringDescription
	| schema |
	
	schema := NeoJSONObject  new 
			at: 'type' put: 'string';
			yourself.
			
	(aStringDescription hasProperty: 'enum') ifTrue: [
		schema 
			at: 'enum' 
			put: (aStringDescription propertyAt: 'enum') asArray ].
			
	aStringDescription hasComment ifTrue: [
		schema at: 'description' put: aStringDescription comment	].
			
	^ currentSchema := schema
%

method: GtMagriteJSONSchemaCreationVisitor
visitToManyRelationDescription: aDescription
	| schema itemSchema  |
	
	itemSchema :=  (aDescription shouldUseExplicitContainerForChildren)
		ifTrue: [
			self extractSchemaWithExplicitContainersForClasses: aDescription classes ]
		ifFalse: [
			self extractSchemaForClasses: aDescription classes ].
	
	schema := NeoJSONObject  new 
		at: 'type' put: 'array';
		at: 'items' put: itemSchema;
		yourself.
						
		^ currentSchema := schema
%

method: GtMagriteJSONSchemaCreationVisitor
visitToManyScalarRelationDescription: aDescription
	| scalarType schema |
	self 
		assert: aDescription classes size = 1
		description: 'Only one scalar type supported at the moment'.
	
	scalarType := nil.
	aDescription classes first = String 
		ifTrue: [ scalarType := 'string' ].
	aDescription classes first = Boolean 
		ifTrue: [ scalarType := 'boolean' ].
	scalarType ifNil: [
		^ Error signal: 'Unsupported scallar type: ', aDescription classes first name ].
	
	schema := NeoJSONObject new
		at: 'type' put: 'array';
		at: 'items' put: (NeoJSONObject new
			at: 'type' put: scalarType;
			yourself);
		yourself.
	
	aDescription hasComment ifTrue: [
		schema at: 'description' put: aDescription comment ].
		
	^ currentSchema := schema
%

method: GtMagriteJSONSchemaCreationVisitor
visitToOneRelationDescription: aDescription 
	^ currentSchema := self 
			extractSchemaForClasses: aDescription classes.
%

category: '*GToolkit-Pharo-Coder-UI'
method: GtMagritteElementBuilder
newPackageNameWidget: aDescription
	| aMemento packageEditor aCompletionStrategy aptitude |
	aMemento := self memento.
	packageEditor := BrEditor new.
	aptitude := aDescription editorAptitude
			ifNil: [ BrGlamorousRegularEditorAptitude new glamorousRegularFontAndSize ]
			ifNotNil: [ :anAptitude | anAptitude value ].

	packageEditor
		inputFilter: BrPackageNameInputFilter new;
		aptitude: aptitude;
		addAptitude: (BrGlamorousWithExplicitContextMenuAptitude
				menu: [ | aPackageName  |
					aPackageName := (aMemento readUsing: aDescription) ifNotNil: [ :aValue | aValue packageName ].
					aPackageName ifNotNil: [ 
						self class environment organization 
							packageNamed: aPackageName ifPresent: [ :aPackage | 	
								GtCoderPackageTarget menuItemsForObject: aPackage hostElement: packageEditor ] ] ]);
		addAptitude: (BrStyleCommonAptitude new
				default: [ :aStyle | aStyle border: BlBorder empty ];
				hovered: [ :aStyle | 
					aStyle
						border: (BlBorder paint: BrGlamorousColors disabledButtonBorderColor width: 1) ];
				focused: [ :aStyle | 
					aStyle
						border: (BlBorder paint: BrGlamorousColors focusedEditorBorderColor width: 1) ]);
		geometry: (BlRoundedRectangleGeometry cornerRadius: 4);
		vFitContent;
		hFitContentLimited;
		margin: (BlInsets top: 2 bottom: 4);
		constraintsDo: [ :c | 
			c grid vertical alignCenter.
			c minWidth: 20 ];
		when: BlFocusInEvent do: [ :anEvent | packageEditor selecter all select ];
		when: BlFocusOutEvent
			do: [ :anEvent | packageEditor deselecter all deselect ];
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :theEditor :aSink | theEditor text: aSink value currentValue packageRope ].
			(aMemento readObservableValueUsing: aDescription) observe: anElementSink ].

	aCompletionStrategy := GtStringsCompletionStrategy new
			completions: (GtPrefixTree withAll: self packageOrganizer packageNames).

	(GtCompletionController on: packageEditor strategy: aCompletionStrategy)
		install.

	packageEditor editor
		when: BrTextEditorModifiedEvent
		do: [ :anEvent | 
			| aValue aNewValue |
			aValue := aMemento readUsing: aDescription.
			aNewValue := aValue copyWithNewPackageName: anEvent text asString.
			GtMagritteBuilderUtility
				write: aNewValue
				using: aDescription
				memento: aMemento
				element: packageEditor ].
	^ packageEditor
%

method: GtMagritteElementBuilder
newTagNameWidget: aDescription
	| aMemento tagEditor aCompletionController aptitude |
	aMemento := self memento.
	tagEditor := BrEditor new.
	aptitude := aDescription editorAptitude
			ifNil: [ BrGlamorousRegularEditorAptitude new glamorousRegularFontAndSize ]
			ifNotNil: [ :anAptitude | anAptitude value ].

	tagEditor
		inputFilter: BrPackageTagNameInputFilter new;
		aptitude: aptitude;
		addAptitude: (BrGlamorousWithExplicitContextMenuAptitude
				menu: [ | aPackageName aTagName |
					aPackageName := (aMemento readUsing: aDescription) ifNotNil: [ :aValue | aValue packageName ].
					aPackageName ifNotNil: [ 
						self class environment organization 
							packageNamed: aPackageName ifPresent: [ :aPackage |
								aTagName := (aMemento readUsing: aDescription) ifNotNil: [ :aValue | aValue tagName ].
								aTagName ifNotNil: [ 
									aPackage tagNamed: aTagName ifPresent: [ :aPackageTag | 
										GtCoderPackageTagTarget menuItemsForObject: aPackageTag hostElement: tagEditor ] ] ] ] ]);
		addAptitude: (BrStyleCommonAptitude new
				default: [ :aStyle | aStyle border: BlBorder empty ];
				hovered: [ :aStyle | 
					aStyle
						border: (BlBorder paint: BrGlamorousColors disabledButtonBorderColor width: 1) ];
				focused: [ :aStyle | 
					aStyle
						border: (BlBorder paint: BrGlamorousColors focusedEditorBorderColor width: 1) ]);
		geometry: (BlRoundedRectangleGeometry cornerRadius: 4);
		vFitContent;
		hFitContentLimited;
		margin: (BlInsets top: 2 bottom: 4);
		constraintsDo: [ :c | 
			c grid vertical alignCenter.
			c minWidth: 20 ];
		when: BlFocusInEvent do: [ :anEvent | tagEditor selecter all select ];
		when: BlFocusOutEvent do: [ :anEvent | tagEditor deselecter all deselect ];
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :theEditor :aSink | 
					| aPackage aCompletionStrategy |
					aPackage := aSink value currentValue packageName asPackageIfAbsent: [ nil ].

					aPackage
						ifNotNil: [ aCompletionController ifNotNil: [ aCompletionController uninstall ].
							aCompletionStrategy := GtStringsCompletionStrategy new
									completions: (GtPrefixTree withAll: (aPackage tags collect: #name)).

							aCompletionController := (GtCompletionController
									on: tagEditor
									strategy: aCompletionStrategy) install ].

					theEditor text: aSink value currentValue tagRope ].
			(aMemento readObservableValueUsing: aDescription) observe: anElementSink ].



	tagEditor editor
		when: BrTextEditorModifiedEvent
		do: [ :anEvent | 
			| aValue aNewValue |
			aValue := aMemento readUsing: aDescription.
			aNewValue := aValue copyWithNewTagName: anEvent text asString.

			GtMagritteBuilderUtility
				write: aNewValue
				using: aDescription
				memento: aMemento
				element: tagEditor ].
	^ tagEditor
%

method: GtMagritteElementBuilder
visitGtPackageAndTagDescription: aDescription
	| packageEditor tagEditor aContainer aLabel aValidationElement aMemento |
	aMemento := self memento.
	aContainer := BrHorizontalPane new fitContent.
	packageEditor := self newPackageNameWidget: aDescription.
	tagEditor := self newTagNameWidget: aDescription.

	self addShortcutsTo: packageEditor using: aDescription.
	self addShortcutsTo: tagEditor using: aDescription.
	
	aContainer
		addChild: packageEditor as: #package;
		addChild: ((GtMagritteBuilderUtility
				newFieldLabelWithSpace: self defaultSpacing
				using: aDescription)
				text: 'Tag:';
				constraintsDo: [ :c | c linear vertical alignCenter ]);
		addChild: tagEditor as: #tag.

	aDescription isWithChangeIndicator
		ifTrue: [ aValidationElement := GtMagritteBuilderUtility
					newValidationContainerWith: aContainer
					memento: aMemento
					using: aDescription ]
		ifFalse: [ aValidationElement := aContainer ].

	aLabel := self addFieldElement: aValidationElement using: aDescription.

	aLabel padding: aLabel padding + (BlInsets top: self defaultSpacing)
%

