method: NullTelemetry
snapshotSpace: aSpace
	self
		profile: []
		executing:  [ :blockClosure |			
			blockClosure value.
			(aSpace root
				asSpartaForm: nil
				scaleFactor: 0.5
				hdpiScaleFactor: 1) -> aSpace extent ]
		as: #spaceSnapshot
%

method: NullTelemetry
snapshotSpace: aSpace after: aBlock
	^ self
		profile: aBlock
		executing:  [ :blockClosure |			
			blockClosure value.
			aSpace
				asSpartaForm: nil
				scaleFactor: nil
				hdpiScaleFactor: aSpace scaleFactor ]
		as: #spaceSnapshot
