	| subagent |
	self threadSource = 'guardian_review' ifTrue: [ ^ true ].
	subagent := self subagentSource.
	^ (subagent isKindOf: Dictionary)
		and: [ (subagent at: 'other' ifAbsent: [ nil ]) = 'guardian' ]
