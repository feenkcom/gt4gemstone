method: GtLACPSubagentExamples
collapsedAgentRefreshPreservesParent
	<gtExample>
	| scripter root child sibling hash siblingHash parentRow parentChildren localTool agent siblingHeader version |
	scripter := self runningAgentsChat.
	root := scripter model.
	child := root childSessions first.
	sibling := root childSessions second.
	hash := child currentTurn identityHash asString.
	siblingHash := sibling currentTurn identityHash asString.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-message-2';
				satisfies: [ :row | 
					parentRow := row.
					parentChildren := row children asArray.
					version := row viewModel renderingVersion.
					true ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-tool-summary-local-call';
				satisfies: [ :line | 
					localTool := line.
					true ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-section-' , hash) asSymbol;
				satisfies: [ :element | 
					agent := element.
					element isExpanded not ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-header-' , siblingHash) asSymbol;
				satisfies: [ :header | 
					siblingHeader := header.
					true ] ].
	scripter
		doStep: [ :step | 
			step
				label: 'Stream reasoning into a collapsed worker';
				block: [ self
						update: {'sessionUpdate' -> 'agent_thought_chunk'.
								'content'
									-> {'type' -> 'text'.
											'text' -> 'I am inspecting the worker result.'} asDictionary}
								asDictionary
						for: child.
					self
						update: {'sessionUpdate' -> 'usage_update'.
								'used' -> 53000.
								'size' -> 200000} asDictionary
						for: child.
					self
						update: {'sessionUpdate' -> 'tool_call'.
								'toolCallId' -> 'additional-nested-call'.
								'title' -> 'Additional nested lookup'.
								'status' -> 'in_progress'} asDictionary
						for: child childSessions first ] ].
	scripter pulseUntilReady.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-message-2';
				satisfies: [ :row | 
					row == parentRow
						and: [ row children asArray = parentChildren
								and: [ row viewModel renderingVersion = version ] ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-tool-summary-local-call';
				satisfies: [ :line | line == localTool ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-section-' , hash) asSymbol;
				satisfies: [ :element | element == agent and: [ element isExpanded not ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-header-' , siblingHash) asSymbol;
				satisfies: [ :header | header == siblingHeader ] ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-summary-' , hash) asSymbol;
				notExists ].
	scripter
		assertStep: [ :step | 
			step
				id: ('acp-agent-counts-' , hash) asSymbol;
				value: [ :pane | pane children collect: [ :label | label text asString ] as: Array ]
					equals: [ #('1 agent' '3 tools') ] ].
	self assert: child contextWindow usedTokens equals: 53000.
	self assert: child contextWindow totalTokens equals: 200000.
	self assert: root contextWindow isReported not.
	self assert: sibling contextWindow isReported not.
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
