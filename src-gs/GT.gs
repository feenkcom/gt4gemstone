			nextPutAll: (self encode: (self containerNameFor: aTestCase));
			nextPutAll: '"'; 
		nextPutAll: ' name="'; 
			nextPutAll: (self encode: (self nameFor: aTestCase)); 
			nextPutAll: '"'; 
		nextPutAll: ' time="'; print: (time asMilliSeconds / 1000.0); 
		nextPutAll: '">'; 
		lf
