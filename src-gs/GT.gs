method: GtLToolCallsByTypeSummarizer
totalExecutionDuration
	^ self relevantToolCalls
		inject: 0 seconds 
		into: [ :total  :each | 
			total + (each totalExecutionDuration 
				ifNil: [ 0 seconds ]) ]
%

method: GtLToolCallsByTypeSummarizer
totalGcExecutionDuration
	^ self relevantToolCalls
		inject: 0 seconds 
		into: [ :total  :each | 
			total + (each totalGcExecutionDuration 
				ifNil: [ 0 seconds ]) ]
%

