method: GtLChatWithScripterExamples
chatElementWithNewMessage_sendWithException
	<gtExample>
	| chat scripter |
	scripter := self chatElementWithNewMessage.
	chat := scripter model.

	self assert: chat messages size equals: 0.

	chat provider
		sendMessageBlock: [ :aMessage | 
