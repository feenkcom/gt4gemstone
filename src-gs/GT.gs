classmethod: GtMagritteBuilderUtility
newToolbarWithActions: aCollection memento: aMemento
	| aToolbar anExecutionStatus |
	aToolbar := BrToolbar new
			aptitude: GtMagritteToolbarAptitude new;
			hFitContentLimited;
			vFitContent;
			padding: (BlInsets top: 5 left: 0);
			constraintsDo: [ :c | 
				c grid horizontal alignLeft.
				c grid horizontal span: 2.
				c linear horizontal alignLeft ].

	aCollection
		doWithIndex: [ :eachAction :anIndex | 
			| aButton |
			aButton := eachAction asBlockButtonWithMemento: aMemento.
			anIndex = aCollection size ifFalse: [ 
				aButton margin: aButton margin + (BlInsets top: 0 bottom: 4 left: 0 right: 4 ) ].
			aToolbar addItem: aButton ].

	anExecutionStatus := self newExecutionStatusWithMemento: aMemento.
	aToolbar addChild: anExecutionStatus as: GtMagritteExecutionStatusElementId.

	^ aToolbar
%

classmethod: GtMagritteBuilderUtility
newValidationContainerWith: aFieldElement memento: aMemento using: aDescription
	| aContainer anIssuesElement aChangeElement anErrorElement |
	aContainer := BrHorizontalGrid new.
	aContainer
		id: (GtMagritteValidatorElementId new description: aDescription);
		cellSpacing: 0;
		columnCount: 4;
		hFitContentLimited;
		vFitContent;
		clipChildren: false.

	aChangeElement := BrFrame new.
	aChangeElement hExact: self defaultThickness.
	aChangeElement vMatchParent.
	aChangeElement background: BrGlamorousColors textHighlightColor.
	aChangeElement visibility: BlVisibility hidden.
	aChangeElement margin: (BlInsets bottom: self defaultSpaceNumber).
	aChangeElement geometry: (BlRoundedRectangleGeometry cornerRadius: 4).
	aChangeElement
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :aLabel :aSink | 
					| aValue |
					aValue := aSink value.
					aValue isChanged
						ifTrue: [ aLabel visibility: BlVisibility visible ]
						ifFalse: [ aLabel visibility: BlVisibility hidden ] ].
			(aMemento readObservableValueUsing: aDescription) observe: anElementSink ].

	anErrorElement := BrFrame new.
	anErrorElement hExact: self defaultThickness.
	anErrorElement vMatchParent.
	anErrorElement background: BrGlamorousColors errorBackgroundColor.
	anErrorElement visibility: BlVisibility hidden.
	anErrorElement margin: (BlInsets bottom: self defaultSpaceNumber).
	anErrorElement geometry: (BlRoundedRectangleGeometry cornerRadius: 4).
	anErrorElement
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :aLabel :aSink | 
					| aValue |
					aValue := aSink value.
					aValue isSuccess
						ifTrue: [ aLabel visibility: BlVisibility hidden ]
						ifFalse: [ aLabel visibility: BlVisibility visible ] ].
			(aMemento validatorUsing: aDescription) observe: anElementSink ].

	anIssuesElement := BrEditor new.
	anIssuesElement
		id: GtMagritteIssuesExplanationId;
		aptitude: (BrGlamorousRegularEditorAptitude new
				glamorousRegularFont;
				glamorousCodeSmallSize;
				foreground: BrGlamorousColors errorBackgroundColor);
		beNotFocusable;
		hFitContentLimited;
		vFitContent;
		text: '';
		padding: (BlInsets
				top: -4
				left: 5
				bottom: 0
				right: 0);
		visibility: BlVisibility gone;
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :aLabel :aSink | 
					| aValue |
					aValue := aSink value.
					(aValue value isChanged not or: [ aValue isSuccess ])
						ifTrue: [ aLabel
								text: '';
								visibility: BlVisibility hidden ]
						ifFalse: [ aLabel
								text: aValue issuesDescription;
								visibility: BlVisibility visible ] ].
			(aMemento validatorUsing: aDescription) observe: anElementSink ].

	aContainer addChild: aChangeElement as: GtMagritteChangeIndicatorId.
	aContainer addChild: aFieldElement as: (GtMagritteFieldElementId new description: aDescription).
	aContainer addChild: anErrorElement as: GtMagritteChangeErrorIndicatorId.
	aContainer
		addChild: (BlElement new
				layout: BlLinearLayout vertical alignCenter;
				addChild: anIssuesElement;
				constraintsDo: [ :c | 
					c horizontal fitContent.
					c vertical matchParent])
		as: #issues.

	^ aContainer
%

classmethod: GtMagritteBuilderUtility
styleEditorWidget: aBrEditor 
	aBrEditor addAptitude: (BrStyleCommonAptitude new
		default: [ :aStyle | 
			aStyle border: BlBorder empty ];
		hovered: [ :aStyle | 
			aStyle border: (BlBorder 
				paint: aBrEditor theme editor borderColor 
				width: 1) ];
		focused: [ :aStyle | 
			aStyle border: (BlBorder 
				paint: aBrEditor theme editor focusedBorderColor 
				width: 1) ]).
				
	aBrEditor 
		geometry: (BlRoundedRectangleGeometry cornerRadius: 4);
		margin: (BlInsets bottom: self defaultSpaceNumber);
		vFitContent;
		hFitContentLimited.
		
	aBrEditor 
		when: BlFocusInEvent do: [ :anEvent | 
			aBrEditor selecter all select ];
		when: BlFocusOutEvent do: [ :anEvent | 
			aBrEditor deselecter all deselect ].
			
	aBrEditor
		constraintsDo: [ :c | 
			c grid vertical alignCenter.
			c minWidth: 20 ]
%

classmethod: GtMagritteBuilderUtility
updateToolbarLabelExecutionStatus: aLabel withExceptionText: aString
	| aShortText aTooltip |
	aString size > 21
		ifTrue: [ aShortText := (aString first: 21) , '...'.
			aTooltip := aString ]
		ifFalse: [ aShortText := aString.
			aTooltip := nil ].

	aLabel
		visibility: BlVisibility visible;
		aptitudeDo: [ :anAptitude | anAptitude foreground: BrGlamorousColors errorBackgroundColor ];
		text: aShortText.

	aLabel
		aptitudeDo: [ :anAptitude | anAptitude - BrGlamorousWithExplicitTooltipAptitude ].
	aTooltip
		ifNotNil: [ aLabel
				aptitudeDo: [ :anAptitude | anAptitude + (BrGlamorousWithExplicitTooltipAptitude text: aString) ] ]
%

classmethod: GtMagritteBuilderUtility
write: aValue using: aDescription memento: aMemento element: anElement
	| aFuture aPromise |
	aFuture := aMemento write: aValue using: aDescription.
	aPromise := aFuture await: GtMagritteBuilderUtility executionConfiguration.

	anElement enqueueTask: (BlPromiseTask new promise: aPromise).

	^ aPromise
%

classmethod: GtMagritteBuilderUtility
writeText: aText using: aDescription memento: aMemento element: anElement
	| aValue |
	aValue := (aDescription isKindOf: GtMATextDescription)
			ifTrue: [ aText copy ]
			ifFalse: [ 
				| aString |
				aString := aText asString.
				[ (aDescription fromString: aString) ifNil: [ aDescription default ] ] 
					on: MAReadError 
					do: [ :anError | aString ] ].

	^ self
		write: aValue
		using: aDescription
		memento: aMemento
		element: anElement
%

category: 'private - building'
classmethod: GtMagritteBuilderUtility
newSingleOptionDropdownContent: aLabel memento: aMemento description: aDescription
	^ BrSimpleList new
		itemStencil: aDescription blocItemStencil;
		itemDataBinder: aDescription blocItemDataBinderStencil;
		hFitContent;
		vFitContent;
		padding: (BlInsets all: self defaultSpaceNumber);
		items: aDescription options;
		when: BrSelectionChanged
			do: [ :anEvent | 
				| aWidgetElement |
				aWidgetElement := anEvent currentTarget.

				anEvent
					selectedDo: [ :anInterval | 
						| selectedObject |
						selectedObject := aWidgetElement viewModel 
							itemAt: anInterval first.
						
						self 
							write: selectedObject 
							using: aDescription 
							memento: aMemento 
							element: aLabel.
						
						aLabel fireEvent: BrDropdownHideWish new ] ]
%

classmethod: GtMagritteBuilderUtility
newSingleOptionDropdownMemento: aMemento using: aDescription

	^ self
		  addDropdownMemento: aMemento
		  using: aDescription
		  withContent: [ :aLabel | 
			  [ 
			  self
				  newSingleOptionDropdownContent: aLabel
				  memento: aMemento
				  description: aDescription ] ]
%

category: 'private - support'
classmethod: GtMagritteBuilderUtility
onFlowList: aFlowElement sinkUpdate: aSink memento: aMemento description: aDescription
	| aModels anExistingViewModels isEditable aViewModels |
	aModels := aSink value currentValue ifNil: [ #() ].
	anExistingViewModels := aFlowElement items.
	isEditable := aDescription definitive not
			and: [ aDescription newItemStencil isNotNil ].

	aViewModels := Array
			new: aModels size + isEditable asBit
			streamContents: [ :aStream | 
				self
					recycleViewModels: anExistingViewModels
					forModels: aModels
					into: aStream
					memento: aMemento
					description: aDescription.

				isEditable
					ifTrue: [ | anAddViewModel |
						anAddViewModel := GtMagritteAddItemViewModel new
								memento: aMemento;
								description: aDescription;
								stencil: aDescription newItemStencil.
						aStream nextPut: anAddViewModel ] ].


	^ aFlowElement items: aViewModels
%

classmethod: GtMagritteBuilderUtility
recycleViewModels: anExistingViewModels forModels: aModels into: aStream memento: aMemento description: aDescription
	aModels
		do: [ :aModel | 
			anExistingViewModels
				detect: [ :eachViewModel | eachViewModel isForObject: aModel ]
				ifFound: [ :aViewModel | aStream nextPut: aViewModel ]
				ifNone: [ | aViewModel |
					aViewModel := aDescription blocItemViewModelStencil
							model: aModel;
							description: aDescription;
							build.
					aDescription definitive
						ifFalse: [ aViewModel
								addButton: (GtMagritteButtonWithIconAction new
										icon: BrGlamorousVectorIcons remove;
										tooltip: 'Remove';
										action: [ :anItemModel :aButton :anItemMemento | 
											| aFuture |
											aFuture := [ self
												removeItem: aModel
												memento: aMemento
												description: aDescription ] asAsyncFuture.
											GtMagritteBuilderUtility 
												awaitFuture: aFuture 
												from: aButton ]) ].

					aStream nextPut: aViewModel ] ]
%

classmethod: GtMagritteBuilderUtility
removeItem: anItem memento: aMemento description: aDescription

	| aNewCollection anObservable aValue |
	anObservable := aMemento readObservableValueUsing: aDescription.
	aValue := anObservable valueOrNil.
	aNewCollection := aValue currentValue copyWithout: anItem.
	aNewCollection = aValue currentValue ifFalse: [ 
		anObservable value: (aValue copyWithCurrentValue: aNewCollection) ]
%

category: 'private - ui'
classmethod: GtMagritteBuilderUtility
addDropdownMemento: aMemento using: aDescription withContent: aContentBlock
	| aLabel |
	aLabel := BrLabel new beFocusable.
	aLabel
		aptitude: (aDescription editorAptitude
				ifNil: [ BrGlamorousLabelAptitude new
						glamorousCodeFont;
						fontSize: 10 ]
				ifNotNil: [ :anAptitude | anAptitude value ]).

	aLabel
		addAptitude: (BrGlamorousWithExplicitDropdownAptitude
				handle: [ BrLabel new
						geometry: (BlRoundedRectangleGeometry cornerRadius: 4);
						aptitude: (aDescription editorAptitude
							ifNil: [ BrGlamorousLabelAptitude new
									glamorousCodeFont;
									fontSize: 10 ]
							ifNotNil: [ :anAptitude | anAptitude value ]);
						padding: (BlInsets all: self defaultSpaceNumber);
						withAsyncSinkDo: [ :anElementSink | 
							anElementSink
								sink: AsyncPeekSink new;
								whenUpdate: [ :theLabel :aSink | 
									| aFileModel aText |
									aFileModel := aSink value currentValue.
									aText := aDescription displayStringFor: aFileModel.
									theLabel text: aText ].
							(aMemento readObservableValueUsing: aDescription) observe: anElementSink ] ]
				content: (aContentBlock value: aLabel));
		margin: ((BlInsets left: self defaultSpaceNumber) withBottom: self defaultSpaceNumber);
		padding: (BlInsets all: self defaultSpaceNumber);
		geometry: (BlRoundedRectangleGeometry cornerRadius: 4);
		constraintsDo: [ :c | 
			c grid horizontal alignCenter.
			c grid vertical alignCenter ];
		background: BrGlamorousColors disabledButtonBackgroundColor.

	aLabel
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :theLabel :aSink | 
					| aValue aText |
					aValue := aSink value currentValue.
					aText := aDescription displayStringFor: aValue.
					theLabel text: aText ].
			(aMemento readObservableValueUsing: aDescription) observe: anElementSink ].

	^ aLabel
%

classmethod: GtMagritteBuilderUtility
newDirectoryDropdownContent: aDropdown memento: aMemento description: aDescription
	| aFileBrowser |
	aFileBrowser := BrFileSelector new.
	aFileBrowser
		vExact: 250;
		hExact: 400;
		buttonLabel: 'Set';
		padding: (BlInsets all: 10);
		addAptitude: BrGlamorousWithVerticalResizerAptitude
				+ BrGlamorousWithHorizontalResizerAptitude
				+ BrGlamorousWithHorizontalResizerAptitude new beLeft.

	aFileBrowser
		okAction: [ :aFileReference | 
			self 
				write: aFileReference 
				using: aDescription 
				memento: aMemento 
				element: aDropdown.

			aDropdown
				enqueueTask: (BlTaskAction new
						action: [ aDropdown dispatchEvent: (BrDropdownHideWish new anchor: aDropdown) ]) ].

	aFileBrowser
		fileFilterBlock: [ :aFileReference | 
			aFileReference isDirectory
				and: [ (FileSystemDirectoryEntry reference: aFileReference) isHidden not ] ].

	aFileBrowser
		withAsyncSinkDo: [ :anElementSink | 
			anElementSink
				sink: AsyncPeekSink new;
				whenUpdate: [ :theFileBrowser :aSink | 
					| aFileModel aFileReference |
					aFileModel := aSink value currentValue.
					aFileReference := aDescription pharoFileReferenceFor: aFileModel.
					theFileBrowser folder: aFileReference ].
			(aMemento readObservableValueUsing: aDescription) observe: anElementSink ].

	^ aFileBrowser
%

category: 'examples'
method: GtLRefactoringChangeExamples
addMethodRefactoringChange
	"A change that adds a method carries the source of the method"

	<gtExample>
	<return: #GtLRefactoringChange>
	| rbChange change |
	rbChange := RBAddMethodChange
			compile: 'previewedMethod ^ 42'
			in: self class
			classified: 'examples'.
	change := GtLRefactoringChange fromChange: rbChange.
	self assert: change change == rbChange.
	self assert: change kind equals: 'added method'.
	self
		assert: change target
		equals: 'GtLRefactoringChangeExamples>>#previewedMethod'.
	self
		assert: change changeDescription
		equals: 'Add GtLRefactoringChangeExamples>>#previewedMethod'.
	self assert: change newSource equals: 'previewedMethod ^ 42'.
	self assert: change hasNewSource.
	^ change
%

method: GtLRefactoringChangeExamples
modifyMethodRefactoringChange
	"A change that compiles an existing method is a modification"

	<gtExample>
	<return: #GtLRefactoringChange>
	| rbChange change |
	rbChange := RBAddMethodChange
			compile: 'refactoringChange ^ nil'
			in: self class
			classified: 'examples'.
	change := GtLRefactoringChange fromChange: rbChange.
	self assert: change kind equals: 'modified method'.
	self
		assert: change target
		equals: 'GtLRefactoringChangeExamples>>#refactoringChange'.
	self assert: change newSource equals: 'refactoringChange ^ nil'.
	^ change
%

method: GtLRefactoringChangeExamples
refactoringChangeSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| dataBlock expected |
	dataBlock := self refactoringChangeMainDataView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	expected := Dictionary new
			at: #changeDescription put: 'MySuperclass>>foo';
			at: #kind put: nil;
			at: #target put: nil;
			at: #newSource put: 'foo ^ 42';
			yourself.
	self assertDataBlock: dataBlock hasLlmJsonData: expected.
	^ dataBlock
%

method: GtLRefactoringChangeExamples
removeMethodRefactoringChange
	"A removal carries no source; the description says what is removed"

	<gtExample>
	<return: #GtLRefactoringChange>
	| rbChange change |
	rbChange := RBRemoveMethodChange remove: #refactoringChange from: self class.
	change := GtLRefactoringChange fromChange: rbChange.
	self assert: change change == rbChange.
	self assert: change kind equals: 'removed method'.
	self
		assert: change target
		equals: 'GtLRefactoringChangeExamples>>#refactoringChange'.
	self assert: change newSource isNil.
	self assert: change hasNewSource not.
	^ change
%

method: GtLRefactoringChangeExamples
removeMethodRefactoringChangeSerialization
	"The RB change is not serialized; newSource is null for a removal"

	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| dataBlock expected |
	dataBlock := (self removeMethodRefactoringChange
			llmDataViewsFor: GtLDataView new) serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	expected := Dictionary new
			at: #changeDescription
				put: 'Remove GtLRefactoringChangeExamples>>#refactoringChange';
			at: #kind put: 'removed method';
			at: #target put: 'GtLRefactoringChangeExamples>>#refactoringChange';
			at: #newSource put: nil;
			yourself.
	self assertDataBlock: dataBlock hasLlmJsonData: expected.
	^ dataBlock
%

method: GtLRefactoringChangeExamples
removeSlotRefactoringChange
	"A slot removal carries no source. Its target is the class that owns the slot"

	<gtExample>
	<return: #GtLRefactoringChange>
	| rbChange change |
	rbChange := RBRemoveInstanceVariableChange
			remove: 'changeDescription'
			from: GtLRefactoringChange.
	change := GtLRefactoringChange fromChange: rbChange.
	self assert: change kind equals: 'removed slot'.
	self assert: change target equals: 'GtLRefactoringChange'.
	self
		assert: change changeDescription
		equals: 'Remove instance variable changeDescription from GtLRefactoringChange'.
	self assert: change newSource isNil.
	^ change
%

category: 'examples - basic'
method: GtLRefactoringChangeExamples
refactoringChange
	<gtExample>
	<return: #GtLRefactoringChange>
	| change |
	change := GtLRefactoringChange changeDescription: 'MySuperclass>>foo'
				newSource: 'foo ^ 42'.
	self assert: change changeDescription equals: 'MySuperclass>>foo'.
	self assert: change newSource equals: 'foo ^ 42'.
