	tool := GtLToolForRemoteExampleMethodsRun new.
	call := GtLFunctionToolCall new.
	call
		rawArguments: {'checkNames'
								-> (STONJSON toString: {self class name asString , '>>exampleSuccess'}).
							'changes'
