method: GtLLepiterContentExporter
visitChildren: aSnippet
	level := level + 1.
	aSnippet children size > 0 ifTrue: [ self linebreaks ].
	aSnippet
		childrenDo: [ :aChild | 
			aChild acceptVisitor: self.
			self linebreaks ].
	level := level - 1
%

