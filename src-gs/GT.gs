category: 'accessing'
method: GtLToolForPreviewRefactoring
description
	^ 'Dry-runs one or more refactoring transformations and returns a preview of the resulting changes without applying them. Pass the objectId from the result to applyRefactoring to execute the changes.

Arguments:
- transformations: a JSON array of transformation specs. Each element is an object with a single key naming the transformation (e.g. PushUpMethod) whose value holds the parameters of that transformation. Call listTransformations to get the JSON schema of the available transformations.

The result has a refactoringName (e.g. Push up method; the distinct names of several transformations are separated by commas) and a refactoringDescription with the parameters of the transformations (separated by semicolons).

Each change in the result has a changeDescription, a kind (e.g. added method, removed method, added slot, removed slot), a target (e.g. MyClass>>#foo for methods, MyClass for class-level changes such as slots) and a newSource. newSource holds the method source, class definition or class comment introduced by the change, and is null for changes that carry no code, such as removals.

Example JSON arguments:
{"transformations": [{"PushUpMethod": {"methodClassName": "MySubclass", "methodNameToPushUp": "foo", "targetClassName": "MySuperclass"}}]}

Example JSON response:
{"refactoringName": "Push up method", "refactoringDescription": "Push up method foo from MySubclass to MySuperclass", "changes": [{"changeDescription": "Add MySuperclass>>#foo", "kind": "added method", "target": "MySuperclass>>#foo", "newSource": "foo ^ 42"}, {"changeDescription": "Remove MySubclass>>#foo", "kind": "removed method", "target": "MySubclass>>#foo", "newSource": null}], "changesCount": 2, "objectId": "abc123", "applied": false}'
%

method: GtLToolForPreviewRefactoring
name
	^'previewRefactoring'
%

method: GtLToolForPreviewRefactoring
transformationsClass
	^GtLCodeTransformations
%

category: 'descriptions'
method: GtLToolForPreviewRefactoring
transformationsDescription
	<magritteDescription>
	^(MAToManyRelationDescription new)
		label: 'Transformations';
		accessor: #transformations;
		classes: self transformationsClass new allowedTransformationClasses;
		useExplicitContainerForChildren;
		beRequired
%

category: 'execution'
method: GtLToolForPreviewRefactoring
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| transformations problems |
	anExecutionContext objectStorage
		ifNil: 
			[^GtLMissingInformationDomainObject new missingModelName: 'objectStorage'].
	transformations := self transformationsClass new
				transformations: (aToolCall arguments at: 'transformations').
	transformations transformations ifEmpty: 
			[^(GtLMissingArgumentDomainObject new)
				arguments: aToolCall arguments;
				missingArgument: 'transformations'].
	problems := transformations gtProblems.
	problems ifNotEmpty: 
			[^GtLProblemDomainObject new errorMessage: 'Invalid transformations: '
						, ('; ' join: (problems collect: [:each | each description]))].
	^self previewTransformations: transformations inContext: anExecutionContext
%

category: 'private'
method: GtLToolForPreviewRefactoring
previewTransformations: aTransformations inContext: anExecutionContext
	| preview |
	preview := [ GtLRefactoringPreview
			namespace: aTransformations applyRefactoring
			refactoringName: aTransformations refactoringName
			refactoringDescription: aTransformations refactoringDescription ]
			on: Error
			do: [ :anError | ^ GtLExceptionDomainObject freeze: anError ].
	preview
		objectId: (anExecutionContext objectStorage
				addNewObject: preview
				reason: (GtLStoredObjectStringReason text: 'Refactoring preview')).
	^ preview
%

