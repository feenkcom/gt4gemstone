method: GtLOllamaGenerateUserMessageVisitor
visitGtLPrimitiveJsonBareDataBlock: aDataBlock
	| string |

	string := aDataBlock jsonData.
	self assert: string isString.
	^ {
		'prompt' -> string.
		} asDictionary
