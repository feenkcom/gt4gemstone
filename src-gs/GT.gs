method: AssertionFailure
gtComparableTypesStateDiffFor: aView
	<gtView>
	<gtExceptionView>
	| assertionContext |
	
	self gtHasStack ifFalse: [ ^ aView empty ].
	assertionContext := self gtLocateAssertEqualsContextWithComparableTypes.
	assertionContext ifNil: [
