		ifTrue: [ ^ (self packages flatCollect: #gtExamplesContained) collect: #method ].
	self isForClasses
		ifTrue: [ ^ (self classes flatCollect: #gtExamples) collect: #method ].
	self assert: self isForExamples.
	^ self examples select: #isGTExampleMethod
