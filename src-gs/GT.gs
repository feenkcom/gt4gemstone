category: 'accessing'
method: NeoJSONSchemaValidator
addValidationError: validationError
	validationErrors add: validationError.
	^ false
%

method: NeoJSONSchemaValidator
addValidationErrorMessage: message
	| validationError |
	validationError := NeoJSONSchemaValidationError new.
	validationError 
		instance: instance; 
		schema: schema;
		message: message. 
	^ self addValidationError: validationError
%

method: NeoJSONSchemaValidator
