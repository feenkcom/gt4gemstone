category: 'accessing'
method: GtLObjectStorage
addNewObject: anObject
	^ self addNewObject: anObject reason: (GtLStoredObjectStringReason text: '')
%

method: GtLObjectStorage
addNewObject: anObject reason: aReason
	"Add an object without checking if it already exists. Return the id of the object"

	| newUUID storedObject |
	newUUID := self generateNewUUID.
	storedObject := GtLStoredObject
			id: newUUID
			value: anObject
			reason: aReason.
	objectsByUUID at: newUUID put: storedObject.
	
	self notifyObjectAdded: storedObject.

	^ newUUID asString36
%

method: GtLObjectStorage
addNewObject: anObject reasonString: aString
	"Add an object without checking if it already exists. Return the id of the object"

	^ self addNewObject: anObject reason:
		(GtLStoredObjectStringReason text: aString asString).
%

method: GtLObjectStorage
announcer
	^announcer
%

method: GtLObjectStorage
locateIdByIdentityForObject: anObject
	objectsByUUID valuesDo: [ :aStoredObject |
		aStoredObject value == anObject ifTrue: [ ^ aStoredObject id asString36 ] ].
	
	NotFound signal: 'Could not find object'  
