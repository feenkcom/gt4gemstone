%

category: 'instance creation'
classmethod: GtLOpenAiCodexCredential
accessToken: anAccessToken refreshToken: aRefreshToken expiresAt: anExpiry accountId: anAccountId
	^ self new
		accessToken: anAccessToken;
		refreshToken: aRefreshToken;
		expiresAt: anExpiry;
		accountId: anAccountId;
		yourself
%

classmethod: GtLOpenAiCodexCredential
defaultCodexAuthFileReference
	^ FileLocator home / '.codex' / 'auth.json' contents
%

classmethod: GtLOpenAiCodexCredential
expiresAtFromAccessToken: anAccessToken
	| parts encodedPayload paddingCount payload expiresAtSeconds |
	[ | paddedPayload |
	parts := anAccessToken substrings: '.'.
	parts size < 2 ifTrue: [ ^ nil ].
	encodedPayload := parts second.
	paddingCount := (4 - (encodedPayload size \\ 4)) \\ 4.
	paddedPayload := encodedPayload , (String new: paddingCount withAll: $=).
	payload := NeoJSONReader fromString: (Base64UrlEncoder new decode: paddedPayload) utf8Decoded.
	expiresAtSeconds := payload at: 'exp' ifAbsent: [ ^ nil ].
	^ DateAndTime fromUnixTime: expiresAtSeconds ]
		on: Error
		do: [ :error | nil ]
%

classmethod: GtLOpenAiCodexCredential
fromDefaultCodexFile
	| json dict accessToken refreshToken accountId expiry |
	json := self defaultCodexAuthFileReference.
	dict := STON fromString: json.
	accessToken := (dict at: 'tokens') at: 'access_token'.
	refreshToken := (dict at: 'tokens') at: 'refresh_token'.
	accountId := (dict at: 'tokens') at: 'account_id'.
	expiry := self expiresAtFromAccessToken: accessToken.
	^ self
		accessToken: accessToken
		refreshToken: refreshToken
		expiresAt: expiry
		accountId: accountId
%

category: 'private'
classmethod: GtLOpenAiCodexCredential
responseStringFrom: aResponseBody
	aResponseBody isString ifTrue: [ ^ aResponseBody ].
	(aResponseBody isKindOf: ByteArray) ifTrue: [ ^ aResponseBody utf8Decoded ].
	(aResponseBody respondsTo: #upToEnd) ifTrue:
		[ ^ self responseStringFrom: aResponseBody upToEnd ].
	self error: 'Unexpected OAuth response body: ', aResponseBody class name
%

category: 'examples'
method: GtLClassReferencesExamples
classReferencesCreation
	<gtExample>
	| reference result |
	reference := GtLMethodReference fromCompiledMethod: (GtLMagritteToolForClassReferences >> #name).
	result := GtLClassReferences new
		givenClassName: 'GtLMagritteToolForClassReferences';
		references: { reference };
		mayHaveMore: true;
		yourself.
	self assert: result givenClassName equals: 'GtLMagritteToolForClassReferences'.
	self assert: result references size equals: 1.
	self assert: result mayHaveMore.
	^ result
%

method: GtLClassReferencesExamples
classReferencesDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| domainObject compositeView dataBlock expectedJson |
	
	domainObject := self classReferencesCreation.
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	expectedJson := {
		#givenClassName -> 'GtLMagritteToolForClassReferences'.
		#references -> (NeoJSONArray with: (NeoJSONObject new
			at: #methodClassName put: 'GtLMagritteToolForClassReferences';
			at: #methodName put: 'name';
			at: #classSide put: false;
			yourself)).
		#mayHaveMore -> true
	} asDictionary.
	self assertDataBlock: dataBlock hasLlmJsonData: expectedJson.
	
	^ dataBlock
%

category: 'private'
method: GtLCoderExpandableLepiterExplanationStyler
isNonEmptyLiteralStringNode: nameNode
	^ nameNode isLiteral
		and: [ nameNode literalValue isString
			and: [ nameNode literalValue notEmpty ] ]
%

method: GtLCoderExpandableLepiterExplanationStyler
stylePageNameInStringMessage: aMessageNode inLepiterBase: aLepiterBase
	| pageName anExpanderAttribute |
	pageName := aMessageNode arguments first.

	(self isNonEmptyLiteralStringNode: pageName) ifFalse: [ ^ self ].

	self
		attribute: (GtCompletionStrategyAttribute new
				strategy: (GtLLepiterPagesCompletionStrategy new database: aLepiterBase))
		from: pageName value startPosition
		to: pageName value stopPosition.

	(aLepiterBase hasPageNamed: pageName literalValue asString) ifFalse: [ ^ self ].

	(self from: pageName value stopPosition to: pageName value stopPosition)
		expanded: false
		adornment: [ | page |
			page := aLepiterBase pageNamed: pageName literalValue asString.
			LePageToolContentTreeElement new
				pageViewModel: page asContentUIModel;
				hMatchParent;
				vExact: 300;
				addAptitude: BrShadowAptitude new + BrGlamorousWithVerticalResizerAptitude new beBottom;
				background: Color white;
				margin: (BlInsets all: 10) ]
		id: GtSourceCoderEmbeddedExpanderToggleId
%

method: GtLCoderExpandableLepiterExplanationStyler
styleSameStrings: aStringLiteralNodel
	| aStringMarker aStringHighlightAttribute theStringOccurences |
	
	aStringMarker := BrTextInvisibleMarkerAttribute new.
	aStringHighlightAttribute := (GtPharoDynamicHighlightAttribute paint: BrGlamorousColors neutralBackgroundColor).

	theStringOccurences := OrderedCollection new.
	
	aStringLiteralNodel topParent 
		allNodesOfType: aStringLiteralNodel class
		do: [ :aNode |
			aNode string = aStringLiteralNodel string 
				ifTrue: [ theStringOccurences add: aNode ] ].
		
	theStringOccurences size <= 1
		ifTrue: [ ^ self ].

	theStringOccurences do: [ :eachNode | 
		(text
			from: eachNode startPosition
			to: eachNode stopPosition)
				attribute: aStringMarker;
				onCursorEnter: [ :aTextEditor :anEvent | 
					aTextEditor text
						findAttribute: aStringMarker
						indicesDo: [ :aVariableStart :aVariableEnd |
							aTextEditor text
								attribute: aStringHighlightAttribute
								from: aVariableStart
								to: aVariableEnd ] ]
				leave: [ :aTextEditor :anEvent |
					aTextEditor text removeAttribute: aStringHighlightAttribute ] ] 
%

category: 'visiting'
method: GtLCoderExpandableLepiterExplanationStyler
styleStringAsLepiter: aMessageNode
	| lepiterString lepiterText |
	lepiterString := aMessageNode arguments first.
	(self isNonEmptyLiteralStringNode: lepiterString) ifFalse: [ ^ self ].
	lepiterText := text
			from: lepiterString startPosition + 1
			to: lepiterString stopPosition - 1.
	GtLMessageStyler new style: lepiterText.
	(text from: lepiterString startPosition to: lepiterString stopPosition)
		foreground: self theme editor pharoStringLiteralForeground.
	self
		attribute: (GtCompletionStrategyAttribute new
				strategy: LeCompletionStrategy new)
		from: lepiterString startPosition
		to: lepiterString stopPosition
%

method: GtLCoderExpandableLepiterExplanationStyler
visitMessage: aMessageNode
	super visitMessage: aMessageNode.

	(#(gtPageExplanation:) includes: aMessageNode selector)
		ifTrue: [ self
				stylePageNameInStringMessage: aMessageNode
				inLepiterBase: LeDatabase gtBook ].
	(#(markdownPage: pageExplanation:) includes: aMessageNode selector)
		ifTrue: [ self
				stylePageNameInStringMessage: aMessageNode
				inLepiterBase: LeDatabasesRegistry defaultLogicalDatabase ].
	(#(m: sendMarkdown: markdown:) includes: aMessageNode selector)
		ifTrue: [ self styleStringAsLepiter: aMessageNode ]
%

method: GtLCoderExpandableLepiterExplanationStyler
visitStringLiteral: aStringLiteralNodel
	super visitStringLiteral: aStringLiteralNodel.
	
	(self isNonEmptyLiteralStringNode: aStringLiteralNodel)
		ifFalse: [ ^ self ].
		
	self styleSameStrings: aStringLiteralNodel.
%

