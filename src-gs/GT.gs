method: GtLToolForExampleMethodRunExamples
exampleRunSuccess
	<gtExample>
	| tool call targetObject resultObject |
	resultObject := GtTMoneyExamples new fortyTwoEuros.
	self ensureLepiterPageForObject: resultObject withSnippetCode: 'GtTMoneyExamples new fortyTwoEuros'.
	tool := GtLToolForExampleMethodRun new.
	call := self
		executeTool: tool
		withArguments: {
			'exampleReference' -> {
					'exampleClassName' -> 'GtTMoneyExamples'.
					'methodName' -> 'fortyTwoEuros'.
					'classSide' -> false
				} asDictionary
			} asDictionary
		inContext: (GtLToolExecutionContext new 
			lepiterDatabase: self theDatabase).
	targetObject := call result targetObject.
	self assert: (targetObject isKindOf: GtLExampleWithResult).
	self assert: targetObject isSuccessResult.
	self assert: targetObject objectId isNil.
	self assert: targetObject playgroundPageReference notNil.
	self assert: targetObject playgroundPageReference databaseId equals: self theDatabase primaryDB uuidString.
	self assert: targetObject playgroundPageReference pageId equals: self theDatabase pages first uid asString36.
	^ call
%

method: GtLToolForExampleMethodRunExamples
exampleRunSuccessStoresObjectId
	<gtExample>
	| objectStorage tool call targetObject objectId storedObject resultObject |
	resultObject := GtLExampleRunDummyExamples new successfulExample.
	self ensureLepiterPageForObject: resultObject withSnippetCode: 'GtLExampleRunDummyExamples new successfulExample'.
	objectStorage := GtLObjectStorage new.
	tool := GtLToolForExampleMethodRun new.
	call := self
		executeTool: tool
		withArguments: {
			'exampleReference' -> {
				'exampleClassName' -> 'GtLExampleRunDummyExamples'.
				'methodName' -> 'successfulExample'.
				'classSide' -> false
			} asDictionary
		} asDictionary
		inContext: (GtLToolExecutionContext new 
			objectStorage: objectStorage;
			lepiterDatabase: self theDatabase).
	targetObject := call result targetObject.
	self assert: (targetObject isKindOf: GtLExampleWithResult).
	self assert: targetObject isSuccessResult.
	self assert: targetObject playgroundPageReference notNil.
	self assert: targetObject playgroundPageReference databaseId equals: self theDatabase primaryDB uuidString.
	self assert: targetObject playgroundPageReference pageId equals: self theDatabase pages first uid asString36.
	objectId := targetObject objectId.
	self assert: objectId isString.
	self assert: (objectStorage objectAt: objectId) equals: 42.
	storedObject := objectStorage storedObjectAt: objectId.
	self assert: storedObject reason class equals: GtLStoredObjectExampleMethodReason.
	^ call
%

category: 'private'
method: GtLToolForExampleMethodRunExamples
ensureLepiterPageForObject: anObject withSnippetCode: aString
	| page snippet |
	page := LePage pharoClassName: anObject class name.
	snippet := LePharoSnippet new.
	snippet code: aString.
	page addSnippet: snippet.
	self theDatabase addPage: page.
	self assert: page children size equals: 1
%

category: 'assertions'
method: GtLToolForTestMethodRunExamples
assertExceptionResult: resultJson errorClass: errorClassName errorMessage: errorMessage stackTraceIncludes: stackTraceSubstrings
	self assertJsonData: resultJson hasExpectedKeys: #('errorClass' 'errorMessage' 'stackTrace').
	self assert: (resultJson at: #errorClass) equals: errorClassName.
	self assert: ((resultJson at: #errorMessage) includesSubstring: errorMessage).
	stackTraceSubstrings do: [ :substring |
		self assert: ((resultJson at: #stackTrace) includesSubstring: substring) ].
%

category: 'examples'
method: GtLToolForTestMethodRunExamples
exampleRunComparisonFailure
	<gtExample>
	<return: #GtLTestCaseWithResultDomainObject>
	| call targetObject dataBlock jsonData exceptionData compositeView |
	
	call := self
		executeTool: GtLToolForTestMethodRun new
		withArguments: {
			'testReference' -> {
				'testClassName' -> 'GtLExampleDummyMixedTest'.
				'methodName' -> 'testComparisonFailure'
			} asDictionary
		} asDictionary.
	targetObject := call result targetObject.
	
	self assert: (targetObject isKindOf: GtLTestCaseWithResultDomainObject).
	self assert: targetObject isErrorResult.
	self assert: targetObject statusText equals: 'error'.
	
	compositeView := targetObject llmDataViewsFor: GtLDataView new.
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assert: dataBlock dataBlocks size equals: 2.
	self assert: dataBlock imageDataBlocks size equals: 1.
	
	jsonData := dataBlock llmJsonData.
	self assert: (jsonData at: #className) equals: 'GtLExampleDummyMixedTest'.
	self assert: (jsonData at: #selector) equals: 'testComparisonFailure'.
	self assert: (jsonData at: #status) equals: 'error'.
	self assert: (jsonData at: #result) equals: 'Error'.
	
	exceptionData := jsonData at: #exception.
	self
		assertExceptionResult: exceptionData
		errorClass: 'GtLExampleDataComparisonException'
		errorMessage: 'GtLExampleDataComparisonException'
		stackTraceIncludes: #('GtLExampleDummyMixedTest>>testComparisonFailure').
	
	^ call
%

