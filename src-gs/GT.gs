category: 'accessing'
method: GtLSynchronousPromise
error
	"Answer the rejection error, or nil if I am fulfilled"

	^ error
%

method: GtLSynchronousPromise
value
	"Answer the fulfilment value, or nil if I am rejected"

	^ value
%

method: GtLSynchronousPromise
wait
	"Answer my value, or my error if I am rejected (as TAsyncPromise>>#wait does; the error is answered, not signalled).
	I am already resolved, so I never block."

	^ isRejected ifTrue: [ error ] ifFalse: [ value ]
%

category: 'chaining'
method: GtLSynchronousPromise
otherwise: onRejectedBlock
	"Answer a promise for the value of onRejectedBlock (recovery), or myself if I am fulfilled"

	<return: #GtLSynchronousPromise>
	^ isRejected
		ifTrue: [ self class evaluate: onRejectedBlock with: error ]
		ifFalse: [ self ]
%

method: GtLSynchronousPromise
then: onFulfilledBlock
	"Answer a promise for the value of onFulfilledBlock, or myself if I am rejected"

	<return: #GtLSynchronousPromise>
	^ isRejected
		ifTrue: [ self ]
		ifFalse: [ self class evaluate: onFulfilledBlock with: value ]
%

method: GtLSynchronousPromise
then: onFulfilledBlock otherwise: onRejectedBlock
	"Evaluate only the block matching my state, as AsyncFulfilledPromise and AsyncRejectedPromise do.
	An Error signalled by the block answers a rejected promise; it is not passed on to the other block."

	<return: #GtLSynchronousPromise>
	^ isRejected
		ifTrue: [ self class evaluate: onRejectedBlock with: error ]
		ifFalse: [ self class evaluate: onFulfilledBlock with: value ]
%

category: 'printing'
method: GtLSynchronousPromise
printOn: aStream
	super printOn: aStream.
	isRejected ifNil: [ ^ self ].
	aStream
		nextPutAll: (isRejected ifTrue: [ ' (rejected: ' ] ifFalse: [ ' (fulfilled: ' ]).
	(isRejected ifTrue: [ error ] ifFalse: [ value ]) printOn: aStream.
	aStream nextPut: $)
%

category: 'private'
method: GtLSynchronousPromise
setError: anError
	value := nil.
	error := anError.
	isRejected := true
%

method: GtLSynchronousPromise
setValue: anObject
	value := anObject.
	error := nil.
	isRejected := false
%

category: 'testing'
method: GtLSynchronousPromise
isAsyncPromise
	^ true
%

method: GtLSynchronousPromise
isFulfilled
	^ isRejected not
%

method: GtLSynchronousPromise
isRejected
	^ isRejected
%

category: 'instance creation'
classmethod: GtLSynchronousPromise
evaluate: aBlock with: anObject
	"Evaluate aBlock with anObject (#cull:, so zero-argument blocks are accepted).
	Answer a promise returned by the block directly, as AsyncPromiseComputation does;
	otherwise answer a promise fulfilled with the value. Reject on Error."

	<return: #GtLSynchronousPromise>
	^ [ | aResult isPromise |
	aResult := aBlock cull: anObject.
	isPromise := self
			gtDo: [ aResult isAsyncPromise ]
			gemstoneDo: [ aResult isKindOf: GtLSynchronousPromise ].
	isPromise ifTrue: [ aResult ] ifFalse: [ self fulfilledWith: aResult ] ]
		on: Error
		do: [ :anError | self rejectedWith: anError ]
%

classmethod: GtLSynchronousPromise
fulfilledWith: anObject
	<return: #GtLSynchronousPromise>
	^ self new setValue: anObject
%

classmethod: GtLSynchronousPromise
rejectedWith: anError
	<return: #GtLSynchronousPromise>
	^ self new setError: anError
%

