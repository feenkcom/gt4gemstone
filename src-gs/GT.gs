%

method: GtLSmaCCToolForParserUpdates
parserUpdateDescription
	<magritteDescription>
	^ MAToOneRelationDescription new
		accessor: #parserUpdate;
		classes: {GtLSmaCCUpdateParser};
		beRequired
%

category: 'private'
method: GtLSmaCCToolForParserUpdates
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments updates |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	updates := arguments
			at: 'parserUpdate'
			ifAbsent: [ ^ GtLMissingArgumentDomainObject new
					arguments: arguments;
					missingArgument: 'parserUpdate' ].
	^ self
		grammarIn: updates
		do: [ :grammar | 
			| oldGrammar |
			updates edits
				do: [ :each | each validateFor: grammar onError: [ :error | ^ error ] ].
			oldGrammar := GtSmaCCGrammar new.
			oldGrammar scannerClassName: grammar scannerClassName.
			oldGrammar parserClassName: grammar parserClassName.
			oldGrammar updateSource: grammar source.
			updates edits do: [ :each | each performOn: grammar ].
			GtLSmaCCParserUpdateResult new
				parserClass: updates parserClass;
				oldGrammar: oldGrammar;
				newGrammar: grammar;
				yourself ]
		onError: [ :error | error ]
%

category: 'accessing'
method: GtLMagritteToolForSubstringLiteralSearch
description
	^ 'Searches for methods by substring literal match.

Arguments:
- query: string

Return values:
- foundMethods: array of method references
- mayHaveMore: boolean indicating if there are more matches than returned

Example JSON arguments:
{
  "query": "substringLiteralSearch"
}

Example JSON response:
{
  "foundMethods": [
    {
      "methodClassName": "GtLToolForSubstringLiteralSearch",
      "methodName": "privatePerformToolCall:inContext:",
      "classSide": false
    }
  ],
  "mayHaveMore": false
}'
%

method: GtLMagritteToolForSubstringLiteralSearch
name
	^ 'substringLiteralSearch'
%

method: GtLMagritteToolForSubstringLiteralSearch
queryDescription
	<magritteDescription>

	^ MAStringDescription new
		label: 'Query';
		accessor: #query;
		beRequired
%

category: 'private'
method: GtLMagritteToolForSubstringLiteralSearch
privatePerformToolCall: aToolCall inContext: anExecutionContext
	| arguments query matches |
	arguments := aToolCall arguments ifNil: [ Dictionary new ].
	query := arguments at: 'query'.

	(query trimBoth isEmpty)
		ifTrue: [ ^ GtLMissingArgumentDomainObject new
				arguments: arguments;
				missingArgument: 'query' ].

	matches := self
		gtDo: [
			| filter |
			filter := query asString gtSubstringLiteralMatch.
			(filter result toArray
				await: GtLSettings futureExecutionConfiguration) wait ]
		gemstoneDo: [
			| organizer methods matchesLiteral |
			organizer := ClassOrganizer gtDefault.
			methods := IdentitySet new.
			matchesLiteral := [ :literal |
				(literal isString and: [
					literal isSymbol not and: [
						(literal findPatternNoCase: { query asString } startingAt: 1) > 0 ] ])
					or: [ (literal isKindOf: Array) and: [
						literal anySatisfy: matchesLiteral ] ] ].
			organizer classes do: [ :class |
				{ class. class class } do: [ :behavior |
					(behavior _fullMethodDictEnv: organizer environmentId) valuesDo: [ :method |
						(method literals anySatisfy: matchesLiteral)
							ifTrue: [ methods add: method ] ] ] ].
			methods asArray ].

	^ GtLMethodsSearchResult fromReferences: matches
%

