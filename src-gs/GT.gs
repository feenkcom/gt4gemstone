 <gtGsExtension>
 "Answer a uniformly selected element."
 | index |
 self isEmpty ifTrue: [ self error: ''Cannot select from an empty collection'' ].
 index := Random new integerBetween: 1 and: self size.
 self do: [ :each | index := index - 1. index = 0 ifTrue: [ ^ each ] ]'
