category: 'private - change'
method: GtLMagritteToolForClassDefinitionChange
applyClassChangeUsing: extractor
	 | oldClass updatedClass originalDescription dictionary |
 oldClass := extractor targetClass.
 originalDescription := GtLClassDefinitionDescription fromClass: oldClass.
 [
 dictionary := System myUserProfile symbolList detect: [ :each |
 (each at: oldClass name ifAbsent: [ nil ]) == oldClass ].
 updatedClass := extractor superclass
 subclass: oldClass name
 instVarNames: extractor instanceVariables
 classVars: extractor classVariables
 classInstVars: extractor classInstanceVariables
 poolDictionaries: oldClass sharedPools
 category: extractor packageName
 inDictionary: dictionary
 options: #().
 updatedClass == oldClass ifFalse: [
 oldClass selectors do: [ :selector |
 updatedClass compileMethod: (oldClass compiledMethodAt: selector) sourceString
 category: (oldClass categoryOfSelector: selector) environmentId: 0 ].
 oldClass class selectors do: [ :selector |
 updatedClass class compileMethod: (oldClass class compiledMethodAt: selector) sourceString
 category: (oldClass class categoryOfSelector: selector) environmentId: 0 ] ].
 updatedClass comment: oldClass comment.
 ClassOrganizer gtDefault addClass: updatedClass
 ] on: Error do: [ :error | ^ GtLProblemDomainObject new errorMessage: error description ].
 ^ GtLClassModificationResult new
 originalClass: originalDescription;
 updatedClass: (GtLClassDefinitionDescription fromClass: updatedClass);
 yourself
%

category: 'examples'
method: GtLMagritteToolForMethodsCompilationExamples
compileInstanceSideMethodsWithExistingSources
		<gtExample>
	| call targetClass selectorOne selectorTwo sourceBeforeOne sourceBeforeTwo |
	targetClass := GtLMagritteToolForMethodsCompilationExamples.
	selectorOne := #gtMagritteCompiledExampleExistingOne.
	selectorTwo := #gtMagritteCompiledExampleExistingTwo.
	sourceBeforeOne := 'gtMagritteCompiledExampleExistingOne ^ 10'.
	sourceBeforeTwo := 'gtMagritteCompiledExampleExistingTwo ^ 20'.
	targetClass compileMethod: sourceBeforeOne category: 'examples' environmentId: 0.
	targetClass compileMethod: sourceBeforeTwo category: 'examples' environmentId: 0.
	[
		call := self
			executeTool: GtLMagritteToolForMethodsCompilation new
			withArguments: {
				'methods' -> {
					{
						'methodClassName' -> 'GtLMagritteToolForMethodsCompilationExamples'.
						'sourceCode' -> 'gtMagritteCompiledExampleExistingOne ^ 11'.
						'protocol' -> 'examples'.
						'classSide' -> false
					} asDictionary.
					{
						'methodClassName' -> 'GtLMagritteToolForMethodsCompilationExamples'.
						'sourceCode' -> 'gtMagritteCompiledExampleExistingTwo ^ 21'.
						'protocol' -> 'examples'.
						'classSide' -> false
					} asDictionary
				}
			} asDictionary.
		self assert: (call result targetObject isKindOf: GtLMethodsCompilationResult).
		self assert: call result targetObject methods size equals: 2.
		self assert: call result targetObject methods first oldMethod sourceCode equals: sourceBeforeOne.
		self assert: call result targetObject methods second oldMethod sourceCode equals: sourceBeforeTwo.
		self assert: call result targetObject methods first newMethod sourceCode equals: 'gtMagritteCompiledExampleExistingOne ^ 11'.
		self assert: call result targetObject methods second newMethod sourceCode equals: 'gtMagritteCompiledExampleExistingTwo ^ 21'
	] ensure: [
		(targetClass includesSelector: selectorOne)
			ifTrue: [ targetClass removeSelector: selectorOne ].
		(targetClass includesSelector: selectorTwo)
			ifTrue: [ targetClass removeSelector: selectorTwo ] ].
	^ call
%

category: 'private'
method: GtLToolForExampleClassesRunExamples
createDynamicExampleClass
		| className testClass |
	className := ('ExampleRunDummyExamples_Test', (UUID new asString36 copyFrom: 1 to: 8)) asSymbol.
	testClass := Object subclass: className instVarNames: #() inDictionary: UserGlobals.
	testClass category: 'Gt4LlmCore-Examples-Temporary'.
	[ #('successfulExample
	<gtExample>
	^ 42' 'failingExample
	<gtExample>
	self assert: false' 'errorExample
	<gtExample>
	self error: ''Intentional example error''' 'skippedExample
	<gtExample>
	<noTest>
	^ 100') do: [ :source |
		testClass compileMethod: source category: #examples environmentId: 0 ] ]
		on: Error do: [ :ex | UserGlobals removeKey: className. ex pass ].
	^ testClass
%

