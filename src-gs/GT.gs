category: 'copying'
method: GtLMessagesGroup
copyForIndependentRequestInChat: aChat
	self isEmpty ifTrue: [ ^ self class withAll: #() ].
	^ self copyForIndependentRequestInChat: aChat upTo: self last
%

method: GtLMessagesGroup
copyForIndependentRequestInChat: aChat upTo: aLastMessage
	| copiedItems |
	
	copiedItems := OrderedCollection new.
	
	items doWithIndex: [ :currentMessage :index | 
			| shouldStop |
			shouldStop := currentMessage = aLastMessage.
			copiedItems add: (currentMessage isReplyMessage
				ifTrue: [ 
					shouldStop := shouldStop or: [
						currentMessage includesMessage: aLastMessage  ].
					currentMessage 
						copyForIndependentRequestInChat: aChat 
						withUserMessage: (copiedItems at: index - 1)
						upTo: aLastMessage. ] 
				ifFalse: [ 
					currentMessage copyForIndependentRequestInChat: aChat ]).
			shouldStop ifTrue: [
				^ self class withAll: copiedItems ] ].
	
	^ self class withAll: copiedItems
%

category: 'enumerating'
method: GtLMessagesGroup
messagesBeforeMatching: aBlock andAllWithAndAfter: aMessage
	| found |
	found := false.
	^ self messagesSelect: [ :eachMessage | 
		(eachMessage = aMessage) ifTrue: [ found := true ].
		found or: [ aBlock value: eachMessage ] ].
%

method: GtLMessagesGroup
messagesDo: aBlock
	"Evaluate do block on all messages.
	Note that some messages may be a composition of other messages."

	self do: [ :eachMessage | eachMessage messagesDo: aBlock ]
%

method: GtLMessagesGroup
messagesReverseDo: aBlock
	"Evaluate do block on all messages in reverse order.
	Note that some messages may be a composition of other messages."

	self reverseDo: [ :eachMessage | eachMessage messagesReverseDo: aBlock ]
%

method: GtLMessagesGroup
messagesSelect: aBlock
	| all |
	all := self species new.
	self messagesDo: [ :eachMessage | 
		(aBlock value: eachMessage) ifTrue: [ all add: eachMessage ] ].
	^ all
%

method: GtLMessagesGroup
messagesWithAndAfter: aMessage
	| found |
	found := false.
	^ self messagesSelect: [ :eachMessage | 
		(eachMessage = aMessage) ifTrue: [ found := true ].
		found ].
%

