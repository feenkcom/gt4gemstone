method: GtLLepiterContentExporter
codeSnippet: aString labelled: aName
	stream
		nextPutAll: '```' , aName
				, '
' , (aString ifNil: [ '' ])
				, '
```'
%

method: GtLLepiterContentExporter
export
	stream := WriteStream on: ''.
	level := 0.
	toExport do: [ :each | 
		[ self visit: each ]
			on: Error
			do: [ :ex |
				strictMode ifTrue:
					[ ex pass ]
				ifFalse:
					[ self errorPages add: each -> ex freeze ] ] ].
	^ stream contents
%

method: GtLLepiterContentExporter
heading: aString level: anInteger
	^ ('#' repeat: anInteger) , ' ' , aString
%

method: GtLLepiterContentExporter
indent: aString
	^ aString"
	level = 0 ifTrue: [ ^ aString ].
	^ ('    ' repeat: level) , '- ' , aString"
%

method: GtLLepiterContentExporter
initialize
	super initialize.
	toExport := OrderedCollection new.
	startHeaderLevel := 1.
	strictMode := true.
%

method: GtLLepiterContentExporter
linebreaks
	stream
		nextPut: Character linefeed;
		nextPut: Character linefeed
%

method: GtLLepiterContentExporter
visit: each
