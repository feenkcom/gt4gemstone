method: GtClassExampleGroup
methodAdded: aMethodAnnouncement
	aMethodAnnouncement methodAdded methodClass = self exampleClass
		ifTrue: [ 
			examples add: aMethodAnnouncement methodAdded gtExample asExampleWithResult.
			self announcer announce: GtExamplesUpdatedAnnouncement new ]
%

method: GtClassExampleGroup
methodRemoved: aMethodAnnouncement
	aMethodAnnouncement methodRemoved methodClass = self exampleClass
		ifTrue: [ 
			examples 
				detect: [:each | each example selector = aMethodAnnouncement methodRemoved selector]
				ifFound: [ :exampleToRemove |
					examples remove: exampleToRemove.
					self announcer announce: GtExamplesUpdatedAnnouncement new ] ]
%

method: GtClassExampleGroup
subscribe
	SystemAnnouncer uniqueInstance weak
		when: MethodAdded send: #methodAdded: to: self;
		when: MethodRemoved send: #methodRemoved: to: self
%

category: 'accessing'
classmethod: GtClassExampleGroup
leJsonV4Name

	^ #gtClassExampleGroup
%

category: 'jsonV3'
classmethod: GtClassExampleGroup
leJsonV4AttributeMapping

	^ super leJsonV4AttributeMapping
		add: #exampleClassName -> #exampleClassName;
		add: #examples -> #examples;
		yourself.
%

category: 'accessing'
method: GtLClassChangeHistoriesGroup
addHistory: aHistory
	self add: aHistory
%

method: GtLClassChangeHistoriesGroup
methodHistories
	"Flatten all method histories from all class histories"
	^ GtLMethodChangeHistoriesGroup new
		addItems: (self items flatCollect: [ :aClassHistory | aClassHistory methodHistories items ]);
		yourself
%

category: 'views'
method: GtLClassChangeHistoriesGroup
gtViewDetailedHistoriesFor: aView
	<gtView>
	
	^ aView columnedTree 
		title: 'By class (detailed)';
		priority: 50;
		items: [ self items ];
		children: [ :anEntry | anEntry gtViewChangeHistoryChildren ];
		column: 'Change' do: [ :aColumn |
			aColumn
				cellStencil: [ GtLCodeChangesDetailsElement new ];
				dataBinder: [ :anElement :aCodeChange | anElement codeChange: aCodeChange ] ];
		column: 'Count' text: [ :anEntry | 
			| entryChangesCount |
			entryChangesCount := anEntry gtViewChangesCount.
			entryChangesCount isZero 
				ifTrue: ['']
				ifFalse: [
					entryChangesCount asString
						, ' '
							, ('change' asPluralBasedOn: entryChangesCount) ]] width: 100;
		column: 'Timestamp' text: [ :anEntry | 
			anEntry gtViewChangeEditTime
				ifNil: ['']
				ifNotNil: [ :aDateAndTime | 
					aDateAndTime printToSeconds ]  ] width: 150
%

method: GtLClassChangeHistoriesGroup
gtViewHistoriesFor: aView
	<gtView>
	
	^ aView columnedTree 
		title: 'By class';
		priority: 20;
		items: [ self items ];
		expandAll;
		children: [ :anEntry | anEntry gtViewChangeHistoryChildren ];
		column: 'Change' do: [ :aColumn |
			aColumn
				cellStencil: [ GtLCodeChangesDetailsElement new ];
				dataBinder: [ :anElement :aCodeChange | anElement codeChange: aCodeChange ] ]
%

category: 'building'
method: GtLACPPermissionScripterExamples
pendingPermissionDisplayed
	<gtExample>
	| permission scripter |
	permission := GtLACPExamples new pendingPermission.
	scripter := BlScripter new
			extent: 1000 @ 700;
			model: permission;
			element: permission session asElement;
			yourself.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-section';
				satisfies: #isExpanded ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-permission-toolbar-permission-1';
				satisfies: [ :toolbar | 
					toolbar class = BrToolbar
						and: [ (toolbar items count: [ :item | item isKindOf: BrButton ]) = 2 ] ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-tool-kind-tool-1';
				satisfies: [ :badge | badge text asString = 'tool' ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-tool-summary-tool-1';
				satisfies: [ :button | button label asString = permission toolCall shortDescription ] ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-content';
				satisfies: [ :work | 
					(GtLACPSessionExamples new editorsIn: work)
						noneSatisfy: [ :editor | editor text asString includesSubstring: 'Permission required' ] ] ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

category: 'examples'
method: GtLACPPermissionScripterExamples
cancelledPermissionDisplayed
	<gtExample>
	| scripter |
	scripter := self pendingPermissionDisplayed.
	scripter doStep: [ :step | step block: [ scripter model session cancelTurn ] ].
	scripter pulseUntilReady.
	self assert: scripter model state equals: #cancelled.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-permission-toolbar-permission-1';
				notExists ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-permission-decision-permission-1';
				value: [ :editor | editor text asString ]
					equals: [ 'Permission cancelled' ] ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

method: GtLACPPermissionScripterExamples
childPermissionOpensWork
	<gtExample>
	| root child helper scripter permission |
	root := GtLACPExamples new session.
	root prompt: 'Ask a worker to inspect the directory'.
	helper := GtLACPSubagentExamples new.
	child := helper
			announce: 'permission-worker'
			title: 'Directory worker'
			in: root.
	helper
		task: 'Inspect the directory'
		from: root
		to: child
		id: 'permission-task'.
	scripter := BlScripter new
			extent: 1100 @ 900;
			model: root;
			element: root asElement;
			yourself.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-content';
				notExists ].
	scripter
		doStep: [ :step | step block: [ self receivePermissionIn: child requestId: 'child-permission' ] ].
	scripter pulseUntilReady.
	permission := child currentTurn permissionRequests first.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-work-section';
				satisfies: #isExpanded ].
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-permission-toolbar-child-permission';
				exists ].
	scripter click
		id: #'acp-permission-allow';
		play.
	scripter pulseUntilReady.
	self assert: permission state equals: #selected.
	scripter
		assertStep: [ :step | 
			step
				id: #'acp-permission-decision-child-permission';
				exists ].
	GtLACPSessionExamples new assertNoRenderingErrorsIn: scripter.
	^ scripter
%

