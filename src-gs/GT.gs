category: 'updating'
classmethod: GtGemStoneExtensionMethods
updateHashOf: aSelector
	| method extension hashMessages hashArgument source updatedSource |
	(self extensionSelectors includes: aSelector)
		ifFalse: [ self error: 'Unknown extension method: ', aSelector asString ].
	method := self class >> aSelector.
	method protocolName = #extensions
		ifFalse: [ self error: 'Method is not in the extensions protocol: ', aSelector asString ].
	extension := self perform: aSelector.
	extension existingMethod
		ifNil: [ self error: 'Cannot update the hash of a missing target method: ', extension className asString, '>>', extension selector asString ].
	hashMessages := method ast allChildren
		select: [ :node | node isMessage and: [ node selector = #hash: ] ].
	hashMessages size = 1
		ifFalse: [ self error: 'Expected exactly one hash: send in extension method: ', aSelector asString ].
	hashArgument := hashMessages first arguments first.
	hashArgument isLiteralNode
		ifFalse: [ self error: 'Expected a literal hash in extension method: ', aSelector asString ].
	source := method sourceCode.
	updatedSource := (source copyFrom: 1 to: hashArgument start - 1),
		extension existingMethodHash storeString,
		(source copyFrom: hashArgument stop + 1 to: source size).
	updatedSource = source
		ifFalse: [ self class compile: updatedSource classified: method protocolName ].
	^ self perform: aSelector
%

category: 'accessing'
method: GROrderedMultiMap
add: anAssociation
	self privateAt: anAssociation key put: anAssociation value.
	^ anAssociation
%

method: GROrderedMultiMap
allAt: aKey
	^ Array streamContents: [ :stream |
		1 to: size do: [ :index |
			(keys at: index) = aKey
				ifTrue: [ stream nextPut: (values at: index) ] ] ]
%

method: GROrderedMultiMap
allAt: aKey ifAbsent: absentBlock
	| results |
	results := self allAt: aKey.
	^ results isEmpty
		ifTrue: [ absentBlock value ]
		ifFalse: [ results ]
%

method: GROrderedMultiMap
at: aKey add: aValue
	"Add an association between aKey and aValue. Do not replace existing
	values with the same key."

	^ self privateAt: aKey put: aValue
%

method: GROrderedMultiMap
removeKey: aKey ifAbsent: aBlock
	"Remove aKey from the receiver, evaluate aBlock if the element is missing."

	"This is inefficient and could be optimized."
	| removed |
	removed := Array new: 2 streamContents: [ :stream |
		| index |
		[ (index := self findIndexFor: aKey) = 0 ] whileFalse: [
			stream nextPut: (self removeIndex: index) ] ].
	^ removed isEmpty
		ifTrue: [ aBlock value ]
		ifFalse: [ removed ]
%

category: 'adding'
method: GROrderedMultiMap
"protocol: adding"
addAll: aDictionary
	aDictionary keysAndValuesDo: [ :key :value |
			self privateAt: key put: value ].
	^ aDictionary
%

category: 'enumerating'
method: GROrderedMultiMap
keysAndAllValuesDo: aTwoArgumentBlock
	| seenKeys |
	seenKeys := GRSmallOrderedSet new.
	1 to: size do: [ :index |
		| key |
		key := keys at: index.
		(seenKeys includes: key) ifFalse: [
			aTwoArgumentBlock
				value: key
				value: (self privateAllAt: key startingAt: index).
			seenKeys add: key ] ]
%

category: 'private'
method: GROrderedMultiMap
privateAllAt: aKey startingAt: aStartInteger
	^ Array new: 2 streamContents: [ :stream |
		aStartInteger to: size do: [ :index |
			(keys at: index) = aKey
				ifTrue: [ stream nextPut: (values at: index) ] ] ]
%

category: 'examples'
method: GtLMethodWithSourceExamples
methodWithSourceDataViewSerialization
	<gtExample>
	<return: #GtLPrimitiveMessageDataBlock>
	| domainObject compositeView dataBlock jsonData |
	domainObject := self methodWithSourceObjectFromCompiledMethodClassSide.
	
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock compositeJsonData.
	self assert: ((jsonData at: #methodReference) at: #methodName) equals: 'fromCompiledMethod:'.
	self assert: ((jsonData at: #methodReference) at: #methodClassName) equals: 'GtLMethodReference'.
	self assert: ((jsonData at: #methodReference) at: #classSide) equals: true.
	self assert: (jsonData at: #sourceCode) equals: (GtLMethodReference class >> #fromCompiledMethod:) sourceCode.
	
	^ dataBlock
%

method: GtLMethodWithSourceExamples
methodWithSourceObjectFromCompiledMethodClassSide
	<gtExample>
	| methodObject |
	methodObject := GtLMethodWithSource
		fromCompiledMethod: (GtLMethodReference class>>#fromCompiledMethod:).

	self
		assert: methodObject methodName
		equals: #fromCompiledMethod:.
	self
		assert: methodObject methodClassName
		equals: #GtLMethodReference.
	self
		assert: methodObject isClassSide
		equals: true.
	self
		assert: methodObject methodClass
		equals: GtLMethodReference class.
	self
		assert: methodObject compiledMethod
		equals: (GtLMethodReference class>>#fromCompiledMethod:).
	self
		assert: methodObject sourceCode
		equals: (GtLMethodReference class>>#fromCompiledMethod:) sourceCode.

	^ methodObject
%

method: GtLMethodWithSourceExamples
methodWithSourceObjectFromCompiledMethodClassSideJsonExport
	<gtExample>
	| methodObject jsonObject |
	methodObject := self methodWithSourceObjectFromCompiledMethodClassSide.
	jsonObject := GtMagritteJSONDataExporter exportObject: methodObject.
	self
		assert: jsonObject
		equals: ((NeoJSONObject new)
			at: 'methodReference' put: ((NeoJSONObject new)
				at: 'methodName' put: 'fromCompiledMethod:';
				at: 'methodClassName' put: 'GtLMethodReference';
				at: 'classSide' put: true;
				yourself);
			at: 'sourceCode' put: (GtLMethodReference class>>#fromCompiledMethod:) sourceCode;
			yourself).

	^ jsonObject
%

