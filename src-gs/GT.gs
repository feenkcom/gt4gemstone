category: 'views'
method: GtLMethodsSearchResult
gtFoundMethodsFor: aView
	<gtView>
	<gtLlmView>
	^ aView columnedList
		title: 'Found methods';
		priority: 1;
		items: [ self foundMethods ];
		column: 'Class' text: [ :each | each methodClass name ] width: 200;
		column: 'Method' text: [ :each | each methodName ]
%

method: GtLMethodsSearchResult
gtMethodsFor: aView
	<gtView>
	<gtLlmView>
	(self foundMethods anySatisfy: [:each | each isKindOf: GtLMissingDomainObject]) ifTrue: [ ^ aView empty ].
	^ aView forward
		title: 'Methods';
		priority: 1;
		object: [ GtSearchFixedMethodsFilter new methods: (self foundMethods 
			collect: [ :each | each compiledMethod ]) ];
		view: #gtItemsFor:
%

category: 'instance creation'
classmethod: GtLMethodsSearchResult
fromReferences: aCollection
	| matchesArray limited |
	matchesArray := aCollection asArray.
	limited := matchesArray first: (200 min: matchesArray size).
	^ self new
		foundMethods: (limited collect: [ :each | GtLMethodReference fromCompiledMethod: each ]);
		mayHaveMore: matchesArray size > 200;
		yourself
%

