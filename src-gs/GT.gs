category: 'visiting'
method: MADescriptionFlattener
addToBuildedDescription: aDescription for: aValue
	"aValue is the intermediate value that can be processed by further expansion"
	aDescription canExpand
		ifTrue: [ self expandDescription: aDescription for: aValue ]
		ifFalse: [ builtDescription add: aDescription ]
%

method: MADescriptionFlattener
expandDescription: aDescription for: aValue
	aValue magritteDescription do: [ :each |
		| val |
		val := aValue readUsing: each.
		each
			addToAccessor: aDescription accessor;
			priority: aDescription priority + (each priority / 1000).
		aDescription groupExpandOnLabel
			ifTrue: [ each group: aDescription label ]
			ifFalse: [ each group: aDescription group ].
		self addToBuildedDescription: each for: val ]
%

category: 'visiting-description'
method: MADescriptionFlattener
visitToOneRelationDescription: aDescription
	| sample |
	aDescription canExpand ifFalse: [ ^ super visitToOneRelationDescription: aDescription ].
	sample := self target isCollection
		ifTrue: [
			self target ifEmpty: [ ^ super visitToOneRelationDescription: aDescription ].
			self target anyOne ]
		ifFalse: [ self target ].
	(sample readUsing: aDescription)
		ifNil: [ super visitToOneRelationDescription: aDescription ]
		ifNotNil: [ :value | self expandDescription: aDescription for: value ]
%

category: 'examples'
method: GtLMissingArgumentDomainObjectExamples
basicMissingArgumentDomainObject
	<gtExample>
	<return: #GtLMissingArgumentDomainObject>
	| domainObject |
	domainObject := GtLMissingArgumentDomainObject new
		missingArgument: 'requiredParam';
		arguments: {'existingArg' -> 'someValue'. 'anotherArg' -> 42} asDictionary;
		errorMessage: 'Missing required argument: requiredParam';
		yourself.
	self assert: domainObject missingArgument equals: 'requiredParam'.
	self assert: domainObject errorMessage equals: 'Missing required argument: requiredParam'.
	self assert: domainObject arguments size equals: 2.
	^ domainObject
%

method: GtLMissingArgumentDomainObjectExamples
emptyMissingArgumentDomainObject
	<gtExample>
	<return: #GtLMissingArgumentDomainObject>
	| domainObject compositeView dataBlock jsonData expectedJson |
	
	domainObject := GtLMissingArgumentDomainObject new.
	self assert: domainObject missingArgument isNil.
	self assert: domainObject errorMessage equals: ''.
	
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock compositeJsonData.
	expectedJson := {
		#missingArgument -> nil.
		#errorMessage -> ''
	} asDictionary.
	self assert: jsonData equals: expectedJson.
	
	^ domainObject
%

method: GtLMissingArgumentDomainObjectExamples
missingArgumentDataViewSerialization
	<gtExample>
	<return: #Dictionary>
	| domainObject compositeView dataBlock expectedJson |
	
	domainObject := self basicMissingArgumentDomainObject.
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	expectedJson := {
		#missingArgument -> 'requiredParam'.
		#errorMessage -> 'Missing required argument: requiredParam'
	} asDictionary.
	self assertDataBlock: dataBlock hasLlmJsonData: expectedJson.
	
	^ dataBlock llmJsonData
%

method: GtLMissingArgumentDomainObjectExamples
missingArgumentWithEmptyArguments
	<gtExample>
	<return: #GtLMissingArgumentDomainObject>
	| domainObject compositeView dataBlock jsonData expectedJson |
	
	domainObject := GtLMissingArgumentDomainObject new
		missingArgument: 'requiredParam';
		arguments: #().
	self assert: domainObject missingArgument equals: 'requiredParam'.
	self assert: domainObject arguments isEmpty.
	
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock compositeJsonData.
	expectedJson := {
		#missingArgument -> 'requiredParam'.
		#errorMessage -> 'Missing argument called requiredParam'
	} asDictionary.
	self assert: jsonData equals: expectedJson.
	
	^ domainObject
%

method: GtLMissingArgumentDomainObjectExamples
missingArgumentWithoutErrorMessage
	<gtExample>
	<return: #GtLMissingArgumentDomainObject>
	| domainObject compositeView dataBlock jsonData expectedJson |
	
	domainObject := GtLMissingArgumentDomainObject new
		missingArgument: 'testParam'.
	self assert: domainObject missingArgument equals: 'testParam'.
	self assert: domainObject errorMessage equals: 'Missing argument called testParam'.
	
	compositeView := domainObject llmDataViewsFor: GtLDataView new.
	self assert: compositeView dataViews size equals: 1.
	
	dataBlock := compositeView serializeToLlmPrimiteData.
	self assertDataBlockHasOnlyJsonData: dataBlock.
	
	jsonData := dataBlock compositeJsonData.
	expectedJson := {
		#missingArgument -> 'testParam'.
		#errorMessage -> 'Missing argument called testParam'
	} asDictionary.
	self assert: jsonData equals: expectedJson.
	
	^ domainObject
%

category: 'examples'
method: GtLWorldChatRegistryDropdownExamples
dropdownUpdatesAfterAddingChat
	<gtExample>
	<return: #BlScripter>
	| registry dropdown scripter |
	registry := GtLChatRegistry new.
	registry newChatWithProvider: GtLOpenAIProviderStub new.
	dropdown := GtLWorldChatRegistryDropdown new
			registry: registry;
			yourself.
	scripter := BlScripter new
			model: registry;
			element: dropdown.

	scripter click
		label: 'Open chats dropdown';
		/ BrButton;
		play.

	scripter assert
		label: 'Assert chat list starts with one chat';
		value: [ :aList | aList items size ] equals: 1;
		onSpaceRoot;
		// BrColumnedList;
		play.

	scripter do
		label: 'Add new chat';
		block: [ registry newChatWithProvider: GtLOpenAIProviderStub new ];
		play.

	scripter assert
		label: 'Assert updated chat list has two items';
		value: [ :aList | aList items size ] equals: 2;
		onSpaceRoot;
		// BrColumnedList;
		play.

	scripter assert
		label: 'Assert updated chat list element has two children';
		value: [ :aScollable | aScollable childrenCount ] equals: 2;
		onSpaceRoot;
		// BrColumnedList;
		/ #scrollable;
		play.

	^ scripter
%

method: GtLWorldChatRegistryDropdownExamples
dropdownWithChats
	<gtExample>
	<return: #BlScripter>
	| registry dropdown scripter |
	registry := GtLChatRegistry new.
	
	registry newChatWithProvider: GtLOpenAIProviderStub new.
	registry newChatWithProvider: GtLOpenAIProviderStub new.
	
	dropdown := GtLWorldChatRegistryDropdown new 
		registry: registry; yourself.
	scripter := BlScripter new
		model: registry;
		element: dropdown.

	scripter click
		label: 'Open chats dropdown';
		/ BrButton;
		play.

	scripter assert
		label: 'List shows two chats';
		value: [ :aList | aList items size ] equals: 2;
		onSpaceRoot;
		// BrColumnedList;
		play.

	^ scripter
%

