mapOpenApiField: fieldName to: propertyName
	^ self
		mapProperty: propertyName
		getter: [ :object | object fields fieldAt: fieldName ]
		setter: [ :object :value | object fieldAt: fieldName put: value ]
%

category: 'accessing'
method: NeoJSONObjectMapping
identifier
	^ subjectClass 
%

method: NeoJSONObjectMapping
propertyNamed: propertyName ifAbsent: block
	| symbolPropertyName |
	symbolPropertyName := propertyName asSymbol.
	^ properties detect: [ :each | each propertyName = symbolPropertyName ] ifNone: block
%

method: NeoJSONObjectMapping
subjectClass: smalltalkClass
	subjectClass := smalltalkClass
%

category: 'convenience'
method: NeoJSONObjectMapping
mapAllInstVars
