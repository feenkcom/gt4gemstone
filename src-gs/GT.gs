method: GtLACPLiveExamples
claudeCodeTurn
	<gtExample>
	| session turn |
	self class enabled ifFalse: [ ^ nil ].
	session := GtLACPClaudeCodeClient new startSessionIn: FileLocator temp.
	[ turn := session
			prompt: 'Reply exactly "ACP connected". Do not use tools or change files.'.
