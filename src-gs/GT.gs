	<return: #BlText>
	| aPath |
	aPath := '[' asRopedText
		         append: self index asRopedText;
		         append: ']' asRopedText.
		         
	self exists ifFalse: [ 
		aPath foreground: BrGlamorousColors errorBackgroundColor ].
		
