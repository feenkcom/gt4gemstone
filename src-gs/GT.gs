category: 'printing'
method: GtLClassDefinitionDescription
printOn: aStream
	super printOn: aStream.
	aStream parenthesize: [
		aStream nextPutAll: (currentClassName ifNil: [ 'unnamed' ]).
		superclassName ifNotNil: [ 
			aStream nextPutAll: ' < ';
				nextPutAll: superclassName ].
		packageName ifNotNil: [ 
			aStream nextPutAll: ' — ';
				nextPutAll: packageName ] ]
%

category: 'views'
method: GtLClassDefinitionDescription
gtClassCoderViewFor: aView
	<gtView>
	<gtLlmView>
	| aClass |
	aClass := self currentClassName asClassIfAbsent: [ ^ aView empty ].
	^ aView explicit
		title: 'Class';
		priority: 0;
		stencil: [ | container |
			container := BrVerticalPane new
					matchParent;
					background: BrGlamorousColors backdropColor.
			container
