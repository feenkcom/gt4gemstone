    to run we report a test failure. "

	^ aBlock 
		valueWithinMilliseconds: aDuration asMilliSeconds 
		onTimeout: [
			self
				assert: false
				description: ['Block evaluation took more than the expected <1p>' expandMacrosWith: aDuration ]
	]
