category: 'convenience'
method: ZnUrl
withPathSegment: segment
	"Return a new URL equal to the receiver with its path extended with segment"
	
	^ self copy
		addPathSegment: segment;
		yourself
%
category: 'convenience'
method: ZnUrl
withPathSegments: pathSegments
