category: 'accessing'
method: ZnUrl
portOrDefault
	^ self hasPort
		ifTrue: [ self port ]
		ifFalse: [ self class defaultPortForScheme: self schemeOrDefault ]
%
category: 'copying'
method: ZnUrl
postCopy
	super postCopy.
	segments := segments copy.
	query := query copy
%
category: 'printing'
method: ZnUrl
printAuthorityOn: stream
	self hasUsername ifTrue: [
		self encode: self username on: stream.
		self hasPassword ifTrue: [
			stream nextPut: $:.
			self encode: self password on: stream ].
		stream nextPut: $@ ].
	self hasHost ifTrue: [ 
		self encode: self host on: stream ].
	self hasPort ifTrue: [ 
		stream nextPut: $:; print: self port ]
%
category: 'printing'
method: ZnUrl
printOn: stream
	self hasScheme ifTrue: [ 
		stream nextPutAll: self scheme; nextPutAll: '://' ].
	self printAuthorityOn: stream.
	self printPathQueryFragmentOn: stream
%
category: 'printing'
method: ZnUrl
printPathOn: stream
	self hasPath ifFalse: [ ^ stream nextPut: $/ ].
 	segments do: [ :each | 
		stream nextPut: $/.
		each == #/
			ifFalse: [ 
				self encode: each on: stream ] ]
%
category: 'printing'
method: ZnUrl
printPathQueryFragmentOn: stream
	self printPathOn: stream.
	self hasQuery
		ifTrue: [ self printQueryOn: stream ].
	self hasFragment
		ifFalse: [ ^ self ].
	stream nextPut: $#.
	self encode: self fragment on: stream
%
category: 'printing'
method: ZnUrl
printQueryOn: stream
	stream nextPut: $?. 
	ZnResourceMetaUtils writeQueryFields: self query on: 	stream
%
