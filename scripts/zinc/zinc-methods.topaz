	^ self hasPath not or: [ segments size = 1 and: [ segments first = #/ ] ]
%
category: 'accessing-path'
method: ZnUrl
lastPathSegment
	^ self isSlash
		ifTrue: [ nil ]
		ifFalse: [ segments last ]
