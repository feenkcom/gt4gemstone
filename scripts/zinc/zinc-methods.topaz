category: 'private'
classmethod: ZnHTTPSocketFacade
client
	^ ZnClient new
		beOneShot;
		yourself
%
category: 'private'
classmethod: ZnHTTPSocketFacade
constructMultiPartFormDataEntity: arguments
	| entity |
	entity := ZnMultiPartFormDataEntity new.
	arguments keysAndValuesDo: [ :key :values |
		values do: [ :value |
			entity addPart: ((value isKindOf: MIMEDocument)
				ifFalse: [ 
					 ZnMimePart fieldName: key value: value ]
				ifTrue: [ | fileEntity contents |
					contents := value content isNil 
						ifTrue: [ (FileStream fileNamed: value url pathForFile) contentsOfEntireFile ] 
						ifFalse: [ value content ].
					fileEntity := ZnEntity with: contents type: value contentType.
					ZnMimePart fieldName: key fileName: value url pathForFile entity: fileEntity ]) ] ].
	^ entity
%
category: 'private'
classmethod: ZnHTTPSocketFacade
execute: request on: stream
	"All our requests are one shot"
	
	request setConnectionClose.
	^ [ 
		request writeOn: stream.
		stream flush.
		ZnResponse readFrom: stream ] ensure: [ stream close ]
%
category: 'private'
classmethod: ZnHTTPSocketFacade
extendHeaders: headers with: object 
	(object isNil or: [ object isEmpty ]) ifTrue: [ ^ headers ].
	object isString 
		ifTrue: [ headers addAll: (ZnHeaders readFrom: object readStream) ] 
		ifFalse: [ headers withAll: object ].
	^ headers
%
category: 'private'
classmethod: ZnHTTPSocketFacade
extendUrl: urlObject withArguments: arguments
	| url |
	url := urlObject asZnUrl.
	(arguments isNil or: [ arguments isEmpty ]) ifTrue: [ ^ url ].
	^ arguments isString
		ifTrue: [ 
			(url printString, (arguments first = $? ifTrue: [ arguments ] ifFalse: [ '?', arguments ])) asZnUrl ] 
		ifFalse: [
			url == urlObject ifTrue: [ url := url copy ].   
			arguments keysAndValuesDo: [ :key :value | 
				value do: [ :each | url queryAt: key add: each ] ].
			^ url ]
%
