category: 'accessing'
classmethod: ZnConstants
frameworkLicense
	"http://en.wikipedia.org/wiki/MIT_License"
	
	^ 'MIT License'
%
category: 'accessing'
classmethod: ZnConstants
frameworkName
	^ 'Zinc HTTP Components'
%
category: 'accessing'
classmethod: ZnConstants
frameworkNameAndVersion
	^ self frameworkName, ' ', self frameworkVersion
%
category: 'accessing'
classmethod: ZnConstants
frameworkVersion
	^ '1.0'
%
category: 'accessing'
classmethod: ZnConstants
httpStatusCodes
	^ HTTPStatusCodes
%
category: 'class initialization'
classmethod: ZnConstants
initialize 
	self initializeHTTPStatusCodes
%
category: 'private'
classmethod: ZnConstants
initializeHTTPStatusCodes 
	"This is the official list from http://www.iana.org/assignments/http-status-codes"

	HTTPStatusCodes := Dictionary newFromPairs: #(
		100 'Continue'
		101 'Switching Protocols'
		102 'Processing'
		200 'OK'
		201 'Created'
		202 'Accepted'
		203 'Non-Authoritative Information'
		204 'No Content'
		205 'Reset Content'
		206 'Partial Content'
		207 'Multi-Status'
		208 'Already Reported'
		226 'IM Used'
		300 'Multiple Choices'
		301 'Moved Permanently'
		302 'Found'
		303 'See Other'
		304 'Not Modified'
		305 'Use Proxy'
		306 'Reserved'
		307 'Temporary Redirect'
		400 'Bad Request'
		401 'Unauthorized'
		402 'Payment Required'
		403 'Forbidden'
		404 'Not Found'
		405 'Method Not Allowed'
		406 'Not Acceptable'
		407 'Proxy Authentication Required'
		408 'Request Timeout'
		409 'Conflict'
		410 'Gone'
		411 'Length Required'
		412 'Precondition Failed'
		413 'Request Entity Too Large'
		414 'Request-URI Too Long'
		415 'Unsupported Media Type'
		416 'Requested Range Not Satisfiable'
		417 'Expectation Failed'
		422 'Unprocessable Entity'
		423 'Locked'
		424 'Failed Dependency'
		425 'Reserved for WebDAV'
		426 'Upgrade Required'
		500 'Internal Server Error'
		501 'Not Implemented'
		502 'Bad Gateway'
		503 'Service Unavailable'
		504 'Gateway Timeout'
		505 'HTTP Version Not Supported'
		506 'Variant Also Negotiates (Experimental)'
		507 'Insufficient Storage'
		508 'Loop Detected'
		510 'Not Extended')
%
category: 'accessing'
classmethod: ZnConstants
knownHTTPMethods
	^ #(
		"Standard HTTP 1.1 Verbs"
		GET PUT POST DELETE HEAD 
		TRACE OPTIONS CONNECT PATCH
		"WebDAV verbs"
		PROPFIND PROPPATCH MKCOL COPY MOVE LOCK UNLOCK)
%
category: 'accessing'
classmethod: ZnConstants
knownHTTPVersions
	^ #('HTTP/1.1' 'HTTP/1.0')
%
category: 'resource limits'
classmethod: ZnConstants
maximumEntitySize
	"Return the maximum entity size to accept from a stream.
	Used by ZnEntity and subclasses. Can be set using #maximumEntitySize:
	This affects both client and server code.
	This helps to protect us from malicious content."
	
	^ ZnMaximumEntitySize value 
		ifNil: [ self defaultMaximumEntitySize ]
%
category: 'resource limits'
classmethod: ZnConstants
maximumEntitySize: integer
	"Set the maximum entity size to accept from a stream to integer bytes."
	
	^ DefaultMaximumEntitySize := integer
%
category: 'resource limits'
classmethod: ZnConstants
maximumLineLength
  "Return the maximum line length to accept.
	Used by ZnLineReader and thus for reading request/status lines as well as headers.
	This helps to protect us from malicious content."

  ^ 8192
%
category: 'accessing'
classmethod: ZnConstants
remoteAddressHeader
	^ 'X-Zinc-Remote-Address'
%
category: 'accessing'
classmethod: ZnConstants
standardHtmlDocType
	^ '<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">'
%
category: 'accessing'
classmethod: ZnConstants
welcomePageHtml
	^ '<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html>
<head>
<title>Zinc HTTP Components</title>
<style type="text/css">
body {
  color: black;
  background: white;
  width: 900px;
  font-family: Verdana, Arial, Helvetica, sans-serif;
  font-size: 13px;
}
p {
  width: 600px;
  padding: 0 20px 10px 20px;
} 
ul,ol {
  width: 600px;
  padding: 0 5px 5px 30px;
} 
#logo {
  color: orange;
  font-family: Helvetica, sans-serif;
  font-weight: bold;
  font-size: 100px;
}
</style>
</head>
<body>
<div id="logo">Zn</div>
<h1>Zinc HTTP Components</h1>
<p>
Welcome to Zinc HTTP Components, 
a modern, open-source Smalltalk framework to deal with the HTTP networking protocol.
</p>
<ul>
<li>Project homepage <a href="http://zn.stfx.eu/">http://zn.stfx.eu</a></li> 
<li>Locally available pages <a href="/help">/help</a></li>
</ul>
<h4>May the Source be with you!</h4>
</body>
</html>
'
%
set compile_env: 0
category: 'comparing'
method: ZnCookie
= aCookie
	(aCookie isKindOf: self class) ifFalse: [ ^ false ].
	^ (aCookie name = self name) & (aCookie path = self path) & (aCookie domain = self domain)
%
category: 'initialize-release'
method: ZnCookie
defaultDomain: aDomain
	self domain ifNil: [ self domain: aDomain ]
%
category: 'accessing'
method: ZnCookie
domain
	^ attributes at: 'domain' ifAbsent: [ nil ]
%
category: 'accessing'
method: ZnCookie
domain: aDomain
	attributes at: 'domain' put: aDomain
%
category: 'accessing'
method: ZnCookie
expires
	^ attributes at: 'expires' ifAbsent: [ nil ]
%
category: 'accessing'
method: ZnCookie
expires: anExpiration
	attributes at: 'expires' put: anExpiration
%
category: 'accessing'
method: ZnCookie
expiresTimeStamp
	self expires ifNil: [ ^ TimeStamp current plusDays: 1 ].
	^ ZnUtils parseHttpDate: self expires
%
category: 'private'
method: ZnCookie
extraAttributes
	"Answer all attributes except name and value"
	^ attributes associationsSelect: [ :ea | (ea key = 'name' or: [ ea key = 'value' ]) not ]
%
category: 'initialize-release'
method: ZnCookie
fromString: aString
	| tokens val data i |
	tokens := aString subStrings: ';'.
	i := tokens first indexOf: $=.
	val := tokens first copyFrom: 1 to: i - 1.
	data := tokens first copyFrom: i + 1 to: tokens first size. 
	self name: val trimBoth; value: data trimBoth.
	2 to: tokens size do: [ :index | 
		self readAttribute: (tokens at: index) ]
%
category: 'converting'
method: ZnCookie
fullString
	^ String streamContents: [ :stream | 
		self writeOn: stream ]
%
category: 'comparing'
method: ZnCookie
hash
	^ (self name hash bitXor: self path hash) bitXor: self domain hash
%
category: 'accessing'
method: ZnCookie
httponly
	"This is not an RFC cookie attribute, but a supplement found in MS Internet Explorer and supported in PHP.
	 See http://msdn.microsoft.com/en-us/library/ms533046.aspx"
	^ attributes at: 'httponly' ifAbsent: [ false ]
%
category: 'accessing'
method: ZnCookie
httponly: aBoolean
	attributes at: 'httponly' put: aBoolean
%
category: 'initialize-release'
method: ZnCookie
initialize 
	attributes := Dictionary new.
%
category: 'testing'
method: ZnCookie
isExpired
	^ (self expiresTimeStamp asUTC < TimeStamp current asUTC) or: [ self expires = 0 ]
%
category: 'testing'
method: ZnCookie
isInDomain: urlObject
	| domain |
	domain := (self domain beginsWith: '.')
		ifTrue: [ self domain copyFrom: 2 to: self domain size ]
		ifFalse: [ self domain ].
	^ urlObject host includesSubstring: domain
%
category: 'testing'
method: ZnCookie
isInPath: urlObject
	^ urlObject pathPrintString includesSubstring: self path
%
category: 'accessing'
method: ZnCookie
maxage
	^ self expires
%
category: 'accessing'
method: ZnCookie
name
	^ attributes at: 'name'
%
category: 'accessing'
method: ZnCookie
name: aName
	attributes at: 'name' put: aName
%
category: 'converting'
method: ZnCookie
nameValueString
	^ String streamContents: [ :stream | 
		self writeNameAndValueOn: stream ]
%
category: 'accessing'
method: ZnCookie
path
	^ attributes at: 'path' ifAbsent: [ '/' ]
%
category: 'accessing'
method: ZnCookie
path: aPath
	attributes at: 'path' put: aPath
%
category: 'printing'
method: ZnCookie
printOn: stream
	self writeOn: stream
%
category: 'initialize-release'
method: ZnCookie
readAttribute: aToken
	| i key data |
	i := aToken indexOf: $=.
	i > 0
		ifTrue: [
			key := (aToken copyFrom: 1 to: i - 1) trimBoth asLowercase.
			data := (aToken copyFrom: i + 1 to: aToken size) trimBoth ]
		ifFalse: [ 
			key := (aToken copyFrom: 1 to: aToken size) trimBoth asLowercase.
			data := true ].
	attributes at: key put: data
%
category: 'accessing'
method: ZnCookie
secure
	^ attributes at: 'secure' ifAbsent: [ false ]
%
category: 'accessing'
method: ZnCookie
secure: aBoolean
	attributes at: 'secure' put: aBoolean
%
category: 'accessing'
method: ZnCookie
value
	^ attributes at: 'value' ifAbsent: [ nil ]
%
category: 'accessing'
method: ZnCookie
value: aValue
	attributes at: 'value' put: aValue
%
category: 'printing'
method: ZnCookie
writeExtraAttributesOn: aStream
	self extraAttributes
		associationsDo: [ :ea | 
			aStream
				nextPutAll: '; ';
				nextPutAll: ea key.
			(ea value isKindOf: Boolean)
				ifFalse: [ 
					aStream
						nextPutAll: '=';
						nextPutAll: ea value ] ]
%
category: 'printing'
method: ZnCookie
writeNameAndValueOn: aStream
	aStream
		nextPutAll: self name;
		nextPutAll: '=';
		nextPutAll: self value
%
category: 'printing'
method: ZnCookie
writeOn: aStream
	self
		writeNameAndValueOn: aStream;
		writeExtraAttributesOn: aStream
%
category: 'instance creation'
classmethod: ZnCookie
fromString: aString
	^ self new 
		fromString: aString; 
		yourself
%
category: 'instance creation'
classmethod: ZnCookie
fromString: aString for: urlObject
	| cookie |
	cookie := self fromString: aString.
	"Ensures a domain value if none provided by the cookie"
	cookie defaultDomain: urlObject host.
	^ cookie
%
category: 'instance creation'
classmethod: ZnCookie
name: nameString value: value
	^ self new
		name: nameString;
		value: value;
		yourself
%
set compile_env: 0
category: 'as yet unclassified'
method: ZnCookieJar
add: aCookie
	(self removeIfExpired: aCookie) ifTrue: [^nil].
	self cookies copy do: [:cookie|
		cookie = aCookie ifTrue: [ self cookies remove: cookie]].
	self cookies add: aCookie
%
category: 'accessing'
method: ZnCookieJar
cookieAt: aName forUrl: urlObject
	(self cookiesForUrl: urlObject) do: [ :cookie | cookie name = aName ifTrue: [ ^ cookie ] ].
	^ nil
%
category: 'accessing'
method: ZnCookieJar
cookies 
	^ cookies ifNil: [ cookies := Bag new ]
%
category: 'accessing'
method: ZnCookieJar
cookiesForUrl: urlObject
	^ self cookies select: [ :cookie | 
		(cookie isExpired not) & (cookie isInDomain: urlObject) & (cookie isInPath: urlObject) ]
%
category: 'accessing'
method: ZnCookieJar
remove: aCookie
	self cookies remove: aCookie ifAbsent: [ nil ]
%
category: 'operations'
method: ZnCookieJar
removeAll
	cookies ifNotNil: [ cookies removeAll ]
%
category: 'operations'
method: ZnCookieJar
removeIfExpired: aCookie
	^ aCookie isExpired 
		ifTrue: [ 
			self remove: aCookie. 
			true ]
		ifFalse: [
			false ]
%
set compile_env: 0
category: 'accessing'
method: ZnCredential
authToken
	^ self authTokenForUrl: nil method: nil
%
category: 'accessing'
method: ZnCredential
authTokenForUrl: urlObject method: method
	self subclassResponsibility
%
category: 'accessing'
method: ZnCredential
domain
	^ domain
%
category: 'accessing'
method: ZnCredential
domain: anObject
	domain := anObject
%
category: 'testing'
method: ZnCredential
isComplete
	^ self subclassResponsibility
%
category: 'operations'
method: ZnCredential
linkToAuthRequest: aHeader
	"Link this credential to the WWW-Authenticate request in the provided header. 
	Used for authentication methods which require parameters provided by the server
	(e.g. Digest authentication)."
	realm := self class findRealmFor: aHeader
%
category: 'accessing'
method: ZnCredential
realm
	^ realm ifNil: [ realm := '' ]
%
category: 'accessing'
method: ZnCredential
realm: anObject
	realm := anObject
%
category: 'accessing'
method: ZnCredential
setAuthorizationHeader: headers for: urlObject method: method
	headers at: 'Authorization' put: self authToken
%
category: 'accessing'
classmethod: ZnCredential
authName
	self subclassResponsibility
%
category: 'accessing class hierarchy'
classmethod: ZnCredential
findHandlerFor: anAuthHeader
	| type i |
	i := anAuthHeader indexOf: Character space.
	type := anAuthHeader copyFrom: 1 to: i - 1.
	self allSubclassesDo: [ :subclass |
		subclass authName = type ifTrue: [ ^ subclass ] ].
	^ nil
%
category: 'accessing'
classmethod: ZnCredential
findRealmFor: anAuthHeader
	(anAuthHeader subStrings: ',') do: [ :token |
		"String>>trimBoth: is a grease method, so not sure if we should be using it."
		(token includesSubstring: 'realm=') 
			ifTrue: [ ^ ((token subStrings: '=') second) ] ].
	^ nil
%
set compile_env: 0
category: 'private'
method: ZnDefaultGsTransactionalServerDelegate
generateTransactionRequestString: request
  "Generate a string echoing the request"

  ^ String
    streamContents: [ :stream | 
      stream
        nextPutAll: 'This is Zinc HTTP Components echoing your request !';
        crlf.
      stream
        nextPutAll: 'Running ';
        print: request server;
        crlf.
      stream
        nextPutAll: request method;
        nextPutAll: ' request for '.
      request uri printPathQueryFragmentOn: stream.
      stream
        crlf;
        nextPutAll: 'with headers';
        crlf.
      request
        headersDo: [ :key :value | 
          stream
            space;
            nextPutAll: key;
            nextPutAll: ': ';
            nextPutAll: value;
            crlf ].
      request hasEntity
        ifTrue: [ 
          stream
            nextPutAll: ' containing ';
            print: request entity ] ]
%
category: 'initialize-release'
method: ZnDefaultGsTransactionalServerDelegate
initialize
  super initialize.
  self
    map: 'transaction' to: #'transactionRequest:';
    yourself
%
category: 'responses'
method: ZnDefaultGsTransactionalServerDelegate
transactionRequest: request
  "Transaction request store into a persistent field ... note that no transaction is needed by handler as the 
   entire request handler is wrapped by a transaction."

  | globalName fieldName fieldValue info entity |
  globalName := request uri queryAt: 'globalName' ifAbsent: [ '' ].
  fieldName := request uri queryAt: 'fieldName' ifAbsent: [ '' ].
  fieldValue := request uri queryAt: 'fieldValue' ifAbsent: [ '' ].
  (UserGlobals at: globalName asSymbol) at: fieldName put: fieldValue.
  info := self generateTransactionRequestString: request.
  entity := ZnEntity textCRLF: info.
  ^ ZnResponse ok: entity
%
set compile_env: 0
category: 'responses'
method: ZnDefaultServerDelegate
bytes: request
	"Answer a number of bytes according to a pattern as an application/octet-stream.
	Optionally take the size from the URI, as in /bytes/32 for 32 bytes, default to 64 bytes.
	The main goal is to be efficient, esp. in benchmarks, that's why we cache (non-thread-safe)"
	
	| count |
	count := Integer readFrom: request uri lastPathSegment ifFail: [ 64 ].
	(byteArray isNil or: [ byteArray size ~= count ]) 
		ifTrue: [
			byteArray := ByteArray new: count.
			1 to: count - 1 do: [ :each | 
				byteArray at: each put: (#(65 66 67 68) at: (each \\ 4 + 1)) ].
			byteArray at: count put: 10 ].
	^ ZnResponse ok: (ZnEntity bytes: byteArray)
%
category: 'responses'
method: ZnDefaultServerDelegate
dwbench: request
	"Reply with the dynamic DW-Bench HTML page"

	^ ZnResponse ok: (ZnEntity html: self generateDWBench)
%
category: 'responses'
method: ZnDefaultServerDelegate
echoRequest: request	
	"Echo request by generating a plain text response useful for debugging purposes"
	
	| delay info entity |
	delay := Integer readFrom: (request uri queryAt: 'delay' ifAbsent: [ '' ]) ifFail: [ 0 ].
	delay > 0 ifTrue: [ (Delay forSeconds: delay) wait ].  
	info := self generateEchoRequestString: request.
	entity := ZnEntity textCRLF: info.
	^ ZnResponse ok: entity
%
category: 'responses'
method: ZnDefaultServerDelegate
errorResponse: request
	"Here we artificially signal an Error at the Smalltalk level,
	optionally with a user defined message."
	
	| message |
	message := request uri queryAt: 'message' ifAbsent: [ 'An artifical error' ].
	Error signal: message
%
category: 'responses'
method: ZnDefaultServerDelegate
favicon: request
	"Answer a nice favicon for browsers to display"

	| entity |
	entity := ZnEntity with: ZnConstants faviconBytes type: 'image/vnd.microsoft.icon'. 
	^ ZnResponse ok: entity
%
category: 'private'
method: ZnDefaultServerDelegate
generateDWBench
	"Generate the dynamic DW-Bench HTML page.
	Although the date/time is variable, the page size is constant."
	
	^ String streamContents: [ :stream |
		stream << ZnConstants standardHtmlDocType.
		stream << '<html><head><title>DW-Bench Dynamic</title></head>'.
		stream << '<body><h1>DW-Bench Dynamic</h1><table border=1>'.
		1 to: 25 do: [ :row |
			stream << '<tr>'.
			1 to: 25 do: [ :col |
				stream << '<td>'; print: row * col; << '</td>' ].
			stream << '</tr>' ].
		stream << '</table><p>'; << Date today yyyymmdd; space; << Time now print24; << '</p></body></html>' ]
%
category: 'private'
method: ZnDefaultServerDelegate
generateEchoRequestString: request
	"Generate a string echoing the request"
	
	^ String streamContents: [ :stream |
		stream nextPutAll: 'This is Zinc HTTP Components echoing your request !'; crlf.
		stream nextPutAll: 'Running '; print: request server; crlf.
		stream nextPutAll: request method; nextPutAll: ' request for '.
		request uri printPathQueryFragmentOn: stream.
		stream crlf; nextPutAll: 'with headers'; crlf.
		request headersDo: [ :key :value |
			stream space; nextPutAll: key; nextPutAll: ': '; nextPutAll: value; crlf ].
		request hasEntity ifTrue: [
			stream nextPutAll: ' containing '; print: request entity ] ]
%
category: 'private'
method: ZnDefaultServerDelegate
generateHelp
	"Generate an HTML page with links to all pages I support"
	
	| title |
	title := self class name, ' Help'.
	^ String streamContents: [ :stream |
		stream << ZnConstants standardHtmlDocType.
		stream << '<html><head><title>'; << title; << '</title></head>'.
		stream << '<body><h1>'; << title; << '</h1><h3>Available Pages</h3><ul>'.
		prefixMap keys sorted do: [ :each | 
			stream << '<li><a href="'; << each; << '">'; << each; << '</a></li>' ].
		stream << '<ul></body></html>' ]
%
category: 'private'
method: ZnDefaultServerDelegate
generateSessionRequest: session
	"Generate an HTML page using a session"
	
	^ String streamContents: [ :stream |
		stream << ZnConstants standardHtmlDocType.
		stream nextPutAll: '<html><head><title>Session</title></head>'.
		stream nextPutAll: '<body><h1>Session</h1>'.
		stream nextPutAll: '<p>I am using '; print: session; nextPutAll: '</p>'.
		stream nextPutAll: '<p>Current session-id='; nextPutAll: session id; nextPutAll: '</p>'.
		stream nextPutAll: '<p>Session hit count is '; print: (session attributeAt: #hitCount); nextPutAll: '</p>'.
		stream nextPutAll: '</body></html>' ]
%
category: 'private'
method: ZnDefaultServerDelegate
generateStatus
	"Generate an HTML page with the state of the server"
	
	^ String streamContents: [ :stream |
		stream << ZnConstants standardHtmlDocType.
		stream nextPutAll: '<html><head><title>ZnServer Status</title></head>'.
		stream nextPutAll: '<body><h1>ZnServer Status</h1>'.
		stream nextPutAll: '<p>I am '; print: ZnCurrentServer value; nextPutAll: '</p>'.
		stream nextPutAll: '<p>'; nextPutAll: self systemVersionInfo; nextPutAll: '</p>'.
		stream nextPutAll: '<pre>'; nextPutAll: self vmStats; nextPutAll: '</pre>'.  
		stream nextPutAll: '<h1>Processes</h1><ol>'.
		self processes do: [ :each |
			stream 
				nextPutAll: '<li>'; 
				nextPutAll: each name; space; nextPut: $[; print: each priority; nextPut: $]; nextPutAll: '<br/>'; nextPutAll: each printString;
				nextPutAll: '</li>' ].
		stream nextPutAll: '</ol>'.  
		stream nextPutAll: '</body></html>' ]
%
category: 'private'
method: ZnDefaultServerDelegate
generateUnicodeTest
	"Generate an HTML page containing all Unicode characters with code points between 0 and 16r024F in a nice table"
	
	^ String streamContents: [ :stream |
		stream << ZnConstants standardHtmlDocType.
		stream << '<html><head><title>Unicode Test Page</title></head>'.
		stream << '<body><h1>Unicode Test Page</h1><table>'.
		0 to: 16r024F by: 8 do: [ :row |
			stream nextPutAll: '<tr>'.
			row to: row + 7 do: [ :each |
				stream nextPutAll: '<td>U+'.
				stream nextPutAll: (each printPaddedWith: $0 to: 4 base: 16). 
				stream nextPut: $=; nextPut: each asCharacter.
				stream nextPutAll: '</td>' ].
			stream nextPutAll: '</tr>' ].
		stream << '</table></body></html>' ]
%
category: 'public'
method: ZnDefaultServerDelegate
handleRequest: request
	| prefix prefixHandler |
	prefix := request uri isSlash
		ifTrue: [ prefixMap at: '/' ifAbsent: [ nil ] ]
		ifFalse: [ request uri firstPathSegment ].
	prefixHandler := prefixMap at: prefix ifAbsent: [ nil ].
	prefixHandler isNil
		ifFalse: [ 
			^ prefixHandler isSymbol
				ifTrue: [ self perform: prefixHandler with: request ]
				ifFalse: [ prefixHandler value: request ] ].
	^ ZnResponse notFound: request uri
%
category: 'public'
method: ZnDefaultServerDelegate
handleRequest: request gemServer: gemServer
  "compatability with ZnGemServerManagingMultiThreadedServer"

  "To add a GemStone transaction, subclass and use something like the following:

    gemServer 
      gemServerTransaction: [ ^ self handleRequest: request ]
      exceptionSet: ExceptionSet new

   Using `ExceptionSet new` means that exceptions handled up the stack.
"

  ^ self handleRequest: request
%
category: 'responses'
method: ZnDefaultServerDelegate
help: request
	"Reply with a dynamic HTML page containing links to all pages I support"

	^ ZnResponse ok: (ZnEntity html: self generateHelp)
%
category: 'initialize-release'
method: ZnDefaultServerDelegate
initialize
	self
		map: 'welcome' to: #welcome:;
		map: 'help' to: #help:;
		map: 'echo' to: #echoRequest:;
		map: 'dw-bench' to: #dwbench:;
		map: 'favicon.ico' to: #favicon:;
		map: 'random' to: #random:;
		map: 'bytes' to: #bytes:;
		map: 'status' to: #status:;
		map: 'unicode' to: #unicode:;
		map: 'session' to: #sessionRequest:;
		map: 'error' to: #errorResponse:;
		map: '/' to: 'welcome'
%
category: 'accessing'
method: ZnDefaultServerDelegate
map: prefix to: handler
	"Arrange for the receiver to dispatch requests matching prefix to handler.
	Handler can be a symbol naming a method in the receiver, 
	or a block accepting the request and producing the response"
	
	self prefixMap 
		at: prefix
		put: handler
%
category: 'accessing'
method: ZnDefaultServerDelegate
prefixMap
	^ prefixMap ifNil: [ prefixMap := Dictionary new ]
%
category: 'private'
method: ZnDefaultServerDelegate
processes
  ^ (ProcessorScheduler scheduler allProcesses
    reject: [ :each | each isTerminated or: [ each = Processor activeProcess ] ])
    sorted: [ :a :b | a priority >= b priority ]
%
category: 'responses'
method: ZnDefaultServerDelegate
random: request
	"Answer a text plain UTF-8 encoded string of random hex characters.
	Optionally take the size from the URI, as in /random/32 for 32 characters.
	Default to 64 characters with a newline at the end"
	
	| count hexString |
	count := Integer readFrom: request uri lastPathSegment ifFail: [ 64 ].
	hexString := String new: count streamContents: [ :stream |
		count - 1 timesRepeat: [ stream nextPut: '0123456789ABCDEF' atRandom ].
		stream lf ].
	^ ZnResponse ok: (ZnEntity text: hexString)
%
category: 'responses'
method: ZnDefaultServerDelegate
sessionRequest: request	
	"An HTML response that uses a session"
	
	| session hitCount |
	session := request session.
	hitCount := session attributeAt: #hitCount ifAbsent: [ 0 ].
	hitCount := hitCount + 1.
	session attributeAt: #hitCount put: hitCount. 
	^ ZnResponse ok: (ZnEntity html: (self generateSessionRequest: session))
%
category: 'responses'
method: ZnDefaultServerDelegate
status: request
	"Reply with a dynamic HTML page describing the state of the server"

	^ ZnResponse ok: (ZnEntity html: self generateStatus)
%
category: 'private'
method: ZnDefaultServerDelegate
systemVersionInfo
	| versionReport |
	versionReport := System stoneVersionReport.
	^ String streamContents: [ :stream |
			stream 
				print: 'GemStone ', (versionReport at: 'gsRelease'), ' of ', (versionReport at: 'gsBuildDate'), ' build ', (versionReport at: 'gsBuildSerialNum'); 
				nextPutAll: ' - '; 
				nextPutAll: ZnConstants defaultServerString ]
