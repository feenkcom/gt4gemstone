				ifTrue: [ stream next: count putAll: collection startingAt: offset ]
				ifFalse: [ 
					buffer := ByteArray new: count.
					buffer replaceFrom: 1 to: count with: collection startingAt: offset.
					stream nextPutAll: buffer ] ]
		ifFalse: [ 
			(collection isKindOf: ByteArray)
				ifTrue: [ 
					buffer := String new: count.
					buffer replaceFrom: 1 to: count with: collection startingAt: offset.
					stream nextPutAll: buffer ]
				ifFalse: [ stream next: count putAll: collection startingAt: offset ] ]
%
category: 'accessing'
method: ZnBivalentWriteStream
nextPut: object
	self isBinary
		ifTrue: [ stream nextPut: object asInteger ]
		ifFalse: [ stream nextPut: object asCharacter ]
%
category: 'accessing'
method: ZnBivalentWriteStream
nextPutAll: collection
	self isBinary
		ifTrue: [ stream nextPutAll: collection asByteArray ]
		ifFalse: [ stream nextPutAll: collection asString ]
%
category: 'initialize-release'
method: ZnBivalentWriteStream
on: writeStream
	stream := writeStream
%
category: 'accessing'
method: ZnBivalentWriteStream
print: object
	object printOn: self
%
category: 'printing'
method: ZnBivalentWriteStream
printOn: aStream
	aStream 
		nextPutAll: 'a '; 
		nextPutAll: self class name
%
category: 'accessing'
method: ZnBivalentWriteStream
space
	self nextPut: Character space
%
category: 'instance creation'
classmethod: ZnBivalentWriteStream
on: writeStream
	"Wrap writeStream as a ZnBivalentWriteStream, unless it is already one"
	
	(writeStream isKindOf: self) ifTrue: [ ^ writeStream ].
	
	^ self basicNew
		on: writeStream;
		yourself
%
set compile_env: 0
category: 'comparing'
method: ZnByteArrayEntity
= other
	^ super = other and: [ self bytes = other bytes ]
%
category: 'accessing'
method: ZnByteArrayEntity
bytes
	^ bytes
%
category: 'accessing'
method: ZnByteArrayEntity
bytes: anObject
	bytes := anObject
%
category: 'accessing'
method: ZnByteArrayEntity
contents
	^ self bytes
%
category: 'comparing'
method: ZnByteArrayEntity
hash
	^ super hash bitXor: self bytes hash
%
category: 'testing'
method: ZnByteArrayEntity
isEmpty 
	^ self bytes isNil or: [ self bytes isEmpty ]
%
category: 'printing'
method: ZnByteArrayEntity
printContentsOn: stream
	super printContentsOn: stream.
	self bytes notNil ifTrue: [ 
		stream space; print: self bytes ]
%
category: 'initialize-release'
method: ZnByteArrayEntity
readFrom: stream
	self contentLength isNil
		ifTrue: [ 
			self bytes: (ZnUtils readUpToEnd: stream limit: ZnConstants maximumEntitySize).
			self contentLength: self bytes size ]
		ifFalse: [ | byteArray |
			self contentLength > ZnConstants maximumEntitySize
				ifTrue: [ ZnEntityTooLarge signal ].
			byteArray := ByteArray new: self contentLength.
			self contentLength > ZnUtils streamingBufferSize 
				ifTrue: [
					ZnUtils streamFrom: stream to: byteArray writeStream size: self contentLength ]
				ifFalse: [
					stream next: self contentLength into: byteArray ]. 
			self bytes: byteArray ]
%
category: 'accessing'
method: ZnByteArrayEntity
readStream
	^ self bytes readStream
%
category: 'writing'
method: ZnByteArrayEntity
writeOn: stream
	ZnUtils nextPutAll: self bytes on: stream
%
category: 'instance creation'
classmethod: ZnByteArrayEntity
bytes: byteArray
	^ (self type: ZnMimeType applicationOctetStream length: byteArray size)
		bytes: byteArray;
		yourself
%
category: 'testing'
classmethod: ZnByteArrayEntity
designatedMimeType
	"I have no designated mime type, I can handle all binary content.
	See #concreteSubclassForType: "
	
	^ nil
%
category: 'testing'
classmethod: ZnByteArrayEntity
matches: mimeType
	"I have no designated mime type, I can handle all binary content.
	See #concreteSubclassForType: "
	
	^ false
%
set compile_env: 0
category: 'initialize-release'
method: ZnByteEncoder
beLenient
	"Don't be strict, which is the default.
	This means that holes in the mapping are let to pass through."

	strict := false
%
category: 'initialize-release'
method: ZnByteEncoder
byteToUnicode: map
	byteToUnicode := map
%
category: 'converting'
method: ZnByteEncoder
encodedByteCountFor: character
	^ 1
%
category: 'initialize-release'
method: ZnByteEncoder
identifier: object
	identifier := object
%
category: 'initialize-release'
method: ZnByteEncoder
initialize
	super initialize.
	strict := true
%
category: 'converting'
method: ZnByteEncoder
nextFromStream: stream
	"In non-strict mode, we let byte values for holes in our mapping pass through"

	| byteValue |
	^ (byteValue := stream next) < 128
		ifTrue: [ Character value: byteValue ]
		ifFalse: [ 
			(byteToUnicode at: byteValue - 127 ifAbsent: [ nil ])
				ifNotNil: [ :unicode | unicode ]
				ifNil: [ 
					strict
						ifTrue: [ self error: 'Character outside encoder range' ]
						ifFalse: [ Character value: byteValue ] ] ]
%
category: 'converting'
method: ZnByteEncoder
nextPut: character toStream: stream
	"In non-strict mode, we let characters for holes in our mapping table pass through"
	
	| code |
	(code := character codePoint) < 128
		ifTrue: [ stream nextPut: code ]
		ifFalse: [ 
			| byte |
			byte := unicodeToByte at: code ifAbsent: [ nil ].
			(byte isNil and: [ strict or: [ code > 255 ] ])
				ifTrue: [ self error: 'Character code outside encoder range' ].
			stream nextPut: (byte ifNil: [ code ]) ]
%
category: 'printing'
method: ZnByteEncoder
printOn: stream
	super printOn: stream.
	stream
		nextPut: $(;
		print: identifier.
	strict
		ifTrue: [ stream nextPutAll: ' strict' ].
	stream nextPut: $)
%
category: 'convenience'
method: ZnByteEncoder
readInto: string startingAt: offset count: requestedCount fromStream: stream
  "Read requestedCount characters into string starting at offset,
	returning the number read, there could be less available when stream is atEnd"

  | byteBuffer readCount |
  byteBuffer := ByteArray new: requestedCount.
  readCount := stream readInto: byteBuffer startingAt: 1 count: requestedCount.
  string
    replaceFrom: offset
    to: offset + readCount - 1
    with: byteBuffer asString
    startingAt: 1.
  ^ readCount
%
category: 'initialize-release'
method: ZnByteEncoder
unicodeToByte: map
	unicodeToByte := map
