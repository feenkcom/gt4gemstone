	^ lock ifNil: [ lock := TransientMutex new ]
%
category: 'private'
method: ZnManagingMultiThreadedServer
socketStreamOn: socket
	| socketStream |
	socketStream := super socketStreamOn: socket.
	self lock critical: [ 
		self connections add: socketStream ].
	^ socketStream
%
category: 'public'
method: ZnManagingMultiThreadedServer
stop: unregister
	super stop: unregister.
	self closeConnections
%
