method: ZnMimeType
matches: aMimeType
	"Compare the receiver to aMimeType, which is the pattern to match, 
	it is a normal instance where main or sub can be wildcards.
	Matches should be used instead of #= to ignore parameters."
	
	^ (aMimeType main = '*'
		or: [ aMimeType main = self main ])
		and: [
			aMimeType sub = '*'
				or: [ aMimeType sub = self sub ] ]
%
category: 'parameters'
method: ZnMimeType
parameterAt: key
	^ self parameterAt: key ifAbsent: [ KeyNotFound signalFor: key ]
%
category: 'parameters'
method: ZnMimeType
parameterAt: key ifAbsent: block
	parameters isNil ifTrue: [ ^ block value ].
	^ self parameters at: key ifAbsent: block
%
category: 'parameters'
method: ZnMimeType
parameterAt: aKey put: aValue
	self parameters at: aKey put: aValue
%
category: 'as yet unclassified'
method: ZnMimeType
parameters
	parameters isNil ifTrue: [ parameters := Dictionary new ].
	^ parameters
%
category: 'accessing'
method: ZnMimeType
parameters: aDictionary
	parameters := aDictionary
%
category: 'copying'
method: ZnMimeType
postCopy
	super postCopy.
	parameters := parameters copy
%
category: 'printing'
method: ZnMimeType
printOn: stream
	stream
		nextPutAll: self main;
		nextPut: $/;
		nextPutAll: self sub.
	parameters isNil ifFalse: [ 
		parameters keysAndValuesDo: [ :key :value | 
			stream
				nextPut: $;;
				nextPutAll: key;
				nextPut: $=;
				nextPutAll: value ] ]
%
category: 'parameters'
method: ZnMimeType
removeParameter: key
	parameters isNil ifTrue: [ ^ self ].
	^ self parameters removeKey: key ifAbsent: [ nil ]
%
category: 'parameters'
method: ZnMimeType
setCharSetUTF8
	self charSet: 'utf-8'
%
category: 'accessing'
method: ZnMimeType
sub
	^ sub
%
category: 'accessing'
method: ZnMimeType
sub: aString
	sub := aString asLowercase
%
category: 'convenience'
classmethod: ZnMimeType
any
	^ self predefinedInstanceAt: #any
	
%
category: 'convenience'
classmethod: ZnMimeType
applicationFormUrlEncoded
	^ self predefinedInstanceAt: #applicationFormUrlEncoded
%
category: 'convenience'
classmethod: ZnMimeType
applicationJavascript
	^ self predefinedInstanceAt: #applicationJavascript
%
category: 'convenience'
classmethod: ZnMimeType
applicationJson
	^ self predefinedInstanceAt: #applicationJson
%
category: 'convenience'
classmethod: ZnMimeType
applicationOctetStream
	^ self predefinedInstanceAt: #applicationOctetStream
%
category: 'convenience'
classmethod: ZnMimeType
applicationPdf
	^ self predefinedInstanceAt: #applicationPdf
%
category: 'convenience'
classmethod: ZnMimeType
applicationXml
	^ self predefinedInstanceAt: #applicationXml
%
category: 'convenience'
classmethod: ZnMimeType
default
	^ self applicationOctetStream
%
category: 'instance creation'
classmethod: ZnMimeType
forFilenameExtension: extension
	^ ExtensionsMap 
		at: extension 
		ifAbsent: [ self default ]
%
category: 'instance creation'
classmethod: ZnMimeType
fromString: aString 
	| main endOfSub sub parts parameters |
	main := aString copyUpTo: $/.
	endOfSub := aString indexOf: $;.
	endOfSub := endOfSub = 0 
		ifTrue: [ aString size ]
		ifFalse: [ endOfSub - 1 ].
	sub := aString copyFrom: main size + 2 to: endOfSub.
	endOfSub = aString size ifTrue: [ ^ self main: main sub: sub ].
	parts := (aString copyFrom: endOfSub + 1 to: aString size) subStrings: ';'.
	parameters := Dictionary new.
	parts do: [ :each | 
		parameters
			at: (each copyUpTo: $=) trimBoth 
			put: (each copyAfter: $=) trimBoth ].
	^ self 
		main: main
		sub: sub
		parameters: parameters
%
category: 'convenience'
classmethod: ZnMimeType
imageGif
	^ self predefinedInstanceAt: #imageGif
%
category: 'convenience'
classmethod: ZnMimeType
imageJpeg
	^ self predefinedInstanceAt: #imageJpeg
%
category: 'convenience'
classmethod: ZnMimeType
imagePng
	^ self predefinedInstanceAt: #imagePng
%
category: 'convenience'
classmethod: ZnMimeType
imageSvg
	^ self predefinedInstanceAt: #imageSvg
%
category: 'class initialization'
classmethod: ZnMimeType
initialize
	self initializeMimeTypes.
	self initializeExtensionsMap
%
category: 'private'
classmethod: ZnMimeType
initializeExtensionsMap 
	"To be extended later"
	
	ExtensionsMap := Dictionary new
		at: 'txt' put: self textPlain;
		at: 'text' put: self textPlain;
		at: 'htm' put: self textHtml;
		at: 'html' put: self textHtml;
		at: 'gif' put: self imageGif;
		at: 'jpg' put: self imageJpeg;
		at: 'jpeg' put: self imageJpeg;
		at: 'png' put: self imagePng;
		at: 'js' put: self applicationJavascript;
		at: 'xml' put: self applicationXml;
		at: 'css' put: self textCss;
		at: 'pdf' put: self applicationPdf;
		at: 'svg' put: self imageSvg;
		yourself
%
category: 'private'
classmethod: ZnMimeType
initializeMimeTypes 
	"To be extended later"

	MimeTypes := Dictionary new
		at: #applicationOctetStream put: (self main: 'application' sub: 'octet-stream');
		at: #applicationJavascript put: (self main: 'application' sub: 'javascript');
		at: #applicationJson put: (self main: 'application' sub: 'json');
		at: #applicationXml put: (self main: 'application' sub: 'xml');
		at: #applicationPdf put: (self main: 'application' sub: 'pdf');
		at: #applicationFormUrlEncoded put: (self main: 'application' sub: 'x-www-form-urlencoded');
		at: #imageGif put: (self main: 'image' sub: 'gif');
		at: #imageJpeg put: (self main: 'image' sub: 'jpeg');
		at: #imagePng put: (self main: 'image' sub: 'png');
		at: #imageSvg put: (self main: 'image' sub: 'svg+xml');
		at: #textPlain put: ((self main: 'text' sub: 'plain') setCharSetUTF8; yourself);
		at: #textHtml put: ((self main: 'text' sub: 'html') setCharSetUTF8; yourself);
		at: #textCss put: (self main: 'text' sub: 'css');
		at: #textJavascript put: (self main: 'text' sub: 'javascript');
		at: #multiPartFormData put: (self main: 'multipart' sub: 'form-data');
		at: #any put: (self main: '*' sub: '*');
		at: #text put: (self main: 'text' sub: '*');
		yourself
%
category: 'instance creation'
classmethod: ZnMimeType
main: aMainString sub: aSubString
	^ self new
		main: aMainString;
		sub: aSubString;
		yourself
%
category: 'instance creation'
classmethod: ZnMimeType
main: aMainString sub: aSubString parameters: aDictionary
	^ (self main: aMainString sub: aSubString)
		parameters: aDictionary;
		yourself
%
category: 'convenience'
classmethod: ZnMimeType
multiPartFormData
	^ self predefinedInstanceAt: #multiPartFormData
%
category: 'accessing'
classmethod: ZnMimeType
predefinedInstanceAt: key
	"Look up and return a predefined instance known under key.
	I return a copy that can be modified.
	See #initializeMimeTypes for the full list."
	
	^ (self sharedInstanceAt: key) copy
%
category: 'private'
classmethod: ZnMimeType
sharedInstanceAt: key
	"Look up and return a predefined instance known under key.
	See #initializeMimeTypes for the full list.
	The returned instance should not be modified."
	
	^ MimeTypes at: key
%
category: 'convenience'
classmethod: ZnMimeType
text
	^ self predefinedInstanceAt: #text
	
%
category: 'convenience'
classmethod: ZnMimeType
textCss
	^ self predefinedInstanceAt: #textCss
%
category: 'convenience'
classmethod: ZnMimeType
textHtml
	^ self predefinedInstanceAt: #textHtml
%
category: 'convenience'
classmethod: ZnMimeType
textJavascript
	^ self predefinedInstanceAt: #textJavascript
%
category: 'convenience'
classmethod: ZnMimeType
textPlain
	^ self predefinedInstanceAt: #textPlain
