category: 'initialize-release'
method: ZnServerSessionManager
initialize
	super initialize.
	sessions := Dictionary new
%
category: 'private'
method: ZnServerSessionManager
newSessionForRequest: request
	| id session |
	id := self newSessionId.
	session := ZnServerSession new.
	session id: id.
	sessions at: id put: session.
	^ session
%
category: 'private'
method: ZnServerSessionManager
newSessionId
	"Create a new session id.
	If the server has a route, append it at the end with a dot as separator."
	
	^ ZnCurrentServer value route
		ifNil: [ UUID new asString36 ]
		ifNotNil: [ :route | 
			String
				streamContents: [ :stream | 
					stream
						<< UUID new asString36;
						nextPut: $.;
						<< route ] ]
%
