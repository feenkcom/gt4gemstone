fileformat utf8
set compile_env: 0
! ------------------- Class definition for Stream
expectvalue /Class
doit
Object subclass: 'Stream'
	instVarNames: #()
	classVars: #( Lf Tab)
	classInstVars: #()
	poolDictionaries: #()
	category: 'Collections-Streams'
	inDictionary: ZincGlobals
	options: #()

%
expectvalue /Class
doit
Stream comment: 
'Stream is an abstract superclass that represents the ability to maintain a
 position reference into a linear sequence of objects.  Concrete subclasses are
 ReadStream and WriteStream.'
%
expectvalue /Class
doit
Stream category: 'Collections-Streams'
%
set compile_env: 0
! ------------------- Class definition for PositionableStream
expectvalue /Class
doit
Stream subclass: 'PositionableStream'
	instVarNames: #( itsCollection position)
	classVars: #()
	classInstVars: #()
	poolDictionaries: #()
	category: 'Collections-Streams'
	inDictionary: ZincGlobals
	options: #()

%
expectvalue /Class
doit
PositionableStream comment: 
'PositionableStreamLegacy is an abstract superclass 
 that provides additional protocol appropriate to Streams whose objects 
 are externally named by indices.

--- instVar itsCollection
A SequenceableCollection; the sequence of objects that the receiver may
 access.
--- instVar position
A SmallInteger; the current position reference for accessing the collection.
'
%
set compile_env: 0
