character: aCharacter
	"The character to pad the string with."

	character := aCharacter
%
category: 'initialization'
method: GRStringPrinter
initialize
	super initialize.
	self character: $ ; length: nil.
	self trimNone; padNone
%
category: 'accessing'
method: GRStringPrinter
length: anInteger
	"The maximal size of the string, or the size to pad to."

	length := anInteger
%
category: 'padding'
method: GRStringPrinter
padCenter
	"Pad to the center."

	pad := #pad:center:to:
%
category: 'padding'
method: GRStringPrinter
padLeft
	"Pad to the left."

	pad := #pad:left:to:
%
category: 'padding'
method: GRStringPrinter
padNone
	"Do not pad the input."

	pad := nil
%
category: 'padding'
method: GRStringPrinter
padRight
	"Pad to the right."

	pad := #pad:right:to:
%
category: 'printing'
method: GRStringPrinter
print: anObject on: aStream
	| string |
	string := anObject greaseString.
	trim isNil
		ifFalse: [ string := string perform: trim ].
	length isNil ifFalse: [
		length < string size
			ifTrue: [ string := string copyFrom: 1 to: length ].
		(pad isNil or: [ character isNil ])
			ifFalse: [ string := self perform: pad with: string with: character with: length ] ].
	aStream nextPutAll: string
