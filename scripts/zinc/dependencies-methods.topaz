	^(self classNamed: aSymbol) ~~ nil
%
category: 'testing'
method: SmalltalkProxy
includesKey: aGlobalName
  ^ (GsSession currentSession symbolList objectNamed: aGlobalName) ~~ nil
%
category: 'testing'
method: SmalltalkProxy
keys
  | symList keys |
  symList := GsSession currentSession symbolList.
  keys := IdentitySet new.
  1 to: symList size do: [ :j | (symList at: j) ifNotNil: [ :aDict | keys addAll: aDict keys ] ].
  ^ keys
%
category: 'testing'
method: SmalltalkProxy
keysAndValuesDo: aBlock
  | symList |
  symList := System myUserProfile symbolList.
  1 to: symList size do: [ :j | (symList at: j) ifNotNil: [ :aDict | aDict keysAndValuesDo: aBlock ] ]
%
