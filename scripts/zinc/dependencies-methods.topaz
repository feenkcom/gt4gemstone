%
category: 'parts-date'
classmethod: GRPrinter
absOffsetHoursPadded
	^ GRMappedPrinter
		block: [ :date | date offset hours abs ]
		next: (self numberWithAtLeastDigits: 2)
%
category: 'parts-date'
classmethod: GRPrinter
absOffsetMinutesPadded
