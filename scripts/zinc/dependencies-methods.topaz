category: 'operations'
method: FileDirectory
createDirectory: localDirName
  "Create a directory with the given name in this directory. Fail if the name is bad or if a file or directory with that name already exists."

  (GsFile
    _createDirectory: (self fullNameFor: localDirName)
    onClient: self onClient
    mode: nil) == nil
    ifTrue: [ 
      ^ self
        error:
          'Could not create directory: ' , (GsFile lastErrorString: self onClient) ]
%
category: 'operations'
method: FileDirectory
deleteDirectory: localDirName
  "Delete the directory with the given name in this directory. Fail if the path is bad or if a directory by that name does not exist."

  (GsFile
    _removeDirectory: (self fullNameFor: localDirName)
    onClient: self onClient) == nil
    ifTrue: [ 
      self
        error:
          'Delete directory: ' , localDirName printString , ' failed: '
            , (GsFile lastErrorString: self onClient) ]
