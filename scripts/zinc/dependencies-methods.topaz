category: 'proxy settings'
classmethod: HTTPSocket
httpProxyUser
	^HTTPProxyUser isNil
		ifTrue: ['']
		ifFalse: [HTTPProxyUser]
%
category: 'put'
classmethod: HTTPSocket
httpPut: contents to: url user: user passwd: passwd
	"Upload the contents of the stream to a file on the server"

	| bare serverName specifiedServer port page serverAddr authorization s list header firstData length aStream command |
	"parse url"
	bare := (url asLowercase beginsWith: 'http://') 
		ifTrue: [url copyFrom: 8 to: url size]
		ifFalse: [url].
	serverName := bare copyUpTo: $/.
	specifiedServer := serverName.
	(serverName includes: $:) ifFalse: [ port := self defaultPort ] ifTrue: [
		port := (serverName copyFrom: (serverName indexOf: $:) + 1 
				to: serverName size) asNumber.
		serverName := serverName copyUpTo: $:.
	].

	page := bare copyFrom: (bare indexOf: $/) to: bare size.
	page size = 0 ifTrue: [page := '/'].
	(self shouldUseProxy: serverName) ifTrue: [ 
		page := 'http://', serverName, ':', port printString, page.		"put back together"
		serverName := self httpProxyServer.
		port := self httpProxyPort].

  	"make the request"	
	serverAddr := GsSocket getHostAddressByName: serverName.
	serverAddr ifNil: [
		^ 'Could not resolve the server named: ', serverName].

	authorization := (ZnBase64Encoder new encode: (user , ':' , passwd) asByteArray).
	s := HTTPSocket  connectToServerOnHost: serverAddr port: port.
	[ command := 
		'PUT ', page, ' HTTP/1.0', CrLf, 
		self userAgentString, CrLf,
		'Host: ', specifiedServer, CrLf, 
		'ACCEPT: */*', CrLf,
		'',
		'Authorization: Basic ' , authorization , CrLf , 
		'Content-length: ', contents size printString, CrLf , CrLf , 
		contents.
	s sendCommand: command.
	"get the header of the reply"
	list := s getResponseUpTo: CrLf, CrLf ignoring: (String with: CR).	"list = header, CrLf, CrLf, beginningOfData"
	header := list at: 1.
	header isEmpty ifTrue: [ ^ 'server aborted early' ].
	firstData := list at: 3.

	"dig out some headers"
	s header: header.
	length := s getHeader: 'content-length'.
	length ifNotNil: [ length := length asNumber ].

	aStream := s getRestOfBuffer: firstData totalLength: length.
	s close.	"Always OK to destroy!"

	^ header, aStream contents
 ] ensure: [ s closeAndDestroy ]
%
category: 'get'
classmethod: HTTPSocket
initHTTPSocket: httpUrl timeoutSecs: timeout ifError: aBlock
	^self initHTTPSocket: httpUrl wait: timeout ifError: aBlock
%
category: 'utilities'
classmethod: HTTPSocket
initHTTPSocket: httpUrl wait: timeout ifError: errorBlock
 | serverName connectToHost connectToPort socket |
 serverName := connectToHost := httpUrl authority.
 connectToPort := httpUrl port ifNil: [ self defaultPort ].
 (self shouldUseProxy: connectToHost) ifTrue: [
  connectToHost := self httpProxyServer ifNil: [ serverName ].
  connectToPort := self httpProxyPort ].
 socket := self newTCPSocket.
 [ socket connectTo: connectToHost port: connectToPort timeout: timeout ]
  on: NetworkError do: [ :error |
   socket closeAndDestroy.
   ^ errorBlock value: 'Error: Server ', httpUrl authority, ' is not responding' ].
 ^ socket
%
category: 'initialization'
classmethod: HTTPSocket
initialize
	"HTTPSocket initialize"

	CR := Character cr.
	LF := Character lf.

	"string for command line termination:"
	CrLf := String with: CR with: LF.

	HTTPProxyCredentials := HTTPBlabEmail := ''.  "	'From: somebody@no.where', CrLf	"
%
category: 'accessing'
classmethod: HTTPSocket
mimeConverterClass

    ^Base64MimeConverter
%
category: 'accessing'
classmethod: HTTPSocket
mimeDocumentClass

    ^MIMEDocument
%
category: 'proxy settings'
classmethod: HTTPSocket
proxyCredentials

	self httpProxyServer ifNotNil: [ ^nil ].
	^HTTPProxyCredentials
%
category: 'proxy settings'
classmethod: HTTPSocket
proxyUser: userName password: password
 HTTPProxyUser := userName.
 HTTPProxyPassword := password.
 HTTPProxyCredentials := 'Proxy-Authorization: Basic ',
  (ZnBase64Encoder new encode: (userName, ':', password) asByteArray), String crlf
%
category: 'proxy settings'
classmethod: HTTPSocket
shouldUseProxy: serverName
	"Retrieve the server and port information from the URL, match it to the proxy settings and open a http socket for the request."

	self httpProxyServer ifNotNil: [
		self httpProxyExceptions
			detect: [:domainName | domainName gemstoneMatch: serverName]
			ifNone: [^true]].
	^false
%
category: 'proxy settings'
classmethod: HTTPSocket
useProxyServerNamed: proxyServerName port: portNum 
	"Direct all HTTP requests to the HTTP proxy server with the given name and port number."

	self httpProxyServer: proxyServerName.
	self httpProxyPort: portNum
%
category: 'accessing'
classmethod: HTTPSocket
userAgentString 
	"self userAgentString"

	^'User-Agent: GemStone',
		(System _gemVersion copyUpTo: $,)
%
set compile_env: 0
category: '*zinc-http'
method: HierarchicalUrl
asZnUrl
	^ ZnUrl new
		scheme: self scheme;
		host: self authority;
		port: self port;
		segments: (self path collect: [ :each | each isEmpty ifTrue: [ #/ ] ifFalse: [ each ] ]);
		query: (self query isNil ifTrue: [ nil ] ifFalse: [ ZnResourceMetaUtils parseQueryFrom: self query readStream ]);
		fragment: self fragment;
		yourself
%
category: 'access'
method: HierarchicalUrl
authority
	^authority
%
category: 'access'
method: HierarchicalUrl
fileName
	"Return the last part of the path,
	most often a filename but does not need to be."

	^self path last
%
category: 'printing'
method: HierarchicalUrl
fullPath
	| ans |
	ans := WriteStreamPortable on: String new.
	path do: [ :pathElem |
		ans nextPut: $/.
		ans nextPutAll: (ZnPercentEncoder new encode: pathElem). ].
	self query == nil  ifFalse: [ 
		ans nextPut: $?.
		ans nextPutAll: self query. ].
	self fragment == nil  ifFalse: [
		ans nextPut: $#.
		ans nextPutAll: (ZnPercentEncoder new encode: self fragment). ].
	
	^ans contents
%
category: 'downloading'
method: HierarchicalUrl
hasContents
	"most of these do...."
	^true
%
category: 'access'
method: HierarchicalUrl
isAbsolute
	
	path size > 0 ifFalse: [^ false].
	(path at: 1) size > 0 ifFalse: [^ false].
	^ ((path at: 1) at: 1) ~~ $.
%
category: 'private'
method: HierarchicalUrl
nativeDecodePercent: text
 | index hex |
 "Validate delimiters before percent decoding; incomplete escapes have the established encoding error."
 index := 1.
 hex := '0123456789abcdefABCDEF'.
 [ index <= text size ] whileTrue: [
  (text at: index) = $% ifTrue: [
   (index + 2 > text size or: [
    (hex includes: (text at: index + 1)) not or: [
     (hex includes: (text at: index + 2)) not ] ])
    ifTrue: [ ZnCharacterEncodingError signal: 'Invalid percent escape in legacy URL' ].
   index := index + 2 ].
  index := index + 1 ].
 ^ ZnPercentEncoder new decode: text
%
category: 'access'
method: HierarchicalUrl
password
	"http://user:pword@foo.com' asUrl password"
	^password
%
category: 'access'
method: HierarchicalUrl
path
	"return a collection of the decoded path elements, as strings"
	^path
%
category: 'access'
method: HierarchicalUrl
path: aCollection
	"Set the collection of path elements."

	path := aCollection
