category: 'http'
method: HTTPSocket
getResponseUpTo: marker
 ^ self getResponseUpTo: marker ignoring: ''
%
category: 'GsDevKit Issue60 patch'
method: HTTPSocket
getResponseUpTo: marker ignoring: ignored
 | response buffer count target matched start character |
 response := ''.
 buffer := ByteArray new: 2000.
 target := marker reject: [ :each | ignored includes: each ].
 target isEmpty ifTrue: [ self error: 'Empty HTTP header delimiter' ].
 [ response size < 2000 ] whileTrue: [
  count := self receiveDataTimeout: 20 into: buffer startingAt: 1.
  count = 0 ifTrue: [
   self isConnected ifTrue: [ ConnectionTimedOut signal: 'HTTP header receive timed out' ].
   ^ { response. ''. '' } ].
  response := response, (buffer copyFrom: 1 to: count) asString.
  matched := 0. start := 1.
  1 to: response size do: [ :index |
   character := response at: index.
   (ignored includes: character) ifFalse: [
    character = (target at: matched + 1)
     ifTrue: [ matched = 0 ifTrue: [ start := index ]. matched := matched + 1 ]
     ifFalse: [ matched := character = target first ifTrue: [ start := index. 1 ] ifFalse: [ 0 ] ].
    matched = target size ifTrue: [
     ^ { response copyFrom: 1 to: start - 1. marker.
      response copyFrom: index + 1 to: response size } ] ] ] ].
 ^ { response. ''. '' }
%
category: 'http'
method: HTTPSocket
getRestOfBuffer: beginning
 | response buffer count |
 response := RWBinaryOrTextStream on: String new.
 response nextPutAll: beginning.
 buffer := ByteArray new: 2000.
 [
  count := self receiveDataTimeout: 5 into: buffer startingAt: 1.
  count > 0
 ] whileTrue: [
  response nextPutAll: (buffer copyFrom: 1 to: count) asString ].
 self isConnected ifTrue: [ ConnectionTimedOut signal: 'HTTP body receive timed out' ].
 response size = 0 ifTrue: [ ^ 'Empty Buffer' ].
 response reset.
 ^ response
%
category: 'http'
method: HTTPSocket
getRestOfBuffer: beginning totalLength: length
 | response buffer count received |
 length ifNil: [ ^ self getRestOfBuffer: beginning ].
 response := RWBinaryOrTextStream on: String new.
 response nextPutAll: beginning.
 received := beginning size.
 buffer := ByteArray new: 2000.
 [ received < length ] whileTrue: [
  count := self receiveDataTimeout: 5 into: buffer startingAt: 1.
  count = 0 ifTrue: [
   self isConnected ifTrue: [ ConnectionTimedOut signal: 'HTTP body receive timed out' ].
   ^ 'server aborted early' ].
  response nextPutAll: (buffer copyFrom: 1 to: count) asString.
  received := received + count ].
 response reset.
 ^ response
%
category: 'http'
method: HTTPSocket
header: headerText
	"set the headers.  Then getHeader: can be used"

	"divide into basic lines"
	| lines foldedLines i statusLine |
	lines := headerText findTokens: (String with: Character cr  with: Character lf).
	lines := lines reject: [ :line | line isEmpty ].
	statusLine := lines first.
	lines := lines copyFrom: 2 to: lines size.

	"parse the status (pretty trivial right now)"
	responseCode := (statusLine findTokens: ' ') second.

	"fold lines that start with spaces into the previous line"
	foldedLines := OrderedCollection new.
	lines do: [ :line |
		line first isSeparator ifTrue: [
			foldedLines at: foldedLines size  put: (foldedLines last, line) ]
		ifFalse: [ foldedLines add: line ] ].

	"make a dictionary mapping headers to header contents"
	headers := Dictionary new.
	foldedLines do: [ :line |
		i := line indexOf: $:.
		i > 0 ifTrue: [
			headers 
			at: (line copyFrom: 1 to: i-1) asLowercase 
			put: (line copyFrom: i+1 to: line size) trimSeparators ] ].
%
