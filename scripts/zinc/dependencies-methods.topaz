category: 'private'
method: TransientMutex
forMutualExclusion

	^true
%
set compile_env: 0
category: '*bootstrap-mutual-exclusion'
method: TransientRecursionLock
critical: aBlock
	"Answer the result of evaluating aBlock while allowing the receiver's
	semaphore to synchronize processing other processes.

	WARNING: do not cache semaphore reference in tems. The variable 
		contexts for this method may be persisted"

	| proc |
	lockingProcess == (proc := Processor activeProcess) ifTrue: [^ aBlock value ].
	self semaphore wait.
	lockingProcess := proc .
	^ aBlock ensure: [
		lockingProcess := nil.
		self semaphore signal ]
%
category: 'Instance Creation'
classmethod: TransientRecursionLock
forMutualExclusion
  "Answer a new semaphore that has an initial pending
   signal, that can be used for mutial exclusion
   processing."
  ^self new
%
set compile_env: 0
category: 'Mutual Exclusion'
method: TransientSemaphore
critical: aBlock
	"inline of Semaphore>>critical: to avoid having instance of Semaphore 
	  on stack if persisted as part of a continuation"
	
	| value |
	self semaphore wait.
	value := aBlock ensure: [ self semaphore signal ].
	^value
%
category: 'private'
method: TransientSemaphore
forMutualExclusion

	^false
%
category: '*bootstrap-private'
method: TransientSemaphore
semaphore
   | sem |
   (sem := semaphore) ifNil:[
      sem := Semaphore new.
      semaphore := sem .
      self forMutualExclusion ifTrue: [ sem signal ].
      "SeasidePlatformSupport addTransient: self."
    ].
    ^ sem
%
