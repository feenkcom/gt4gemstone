category: 'operations'
method: FileDirectory
deleteLocalFiles
	"Delete the local files in this directory."

	self fileNames do:[:fn| self deleteFileNamed: fn ifAbsent: [self error: 'Could not delete the old version of file ' , (self fullNameFor: fn) ]]
