category: 'Adding'
method: ReadStream
upTo: anObject
| start end |

start := position.
end := itsCollection indexOf: anObject startingAt: start .
end == 0 ifTrue:[ ^self upToEnd ].

"skip to the end and return the data passed over"
position := end + 1.
^itsCollection copyFrom: start to: (end - 1)
