category: 'operations'
method: FileDirectory
fileNames
	"Return a collection of names for the files (but not directories) in this directory."
	"FileDirectory default fileNames"

	^ (self entries select: [:entry | (entry dirFlag) not])
		collect: [:entry | entry name]
%
category: 'utilities'
method: FileDirectory
fileNamesMatching: pat
	"
	FileDirectory default fileNamesMatching: '*'
	FileDirectory default fileNamesMatching: '*.image;*.changes'
	"
	
	| files |
	files := OrderedCollection new.
	
	(pat findTokens: ';', String crlf) do: [ :tok | 
		files addAll: (self fileNames select: [:name | tok match: name]) ].
	
	^files
%
category: 'operations'
method: FileDirectory
fileNamesMatchingPattern: patternArray
	"
	FileDirectory default fileNamesMatchingPattern: #(#( $* ))
	FileDirectory default fileNamesMatchingPattern: #( #( $* '.image') #($*'.changes') )
	"
	
	| files |
	files := OrderedCollection new.
	
	patternArray do: [ :pat | 
		files addAll: (self fileNames select: [:name | name matchPattern: pat ]) ].
	
	^files
%
category: 'operations'
method: FileDirectory
forceNewDirectoryNamed: localDirectoryName
  "Ensure that the receiver and all parent directory exist. Create them if necessary"
  
  self exists ifFalse: [ self containingDirectory forceNewDirectoryNamed: self localName ].
  (self directoryNamed: localDirectoryName) exists
    ifFalse: [ self createDirectory: localDirectoryName].
  ^self
