category: 'accessing'
method: SmalltalkProxy
allClasses

	^ self classOrganizer classes asArray
%
category: 'accessing'
method: SmalltalkProxy
associationAt: aGlobalName
  ^ GsSession currentSession symbolList resolveSymbol: aGlobalName
%
category: 'accessing'
method: SmalltalkProxy
at: aGlobalName
  ^ GsSession currentSession symbolList objectNamed: aGlobalName
%
category: 'accessing'
method: SmalltalkProxy
at: aGlobalName ifAbsent: aBlock
  | glob |
  aGlobalName isNil
    ifTrue: [ ^ aBlock value ].
  glob := GsSession currentSession symbolList objectNamed: aGlobalName.
  ^ glob == nil
    ifTrue: [ aBlock value ]
    ifFalse: [ glob ]
%
category: 'accessing'
method: SmalltalkProxy
at: aGlobalName ifPresent: aBlock
  | glob |
  aGlobalName isNil
    ifTrue: [ ^ nil ].
  glob := GsSession currentSession symbolList objectNamed: aGlobalName.
  ^ glob ~~ nil
    ifTrue: [ aBlock value: glob ]
    ifFalse: [ glob ]
%
category: 'accessing'
method: SmalltalkProxy
at: aGlobalName put: anObject
  ^ (GsSession currentSession symbolList objectNamed: #'UserGlobals')
    at: aGlobalName
    put: anObject
%
category: 'accessing'
method: SmalltalkProxy
bindingOf: varName
	^self associationAt: varName
%
category: 'accessing'
method: SmalltalkProxy
classNamed: className
	"className is either a class name or a class name followed by '
	class'. Answer the class or metaclass it names"
	| meta baseName baseClass |
	(className endsWith: ' class')
		ifTrue: [meta := true.
			baseName := className copyFrom: 1 to: className size - 6]
		ifFalse: [meta := false.
			baseName := className].
	baseClass := self
				at: baseName asSymbol
				ifAbsent: [^ nil].
	meta
		ifTrue: [^ baseClass class]
		ifFalse: [^ baseClass]
%
category: 'accessing'
method: SmalltalkProxy
classNames

	^ClassOrganizer cachedOrganizer classes collect: [:ea | ea name ]
%
