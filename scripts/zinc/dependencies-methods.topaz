category: 'accessing'
method: FileDirectory
directoryEntry
	^self containingDirectory directoryEntryFor: self localName
%
category: 'enumeration'
method: FileDirectory
directoryEntryFor: filenameOrPath
	"Answer the directory entry for the given file or path. Sorta like a poor man's stat()."
	| fName dir |
	self class splitName: filenameOrPath to:[:filePath :name |
		fName := name.
		filePath isEmpty
			ifTrue: [dir := self]
			ifFalse: [dir := self class on: filePath]].
	^dir entries detect:[:entry| entry name = fName] ifNone:[nil]
%
category: 'operations'
method: FileDirectory
directoryExists: filenameOrPath
	"Answer true if a directory of the given name exists. The given name may be either a full path name or a local directory within this directory."


	| fName dir |
	self class splitName: filenameOrPath to:
		[:filePath :name |
			fName := name.
			filePath isEmpty
				ifTrue: [dir := self]
				ifFalse: [dir := self directoryNamed: filePath]].

	^dir exists and: [ dir directoryNames includes: fName ].
%
category: 'operations'
method: FileDirectory
directoryNamed: aString

	^ self class on: (self fullNameFor: aString)
%
category: 'operations'
method: FileDirectory
directoryNames
	"Return a collection of names for the subdirectories of this directory."
	"FileDirectory default directoryNames"

	^ (self entries select: [:entry | entry dirFlag])
		collect: [:entry | entry name]
%
category: 'operations'
method: FileDirectory
entries

	| ar contents |
	ar := Array new.
	contents := GsFile contentsAndTypesOfDirectory: self pathString onClient: self onClient.
	1 to: contents size by: 2 do: [:i | | path dirFlag modTime sz nm entry |
		path := contents at: i.
		nm := (path findTokens: '/\') last.
		((nm ~= '.') _and: [nm ~= '..'])
			ifTrue: [
				dirFlag := (contents at: i + 1) not.
				modTime := GsFile _fileModTime: path onClient: self onClient.
				sz := dirFlag 
					ifTrue: [0]
					ifFalse: [GsFile _sizeOf: path onClient: self onClient].
				entry := (DirectoryEntry name: nm creationTime: modTime modificationTime: modTime dirFlag: dirFlag fileSize: sz)
					sourceDirectory: self;
					yourself.
				ar add: entry
			].
	].
	^ar
%
category: 'testing'
method: FileDirectory
exists
  | result |
  result := GsFile _exists: self pathString onClient: self onClient.
  result
    ifNil: [ 
      self
        error:
          'Disk error: ' , (GsFile lastErrorString ifNil: [ '' ]) , ' for path: '
            , self pathString ].
  ^ result
%
category: 'testing'
method: FileDirectory
fileExists: filenameOrPath
	"Answer true if a file of the given name exists. The given name may be either a full path name or a local file within this directory."
	"FileDirectory default fileExists: Smalltalk sourcesName"

	| fName dir |
	self class splitName: filenameOrPath to:
		[:filePath :name |
			fName := name.
			filePath isEmpty
				ifTrue: [dir := self]
				ifFalse: [dir := self class on: filePath]].
	^dir fileNames includes: fName
%
category: 'stream creation'
method: FileDirectory
fileNamed: localFileName
	"Open the file with the given name in this directory for writing."

	| fullName |
	fullName := self fullNameFor: localFileName.
	(GsFile _exists: fullName onClient: self onClient)
		ifFalse: [ ^self error: 'File named: ', localFileName printString, ' does not exist.' ].
	^BinaryOrTextFile open: fullName mode: 'a+b' onClient: self onClient.
