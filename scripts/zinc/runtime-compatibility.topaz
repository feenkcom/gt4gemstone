fileformat utf8
set compile_env: 0
category: 'accessing'
classmethod: ZnNetworkingUtils
default	<gtGsExtension>	^ SessionTemps current at: #ZnNetworkingUtils_default ifAbsentPut: [ self new ]
%
category: 'accessing'
classmethod: ZnNetworkingUtils
default: anInstance	<gtGsExtension>	SessionTemps current at: #ZnNetworkingUtils_default put: anInstance
%
category: 'public'
classmethod: ZnSingleThreadedServer
default	<gtGsExtension>	| defaults |	defaults := SessionTemps current at: #ZnSingleThreadedServer_defaults ifAbsentPut: [ IdentityDictionary new ].	^ defaults at: self ifAbsent: [ nil ]
%
category: 'public'
classmethod: ZnSingleThreadedServer
defaultOn: portNumber	<gtGsExtension>	| defaults server |	defaults := SessionTemps current at: #ZnSingleThreadedServer_defaults ifAbsentPut: [ IdentityDictionary new ].	server := defaults at: self ifAbsent: [ nil ].	server ifNil: [ server := self on: portNumber. defaults at: self put: server ]		ifNotNil: [ server stop; port: portNumber ].	^ server
%
category: 'public'
classmethod: ZnSingleThreadedServer
stopDefault	<gtGsExtension>	| defaults server |	defaults := SessionTemps current at: #ZnSingleThreadedServer_defaults ifAbsentPut: [ IdentityDictionary new ].	server := defaults at: self ifAbsent: [ nil ].	server ifNotNil: [ server stop. defaults removeKey: self ifAbsent: [ ] ].	^ server
%
category: 'accessing'
classmethod: ZnServer
managedServers	<gtGsExtension>	^ SessionTemps current at: #ZnServer_managedServers ifAbsentPut: [ IdentitySet new ]
%
