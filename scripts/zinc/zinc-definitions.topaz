! ------------------- Class definition for ZnByteEncoder
expectvalue /Class
doit
ZnCharacterEncoder subclass: 'ZnByteEncoder'
	instVarNames: #( identifier byteToUnicode unicodeToByte
	                  strict)
	classVars: #( ByteTextConverters)
	classInstVars: #()
	poolDictionaries: #()
	category: 'Zinc-Character-Encoding-Core'
	inDictionary: ZincGlobals
	options: #()

%
expectvalue /Class
doit
ZnByteEncoder comment: 
'I am ZnByteEncoder, a concrete subclass of ZnCharacterEncoder.I handle single byte encodings where byte values 0 to 127 map to ASCIIand 128 to 255 are a permutation to Unicode characters.I derive my mappings by parsing official unicode.org specifications.Part of Zinc HTTP Components.'
%
expectvalue /Class
doit
ZnByteEncoder category: 'Zinc-Character-Encoding-Core'
%
