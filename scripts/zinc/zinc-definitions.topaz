! ------------------- Class definition for ZnChunkedWriteStream
expectvalue /Class
doit
Object subclass: 'ZnChunkedWriteStream'
	instVarNames: #( stream extraHeaders totalSize
	                  chunkCount)
	classVars: #()
	classInstVars: #()
	poolDictionaries: #()
	category: 'Zinc-HTTP-Streaming'
	inDictionary: ZincGlobals
	options: #()

%
expectvalue /Class
doit
ZnChunkedWriteStream comment: 
'I am ZnChunkedWriteStream, I wrap another write stream and add HTTP 1.1 chunked transfer encoding.I write a chunk for each #nextPutAll: or #next:putAll:startingAt:I should be wrapped in a ZnBufferedWriteStream for #next: to work.When done, send #close or #finish to me.Part of Zinc HTTP Components.'
%
expectvalue /Class
doit
ZnChunkedWriteStream category: 'Zinc-HTTP-Streaming'
%
